class _AutonomySendTarget:
    """Minimal event-like send target for the P0-1 background generator."""

    def __init__(self, plugin, umo, sender_id="", sender_name="", private=True):
        self._plugin = plugin
        self.unified_msg_origin = str(umo or "")
        self._sender_id = str(sender_id or "")
        self._sender_name = str(sender_name or "")
        self._private = bool(private)

    def is_private_chat(self):
        return self._private

    def get_sender_id(self):
        return self._sender_id

    def get_sender_name(self):
        return self._sender_name

    async def send(self, chain):
        return await self._plugin.context.send_message(self.unified_msg_origin, chain)


@register("astrbot_plugin_biocore", "Johnhmzm", "拟态生物情绪核心：注入表达意图，不生成回复", "1.3.4")
class BioCorePlugin(Star):
    def __init__(self, context: Context, config=None):
        # L0 config layer: inject paths so ConfigMixin never imports main
        self._data_dir = DATA_DIR
        self._persist_dir = _PERSIST_DATA_DIR
        self._profile_path = PROFILE_PATH
        self._api_config_path = API_CONFIG_PATH
        super().__init__(context)
        self.config = config or {}
        self.enabled = bool(self.config.get("enabled", True))
        # emotion probe concurrency guard: busy -> drop (never queue).
        self._probe_inflight = 0
        try:
            self.emotion_probe_max_inflight = max(
                1, int(self.config.get("emotion_probe_max_inflight", 1) or 1))
        except Exception:
            self.emotion_probe_max_inflight = 1
        self.inject_intent = bool(self.config.get("inject_intent", True))
        try:
            self.summary_max_chars = max(0, int(self.config.get("summary_max_chars", 0) or 0))
        except Exception:
            self.summary_max_chars = 0
        self.bc_prompt_mode = str(self.config.get("bc_prompt_mode", "telemetry") or "telemetry").strip().lower()
        if self.bc_prompt_mode not in ("telemetry", "semantic", "text"):
            self.bc_prompt_mode = "telemetry"
        self.bc_text_legend_enabled = bool(
            self.config.get("bc_text_legend_enabled", True))
        self.voice_transcription_enabled = bool(self.config.get("voice_transcription_enabled", True))
        try:
            self.event_summary_delay_hours = max(0, int(self.config.get("event_summary_delay_hours", 6) or 6))
        except Exception:
            self.event_summary_delay_hours = 6
        self.proactive_reply = bool(self.config.get("proactive_reply", False))
        # Task-15: noise -> autonomy. Both default false; when off no readiness
        # is computed, no background task starts, and no message can be sent.
        self.proactive_autonomy = bool(self.config.get("proactive_autonomy", False))
        self.proactive_send = bool(self.config.get("proactive_send", False))
        # Task-28: minimal autonomy loop (default OFF; private-only; token-only).
        self.autonomy_loop_enabled = bool(self.config.get("autonomy_loop_enabled", False))
        self.autonomy_loop_theta_ig = self._loop_cfg_float(
            "autonomy_loop_theta_ig", AUTONOMY_LOOP_THETA_IG,
            AUTONOMY_LOOP_THETA_MIN, AUTONOMY_LOOP_THETA_MAX)
        self.autonomy_loop_margin = self._loop_cfg_float(
            "autonomy_loop_margin", AUTONOMY_LOOP_MARGIN,
            AUTONOMY_LOOP_MARGIN_MIN, AUTONOMY_LOOP_MARGIN_MAX)
        self.autonomy_loop_k_delay = self._loop_cfg_float(
            "autonomy_loop_k_delay", AUTONOMY_LOOP_K_DELAY,
            AUTONOMY_LOOP_K_MIN, AUTONOMY_LOOP_K_MAX)
        self.autonomy_loop_ior_seconds = self._loop_cfg_float(
            "autonomy_loop_ior_seconds", AUTONOMY_LOOP_IOR_SECONDS,
            AUTONOMY_LOOP_IOR_MIN, AUTONOMY_LOOP_IOR_MAX)
        self.autonomy_loop_c0 = self._loop_cfg_float(
            "autonomy_loop_c0", AUTONOMY_LOOP_C0, 0.0, 1.0)
        self.autonomy_loop_c1 = self._loop_cfg_float(
            "autonomy_loop_c1", AUTONOMY_LOOP_C1, 0.0, 1.0)
        self.autonomy_loop_c2 = self._loop_cfg_float(
            "autonomy_loop_c2", AUTONOMY_LOOP_C2, 0.0, 1.0)
        self.autonomy_loop_token_only = bool(
            self.config.get("autonomy_loop_token_only", True))
        # MOD-2 (restored in step-3): L4 autonomy tick engine selector.
        # "module" = biocore_model.autonomy_tick (new default); "legacy" = the
        # in-core autonomy loop, kept as the fallback path until step-4 removal.
        self.autonomy_tick_engine = str(
            self.config.get("autonomy_tick_engine", "module") or "module").strip().lower()
        if self.autonomy_tick_engine not in ("legacy", "module"):
            self.autonomy_tick_engine = "module"
        # task-35/36: reply-side wiring (all deterministic, default OFF except
        # read-only telemetry counters which have no behavioural effect).
        self.refusal_brevity_enabled = bool(
            self.config.get("refusal_brevity_enabled", False))
        self.reply_consistency_enabled = bool(
            self.config.get("reply_consistency_enabled", False))
        self.llm_telemetry_enabled = bool(
            self.config.get("llm_telemetry_enabled", False))
        self.token_usage_enabled = bool(
            self.config.get("token_usage_enabled", False))
        # P1-3: real reply truncation cap (only active with refusal_brevity_enabled).
        try:
            self.refusal_brevity_max_chars = max(40, min(400, int(
                self.config.get("refusal_brevity_max_chars", 160) or 160)))
        except Exception:
            self.refusal_brevity_max_chars = 160
        # ---- 1.3.1 model-layer (task-37/38/39) ----
        self.bc_budget_enabled = bool(self.config.get("bc_budget_enabled", True))
        # §6: total char budget 480–800 (engineering); the old token-only key
        # was dead config and has been removed (P2 fix).
        try:
            self.bc_budget_chars = max(480, min(800, int(
                self.config.get("bc_budget_chars", 700) or 700)))
        except Exception:
            self.bc_budget_chars = 700
        self.sycophancy_check_enabled = bool(
            self.config.get("sycophancy_check_enabled", True))
        self.bc_dedupe_enabled = bool(self.config.get("bc_dedupe_enabled", True))
        try:
            self.bc_dedupe_history = max(1, min(50, int(
                self.config.get("bc_dedupe_history", 5) or 5)))
        except Exception:
            self.bc_dedupe_history = 5
        self.bc_hints_enabled = bool(self.config.get("bc_hints_enabled", True))
        self.bc_trace_enabled = bool(self.config.get("bc_trace_enabled", False))
        _wl = self.config.get("bc_label_whitelist")
        self._bc_label_whitelist = (list(_wl) if isinstance(_wl, (list, tuple)) and _wl
                                    else None)
        # P1-1: F1 split into two independent switches.
        #   trace: write state.reverse_check only (default ON, read-only, no hint)
        #   hint:  inject the <=140-char "avoid X" line next round (default OFF)
        self.think_selfcheck_trace_enabled = bool(
            self.config.get("think_selfcheck_trace_enabled", True))
        self.think_selfcheck_hint_enabled = bool(
            self.config.get("think_selfcheck_hint_enabled", False))
        self.think_repeat_guard_enabled = bool(
            self.config.get("think_repeat_guard_enabled", False))
        self.think_reflect_enabled = bool(
            self.config.get("think_reflect_enabled", False))
        try:
            self.think_reflect_daily_cap = max(1, min(20, int(
                self.config.get("think_reflect_daily_cap", 3) or 3)))
        except Exception:
            self.think_reflect_daily_cap = 3
        self.think_reflect_private_only = bool(
            self.config.get("think_reflect_private_only", True))
        self.think_reflect_llm_enabled = bool(
            self.config.get("think_reflect_llm_enabled", False))
        self.think_reflect_provider = str(
            self.config.get("think_reflect_provider", "") or "").strip()
        self.soft_bound_enabled = bool(self.config.get("soft_bound_enabled", False))
        self.soft_bound_k = self._loop_cfg_float("soft_bound_k", 0.10, 0.05, 0.20)
        self.soft_bound_m_frac = self._loop_cfg_float(
            "soft_bound_m_frac", 0.08, 0.05, 0.10)
        self.soft_bound_lam = self._loop_cfg_float(
            "soft_bound_lam", 0.10, 0.05, 0.20)
        self.path_monitor_enabled = bool(
            self.config.get("path_monitor_enabled", False))
        # ---- task-43: L1 thinking-physiology behaviour switches (all OFF) ----
        self.conflict_gate_enabled = bool(
            self.config.get("conflict_gate_enabled", False))
        self.rumination_effect_enabled = bool(
            self.config.get("rumination_effect_enabled", False))
        self.anchor_update_enabled = bool(
            self.config.get("anchor_update_enabled", False))
        self.identity_threat_stress_enabled = bool(
            self.config.get("identity_threat_stress_enabled", False))
        self.anchor_weight = self._loop_cfg_float(
            "anchor_weight", 0.25, 0.0, 0.9)
        # ---- task-38 accuracy ----
        self.temporal_validity_enabled = bool(
            self.config.get("temporal_validity_enabled", False))
        self.calibration_adaptive_enabled = bool(
            self.config.get("calibration_adaptive_enabled", False))
        self.rerank_enabled = bool(self.config.get("rerank_enabled", False))
        try:
            self.rerank_top_n = max(1, min(10, int(
                self.config.get("rerank_top_n", 5) or 5)))
        except Exception:
            self.rerank_top_n = 5
        self.memory_pin_enabled = bool(self.config.get("memory_pin_enabled", True))
        self.memory_overflow_compact_enabled = bool(
            self.config.get("memory_overflow_compact_enabled", False))
        self.mood_congruence_enabled = bool(
            self.config.get("mood_congruence_enabled", False))
        self.emotion_gating_enabled = bool(
            self.config.get("emotion_gating_enabled", False))
        # ---- task-37 token/cost ----
        self.token_budget_enabled = bool(
            self.config.get("token_budget_enabled", True))
        self.memory_recall_budget_enabled = bool(
            self.config.get("memory_recall_budget_enabled", False))
        try:
            self.recall_top_k = max(1, min(8, int(
                self.config.get("recall_top_k", 3) or 3)))
        except Exception:
            self.recall_top_k = 3
        try:
            self.recall_single_chars = max(40, min(220, int(
                self.config.get("recall_single_chars", 120) or 120)))
        except Exception:
            self.recall_single_chars = 120
        self.savings_mode = bool(self.config.get("savings_mode", False))
        self.context_budget_enabled = bool(
            self.config.get("context_budget_enabled", False))
        try:
            self.context_budget_turns = max(2, min(40, int(
                self.config.get("context_budget_turns", 8) or 8)))
        except Exception:
            self.context_budget_turns = 8
        self.cost_input_per_1m = self._loop_cfg_float(
            "cost_input_per_1m", 2.0, 0.0, 1000.0)
        self.cost_output_per_1m = self._loop_cfg_float(
            "cost_output_per_1m", 8.0, 0.0, 1000.0)
        self.cost_cache_per_1m = self._loop_cfg_float(
            "cost_cache_per_1m", 0.5, 0.0, 1000.0)
        # ---- task-54/55 chains (all default OFF; no LLM) ----
        self.expression_chain_enabled = bool(
            self.config.get("expression_chain_enabled", False))
        self.relationship_chain_enabled = bool(
            self.config.get("relationship_chain_enabled", False))
        self.gottman_enabled = bool(self.config.get("gottman_enabled", False))
        self.big5_effect_enabled = bool(
            self.config.get("big5_effect_enabled", False))
        self.learning_bandit_enabled = bool(
            self.config.get("learning_bandit_enabled", False))
        self.learning_relationship_enabled = bool(
            self.config.get("learning_relationship_enabled", False))
        self.learning_worthiness_enabled = bool(
            self.config.get("learning_worthiness_enabled", False))
        # P0/P1 safety + external-call governance (default-safe).
        self.data_admin_token = str(self.config.get("data_admin_token", "") or "")
        self.embedding_sensitive_allowed = bool(
            self.config.get("embedding_sensitive_allowed", False))
        try:
            self.bg_llm_daily_calls = max(0, min(100000, int(
                self.config.get("bg_llm_daily_calls", 200) or 200)))
        except Exception:
            self.bg_llm_daily_calls = 200
        self.bg_llm_daily_cost = self._loop_cfg_float(
            "bg_llm_daily_cost", 2.0, 0.0, 1000.0)
        try:
            self.outbound_timeout_ms = max(2000, min(5000, int(
                self.config.get("outbound_timeout_ms", 3000) or 3000)))
        except Exception:
            self.outbound_timeout_ms = 3000
        try:
            self.image_caption_timeout_ms = max(2000, min(20000, int(
                self.config.get("image_caption_timeout_ms", 8000) or 8000)))
        except Exception:
            self.image_caption_timeout_ms = 8000
        try:
            self.summary_llm_timeout_ms = max(2000, min(20000, int(
                self.config.get("summary_llm_timeout_ms", 8000) or 8000)))
        except Exception:
            self.summary_llm_timeout_ms = 8000
        # "省钱模式" is an OPTIONAL preset (default off); it only overrides
        # effective caps, never the accuracy-first defaults.
        if self.savings_mode:
            _eff = savings_overrides({
                "bc_budget_chars": self.bc_budget_chars,
                "recall_top_k": self.recall_top_k,
                "recall_single_chars": self.recall_single_chars})
            self.bc_budget_chars = int(_eff["bc_budget_chars"])
            self.memory_recall_budget_enabled = bool(_eff["memory_recall_budget_enabled"])
            self.recall_top_k = int(_eff["recall_top_k"])
            self.recall_single_chars = int(_eff["recall_single_chars"])
            self.sentence_dedup_enabled = bool(_eff["sentence_dedup_enabled"])
            self.bc_hints_enabled = bool(_eff["bc_hints_enabled"])
        # Stage-2: C8+C9 goal<->appraisal closed loop (default OFF = 1.2.98).
        self.bio_feedback_loops = bool(self.config.get("bio_feedback_loops", False))
        # Task-20: L1 learning defaults ON with small steps + hard bounds.
        self.bio_learning = bool(self.config.get("bio_learning", True))
        _rm = str(self.config.get("retention_model", "single") or "single")
        self.retention_model = _rm if _rm in LEARNING_RETENTION_MODELS else "single"
        # Batch4 attention flags: all default OFF = pure 1.2.98 no-op.
        self.attention_gate_enabled = bool(self.config.get("attention_gate_enabled", False))
        try:
            self.attention_gate_s = max(0.20, min(0.40, float(self.config.get("attention_gate_s", 0.30) or 0.30)))
        except Exception:
            self.attention_gate_s = 0.30
        try:
            self.attention_gate_shift = max(-0.20, min(0.20, float(self.config.get("attention_gate_shift", 0.0) or 0.0)))
        except Exception:
            self.attention_gate_shift = 0.0
        self.fan_penalty_enabled = bool(self.config.get("fan_penalty_enabled", False))
        try:
            self.fan_cap = max(1, min(64, int(self.config.get("fan_cap", 32) or 32)))
        except Exception:
            self.fan_cap = 32
        try:
            self.fan_gain = max(0.05, min(0.20, float(self.config.get("fan_gain", 0.10) or 0.10)))
        except Exception:
            self.fan_gain = 0.10
        try:
            self.fan_floor = max(0.50, min(0.85, float(self.config.get("fan_floor", 0.70) or 0.70)))
        except Exception:
            self.fan_floor = 0.70
        self.cowan_capacity_enabled = bool(self.config.get("cowan_capacity_enabled", False))
        try:
            self.cowan_capacity = max(3, min(6, int(self.config.get("cowan_capacity", 4) or 4)))
        except Exception:
            self.cowan_capacity = 4
        self.attention_topk_cap_enabled = bool(self.config.get("attention_topk_cap_enabled", False))
        try:
            self.attention_topk_cap = max(3, min(6, int(self.config.get("attention_topk_cap", 4) or 4)))
        except Exception:
            self.attention_topk_cap = 4
        # Batch5 H2: event chain (default OFF; H2-3 multi-hop also OFF).
        self.attention_gate_mode = str(self.config.get("attention_gate_mode", "hard") or "hard").lower()
        if self.attention_gate_mode not in ("hard", "probabilistic"):
            self.attention_gate_mode = "hard"
        try:
            self.attention_seed = int(self.config.get("attention_seed", 0) or 0)
        except Exception:
            self.attention_seed = 0
        # H2-2 budget is independent of the H2-1 edge switch.
        self.chain_budget_enabled = bool(self.config.get("chain_budget_enabled", False))
        self.memory_chain_enabled = bool(self.config.get("memory_chain_enabled", False))
        self.salience_boost_enabled = bool(self.config.get("salience_boost_enabled", False))
        self.sentence_dedup_enabled = bool(self.config.get("sentence_dedup_enabled", False))
        self.embedding_cache_enabled = bool(self.config.get("embedding_cache_enabled", True))
        try:
            self.embedding_timeout_ms = max(100, min(15000, int(
                self.config.get("embedding_timeout_ms", EMBED_TIMEOUT_MS_DEFAULT)
                or EMBED_TIMEOUT_MS_DEFAULT)))
        except Exception:
            self.embedding_timeout_ms = EMBED_TIMEOUT_MS_DEFAULT
        self.memory_chain_multihop = bool(self.config.get("memory_chain_multihop", False))
        try:
            self.chain_hops = max(1, min(2, int(self.config.get("chain_hops", 2) or 2)))
        except Exception:
            self.chain_hops = 2
        try:
            self.chain_fan_out = max(1, min(3, int(self.config.get("chain_fan_out", 3) or 3)))
        except Exception:
            self.chain_fan_out = 3
        try:
            self.chain_decay = max(0.4, min(0.6, float(self.config.get("chain_decay", 0.5) or 0.5)))
        except Exception:
            self.chain_decay = 0.5
        try:
            self.chain_max_new = max(1, min(6, int(self.config.get("chain_max_new", 6) or 6)))
        except Exception:
            self.chain_max_new = 6
        try:
            self.noise_seed = int(self.config.get("noise_seed", 0) or 0)
        except Exception:
            self.noise_seed = 0
        self._autonomy_task = None
        self._autonomy_private_sessions = {}
        # A1: event ranking is deterministic by default; the optional LLM rerank
        # follows the global rerank provider only when this switch is turned on.
        self.event_ranking_llm = bool(self.config.get("event_ranking_llm", False))
        # D5: stable default shape even before the first recall fills it.
        self._last_memory_trace = dict(DEFAULT_MEMORY_TRACE)
        self.memory_dedup_embedding = bool(self.config.get("memory_dedup_embedding", True))
        # M1 memory module: default OFF; enabled = shadow engine (no behaviour change).
        self.memory_module_enabled = bool(self.config.get("memory_module_enabled", False))
        self._memory_module_engines = {}
        self._memory_module_last_recall = None
        # task-33: deterministic memory-point worthiness gate (default ON).
        # OFF = exact legacy behaviour (archive every candidate, no new fields).
        self.memory_worthiness_enabled = bool(
            self.config.get("memory_worthiness_enabled", True))
        # Safety switch: default ON (new installs). When OFF, no masking,
        # no cross-session isolation, no forced abstention, no poison filter.
        # Saved old settings keep the user's stored value (load_settings below).
        self.safety_enabled = bool(self.config.get("safety_enabled", True))
        self.cross_session_memory = not self.safety_enabled
        self.sensitive_memory_protection = self.safety_enabled
        # P2: warn AFTER the value is assigned (previously logged false always).
        if not self.safety_enabled:
            logger.warning("[biocore] safety_enabled=false: 公开部署建议保持开启；"
                           "私人使用可关（敏感掩码/跨会话隔离/低置信拒答/投毒过滤关闭）")
        # Hybrid lexical+MMR retrieval and LLM-proposed write candidates.
        self.hybrid_retrieval = bool(self.config.get("hybrid_retrieval", True))
        self.llm_memory_candidates = bool(self.config.get("llm_memory_candidates", True))
        # B-T02 we-memory is evidence-gated and OFF by default (needs real
        # shared-ritual evidence before it writes relationship state).
        self.we_memory_enabled = bool(self.config.get("we_memory_enabled", False))
        # L-T02..L-T12 bounded runtime state. Only the last trace/hint is kept
        # in memory; no prompt text is stored and no reply is generated.
        self._last_cause_trace = []
        self._last_strategy_hint = ""
        self._last_memory_entries = []
        self._llm_v2_last = {}
        # task-36: bounded read-only telemetry (never feeds prompts or gates).
        self._llm_telemetry = {"counters": {}, "recent": []}
        self._token_usage = {"available": False, "sessions": {}}
        # task-37/39/40 per-turn read-only state (never fed back into prompts).
        self._bc_history = []
        self._last_injection_trace = None
        self._last_reverse_check = None
        # P1-1: F1 hint is NOT merged into strategy hints; it is a separate
        # pending line accounted inside bc_budget_chars.
        self._reverse_check_hint = ""
        self._repeat_guard = None
        self._repeat_hint = ""
        self._repeat_streak = 0
        self._reflect_hint = ""
        self._reflect_stats = {}
        self._reflect_cache = {}
        self._path_monitor = None
        self._token_budget = {"sessions": {}, "today": {}, "calls": 0}
        self._recent_replies = []
        self._label_history = []
        self._thought_note_current = ""
        self._rerank_stats = {"calls": 0, "fallback": 0, "last_n": 0}
        # task-54/55: per-session learning state (L1 read-only projection).
        self._learning = {}
        self._learning_pending = {}
        self._learning_daily = {}
        self._last_user_text = ""
        # P0/P1 safety ops state (read-only; tokens are in-memory/one-shot).
        self._download_tokens = {}
        self._delete_tokens = {}
        self._image_caption_timeouts = 0
        self._bg_lock = None
        self._bg_llm_usage = {"day": "", "calls": 0, "cost": 0.0}
        self._embed_cache_sig = None
        self._image_fail_count = 0
        self._corrupt_backups = 0
        self._migration_note = ""
        self._restore_fail_inject = False
        try:
            self._env_checks = self._run_env_selfcheck()
        except Exception:
            self._env_checks = {"warnings": ["selfcheck_failed"]}
        # LLM scope: user requirement is "LLM only for reply + summary".
        # When true, BioCore only calls the LLM for event/memory summaries;
        # persona compile / event ranking / reflection / image caption are
        # skipped (deterministic fallbacks where available).
        self.llm_only_reply_summary = bool(
            self.config.get("llm_only_reply_summary", True))
        self.llm_functions = {
            _name: {"enabled": LLM_FUNCTION_DEFAULTS[_name],
                    "provider": "follow_llm"}
            for _name in LLM_FUNCTIONS
        }
        self.first_run_persona_compile = bool(self.config.get("first_run_persona_compile", True))
        self.kb_enabled = bool(self.config.get("kb_enabled", False))
        _names = self.config.get("kb_names", [])
        self.kb_names = [str(x).strip() for x in _names] if isinstance(_names, (list, tuple)) else []
        self.cores = {}
        # Synthetic fallback core when no user core exists yet (restart).
        self._global_bio_core = None
        self._last_insult_ts = 0.0
        self.lexical_fallback_enabled = bool(
            self.config.get("lexical_fallback_enabled", True))
        self._consolidating = False
        self._last_consolidation = 0.0
        self._last_event_archive = 0.0
        self._last_reflection = 0.0
        try:
            self.reflection_interval_hours = max(1, int(self.config.get("reflection_interval_hours", 6) or 6))
        except Exception:
            self.reflection_interval_hours = 6
        # Event-driven insight trigger: fallback is a 24h ultra-long safety net,
        # not a periodic 6h main trigger anymore.
        self._insight_fallback_hours = max(INSIGHT_FALLBACK_HOURS, int(self.reflection_interval_hours))
        # Tunable thresholds (defaults match the constants above; AstrBot plugin
        # config exposes insight_min_new_events / insight_cooldown_minutes).
        try:
            self._insight_min_new_events = max(
                1, int(self.config.get("insight_min_new_events", INSIGHT_MIN_NEW_EVENTS)
                       or INSIGHT_MIN_NEW_EVENTS))
        except Exception:
            self._insight_min_new_events = INSIGHT_MIN_NEW_EVENTS
        try:
            self._insight_cooldown_minutes = max(
                1, int(self.config.get("insight_cooldown_minutes", INSIGHT_COOLDOWN_SECONDS // 60)
                       or (INSIGHT_COOLDOWN_SECONDS // 60)))
        except Exception:
            self._insight_cooldown_minutes = INSIGHT_COOLDOWN_SECONDS // 60
        # Long-term pattern insight: main entry is the manual dashboard button;
        # automatic generation is opt-in and OFF by default.
        self.insight_auto_enabled = bool(self.config.get("insight_auto_enabled", False))
        try:
            self.stimulus_decay_seconds = max(30, int(self.config.get("stimulus_decay_seconds", 300) or 300))
            self.stimulus_habituation = max(0.0, float(self.config.get("stimulus_habituation", 0.75) or 0.75))
        except Exception:
            self.stimulus_decay_seconds = 300
            self.stimulus_habituation = 0.75
        self.image_recognition_enabled = bool(self.config.get("image_recognition_enabled", True))
        try:
            self.image_service_idle_seconds = max(30, int(self.config.get("image_service_idle_seconds", 120) or 120))
        except Exception:
            self.image_service_idle_seconds = 120
        try:
            self.image_cache_max_entries = max(20, int(self.config.get("image_cache_max_entries", 500) or 500))
        except Exception:
            self.image_cache_max_entries = 500
        def _configured_path(key):
            raw = str(self.config.get(key, "") or "").strip()
            return Path(raw) if raw else None
        self.image_llama_server = _configured_path("image_llama_server")
        self.image_llama_model = _configured_path("image_llama_model")
        self.image_llama_mmproj = _configured_path("image_llama_mmproj")
        try:
            _raw_port = int(self.config.get("image_service_port", 0) or 0)
            self.image_service_port = _raw_port if _raw_port > 0 else 0
        except Exception:
            self.image_service_port = 0
        # Lazy image-service process/lock state (initialized here so the
        # first image request does not AttributeError).
        self._image_proc = None
        self._image_last_used = 0.0
        self._image_service_lock = None
        _triggers = self.config.get("image_trigger_words", [])
        self.image_trigger_words = ([str(x).strip() for x in _triggers if str(x).strip()]
                                    if isinstance(_triggers, (list, tuple)) else [])
        try:
            self.valence_decay_minutes = max(1.0, float(self.config.get("valence_decay_minutes", 120) or 120))
        except Exception:
            self.valence_decay_minutes = 120.0
        try:
            self.arousal_decay_minutes = max(1.0, float(self.config.get("arousal_decay_minutes", 30) or 30))
        except Exception:
            self.arousal_decay_minutes = 30.0
        try:
            self.social_decay_minutes = max(1.0, float(self.config.get("social_decay_minutes", 180) or 180))
        except Exception:
            self.social_decay_minutes = 180.0
        self.stimuli = []
        self.profile = None
        self.persona_text = ""
        # Persona selection: empty = follow AstrBot default persona.
        self.persona_id = str(self.config.get("persona_id") or "").strip()
        # Hash of the persona text whose numeric profile was compiled; lets
        # strict LLM mode still compile ONCE on first run / persona change.
        self._persona_compiled_hash = ""
        # Schema slots proposed once by the persona compiler (bounded strings).
        self.schema_texts = []
        # L-T07: bounded persona style slots proposed by the compiler (never
        # prompt text; the interpretation layer stays the only prompt owner).
        self.persona_style = {"intimacy_style": "neutral", "address_terms": []}
        self.self_model = self._load_self_model()
        if not isinstance(self.self_model.get("diary"), list):
            self.self_model["diary"] = []
        if not isinstance(self.self_model.get("relationship_narratives"), list):
            self.self_model["relationship_narratives"] = []
        self.api_config = {}
        DATA_DIR.mkdir(parents=True, exist_ok=True)
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        self._load_profile()
        self._load_settings()
        # The host event loop may not be running yet: init only records that
        # the loop is wanted; page_status / the first message starts it.
        self._life_task = None
        self._life_start_pending = True
        try:
            self._ensure_life_task()
        except Exception:
            self._life_start_pending = True
        if "kb_enabled" in self.config:
            self.kb_enabled = bool(self.config.get("kb_enabled"))
        if "kb_names" in self.config:
            _n = self.config.get("kb_names")
            if isinstance(_n, (list, tuple)):
                self.kb_names = [str(x).strip() for x in _n if str(x).strip()]
        self._load_api_config()
        self._register_page_api()
        try:
            self._cleanup_duplicate_events()
        except Exception as exc:
            logger.warning("[biocore] dedupe init failed: %s", exc)
        try:
            _d = self._public_api_config()
            logger.info("[biocore] api defaults llm=%s embedding=%s rerank=%s",
                        (_d.get("llm") or {}).get("provider_id"),
                        (_d.get("embedding") or {}).get("provider_id"),
                        (_d.get("rerank") or {}).get("provider_id"))
        except Exception as exc:
            logger.warning("[biocore] api defaults probe failed: %s", exc)

    def _load_profile(self):
        try:
            _profile_file = None
            for _cand in (PROFILE_PATH, _PERSIST_DATA_DIR / "persona_profile.json"):
                try:
                    if _cand.exists():
                        _profile_file = _cand
                        break
                except Exception:
                    continue
            if _profile_file is not None:
                d = json.loads(_profile_file.read_text(encoding="utf-8"))
                self.profile = dict(d.get("profile") or {})
                self.persona_text = str(d.get("persona") or "")
                _ph = str(d.get("persona_hash") or "")
                self._persona_compiled_hash = _ph or (_sha256(self.persona_text) if self.persona_text else "")
                _schema = d.get("schema")
                if isinstance(_schema, list):
                    self.schema_texts = [str(x).strip()[:60] for x in _schema
                                         if str(x).strip()][:6]
                _style = d.get("style")
                if isinstance(_style, dict):
                    _tag = str(_style.get("intimacy_style") or "neutral")
                    if _tag not in ("neutral", "playful", "gentle", "reserved"):
                        _tag = "neutral"
                    _terms = [str(x).strip()[:12] for x in (_style.get("address_terms") or [])
                              if str(x).strip()][:3]
                    self.persona_style = {"intimacy_style": _tag, "address_terms": _terms}
                logger.info("[biocore] loaded profile %s", _profile_file)
        except Exception as exc:
            logger.warning("[biocore] profile load failed: %s", exc)

    async def _persona_text(self, event) -> str:
        try:
            pm = self.context.persona_manager
            _pid = str(getattr(self, "persona_id", "") or self.config.get("persona_id") or "").strip()
            if _pid:
                try:
                    _p = pm.get_persona_v3_by_id(_pid)
                except Exception:
                    _p = None
                if _p:
                    if isinstance(_p, dict):
                        return str(_p.get("prompt") or _p.get("system_prompt") or "")
                    return str(getattr(_p, "prompt", "") or getattr(_p, "system_prompt", "") or "")
            p = await pm.get_default_persona_v3(getattr(event, "unified_msg_origin", None))
            if isinstance(p, dict):
                return str(p.get("prompt") or p.get("system_prompt") or "")
            return str(getattr(p, "prompt", "") or getattr(p, "system_prompt", "") or "")
        except Exception as exc:
            logger.warning("[biocore] persona read failed: %s", exc)
            return ""

    def _function_cfg(self, kind: str) -> dict:
        _name = LLM_FUNCTION_ALIASES.get(str(kind or ""), str(kind or ""))
        _all = getattr(self, "llm_functions", None)
        if not isinstance(_all, dict):
            return {"enabled": True, "provider": "follow_llm"}
        _cfg = _all.get(_name)
        if not isinstance(_cfg, dict):
            _cfg = {}
        return {
            "enabled": bool(_cfg.get("enabled", LLM_FUNCTION_DEFAULTS.get(_name, True))),
            "provider": str(_cfg.get("provider") or "follow_llm"),
        }

    def _llm_allowed(self, kind: str) -> bool:
        """Per-function LLM switch (replaces the old global strict flag)."""
        _all = getattr(self, "llm_functions", None)
        if not isinstance(_all, dict):
            # Test harness / legacy object created before this feature: keep
            # the old llm_only_reply_summary semantics when present.
            _strict = getattr(self, "llm_only_reply_summary", None)
            if _strict is None:
                return True
            return (not bool(_strict)) or str(kind or "") in ("reply", "summary")
        if not self._function_cfg(kind)["enabled"]:
            return False
        # P1-3: global background-LLM daily budget (calls + estimated cost).
        if str(kind) in LLM_BACKGROUND_KINDS:
            try:
                _today = time.strftime("%Y-%m-%d")
                if str(self._bg_llm_usage.get("day") or "") != _today:
                    self._bg_llm_usage = {"day": _today, "calls": 0, "cost": 0.0}
                _limit_calls = int(getattr(self, "bg_llm_daily_calls", 200) or 0)
                _limit_cost = float(getattr(self, "bg_llm_daily_cost", 2.0) or 0.0)
                if ((_limit_calls and int(self._bg_llm_usage.get("calls", 0)) >= _limit_calls)
                        or (_limit_cost and float(self._bg_llm_usage.get("cost", 0.0)) >= _limit_cost)):
                    self._bg_budget_blocked = True
                    self._record_llm_telemetry(kind, "budget_blocked")
                    return False
            except Exception:
                pass
        return True

    def _provider_kind(self, provider) -> str:
        """Classify a provider by id/model/type (chat / vision / embedding / tts / rerank)."""
        try:
            cfg = getattr(provider, "provider_config", {}) or {}
            raw = " ".join(str(x or "") for x in (
                cfg.get("id"), cfg.get("model"),
                cfg.get("provider_type"), type(provider).__name__,
            )).lower()
        except Exception:
            raw = ""
        if any(x in raw for x in ("img", "image", "vision", "t2i", "dall", "stable", "midjourney", "exusiai-img")):
            return "vision"
        if any(x in raw for x in ("tts", "speech", "voice")):
            return "tts"
        if any(x in raw for x in ("embed", "bge", "text-embedding")):
            return "embedding"
        if "rerank" in raw:
            return "rerank"
        return "chat"

    async def _provider_for(self, kind: str, event=None):
        """Resolve the LLM provider for one function.

        Default ("follow_llm") uses AstrBot's current chat provider. A configured
        provider_id is looked up via get_provider_by_id; if it is missing we log
        a warning and fall back to the main LLM instead of failing the feature.
        """
        _cfg = self._function_cfg(kind)
        _override = _cfg["provider"]
        _umo = str(getattr(event, "unified_msg_origin", "") or "") if event is not None else ""
        if _override and _override not in ("follow_llm", "main", "default", ""):
            _p = None
            try:
                _p = self.context.get_provider_by_id(_override)
            except Exception as exc:
                logger.warning("[biocore] provider lookup failed for %s (%s): %s", kind, _override, exc)
                _p = None
            if _p is not None:
                if self._provider_kind(_p) == "chat":
                    return _p
                logger.warning("[biocore] llm function %s provider %s is not a chat provider; fallback to main LLM",
                               kind, _override)
            else:
                logger.warning("[biocore] llm function %s provider %s not found; fallback to main LLM", kind, _override)
        try:
            return await self.context.get_using_provider_async(_umo)
        except Exception as exc:
            logger.warning("[biocore] main LLM provider lookup failed for %s: %s", kind, exc)
            return None


    # ------------------------------------------------------------------
    # LLM v2 (L-T01..L-T12): proposal-only model calls.
    #
    # Contract:
    #   * every function is registered in LLM_FUNCTIONS and defaults to OFF;
    #   * prompt text + output parsing only live in interpretation.py;
    #   * a model output is validated before storage (relationship_meta);
    #   * no function writes core v/a/d/trust/goals or generates a reply;
    #   * strict/legacy mode (_llm_allowed) skips every extra call.
    # ------------------------------------------------------------------
    @staticmethod
    def _truncate_at_sentence(text, cap) -> str:
        """P1-3: bounded sentence-boundary truncation for refusal brevity."""
        value = str(text or "").strip()
        try:
            limit = max(1, int(cap or 0))
        except Exception:
            limit = 160
        if len(value) <= limit:
            return value
        head = value[:limit]
        idx = -1
        for boundary in ("。", "！", "？", "；", "…", "\n", ".", "!", "?"):
            pos = head.rfind(boundary)
            if pos > idx:
                idx = pos
        if idx >= max(1, int(limit * 0.4)):
            return head[:idx + 1].strip()
        return head.rstrip()

    def _cost_for(self, input_tokens=0, output_tokens=0,
                  cached_tokens=0) -> float:
        """task-37: CNY cost from the configurable price table (per 1M tokens)."""
        try:
            tin = max(0, int(input_tokens or 0))
            tout = max(0, int(output_tokens or 0))
            tcached = max(0, min(tin, int(cached_tokens or 0)))
        except Exception:
            return 0.0
        price_in = float(getattr(self, "cost_input_per_1m", 2.0) or 0.0)
        price_out = float(getattr(self, "cost_output_per_1m", 8.0) or 0.0)
        price_cache = float(getattr(self, "cost_cache_per_1m", 0.5) or 0.0)
        return round(((tin - tcached) * price_in
                      + tcached * price_cache
                      + tout * price_out) / 1_000_000.0, 6)

    def _record_token_budget(self, session, *, input_tokens=0,
                             output_tokens=0, cached_tokens=0,
                             estimated=True, core=None,
                             count_call=True) -> None:
        """task-37: measured/estimated token + cost counters (read-only)."""
        try:
            store = self._token_budget if isinstance(
                getattr(self, "_token_budget", None), dict) else {}
            sessions = store.get("sessions") if isinstance(store.get("sessions"), dict) else {}
            key = str(session or "default")[:80]
            item = sessions.get(key) if isinstance(sessions.get(key), dict) else {}
            tin = int(input_tokens or 0)
            tout = int(output_tokens or 0)
            tcached = int(cached_tokens or 0)
            item["input_tokens"] = int(item.get("input_tokens", 0) or 0) + tin
            item["output_tokens"] = int(item.get("output_tokens", 0) or 0) + tout
            item["cached_tokens"] = int(item.get("cached_tokens", 0) or 0) + tcached
            # P2: a turn has one input call and one output call -> count the
            # round only on the output call (request passes count_call=False).
            if count_call:
                item["calls"] = int(item.get("calls", 0) or 0) + 1
            item["estimated_calls"] = (int(item.get("estimated_calls", 0) or 0)
                                       + (1 if estimated else 0))
            item["estimated"] = bool(estimated) or bool(item.get("estimated"))
            item["last_input"] = tin
            item["last_output"] = tout
            item["last_estimated"] = bool(estimated)
            item["cost"] = round(float(item.get("cost", 0.0) or 0.0)
                                 + self._cost_for(tin, tout, tcached), 6)
            sessions[key] = item
            store["sessions"] = sessions
            if count_call:
                store["calls"] = int(store.get("calls", 0) or 0) + 1
            today = time.strftime("%Y-%m-%d")
            day = store.get("today") if isinstance(store.get("today"), dict) else {}
            if str(day.get("date") or "") != today:
                day = {"date": today, "input_tokens": 0, "output_tokens": 0,
                       "cached_tokens": 0, "cost": 0.0, "calls": 0,
                       "estimated_calls": 0, "estimated": False}
            day["input_tokens"] = int(day.get("input_tokens", 0) or 0) + tin
            day["output_tokens"] = int(day.get("output_tokens", 0) or 0) + tout
            day["cached_tokens"] = int(day.get("cached_tokens", 0) or 0) + tcached
            day["cost"] = round(float(day.get("cost", 0.0) or 0.0)
                                + self._cost_for(tin, tout, tcached), 6)
            if count_call:
                day["calls"] = int(day.get("calls", 0) or 0) + 1
            day["estimated_calls"] = (int(day.get("estimated_calls", 0) or 0)
                                      + 1)
            day["estimated"] = bool(day.get("estimated")) or bool(estimated)
            store["today"] = day
            self._token_budget = store
            if core is not None and getattr(self, "token_budget_enabled", True):
                core.token_usage = dict(item)
        except Exception:
            pass

    @staticmethod
    def _reflect_template(triggers, reverse=None, core=None) -> str:
        labels = getattr(core, "labels", {}) if core is not None else {}
        labels = labels if isinstance(labels, dict) else {}
        emo = str(labels.get("emotion") or "neutral")[:10]
        need = str(labels.get("need") or "talk")[:10]
        action = {"low_confidence": "先确认再回答",
                  "violations": "少下结论、先核对",
                  "user_ask": "先复述再解释",
                  "relationship": "先接住情绪"}.get(
                      (triggers or ["generic"])[0], "先接住情绪")
        text = ("自我检查（%s）：情绪=%s 需要=%s；下一轮：%s"
                % ("/".join((triggers or ["generic"])[:2]), emo, need, action))
        return text[:120]

    async def _reflect_llm_text(self, key, prompt):
        """Optional cheaper-model reflection: 24h cache, silent fallback."""
        try:
            cache = self._reflect_cache if isinstance(
                getattr(self, "_reflect_cache", None), dict) else {}
            now = time.time()
            hit = cache.get(key)
            if isinstance(hit, tuple) and len(hit) == 2 and now - float(hit[0]) < 86400:
                return str(hit[1])[:120], "cached"
            provider = None
            if getattr(self, "think_reflect_provider", ""):
                try:
                    provider = self.context.get_provider_by_id(
                        self.think_reflect_provider)
                except Exception:
                    provider = None
            if provider is None:
                return "", "no_provider"
            try:
                resp = await provider.text_chat(prompt=prompt)
                text = str(getattr(resp, "completion_text", "") or "").strip()[:120]
            except Exception:
                return "", "error"
            if not text:
                return "", "empty"
            cache[key] = (now, text)
            self._reflect_cache = dict(list(cache.items())[-20:])
            return text, "llm"
        except Exception:
            return "", "error"

    async def _maybe_think_reflect(self, event, core, reply, user_text="") -> bool:
        """task-39 F2: one bounded reflection when a trigger fires (default OFF)."""
        try:
            _umo = str(getattr(event, "unified_msg_origin", "default") or "default")
            if (getattr(self, "think_reflect_private_only", True)
                    and not self._is_private_event(event)):
                stats = self._reflect_stats.setdefault(_umo, {"count": 0, "day": ""})
                stats["blocked_private"] = int(stats.get("blocked_private", 0) or 0) + 1
                return False
            triggers = []
            _ansc = (getattr(self, "_last_memory_meta", {}) or {}).get("answer_confidence")
            try:
                if _ansc is not None and float(_ansc) < 0.40:
                    triggers.append("low_confidence")
            except Exception:
                pass
            _rc = getattr(self, "_last_reverse_check", None)
            if isinstance(_rc, dict) and len(_rc.get("violations") or []) >= 2:
                triggers.append("violations")
            if any(w in str(user_text or "") for w in ("你想想", "想想为什么", "反思", "为什么")):
                triggers.append("user_ask")
            try:
                _rel = self._relationship_of(self._user_record(event))
                _state = _rel.get("state") if isinstance(_rel.get("state"), dict) else {}
                if float(_state.get("conflict", 0.0) or 0.0) >= 0.60:
                    triggers.append("relationship")
            except Exception:
                pass
            if not triggers:
                return False
            today = time.strftime("%Y-%m-%d")
            stats = self._reflect_stats.setdefault(_umo, {"count": 0, "day": ""})
            if str(stats.get("day") or "") != today:
                stats["day"] = today
                stats["count"] = 0
            cap = max(1, int(getattr(self, "think_reflect_daily_cap", 3) or 3))
            if int(stats.get("count", 0) or 0) >= cap:
                stats["blocked_daily"] = int(stats.get("blocked_daily", 0) or 0) + 1
                return False
            template = self._reflect_template(triggers, _rc, core)
            text = template
            fallback = True
            if getattr(self, "think_reflect_llm_enabled", False):
                key = _sha256(str(triggers) + str(_umo) + str(reply)[:80])[:16]
                llm_text, source = await self._reflect_llm_text(
                    key, "用不超过120字、只做一次自我检查：%s" % template)
                if llm_text:
                    text = llm_text
                    fallback = False
                stats["last_source"] = source
            try:
                tree = getattr(core, "reflection_tree", None)
                if not isinstance(tree, dict):
                    tree = {"roots": [], "count": 0}
                node = {"ts": time.time(), "insight": text,
                        "emotion": str((getattr(core, "labels", {}) or {}).get("emotion") or "neutral"),
                        "source": "think_reflect", "trigger": list(triggers[:3]),
                        "fallback": bool(fallback), "children": []}
                roots = tree.get("roots") or []
                if roots:
                    roots[-1].setdefault("children", []).append(node)
                else:
                    roots.append(node)
                tree["roots"] = roots[-10:]
                tree["count"] = int(tree.get("count", 0)) + 1
                core.reflection_tree = tree
            except Exception:
                pass
            stats["count"] = int(stats.get("count", 0) or 0) + 1
            stats["last_trigger"] = list(triggers[:3])
            stats["last_fallback"] = bool(fallback)
            self._reflect_hint = ("先核对再回答；少下结论" if "violations" in triggers
                                  else "先确认对方状态")[:140]
            try:
                if getattr(self, "think_repeat_guard_enabled", False):
                    self._repeat_hint = self._repeat_hint or "换一种说法"
            except Exception:
                pass
            return True
        except Exception:
            return False

    @staticmethod
    def _mood_multiplier(v) -> float:
        """task-38: mood-consistent recall multiplier (0.90–1.10, default OFF)."""
        try:
            value = max(-1.0, min(1.0, float(v or 0.0)))
        except Exception:
            value = 0.0
        return max(0.90, min(1.10, 1.0 + 0.10 * value))

    @staticmethod
    def _emotion_gate_params(stress, v) -> dict:
        """task-38: emotion gating (raise threshold / lower top-k when stressed)."""
        try:
            s = max(0.0, min(1.0, float(stress or 0.0)))
            val = max(-1.0, min(1.0, float(v or 0.0)))
        except Exception:
            s, val = 0.0, 0.0
        active = bool(s >= 0.65 or val <= -0.50)
        return {"active": active,
                "threshold_bonus": 0.05 if active else 0.0,
                "top_k_cap": 2 if active else 0}

    # ---- task-54/55 expression / relationship / learning (default OFF) ----
    def _learning_for(self, session) -> dict:
        store = self._learning if isinstance(getattr(self, "_learning", None), dict) else {}
        key = str(session or "default")[:80]
        st = store.get(key) if isinstance(store.get(key), dict) else {}
        day = time.strftime("%Y-%m-%d")
        if str(st.get("day") or "") != day:
            st = {"day": day, "cap_base": float(st.get("cap_base", 30.0) or 30.0),
                  "cap_delta_today": 0.0, "rel_delta_today": 0.0,
                  "k1": float(st.get("k1", 1.0) or 1.0),
                  "k3": float(st.get("k3", 1.0) or 1.0),
                  "repair_mult": float(st.get("repair_mult", 1.0) or 1.0),
                  "worth_bias": float(st.get("worth_bias", 0.0) or 0.0),
                  "updates": 0, "reward_baseline": float(st.get("reward_baseline", 0.0) or 0.0)}
        for k, v in (("cap_base", 30.0), ("cap_delta_today", 0.0),
                     ("rel_delta_today", 0.0), ("k1", 1.0), ("k3", 1.0),
                     ("repair_mult", 1.0), ("worth_bias", 0.0),
                     ("updates", 0), ("reward_baseline", 0.0)):
            st.setdefault(k, v)
        st["last_ts"] = time.time()
        store[key] = st
        # P2: bounded session map (oldest dropped, never unbounded growth).
        if len(store) > 50:
            _keep = sorted(store.items(), key=lambda kv: float(
                (kv[1] or {}).get("last_ts", 0.0) or 0.0), reverse=True)[:50]
            store = dict(_keep)
        self._learning = store
        return st

    def _learning_publish(self, core, session) -> None:
        if core is None:
            return
        if any(getattr(self, k, False) for k in (
                "learning_bandit_enabled", "learning_relationship_enabled",
                "learning_worthiness_enabled")):
            core.learning_state = dict(self._learning_for(session))

    @staticmethod
    def _learning_reward(prev_len, user_len, same_emotion=False) -> float:
        try:
            pl = max(1, int(prev_len or 0))
            ul = max(0, int(user_len or 0))
        except Exception:
            pl, ul = 1, 0
        engagement = min(1.0, ul / float(pl))
        emotion_cont = 1.0 if same_emotion else 0.0
        awkward = 1.0 if ul < 4 else 0.0
        shortened = 1.0 if ul < 0.5 * pl else 0.0
        return round(0.25 * engagement + 0.25 * emotion_cont
                     - 0.25 * awkward - 0.25 * shortened, 4)

    def _learning_bandit_update(self, core, session, reward) -> dict:
        st = self._learning_for(session)
        eta = 0.02
        baseline = float(st.get("reward_baseline", 0.0) or 0.0)
        target = float(st.get("cap_base", 30.0) or 30.0) + eta * (float(reward) - baseline)
        target = max(30.0, min(240.0, target))
        allowed = max(0.0, 5.0 - abs(float(st.get("cap_delta_today", 0.0) or 0.0)))
        step = max(-allowed, min(allowed, target - float(st.get("cap_base", 30.0))))
        st["cap_base"] = round(float(st["cap_base"]) + step, 4)
        st["cap_delta_today"] = round(float(st.get("cap_delta_today", 0.0)) + step, 4)
        st["reward_baseline"] = round(0.9 * baseline + 0.1 * float(reward), 4)
        st["updates"] = int(st.get("updates", 0)) + 1
        self._learning_publish(core, session)
        return dict(st)

    def _learning_relationship_update(self, core, session, disclosure=0.0,
                                      overreach=0.0) -> dict:
        st = self._learning_for(session)
        step = 0.01
        d1 = step * (1.0 if disclosure else 0.0) - step * (1.0 if overreach else 0.0)
        d3 = step * (1.0 if overreach else 0.0)
        d_rep = 0.01 if disclosure else -0.01
        # P1-3: hard daily cap ±0.03 across calls (all relationship coeffs).
        used = float(st.get("rel_delta_today", 0.0) or 0.0)
        remaining = 0.03 - abs(used)
        total = d1 + d3 + d_rep
        if abs(total) > remaining:
            scale = remaining / abs(total) if total else 0.0
            d1, d3, d_rep = d1 * scale, d3 * scale, d_rep * scale
        st["k1"] = round(max(0.50, min(1.50, float(st["k1"]) + d1)), 4)
        st["k3"] = round(max(0.50, min(1.50, float(st["k3"]) + d3)), 4)
        st["repair_mult"] = round(max(0.80, min(1.20, float(st["repair_mult"]) + d_rep)), 4)
        st["rel_delta_today"] = round(used + d1 + d3 + d_rep, 4)
        st["updates"] = int(st.get("updates", 0)) + 1
        self._learning_publish(core, session)
        return dict(st)

    def _learning_worthiness_step(self, core, session, important=True) -> dict:
        st = self._learning_for(session)
        delta = 0.01 if important else -0.01
        st["worth_bias"] = round(max(-0.05, min(0.05,
                                   float(st.get("worth_bias", 0.0)) + delta)), 4)
        st["updates"] = int(st.get("updates", 0)) + 1
        self._learning_publish(core, session)
        return dict(st)

    def _expression_hint(self, core, session, user_text="") -> str:
        labels = getattr(core, "labels", {}) or {}
        expr = str(labels.get("expression") or "normal")
        elaboration = {"open": 1.0, "normal": 0.6, "short": 0.25}.get(expr, 0.6)
        stress = float(getattr(core, "stress", 0.0) or 0.0)
        st = self._learning_for(session)
        cap_base = float(st.get("cap_base", 30.0)) if getattr(
            self, "learning_bandit_enabled", False) else 30.0
        if getattr(self, "big5_effect_enabled", False) and isinstance(
                getattr(core, "big5_effect", None), dict):
            elaboration += (float(core.big5_effect.get("openness", 0.5)) - 0.5) * 0.2
        suppression = float(getattr(core, "suppression", 0.0) or 0.0)
        if not suppression:
            try:
                _m = getattr(self, "_last_memory_meta", {}) or {}
                suppression = 0.5 if _m.get("abstain") else 0.0
            except Exception:
                suppression = 0.0
        cap_t = interpretation.expression_length_cap(
            elaboration, suppression=suppression, stress=stress, cap_base=cap_base)
        try:
            rel = self._relationship_of(self._user_record_from_text(user_text))
            state = rel.get("state") if isinstance(rel.get("state"), dict) else {}
            distance = 1.0 - float(state.get("closeness", 0.5) or 0.5)
            trust = float(state.get("trust", 0.5) or 0.5)
        except Exception:
            distance, trust = 0.5, 0.5
        risk = interpretation.politeness_risk(distance, trust, stress)
        strategy = interpretation.politeness_strategy(risk)
        allowed = False
        try:
            meta = getattr(self, "_last_memory_meta", {}) or {}
            if int(meta.get("count", 0) or 0) > 0:
                mode = "explicit" if any(w in str(user_text) for w in (
                    "记得", "上次", "之前", "你忘")) else "none"
                allowed = interpretation.memory_citation_allowed(
                    mode,
                    continuity_seconds=float(meta.get("continuity_seconds", 0.0) or 0.0),
                    open_loop=bool(getattr(core, "open_loops", None)),
                    milestone=bool(meta.get("milestone")),
                    confidence=float(meta.get("confidence", 0.0) or 0.0),
                    already_cited=0)
        except Exception:
            allowed = False
        return interpretation.expression_prompt_hint(
            cap_t, strategy, "可引用1条" if allowed else "不点破记忆")

    def _user_record_from_text(self, text):
        try:
            return self._relationship_of({})
        except Exception:
            return {}

    def _big5_effect(self, core) -> dict:
        prof = getattr(core, "profile", {}) if isinstance(
            getattr(core, "profile", {}), dict) else {}
        traits = prof.get("traits") if isinstance(prof.get("traits"), dict) else (
            prof.get("big5") if isinstance(prof.get("big5"), dict) else {})
        # Persona profile stores Big Five as FLAT O/C/E/A/N (compiled profile).
        # Reading only nested traits silently fell back to 0.5 for everyone.
        flat = {"openness": "O", "conscientiousness": "C", "extraversion": "E",
                "agreeableness": "A", "neuroticism": "N"}

        def _trait(name):
            short = flat[name]
            for key in (short, short.lower(), name):
                if key in prof:
                    try:
                        return max(0.0, min(1.0, float(prof[key])))
                    except Exception:
                        break
            for key in (name, short, short.lower()):
                if key in traits:
                    try:
                        return max(0.0, min(1.0, float(traits[key])))
                    except Exception:
                        break
            return 0.5

        cue = max(0.0, min(1.0, (float(getattr(core, "a", 0.5) or 0.0)
                                 + (0.5 + 0.5 * float(getattr(core, "v", 0.0) or 0.0))) / 2.0))
        out = {}
        for name in flat:
            out[name] = interpretation.big5_trait_effect(_trait(name), cue)
        return out

    def _apply_relationship_chain(self, event, core, user_text, reply) -> None:
        try:
            data = self._user_record(event)
            rel = data.get("relationship") if isinstance(data, dict) else None
            if not isinstance(rel, dict):
                return
            state = rel.get("state") if isinstance(rel.get("state"), dict) else {}
            trust = float(state.get("trust", 0.5) or 0.5)
            conflict = float(state.get("conflict", 0.5) or 0.5)
            closeness = float(state.get("closeness", 0.5) or 0.5)
            repair = float(state.get("repair", 0.0) or 0.0)
            dyn = relationship_meta.attachment_dynamics(trust, conflict, closeness)
            text = str(user_text or "")
            disclosure = min(1.0, sum(1 for w in ("其实", "感觉", "最近", "压力",
                                                  "难过", "开心", "害怕", "喜欢")
                                      if w in text) / 3.0)
            response = 1.0 if any(w in str(reply or "") for w in (
                "我在", "听起来", "理解", "然后呢", "嗯，")) else 0.0
            overreach = 1.0 if interpretation._OVERREACH_RE.search(str(reply or "")) else 0.0
            st = self._learning_for(str(getattr(event, "unified_msg_origin", "default")))
            k1 = float(st.get("k1", 1.0)) if getattr(
                self, "learning_relationship_enabled", False) else 1.0
            k3 = float(st.get("k3", 1.0)) if getattr(
                self, "learning_relationship_enabled", False) else 1.0
            d_close = relationship_meta.closeness_step(disclosure, response, overreach, k1, k3)
            conflict_step = repair_act_step = 0.0
            horsemen = {}
            _writes = bool(getattr(self, "relationship_chain_enabled", False))
            if _writes and getattr(self, "gottman_enabled", False):
                horsemen, conflict_step = relationship_meta.gottman_conflict_step(text)
                _, repair_act_step = relationship_meta.repair_step(reply, dyn["repair_speed"])
                try:
                    repair_act_step *= float(st.get("repair_mult", 1.0) or 1.0)
                except Exception:
                    pass
            # P1-2: every per-round relationship delta is clipped to ±0.03.
            d_close = max(-0.03, min(0.03, d_close))
            conflict_step = max(-0.03, min(0.03, conflict_step))
            repair_act_step = max(-0.03, min(0.03, repair_act_step))
            closeness = max(0.0, min(1.0, closeness + d_close))
            conflict = max(0.0, min(1.0, conflict + conflict_step))
            repair = max(0.0, min(1.0, repair + repair_act_step))
            if _writes:
                rel["state"] = dict(state, trust=round(trust, 3), closeness=round(closeness, 3),
                                    conflict=round(conflict, 3), repair=round(repair, 3),
                                    predictability=state.get("predictability", 0.5))
                data["relationship"] = rel
                self._save_user_record(event, data)
            core.relationship_dynamics = dict(dyn, d_closeness=d_close,
                                              conflict_step=conflict_step,
                                              repair_step=repair_act_step,
                                              gottman=horsemen)
            if getattr(self, "learning_relationship_enabled", False):
                self._learning_relationship_update(
                    core, str(getattr(event, "unified_msg_origin", "default")),
                    disclosure=disclosure, overreach=overreach)
            if getattr(self, "big5_effect_enabled", False):
                core.big5_effect = self._big5_effect(core)
        except Exception:
            pass

    # ---- P2: startup self-check + transactional restore ----
    def _run_env_selfcheck(self) -> dict:
        warnings = []
        checks = {}
        try:
            probe = DATA_DIR / (".write_probe_" + str(int(time.time())))
            probe.write_text("ok", encoding="utf-8")
            probe.unlink(missing_ok=True)
            checks["data_writable"] = True
        except Exception:
            checks["data_writable"] = False
            warnings.append("data 目录不可写")
        version = ""
        try:
            import astrbot as _astrbot
            version = str(getattr(_astrbot, "__version__", "") or "")
        except Exception:
            version = ""
        version_ok = False
        try:
            _parts = [int(x) for x in re.findall(r"\d+", version)[:2]]
            if len(_parts) >= 2:
                version_ok = (4, 16) <= (_parts[0], _parts[1]) < (5, 0)
        except Exception:
            version_ok = False
        if not version:
            warnings.append("AstrBot 版本读取失败")
        elif not version_ok:
            warnings.append("AstrBot 版本不在 >=4.16,<5 范围: " + version)
        persona_present = PROFILE_PATH.exists()
        missing_config = []
        if not persona_present:
            missing_config.append("persona")
            warnings.append("未设置 persona（persona_profile.json 缺失）")
        api_ok = False
        try:
            _api = json.loads(API_CONFIG_PATH.read_text(encoding="utf-8"))
            _blob = json.dumps(_api, ensure_ascii=False).lower()
            api_ok = any(k in _blob for k in ("api_key", "apikey")) and "****" not in _blob
        except Exception:
            api_ok = False
        if not api_ok:
            missing_config.append("api_key")
            warnings.append("未配置 API Key（api_config.json 缺失或为空）")
        checks.update({"astrbot_version": version, "version_ok": version_ok,
                       "persona_present": persona_present, "api_key_present": api_ok,
                       "missing_config": missing_config, "warnings": warnings})
        try:
            (DATA_DIR / "env_checks.json").write_text(
                json.dumps(checks, ensure_ascii=False, indent=1), encoding="utf-8")
        except Exception:
            pass
        return checks

    def _commit_restore(self, staged_files, rollback_files) -> tuple:
        """P2: replace files via os.replace; on failure roll back and report."""
        import os as _os
        import shutil as _shutil
        done = []
        created = []
        try:
            for rel, staged in staged_files.items():
                dest = DATA_DIR / rel
                existed = dest.exists()
                dest.parent.mkdir(parents=True, exist_ok=True)
                if getattr(self, "_restore_fail_inject", False):
                    raise RuntimeError("injected restore failure")
                _os.replace(str(staged), str(dest))
                done.append(rel)
                if not existed:
                    created.append(rel)
            return len(done), ""
        except Exception as exc:
            for rel in done:
                backup = rollback_files.get(rel)
                dest = DATA_DIR / rel
                if backup and backup.exists():
                    dest.parent.mkdir(parents=True, exist_ok=True)
                    _shutil.copyfile(str(backup), str(dest))
            # P2: remove files newly created by this failed restore.
            for rel in created:
                try:
                    (DATA_DIR / rel).unlink(missing_ok=True)
                except Exception:
                    pass
            return len(done), str(exc)

    def _record_llm_telemetry(self, kind, outcome, detail="") -> None:
        """task-36: bounded read-only LLM failure/fallback telemetry."""
        if not getattr(self, "llm_telemetry_enabled", False):
            return
        try:
            tele = self._llm_telemetry if isinstance(
                getattr(self, "_llm_telemetry", None), dict) else {"counters": {}, "recent": []}
            counters = tele.get("counters") if isinstance(tele.get("counters"), dict) else {}
            key = "%s:%s" % (str(kind or "?")[:24], str(outcome or "?")[:16])
            counters[key] = min(10 ** 6, int(counters.get(key, 0) or 0) + 1)
            tele["counters"] = dict(sorted(counters.items(), key=lambda kv: -kv[1])[:20])
            recent = tele.get("recent") if isinstance(tele.get("recent"), list) else []
            tele["recent"] = ([{"ts": round(time.time(), 3), "kind": str(kind or "?")[:24],
                                "outcome": str(outcome or "?")[:16],
                                "detail": str(detail or "")[:120]}]
                              + [x for x in recent if isinstance(x, dict)])[:20]
            self._llm_telemetry = tele
        except Exception:
            pass

    @staticmethod
    def _extract_token_usage(response):
        """task-36: read provider usage if present; never guess/estimate."""
        candidates = []
        try:
            candidates.append(getattr(response, "usage", None))
            candidates.append(getattr(response, "usage_metadata", None))
            candidates.append(getattr(response, "token_usage", None))
            raw = getattr(response, "raw_completion", None)
            if isinstance(raw, dict):
                candidates.append(raw.get("usage"))
            elif raw is not None:
                candidates.append(getattr(raw, "usage", None))
        except Exception:
            pass
        for item in candidates:
            data = item if isinstance(item, dict) else None
            if data is None and item is not None:
                try:
                    data = {"prompt_tokens": getattr(item, "prompt_tokens", None),
                            "completion_tokens": getattr(item, "completion_tokens", None),
                            "total_tokens": getattr(item, "total_tokens", None)}
                except Exception:
                    data = None
            if not isinstance(data, dict):
                continue
            try:
                prompt = int(data.get("prompt_tokens") or 0)
                completion = int(data.get("completion_tokens") or 0)
                total = int(data.get("total_tokens") or (prompt + completion))
                cached = int(data.get("cached_tokens")
                             or data.get("prompt_cache_hit_tokens")
                             or data.get("cache_read_input_tokens") or 0)
            except Exception:
                continue
            if prompt or completion or total:
                return {"prompt_tokens": max(0, prompt),
                        "completion_tokens": max(0, completion),
                        "total_tokens": max(0, total),
                        "cached_tokens": max(0, cached)}
        return None

    def _record_token_usage(self, session, usage) -> None:
        if not getattr(self, "token_usage_enabled", False) or not isinstance(usage, dict):
            return
        try:
            store = self._token_usage if isinstance(
                getattr(self, "_token_usage", None), dict) else {"available": False, "sessions": {}}
            sessions = store.get("sessions") if isinstance(store.get("sessions"), dict) else {}
            key = str(session or "default")[:80]
            item = sessions.get(key) if isinstance(sessions.get(key), dict) else {}
            item["calls"] = min(10 ** 6, int(item.get("calls", 0) or 0) + 1)
            for field in ("prompt_tokens", "completion_tokens", "total_tokens"):
                item[field] = min(10 ** 12, int(item.get(field, 0) or 0)
                                  + int(usage.get(field, 0) or 0))
            item["last_ts"] = round(time.time(), 3)
            sessions[key] = item
            store["sessions"] = sessions
            store["available"] = True
            self._token_usage = store
        except Exception:
            pass

    # ---- P2: persisted, concurrency-safe background LLM budget ----
    def _bg_budget_file(self):
        return DATA_DIR / "background_budget.json"

    def _bg_budget_reserve(self, kind) -> bool:
        import threading
        import json as _json
        lock = getattr(self, "_bg_lock", None)
        if lock is None:
            lock = threading.Lock()
            self._bg_lock = lock
        with lock:
            path = self._bg_budget_file()
            day = time.strftime("%Y-%m-%d")
            state = {}
            try:
                if path.exists():
                    state = _json.loads(path.read_text(encoding="utf-8"))
            except Exception:
                state = {}
            if str(state.get("day") or "") != day:
                state = {"day": day, "calls": 0, "cost": 0.0}
            limit_calls = int(getattr(self, "bg_llm_daily_calls", 200) or 0)
            limit_cost = float(getattr(self, "bg_llm_daily_cost", 2.0) or 0.0)
            if ((limit_calls and int(state.get("calls", 0)) >= limit_calls)
                    or (limit_cost and float(state.get("cost", 0.0)) >= limit_cost)):
                self._bg_llm_usage = state
                return False
            state["calls"] = int(state.get("calls", 0)) + 1
            try:
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_text(_json.dumps(state), encoding="utf-8")
            except Exception:
                pass
            self._bg_llm_usage = state
            return True

    def _bg_budget_add_cost(self, cost) -> None:
        import threading
        import json as _json
        lock = getattr(self, "_bg_lock", None)
        if lock is None:
            lock = threading.Lock()
            self._bg_lock = lock
        try:
            with lock:
                path = self._bg_budget_file()
                day = time.strftime("%Y-%m-%d")
                state = {}
                if path.exists():
                    state = _json.loads(path.read_text(encoding="utf-8"))
                if str(state.get("day") or "") != day:
                    state = {"day": day, "calls": 0, "cost": 0.0}
                state["cost"] = round(float(state.get("cost", 0.0)) + float(cost or 0.0), 6)
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_text(_json.dumps(state), encoding="utf-8")
                self._bg_llm_usage = state
        except Exception:
            pass

    async def _bg_llm_direct(self, kind, provider, prompt, timeout_ms=None):
        """P1-5: budget + timeout wrapper for direct provider.text_chat paths."""
        try:
            if not self._bg_budget_reserve(kind):
                self._record_llm_telemetry(kind, "budget_blocked")
                return None
        except Exception:
            pass
        try:
            _tmo = max(2.0, min(20.0, float(
                timeout_ms or getattr(self, "summary_llm_timeout_ms", 8000)) / 1000.0))
            _call = provider.text_chat(prompt=prompt)
            if _SERVICES is not None:
                resp = await _SERVICES.llm(_call, _tmo)
            else:
                resp = await asyncio.wait_for(_call, timeout=_tmo)
        except asyncio.TimeoutError:
            self._record_llm_telemetry(kind, "timeout")
            return None
        except Exception:
            self._record_llm_telemetry(kind, "call_error")
            return None
        raw = str(getattr(resp, "completion_text", "") or "")
        try:
            self._bg_budget_add_cost(self._cost_for(
                max(1, int(len(prompt) / 2.2)), max(1, int(len(raw) / 2.2))))
        except Exception:
            pass
        return resp

    async def _llm_v2_call(self, kind, prompt, parser, event=None, system_prompt=None,
                           timeout_ms=None):
        if not self._llm_allowed(kind):
            return None
        try:
            provider = await self._provider_for(kind, event)
        except Exception as exc:
            logger.warning("[biocore] llm v2 provider failed (%s): %s", kind, exc)
            self._record_llm_telemetry(kind, "provider_error", str(exc))
            return None
        if provider is None:
            self._record_llm_telemetry(kind, "no_provider")
            return None
        if str(kind) in LLM_BACKGROUND_KINDS:
            try:
                if not self._bg_budget_reserve(kind):
                    self._record_llm_telemetry(kind, "budget_blocked")
                    return None
            except Exception:
                pass
        try:
            _tmo = max(0.5, float(timeout_ms or getattr(
                self, "outbound_timeout_ms", 3000)) / 1000.0)
            _call = (provider.text_chat(prompt=prompt, system_prompt=system_prompt)
                     if system_prompt else provider.text_chat(prompt=prompt))
            if _SERVICES is not None:
                resp = await _SERVICES.llm(_call, _tmo)
            else:
                resp = await asyncio.wait_for(_call, timeout=_tmo)
            raw = str(getattr(resp, "completion_text", "") or "").strip()
            if str(kind) in LLM_BACKGROUND_KINDS:
                try:
                    _in = max(1, int(len(prompt) / 2.2))
                    _out = max(1, int(len(raw) / 2.2))
                    self._bg_budget_add_cost(self._cost_for(_in, _out))
                except Exception:
                    pass
            if not raw:
                self._record_llm_telemetry(kind, "empty")
                return None
            return parser(raw)
        except asyncio.TimeoutError:
            self._record_llm_telemetry(kind, "timeout")
            return None
        except Exception as exc:
            logger.warning("[biocore] llm v2 call/paser failed (%s): %s", kind, exc)
            self._record_llm_telemetry(kind, "call_error", str(exc))
            return None

    def _llm_v2_cooldown_ok(self, kind):
        try:
            last = float((getattr(self, "_llm_v2_last", {}) or {}).get(kind, 0.0) or 0.0)
        except Exception:
            last = 0.0
        return (time.time() - last) >= float(LLM_V2_COOLDOWNS.get(kind, 600))

    def _llm_v2_mark(self, kind):
        if not isinstance(getattr(self, "_llm_v2_last", None), dict):
            self._llm_v2_last = {}
        self._llm_v2_last[kind] = time.time()

    def _user_record(self, event):
        try:
            path = self._user_path(event)
            if path.exists():
                data = json.loads(path.read_text(encoding="utf-8"))
                if isinstance(data, dict):
                    return data
        except Exception:
            pass
        return {}

    def _save_user_record(self, event, data):
        try:
            if not isinstance(data, dict):
                return
            path = self._user_path(event)
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(json.dumps(data, ensure_ascii=False, indent=1), encoding="utf-8")
        except Exception as exc:
            logger.warning("[biocore] user record save failed: %s", exc)

    def _record_calibration(self, event, source, predicted, correct) -> None:
        """Persist one calibration sample in the user relationship doc.

        Record-only: writes relationship.calibration (EWMA/Brier per evidence
        source) via the single user-file writer; it never rewrites trust or any
        other biological field. Called from the memory-conflict branch.
        """
        path = self._user_path(event)
        if not path.exists():
            return
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            return
        if not isinstance(data, dict):
            return
        rel = dict(data.get("relationship")) if isinstance(data.get("relationship"), dict) else {}
        rel["calibration"] = relationship_meta.calibration_update(
            rel.get("calibration"), source, predicted, correct)
        try:
            rel["calibration_last_delta"] = self._calibration_step(
                abs(float(predicted) - float(correct)),
                int((rel.get("calibration") or {}).get("samples", 1) or 1))
        except Exception:
            pass
        data["relationship"] = rel
        self._save_user_record(event, data)

    def _relationship_of(self, user_data):
        rel = (user_data or {}).get("relationship") if isinstance(user_data, dict) else None
        return rel if isinstance(rel, dict) else {}

    def _deterministic_hint(self, text, user_data, events_raw, memory_meta, core=None):
        """One bounded deterministic token; interpretation owns the wording."""
        rel = self._relationship_of(user_data)
        repair_state = rel.get("repair_state") if isinstance(rel.get("repair_state"), dict) else {}
        hint = interpretation.repair_strategy_block(repair_state)
        if not hint:
            # G2/L9: refusal is a posture token derived from boundary state. It
            # is not a gate and never decides whether a reply is sent.
            try:
                _state = rel.get("state") if isinstance(rel.get("state"), dict) else {}
                _protocol = relationship_meta.refusal_protocol({
                    "boundary_pressure": float(getattr(core, "boundary_pressure", 0.0) or 0.0),
                    "trust": float(_state.get("trust", 0.5) or 0.5),
                    "conflict": float(_state.get("conflict", 0.0) or 0.0),
                })
                hint = interpretation.refusal_strategy_block(_protocol)
            except Exception:
                hint = ""
        if not hint:
            # A4: deterministic empathy token from core affect (no LLM call).
            try:
                hint = interpretation.empathy_strategy_block(core)
            except Exception:
                hint = ""
        if not hint and interpretation.cause_question(text):
            hint = interpretation.cause_trace_block(getattr(self, "_last_cause_trace", []))
        if not hint:
            hint = interpretation.memory_receipt_block(memory_meta, text)
        if not hint:
            hint = interpretation.grounding_check_block(memory_meta, text)
        if not hint:
            hint = interpretation.response_strategy_block(events_raw)
        return hint

    async def _maybe_llm_hints(self, event, core, user_data, events_raw, memory_meta, text):
        """Optional per-turn strategy refinement; only when a function is ON."""
        parts = [self._deterministic_hint(text, user_data, events_raw, memory_meta, core)]
        rel = self._relationship_of(user_data)
        state = rel.get("state") if isinstance(rel.get("state"), dict) else {}
        repair_state = rel.get("repair_state") if isinstance(rel.get("repair_state"), dict) else {}
        phase = str(repair_state.get("phase") or "stable")
        gate = str((memory_meta or {}).get("gate") or "none")
        try:
            conflict = float(state.get("conflict", 0.5) or 0.5)
            trust = float(state.get("trust", 0.5) or 0.5)
        except Exception:
            conflict, trust = 0.5, 0.5
        try:
            if phase != "stable" and self._llm_v2_cooldown_ok("repair_hint"):
                tag = await self._llm_v2_call(
                    "repair_hint", interpretation.repair_hint_prompt(repair_state),
                    interpretation.parse_repair_hint, event)
                if tag:
                    parts.append("llm_repair=" + tag)
                    self._llm_v2_mark("repair_hint")
            elif events_raw and self._llm_v2_cooldown_ok("empathy_hint"):
                tag = await self._llm_v2_call(
                    "empathy_hint", interpretation.empathy_hint_prompt(events_raw),
                    interpretation.parse_empathy_hint, event)
                if tag:
                    parts.append("llm_empathy=" + tag)
                    self._llm_v2_mark("empathy_hint")
            elif gate in ("semi", "force") and self._llm_v2_cooldown_ok("pragmatics_hint"):
                tag = await self._llm_v2_call(
                    "pragmatics_hint", interpretation.pragmatics_hint_prompt(memory_meta),
                    interpretation.parse_pragmatics_hint, event)
                if tag:
                    parts.append("llm_pragma=" + tag)
                    self._llm_v2_mark("pragmatics_hint")
            elif (conflict < 0.45 and trust > 0.5 and self._llm_v2_cooldown_ok("humor_hint")):
                tag = await self._llm_v2_call(
                    "humor_hint", interpretation.humor_hint_prompt(rel),
                    interpretation.parse_humor_hint, event)
                if tag and tag != "none":
                    parts.append("humor=" + tag)
                    self._llm_v2_mark("humor_hint")
        except Exception as exc:
            logger.warning("[biocore] llm v2 hint failed: %s", exc)
        hint = interpretation.combine_strategy_hint(*parts)
        self._last_strategy_hint = hint
        return hint

    async def _maybe_tom_probe(self, event, core, text, user_data, memory_meta):
        """L-T06: optional bounded ToM annotation; never changes core state."""
        if not self._llm_allowed("tom_probe") or not self._llm_v2_cooldown_ok("tom_probe"):
            return
        try:
            recent = [str(h.get("text") or "") for h in (core.history or [])[-6:]]
            refs = [str(x) for x in (getattr(self, "_last_memory_entries", []) or []) if str(x)][:6]
            proposal = await self._llm_v2_call(
                "tom_probe",
                interpretation.tom_prompt(user_data, recent, memory_lines=refs),
                lambda raw: interpretation.parse_tom_update(raw, allowed_refs=refs),
                event)
            if not proposal:
                return
            updated = relationship_meta.apply_tom_update(user_data, proposal, allowed_refs=refs)
            if updated:
                self._save_user_record(event, updated)
                self._llm_v2_mark("tom_probe")
        except Exception as exc:
            logger.warning("[biocore] tom probe failed: %s", exc)

    async def _maybe_relationship_impression(self, event, core):
        """L-T01/A3: bounded impression writing; deterministic by default.

        The LLM path stays available behind the per-function switch (default
        OFF). With the switch off, the relation numbers are mapped to a short
        deterministic template. Neither path touches trust or core state.
        """
        if not self._llm_v2_cooldown_ok("relationship_impression"):
            return
        try:
            events = [e for e in self._event_archive(12) if isinstance(e, dict)]
            important = [e for e in events
                         if float(e.get("importance", 0.0) or 0.0) >= 0.6]
            if len(important) < 3:
                return
            allowed = [str(e.get("id") or "") for e in important if str(e.get("id") or "")]
            if len(allowed) < 3:
                return
            user_data = self._user_record(event)
            current = self._relationship_of(user_data)
            if self._llm_allowed("relationship_impression"):
                proposal = await self._llm_v2_call(
                    "relationship_impression",
                    interpretation.relationship_impression_prompt(important, current),
                    lambda raw: interpretation.parse_relationship_impression(
                        raw, allowed_refs=allowed),
                    event)
                if not proposal:
                    return
            else:
                proposal = interpretation.relationship_impression_template(
                    current, len(important))
                if not proposal.get("traits"):
                    return
                proposal["evidence_refs"] = allowed[:6]
            updated = relationship_meta.apply_relationship_impression(
                current, proposal, allowed_refs=allowed)
            if not updated:
                return
            user_data["relationship"] = updated
            self._save_user_record(event, user_data)
            self._llm_v2_mark("relationship_impression")
        except Exception as exc:
            logger.warning("[biocore] relationship impression failed: %s", exc)

    async def _maybe_diary(self, event, core):
        """L-T08: at most one bounded diary entry per cooldown (default OFF)."""
        if not self._llm_allowed("diary") or not self._llm_v2_cooldown_ok("diary"):
            return
        try:
            digests = [d for d in (getattr(core, "daily_digests", []) or [])
                       if isinstance(d, dict)]
            if not digests:
                return
            digest = digests[-1]
            allowed = [str(x) for x in (digest.get("event_ids") or []) if str(x)]
            if not allowed:
                return
            titles = [str(e.get("title") or "")
                      for e in self._event_archive(10) if isinstance(e, dict)]
            parsed = await self._llm_v2_call(
                "diary", interpretation.diary_prompt(digest, titles),
                lambda raw: interpretation.parse_diary(raw, allowed_event_ids=allowed),
                event)
            if not parsed:
                return
            diary = self.self_model.get("diary")
            if not isinstance(diary, list):
                diary = []
            diary.append({"ts": time.time(), "date": str(digest.get("date") or ""),
                          "text": parsed["diary"], "evidence": parsed["evidence"],
                          "generated": True})
            self.self_model["diary"] = diary[-30:]
            self._save_self_model()
            self._llm_v2_mark("diary")
        except Exception as exc:
            logger.warning("[biocore] diary failed: %s", exc)

    async def _maybe_relationship_narrative(self, event, core):
        """L-T12: manual/periodic bounded relationship narrative (default OFF)."""
        if not self._llm_allowed("relationship_narrative"):
            return
        if not self._llm_v2_cooldown_ok("relationship_narrative"):
            return
        try:
            user_data = self._user_record(event)
            rel = self._relationship_of(user_data)
            marks = [m for m in (rel.get("milestones") or []) if isinstance(m, dict)]
            allowed = [str(m.get("key") or m.get("type") or "") for m in marks
                       if str(m.get("key") or m.get("type") or "")]
            if not allowed:
                return
            parsed = await self._llm_v2_call(
                "relationship_narrative",
                interpretation.relationship_narrative_prompt(rel),
                lambda raw: interpretation.parse_relationship_narrative(
                    raw, allowed_refs=allowed), event)
            if not parsed:
                return
            items = self.self_model.get("relationship_narratives")
            if not isinstance(items, list):
                items = []
            items.append({"ts": time.time(), "text": parsed["narrative"],
                          "evidence_refs": parsed["evidence_refs"]})
            self.self_model["relationship_narratives"] = items[-5:]
            self._save_self_model()
            self._llm_v2_mark("relationship_narrative")
        except Exception as exc:
            logger.warning("[biocore] relationship narrative failed: %s", exc)


    def _vision_provider_for(self, event=None):
        """Resolve the vision provider for image caption (never a text LLM)."""
        _cfg = self._function_cfg("image_caption")
        _override = _cfg["provider"]
        _pid = ""
        if _override and _override not in ("follow_llm", "main", "default", ""):
            _pid = _override
        if not _pid:
            try:
                _cfg_all = self.context.get_config()
                _ps = _cfg_all.get("provider_settings", {}) if isinstance(_cfg_all, dict) else {}
                _pid = str(_ps.get("default_image_caption_provider_id") or "exusiai-img")
            except Exception:
                _pid = "exusiai-img"
        try:
            _vp = self.context.get_provider_by_id(_pid)
        except Exception as exc:
            logger.warning("[biocore] vision provider lookup failed (%s): %s", _pid, exc)
            return None
        if _vp is not None and self._provider_kind(_vp) == "vision":
            return _vp
        if _vp is not None:
            logger.warning("[biocore] image_caption provider %s is not a vision provider; ignored", _pid)
        # Fall back to the configured default image provider, but never a text LLM.
        try:
            _cfg = self.context.get_config()
            _ps = _cfg.get("provider_settings", {}) if isinstance(_cfg, dict) else {}
            _def = str(_ps.get("default_image_caption_provider_id") or "")
            if _def and _def != _pid:
                _vp2 = self.context.get_provider_by_id(_def)
                if _vp2 is not None and self._provider_kind(_vp2) == "vision":
                    return _vp2
        except Exception:
            pass
        return None

    async def _compile_profile(self, event):
        text = await self._persona_text(event)
        if not text:
            self.profile = dict(DEFAULT_PROFILE)
            self.persona_text = ""
            self.schema_texts = []
            try:
                PROFILE_PATH.write_text(json.dumps(
                    {"persona": "", "profile": self.profile, "schema": [],
                     "style": dict(getattr(self, "persona_style", {}) or {})},
                    ensure_ascii=False, indent=1), encoding="utf-8")
            except Exception:
                pass
            return
        if not self._llm_allowed("persona_compile"):
            self.persona_text = text
            logger.info("[biocore] persona_compile disabled; keep saved profile")
            return
        _ph = _sha256(text)
        if getattr(self, "_persona_compiled_hash", "") == _ph and getattr(self, "profile", None):
            # Already compiled for this persona: no extra LLM call.
            self.persona_text = text
            logger.info("[biocore] persona already compiled; skip")
            return
        try:
            provider = await self._provider_for("persona_compile", event)
            if provider is None:
                self.profile = dict(DEFAULT_PROFILE)
                return
            # Prompt construction and output validation belong to the
            # interpretation layer; this wiring only calls it.
            system = interpretation.persona_compile_system()
            prompt = interpretation.persona_compile_prompt(text)
            resp = await provider.text_chat(prompt=prompt, system_prompt=system)
            raw = str(getattr(resp, "completion_text", "") or "")
            _compiled = interpretation.parse_persona_compile(raw, DEFAULT_PROFILE)
            self.profile = _compiled.get("profile") or dict(DEFAULT_PROFILE)
            self.schema_texts = list(_compiled.get("schema") or [])
            _style = _compiled.get("style") if isinstance(_compiled.get("style"), dict) else {}
            self.persona_style = {"intimacy_style": str(_style.get("intimacy_style") or "neutral"),
                                  "address_terms": list(_style.get("address_terms") or [])[:3]}
            logger.info("[biocore] persona schema slots=%s style=%s", len(self.schema_texts),
                        self.persona_style.get("intimacy_style"))
        except Exception as exc:
            logger.warning("[biocore] persona compile failed: %s", exc)
            self.profile = dict(DEFAULT_PROFILE)
        self.persona_text = text
        try:
            PROFILE_PATH.write_text(json.dumps(
                {"persona": self.persona_text, "profile": self.profile,
                 "schema": list(getattr(self, "schema_texts", []) or []),
                 "style": dict(getattr(self, "persona_style", {}) or {}),
                 "persona_hash": _sha256(self.persona_text or text)},
                ensure_ascii=False, indent=1), encoding="utf-8")
            self._persona_compiled_hash = _sha256(self.persona_text or text)
            logger.info("[biocore] first-run profile written: %s", PROFILE_PATH)
        except Exception as exc:
            logger.warning("[biocore] profile save failed: %s", exc)

    def _core(self, event) -> BioCore:
        key = str(getattr(event, "unified_msg_origin", "default") or "default")
        if key not in self.cores:
            core = BioCore(self.profile or DEFAULT_PROFILE)
            try:
                core.valence_decay_minutes = float(getattr(self, "valence_decay_minutes", 120.0))
                core.arousal_decay_minutes = float(getattr(self, "arousal_decay_minutes", 30.0))
                core.social_decay_minutes = float(getattr(self, "social_decay_minutes", 180.0))
            except Exception:
                pass
            try:
                safe = "".join(c if c.isalnum() or c in "-_" else "_" for c in key)[:80]
                f = STATE_DIR / (safe + ".json")
                if f.exists():
                    core.load_state(json.loads(f.read_text(encoding="utf-8")))
            except Exception:
                pass
            # Task-15: readiness is owned by plugin config, never restored from
            # state; the optional noise seed is applied only when autonomy is on.
            core.autonomy_enabled = bool(getattr(self, "proactive_autonomy", False))
            # Task-28: loop switch + tuning are config-owned, never restored from
            # the state file; re-applied on every core build/config reload.
            core.autonomy_loop_enabled = bool(
                getattr(self, "autonomy_loop_enabled", False))
            core.autonomy_loop_theta_ig = self._loop_cfg_float(
                "autonomy_loop_theta_ig", AUTONOMY_LOOP_THETA_IG,
                AUTONOMY_LOOP_THETA_MIN, AUTONOMY_LOOP_THETA_MAX)
            core.autonomy_loop_margin = self._loop_cfg_float(
                "autonomy_loop_margin", AUTONOMY_LOOP_MARGIN,
                AUTONOMY_LOOP_MARGIN_MIN, AUTONOMY_LOOP_MARGIN_MAX)
            core.autonomy_loop_k_delay = self._loop_cfg_float(
                "autonomy_loop_k_delay", AUTONOMY_LOOP_K_DELAY,
                AUTONOMY_LOOP_K_MIN, AUTONOMY_LOOP_K_MAX)
            core.autonomy_loop_ior_seconds = self._loop_cfg_float(
                "autonomy_loop_ior_seconds", AUTONOMY_LOOP_IOR_SECONDS,
                AUTONOMY_LOOP_IOR_MIN, AUTONOMY_LOOP_IOR_MAX)
            core.autonomy_loop_c0 = self._loop_cfg_float(
                "autonomy_loop_c0", AUTONOMY_LOOP_C0, 0.0, 1.0)
            core.autonomy_loop_c1 = self._loop_cfg_float(
                "autonomy_loop_c1", AUTONOMY_LOOP_C1, 0.0, 1.0)
            core.autonomy_loop_c2 = self._loop_cfg_float(
                "autonomy_loop_c2", AUTONOMY_LOOP_C2, 0.0, 1.0)
            core.autonomy_loop_token_only = bool(
                getattr(self, "autonomy_loop_token_only", True))
            core.reply_consistency_enabled = bool(
                getattr(self, "reply_consistency_enabled", False))
            # 1.3.1 model-layer flags (read-only unless explicitly opt-in).
            core.think_selfcheck_trace_enabled = bool(
                getattr(self, "think_selfcheck_trace_enabled", True))
            core.think_selfcheck_hint_enabled = bool(
                getattr(self, "think_selfcheck_hint_enabled", False))
            core.soft_bound_enabled = bool(
                getattr(self, "soft_bound_enabled", False))
            core.soft_bound_k = float(getattr(self, "soft_bound_k", 0.10) or 0.10)
            core.soft_bound_m_frac = float(
                getattr(self, "soft_bound_m_frac", 0.08) or 0.08)
            core.soft_bound_lam = float(
                getattr(self, "soft_bound_lam", 0.10) or 0.10)
            core.token_budget_enabled = bool(
                getattr(self, "token_budget_enabled", True))
            core.temporal_validity_enabled = bool(
                getattr(self, "temporal_validity_enabled", False))
            core.mood_congruence_enabled = bool(
                getattr(self, "mood_congruence_enabled", False))
            core.emotion_gating_enabled = bool(
                getattr(self, "emotion_gating_enabled", False))
            core.path_monitor_enabled = bool(
                getattr(self, "path_monitor_enabled", False))
            core.injection_trace_enabled = bool(
                getattr(self, "bc_trace_enabled", False))
            core.conflict_gate_enabled = bool(
                getattr(self, "conflict_gate_enabled", False))
            core.rumination_effect_enabled = bool(
                getattr(self, "rumination_effect_enabled", False))
            core.anchor_update_enabled = bool(
                getattr(self, "anchor_update_enabled", False))
            core.identity_threat_stress_enabled = bool(
                getattr(self, "identity_threat_stress_enabled", False))
            core.anchor_weight = float(getattr(self, "anchor_weight", 0.25) or 0.25)
            core.sycophancy_check_enabled = bool(
                getattr(self, "sycophancy_check_enabled", True))
            core.expression_chain_enabled = bool(
                getattr(self, "expression_chain_enabled", False))
            core.relationship_chain_enabled = bool(
                getattr(self, "relationship_chain_enabled", False))
            core.gottman_enabled = bool(getattr(self, "gottman_enabled", False))
            core.big5_effect_enabled = bool(
                getattr(self, "big5_effect_enabled", False))
            core.learning_bandit_enabled = bool(
                getattr(self, "learning_bandit_enabled", False))
            core.learning_relationship_enabled = bool(
                getattr(self, "learning_relationship_enabled", False))
            core.learning_worthiness_enabled = bool(
                getattr(self, "learning_worthiness_enabled", False))
            core.bio_feedback_loops = bool(
                getattr(self, "bio_feedback_loops", False))
            core.bio_learning = bool(getattr(self, "bio_learning", True))
            core.retention_model = str(
                getattr(self, "retention_model", "power_law") or "power_law")
            if core.autonomy_enabled or core.autonomy_loop_enabled:
                try:
                    _seed = int(getattr(self, "noise_seed", 0) or 0)
                    core._noise_seed = max(0, _seed)
                    if _seed > 0:
                        core._rng = __import__("random").Random(_seed)
                except Exception:
                    pass
            self.cores[key] = core
        return self.cores[key]

    def _seed_trust_from_user(self, event, core) -> None:
        """G3: seed core.trust from the user record once per session core.

        Runs only on the first turn after a core is (re)built in this process;
        the core-side method caps the single-step delta at 0.05 and marks the
        core as seeded, so later turns cannot oscillate. User doc is read-only.
        """
        if core is None or getattr(core, "_user_trust_seeded", False):
            return
        try:
            path = self._user_path(event)
            if not path.exists():
                return
            data = json.loads(path.read_text(encoding="utf-8"))
            if not isinstance(data, dict):
                return
            core.seed_trust_from_user(
                data.get("trust", 0.5), TRUST_SEED_WEIGHT, TRUST_SEED_MAX_DELTA)
        except Exception:
            pass

    def _is_private_event(self, event) -> bool:
        """Task-15: only private chats can ever trigger autonomy output."""
        try:
            umo = str(getattr(event, "unified_msg_origin", "") or "")
            if "GroupMessage" in umo or "GuildMessage" in umo:
                return False
            check = getattr(event, "is_private_chat", None)
            if callable(check):
                return bool(check())
            return False
        except Exception:
            return False

    def _loop_cfg_float(self, key: str, default: float,
                        lo: float, hi: float) -> float:
        """Read one numeric autonomy-loop config value (finite + clamped)."""
        try:
            value = float(self.config.get(key, default))
        except Exception:
            return float(default)
        if value != value or value in (float("inf"), float("-inf")):
            return float(default)
        return max(float(lo), min(float(hi), value))

    def _update_autonomy_readiness(self, core, user_data=None) -> dict:
        """Task-15: ask L1 to compute readiness only when autonomy is enabled."""
        if not getattr(self, "proactive_autonomy", False) or core is None:
            return {}
        try:
            return core.autonomy_state(self._relationship_of(user_data))
        except Exception:
            return {}

    def _autonomy_template(self, core) -> str:
        """Task-15: state-style deterministic proactive text (no summaries/LLM).

        Uses only need + current emotion + closeness band, so the send cannot
        leak event titles or stale summaries and stays reproducible.
        """
        labels = getattr(core, "labels", {}) or {}
        need = str(labels.get("need") or "talk")
        emotion = str(labels.get("emotion") or "neutral")
        need_txt = {"space": "你先忙，我不打扰。",
                    "share": "想听听你今天的碎片。",
                    "vent": "要是想说，我在。",
                    "be_heard": "我在听。",
                    "talk": "想和你说两句。"}.get(need, "想和你说两句。")
        emotion_txt = {"joy": "心情还算轻",
                       "sadness": "心里有点沉",
                       "anger": "有点憋着火",
                       "fear": "有点不安",
                       "loneliness": "有点想人陪",
                       "neutral": "情绪平稳"}.get(emotion, "情绪平稳")
        try:
            rel = getattr(core, "relationship_context", None) or {}
            closeness = float((rel.get("state") or {}).get("closeness", 0.5) or 0.5)
        except Exception:
            closeness = 0.5
        if closeness >= 0.65:
            close_txt = "和你还挺亲近"
        elif closeness <= 0.35:
            close_txt = "和你有点距离"
        else:
            close_txt = "和你平常"
        return ("%s%s，%s。" % (need_txt, emotion_txt, close_txt))[:AUTONOMY_MAX_CHARS_MAX]

    def _load_policy_q(self):
        try:
            from biocore_model import ui_settings as _ui
            data = _ui.load(self)
            table = (data.get("autonomy") or {}).get("policy_q")
            return table if isinstance(table, dict) else {}
        except Exception:
            return {}

    def _save_policy_q(self, table):
        try:
            from biocore_model import ui_settings as _ui
            _ui.save(self, {"autonomy": {"policy_q": dict(table or {})}})
        except Exception:
            pass

    def _autonomy_gate(self, core, relationship, now=None):
        """Task-15: L3 applies send gates to an L1 readiness result."""
        if core is None:
            return None, {"enabled": False}
        try:
            current = float(now if now is not None else time.time())
            state = core.autonomy_state(relationship, now=current)
            if not state.get("enabled") or not state.get("ready"):
                return None, state or {}
            # Stage-2: refusal_protocol is now a real gate, not a posture token.
            rel_state = relationship.get("state") if isinstance(relationship, dict) else {}
            rel_state = rel_state if isinstance(rel_state, dict) else {}
            try:
                protocol = relationship_meta.refusal_protocol({
                    "boundary_pressure": float(getattr(core, "boundary_pressure", 0.0) or 0.0),
                    "trust": float(rel_state.get("trust", 0.5) or 0.5),
                    "conflict": float(rel_state.get("conflict", 0.0) or 0.0),
                })
            except Exception:
                protocol = {"mode": "comply"}
            if str(protocol.get("mode") or "comply") == "decline":
                return None, state
            if str(protocol.get("mode") or "comply") == "negotiate":
                state = dict(state)
                _cap = 90
                # task-35: opt-in refusal brevity also tightens proactive output.
                if getattr(self, "refusal_brevity_enabled", False):
                    _cap = 60
                state["max_chars"] = min(int(state.get("max_chars") or 120), _cap)
            hour = time.localtime(current).tm_hour
            if AUTONOMY_QUIET_START_HOUR <= hour < AUTONOMY_QUIET_END_HOUR:
                return None, state
            last_ts = float(state.get("last_sent_ts", 0.0) or 0.0)
            if last_ts > 0 and (current - last_ts) < AUTONOMY_COOLDOWN_SECONDS:
                return None, state
            day = time.strftime("%Y-%m-%d", time.localtime(current))
            sent_count = int(state.get("sent_count", 0) or 0)
            if str(state.get("sent_day") or "") != day:
                sent_count = 0
            if sent_count >= AUTONOMY_DAILY_CAP:
                return None, state
            max_chars = int(state.get("max_chars") or 120)
            text = self._autonomy_template(core)[:max(1, max_chars)].strip()
            return (text or None), state
        except Exception:
            return None, {"enabled": False}

    async def _maybe_proactive_send(self, event, core, now=None) -> bool:
        """Task-15: private-only send of the deterministic template."""
        if not getattr(self, "proactive_autonomy", False):
            return False
        if not getattr(self, "proactive_send", False) or core is None:
            return False
        if not self._is_private_event(event):
            return False
        try:
            current = float(now if now is not None else time.time())
            try:
                user_data = self._user_record(event)
            except Exception:
                user_data = {}
            text, state = self._autonomy_gate(
                core, self._relationship_of(user_data), now=current)
            if not text:
                return False
            await event.send(MessageChain([Plain(text)]))
            try:
                from biocore_model import policy_learning as _pl_send
                _ctx_key = _pl_send.make_context(
                    "protest" if int(state.get("sent_count", 0) or 0) else "expect",
                    str(getattr(self, "attachment_style", "secure") or "secure"),
                    time.localtime(current).tm_hour)
                _pick = _pl_send.choose(_ctx_key, self._load_policy_q(), epsilon=0.1)
                self._policy_pending = {"ctx": _ctx_key,
                                        "action": _pick["action"],
                                        "ts": float(current)}
            except Exception:
                pass
            day = time.strftime("%Y-%m-%d", time.localtime(current))
            sent_count = int(state.get("sent_count", 0) or 0)
            if str(state.get("sent_day") or "") != day:
                sent_count = 0
            core._proactive_autonomy.update({
                "last_sent_ts": round(current, 3),
                "sent_day": day,
                "sent_count": sent_count + 1,
                "last_sent_chars": len(text),
            })
            return True
        except Exception as exc:
            logger.warning("[biocore] proactive send failed: %s", exc)
            return False

    def _register_autonomy_session(self, event) -> None:
        """Task-15: remember one private session for the background generator."""
        try:
            umo = str(getattr(event, "unified_msg_origin", "") or "").strip()
            if not umo:
                return
            sid, sname = self._speaker(event)
            self._autonomy_private_sessions[umo] = {
                "umo": umo, "sender_id": sid, "sender_name": sname,
                "ts": round(time.time(), 3),
            }
            if len(self._autonomy_private_sessions) > 20:
                _items = sorted(self._autonomy_private_sessions.items(),
                                key=lambda kv: float(kv[1].get("ts", 0.0) or 0.0),
                                reverse=True)[:20]
                self._autonomy_private_sessions = dict(_items)
        except Exception:
            pass


    def _ensure_life_task(self) -> None:
        """Single always-on loop: start it only when a loop is running.

        Plugin construction can happen before the host event loop exists; in
        that case only a pending flag is set and the first status/message call
        starts the task. Safe to call many times (idempotent).
        """
        if not getattr(self, "enabled", True):
            return
        task = getattr(self, "_life_task", None)
        if task is not None and not task.done():
            self._life_start_pending = False
            return
        try:
            asyncio.get_running_loop()
        except RuntimeError:
            self._life_start_pending = True
            return
        try:
            self._life_task = asyncio.create_task(self._life_loop())
            self._life_start_pending = False
            logger.info("[biocore] life loop started")
        except Exception as exc:
            self._life_start_pending = True
            logger.warning("[biocore] life loop start failed: %s", exc)

    def _stop_life_task(self) -> None:
        task = getattr(self, "_life_task", None)
        if task is not None and not task.done():
            task.cancel()
        self._life_task = None
        self._life_start_pending = False

    def _bio_state_key(self):
        """(key, source_path) for hydration: last_umo first, then newest state."""
        try:
            try:
                from .biocore_model import ui_settings as _ui_h
            except Exception:
                from biocore_model import ui_settings as _ui_h
            acc = ((_ui_h.load(self).get("autonomy") or {}).get("accumulator") or {})
            key = str(acc.get("last_umo") or "").strip()
            if key:
                return key, None
        except Exception:
            pass
        try:
            files = sorted(STATE_DIR.glob("*.json"),
                           key=lambda f: f.stat().st_mtime, reverse=True)
            if files:
                return files[0].stem, files[0]
        except Exception:
            pass
        return "", None

    def _make_global_bio_core(self):
        """Synthetic core from ui_settings.bio_state (no user is created)."""
        try:
            try:
                from .biocore_model import ui_settings as _ui_h
            except Exception:
                from biocore_model import ui_settings as _ui_h
            raw = _ui_h.load(self).get("bio_state") or {}
            state = dict(raw) if isinstance(raw, dict) else {}
        except Exception:
            state = {}
        defaults = {"v": 0.0, "a": 0.4, "d": 0.55, "social": 0.5,
                    "stress": 0.15, "energy": 0.5, "trust": 0.5,
                    "allostatic_load": 0.0, "sleep_debt": 0.0,
                    "last_debt_ts": 0.0, "last_bio_tick_ts": 0.0,
                    "circadian_alertness": 0.5}
        for name, default in defaults.items():
            try:
                state[name] = float(state.get(name, default) or default)
            except Exception:
                state[name] = default
        core = types.SimpleNamespace(
            v=state["v"], a=state["a"], d=state["d"], social=state["social"],
            stress=state["stress"], energy=state["energy"], trust=state["trust"],
            allostatic_load=state["allostatic_load"], sleep_debt=state["sleep_debt"],
            last_debt_ts=state["last_debt_ts"],
            last_bio_tick_ts=state["last_bio_tick_ts"],
            circadian_alertness=state["circadian_alertness"],
            _bio_tick_count=int(state.get("_bio_tick_count", 0) or 0),
            labels=dict(state.get("labels") or {"emotion": "neutral", "intensity": 0.0}),
            needs=(dict(state["needs"]) if isinstance(state.get("needs"), dict) else None),
            intero=(dict(state["intero"]) if isinstance(state.get("intero"), dict) else None),
            pending_intent=(dict(state["pending_intent"])
                            if isinstance(state.get("pending_intent"), dict) else None),
        )
        core.snapshot = lambda: {"v": core.v, "a": core.a, "d": core.d,
                                 "social": core.social, "stress": core.stress,
                                 "energy": core.energy, "trust": core.trust,
                                 "allostatic_load": core.allostatic_load,
                                 "labels": dict(core.labels),
                                 "sleep_debt": core.sleep_debt}
        return core

    def _ensure_bio_core(self):
        """Hydrate one core from last_umo/newest state; else synthetic global."""
        cores = getattr(self, "cores", None) or {}
        try:
            if isinstance(cores, dict) and cores:
                return next(iter(cores.values()))
        except Exception:
            pass
        if getattr(self, "_global_bio_core", None) is not None:
            return self._global_bio_core
        key, _path = self._bio_state_key()
        if key:
            try:
                core = self._core(types.SimpleNamespace(unified_msg_origin=key))
                self.cores[key] = core
                return core
            except Exception:
                pass
        try:
            core = self._make_global_bio_core()
            self._global_bio_core = core
            return core
        except Exception:
            return None

    def _persist_global_bio_state(self):
        core = getattr(self, "_global_bio_core", None)
        if core is None:
            return
        try:
            try:
                from .biocore_model import ui_settings as _ui_h
            except Exception:
                from biocore_model import ui_settings as _ui_h
            snap = dict(core.snapshot() if callable(getattr(core, "snapshot", None)) else {})
            for extra in ("intero", "needs", "sleep_debt", "last_debt_ts",
                          "last_bio_tick_ts", "_bio_tick_count",
                          "pending_intent", "circadian_alertness"):
                value = getattr(core, extra, None)
                if isinstance(value, dict):
                    snap[extra] = dict(value)
                elif value is not None:
                    snap[extra] = value
            _ui_h.save(self, {"bio_state": snap})
        except Exception:
            pass

    def _bio_cores_for_tick(self):
        try:
            cores = list((getattr(self, "cores", {}) or {}).values())
        except Exception:
            cores = []
        if cores:
            return cores
        core = self._ensure_bio_core()
        return [core] if core is not None else []

    def _autonomy_params(self):
        """Persona/relationship-derived rhythm params (+ ui_settings overrides)."""
        try:
            try:
                from .biocore_model import autonomy_params as _ap
            except Exception:
                from biocore_model import autonomy_params as _ap
            try:
                from .biocore_model import ui_settings as _ui
            except Exception:
                from biocore_model import ui_settings as _ui
            relationship = self._relationship_of({})
            params = _ap.from_profile(
                getattr(self, "profile", {}) or {}, relationship,
                responsiveness=float(getattr(self, "autonomy_responsiveness", 0.5) or 0.5),
                ignore_rate=float(getattr(self, "autonomy_ignore_rate", 0.0) or 0.0))
            overrides = ((_ui.load(self).get("autonomy") or {}).get("params") or {})
            return _ap.apply_overrides(params, overrides if isinstance(overrides, dict) else {})
        except Exception:
            return {"theta": 0.55, "tau_hours": 24.0, "cooldown_s": 1800,
                    "social_tau_hours": 18.0, "silence_tau_hours": 2.0,
                    "daily_cap": 5}

    def _autonomy_insult_blocked(self, now):
        """True for 30 min after an insult: autonomy must not initiate."""
        try:
            last = float(getattr(self, "_last_insult_ts", 0.0) or 0.0)
            return last > 0 and (float(now) - last) < 1800.0
        except Exception:
            return False

    def _apply_autonomy_params(self, payload, params):
        """Overwrite accumulator rhythm keys from params (theta always wins)."""
        out = dict(payload or {})
        params = params if isinstance(params, dict) else {}
        try:
            out["theta"] = float(params.get("theta", out.get("theta", 0.55)) or 0.55)
        except Exception:
            out.setdefault("theta", 0.55)
        for key, pkey in (("cooldown_seconds", "cooldown_s"),
                          ("daily_cap", "daily_cap")):
            if key not in out:
                continue
            try:
                out[key] = int(params.get(pkey, out[key]))
            except Exception:
                pass
        return out

    def _write_autonomy_theta_once(self):
        """Startup: persist persona theta immediately, not after the first tick."""
        if getattr(self, "_autonomy_theta_written", False):
            return
        self._autonomy_theta_written = True
        try:
            try:
                from .biocore_model import ui_settings as _ui
            except Exception:
                from biocore_model import ui_settings as _ui
            params = self._autonomy_params()
            auto = _ui.load(self).get("autonomy") or {}
            acc = dict(auto.get("accumulator") or {})
            acc = self._apply_autonomy_params(acc, params)
            _ui.save(self, {"autonomy": {"accumulator": acc}})
        except Exception:
            pass

    async def _life_loop(self) -> None:
        while getattr(self, "enabled", True):
            try:
                _now = time.time()
                try:
                    self._write_autonomy_theta_once()
                except Exception:
                    pass
                self._life_tick_n = int(getattr(self, "_life_tick_n", 0) or 0) + 1
                _n = self._life_tick_n
                _autonomy_on = (getattr(self, "proactive_autonomy", False)
                                or getattr(self, "autonomy_loop_enabled", False))
                _do_autonomy = bool(_autonomy_on and _n % 6 == 0)
                _do_memory = bool(_n % 360 == 0)
                for _core in self._bio_cores_for_tick():
                    if _bio_tick is None:
                        break
                    _sum = _bio_tick.bio_tick(_core, _now)
                    try:
                        from .biocore_model import (autonomic as _auto, criticality as _crit,
                                                    intent_render as _irender, mind_wander as _wander,
                                                    noise_bank as _noise)
                        _thr = _auto.threshold(now=_now)
                        _sig = _noise.value(getattr(self, "noise_seed", 0), int(_now // 60), "core")
                        if float(_sum.get("discomfort") or 0.0) + 0.05 * _sig["value"] > _thr:
                            if not isinstance(getattr(_core, "pending_intent", None), dict):
                                _pull = _wander.choose(getattr(_core, "open_loops", None) or [],
                                                       rumination=float(getattr(_core, "rumination_ema", 0.0)),
                                                       seed=int(_now), now=int(_now))
                                if _pull:
                                    _core.pending_intent = {"action": "share", "reason": "life-loop wander",
                                                            "weight": _pull["weight"], "ts": _now,
                                                            "burst": _crit.burst_value(int(_now), int(_now // 60))}
                        if isinstance(getattr(_core, "pending_intent", None), dict):
                            _core.pending_intent["text"] = _irender.render(_core.pending_intent)
                    except Exception:
                        pass
                    _log = _sum.get("log") or {}
                    if _n == 1 or _n % 6 == 0 or _log.get("emit"):
                        logger.info("[biocore] bio_tick %s", _log)
                    if _n % 10 == 0:
                        logger.info("[biocore] needs tick %s", _log.get("needs"))
                    if _do_memory:
                        try:
                            _bio_tick.memory_maintenance(_core, _now)
                        except Exception:
                            pass
                    if _core is getattr(self, "_global_bio_core", None):
                        try:
                            self._persist_global_bio_state()
                        except Exception:
                            pass
                if _do_autonomy:
                    try:
                        await self._autonomy_tick(now=_now)
                    except Exception as _at_exc:
                        logger.warning("[biocore] autonomy tick in life loop: %s", _at_exc)
            except Exception as exc:
                logger.warning("[biocore] life loop: %s", exc)
            await asyncio.sleep(10)

    def _ensure_autonomy_task(self) -> None:
        """Deprecated no-op: the single life loop owns the 60s tick.

        Keeping the legacy 300s loop from starting here prevents a double-run:
        _life_loop already calls _autonomy_tick(now) on its own 60s cadence.
        """
        logger.debug("[biocore] _ensure_autonomy_task is a no-op (life loop owns ticks)")

    async def _autonomy_loop(self) -> None:
        """P0-1: 5-minute deterministic tick; exits immediately when disabled."""
        try:
            while (getattr(self, "proactive_autonomy", False)
                   or getattr(self, "autonomy_loop_enabled", False)):
                await asyncio.sleep(AUTONOMY_TICK_SECONDS)
                if not (getattr(self, "proactive_autonomy", False)
                        or getattr(self, "autonomy_loop_enabled", False)):
                    break
                try:
                    await self._autonomy_tick()
                except Exception:
                    pass
        except asyncio.CancelledError:
            return
        except Exception:
            return

    @staticmethod
    def _autonomy_exit_plan(acted: bool, loop_on: bool, proactive_on: bool,
                            proactive_send: bool, token_only: bool) -> str:
        """Single-exit decision for one autonomy tick (spec §7.1 / S20).

        Returns "token" (loop broadcast only; nothing is sent), "send" (the
        existing task-15 send gate may run) or "none". It can never return two
        exits for the same session/tick.
        """
        if not proactive_on or not proactive_send:
            return "token" if acted else "none"
        if acted and loop_on and token_only:
            return "token"
        return "send"

    async def _autonomy_tick(self, now=None) -> list:
        """One autonomous tick over remembered PRIVATE sessions (task-15+task-28).

        Task-28 adds the candidate/arbitration token broadcast. Exit mutual
        exclusion (S20): per session per tick, either the loop broadcasts one
        token (token-only => nothing sent) or the existing task-15 send gate may
        send at most once -- never both.
        """
        engine = str(getattr(self, "autonomy_tick_engine", "module") or "module").lower()
        if engine == "module":
            try:
                return await self._autonomy_tick_module(now)
            except Exception as exc:
                logger.warning("[biocore] autonomy module engine failed, "
                               "falling back to legacy: %s", exc)
        # legacy path (engine=legacy or module failure); kept until step-4.
        sent = []
        loop_on = bool(getattr(self, "autonomy_loop_enabled", False))
        proactive_on = bool(getattr(self, "proactive_autonomy", False))
        if not (loop_on or proactive_on):
            return sent
        try:
            current = float(now if now is not None else time.time())
        except Exception:
            current = time.time()
        for umo, info in list(getattr(self, "_autonomy_private_sessions", {}).items()):
            try:
                if current - float(info.get("ts", 0.0) or 0.0) > 86400:
                    continue
                cores = getattr(self, "cores", None)
                core = cores.get(umo) if isinstance(cores, dict) else None
                if core is None or not (getattr(core, "autonomy_enabled", False)
                                        or getattr(core, "autonomy_loop_enabled", False)):
                    continue
                # Unified noise model: one update point per tick.
                try:
                    core.noise_tick(now=current)
                except Exception:
                    pass
                target = _AutonomySendTarget(
                    self, umo, info.get("sender_id", ""),
                    info.get("sender_name", ""), private=True)
                acted = False
                if loop_on and getattr(core, "autonomy_loop_enabled", False):
                    # legacy autonomy loop removed: L4 module engine owns ticks
                    acted = False
                plan = self._autonomy_exit_plan(
                    acted, loop_on, proactive_on,
                    bool(getattr(self, "proactive_send", False)),
                    bool(getattr(self, "autonomy_loop_token_only", True)))
                if plan == "send":
                    if await self._maybe_proactive_send(target, core, now=current):
                        sent.append(umo)
            except Exception:
                continue
        return sent

    async def _autonomy_tick_module(self, now=None) -> list:
        """MOD-2: run one L4 tick through biocore_model.autonomy_tick.

        The L4 module is dependency-injected and never imports main. All deps
        below are built from plugin-owned state only; the module keeps its
        current signatures -- autonomy_model.step(V, drift, leak=0.15,
        sigma=0.06, theta=0.55) and send_gate(state, private=True, now=None,
        quiet_start=23, quiet_end=8, cooldown_seconds=1800, daily_cap=3,
        send_enabled=True). Any setup error is raised to _autonomy_tick, which
        falls back to the legacy loop.
        """
        import asyncio as _asyncio
        try:
            from .biocore_model import autonomy_tick as _tick_mod
            from .biocore_model import autonomy_model as _am
            from .biocore_model import ui_settings as _ui
        except Exception:
            from biocore_model import autonomy_tick as _tick_mod
            from biocore_model import autonomy_model as _am
            from biocore_model import ui_settings as _ui
        current = float(now if now is not None else time.time())
        params = self._autonomy_params()
        auto = _ui.load(self).get("autonomy") or {}
        acc = auto.get("accumulator") if isinstance(auto.get("accumulator"), dict) else {}
        sessions = [{"umo": str(umo)} for umo in
                    list(getattr(self, "_autonomy_private_sessions", {}) or {})]
        if not sessions:
            _recent = str((acc or {}).get("last_umo") or "")
            if _recent:
                sessions = [{"umo": _recent}]
            else:
                # No session is not a reason to freeze V: the module tick still
                # advances V/drift below and reports reason=no_session.
                logger.info("[biocore] autonomy module tick: no session; V still advances")
        deps = type("Deps", (), {})()
        deps.load_acc = lambda: dict((_ui.load(self).get("autonomy") or {}).get("accumulator") or {})

        def _save_acc(value):
            payload = dict(value or {})
            # Persona-derived theta must overwrite the stale hard-coded value;
            # only fall back to setdefault when params are unavailable.
            payload = self._apply_autonomy_params(payload, params)
            try:
                payload["V"] = max(0.0, float(payload.get("V", 0.0) or 0.0))
            except Exception:
                payload["V"] = 0.0
            if sessions:
                payload["last_umo"] = str(sessions[0].get("umo") or "")
            else:
                payload.setdefault("last_umo", "")
            return _ui.save(self, {"autonomy": {"accumulator": payload}})

        deps.save_acc = _save_acc
        deps.list_sessions = lambda: list(sessions)
        deps.params = lambda: dict(params)
        deps.get_core = lambda umo: (self.cores.get(umo)
                                     if isinstance(getattr(self, "cores", None), dict) else None)
        deps.any_core = lambda: next(
            iter((getattr(self, "cores", {}) or {}).values()), None)
        def _snapshot_with_parts(core):
            snap = dict(core.snapshot()) if hasattr(core, "snapshot") else {}
            try:
                snap["parts"] = _am.parts_from_state(
                    core, relationship=self._relationship_of({}),
                    now=current, acc=acc, params=params,
                    social_baseline=(getattr(self, "profile", {}) or {}).get(
                        "social_baseline"))
            except Exception:
                pass
            return snap

        deps.snapshot = _snapshot_with_parts
        deps.step = lambda V, drift, theta: _am.step(
            float(V), float(drift),
            leak=float(acc.get("leak", 0.15) or 0.15),
            sigma=float(acc.get("sigma", 0.06) or 0.06),
            theta=float(theta))

        def _gate(core, acc_state, silence, now_ts):
            try:
                if self._autonomy_insult_blocked(now_ts):
                    return False, "insult_cooldown"
                state = core.autonomy_state(
                    self._relationship_of({}), now=float(now_ts), persist=False)
                return _am.send_gate(
                    state, private=True, now=float(now_ts),
                    quiet_start=AUTONOMY_QUIET_START_HOUR,
                    quiet_end=AUTONOMY_QUIET_END_HOUR,
                    cooldown_seconds=int(params.get("cooldown_s", AUTONOMY_COOLDOWN_SECONDS) or AUTONOMY_COOLDOWN_SECONDS),
                    daily_cap=int(params.get("daily_cap", getattr(self, "autonomy_daily_cap", 5)) or 5),
                    send_enabled=bool(getattr(self, "proactive_send", False)))
            except Exception as exc:
                return False, "gate_error:" + type(exc).__name__

        deps.gate = _gate
        _built = {"prompt": "", "system": "", "max_chars": 0, "text": ""}

        def _build_text(core, acc_state):
            built = self._build_proactive_text(core, acc_state, current)
            _built.update(built)
            return str(built.get("text") or "")

        deps.build_text = _build_text

        def _send_text(umo, text):
            async def _send():
                final = str(text or "")
                if getattr(self, "proactive_llm_enabled", True) and _built.get("prompt"):
                    try:
                        upgraded = await self._llm_v2_call(
                            "proactive", str(_built["prompt"]),
                            lambda raw: self._sanitize_proactive_text(str(raw or ""), 0),
                            event=_AutonomySendTarget(self, umo, private=True),
                            system_prompt=str(_built.get("system") or ""))
                        final = str(upgraded) if upgraded else final
                    except Exception as exc:
                        logger.warning("[biocore] proactive llm text failed: %s", exc)
                final = self._sanitize_proactive_text(
                    final, int(_built.get("max_chars", 0) or 0)) or str(text or "")
                try:
                    target = _AutonomySendTarget(self, umo, private=True)
                    await target.send(MessageChain([Plain(final)]))
                except Exception as exc:
                    logger.warning("[biocore] autonomy module send failed: %s", exc)
            try:
                _asyncio.ensure_future(_send())
                return True
            except Exception:
                return False

        deps.send_text = _send_text
        result = _tick_mod.tick_once(deps, current)
        logger.info("[biocore] autonomy tick engine=module V=%.3f theta=%.3f sent=%d "
                    "skipped=%d blocked=%d reason=%s",
                    float(deps.load_acc().get("V", 0.0) or 0.0),
                    float(params.get("theta", 0.55) or 0.55),
                    len(result.get("sent") or []), len(result.get("skipped") or []),
                    len(result.get("blocked") or []), result.get("reason", ""))
        return list(result.get("sent") or [])


    def _build_proactive_text(self, core, acc_state, now_ts) -> dict:
        """Reason + L3 prompt + fallback text for one proactive send (sync)."""
        try:
            from .biocore_model import (autonomy_reason as _reason, autonomy_model as _am,
                                        expr_template as _etpl, expr_state as _estate)
        except Exception:
            from biocore_model import (autonomy_reason as _reason, autonomy_model as _am,
                                       expr_template as _etpl, expr_state as _estate)
        state, snapshot = {}, {}
        try:
            state = core.autonomy_state(self._relationship_of({}), now=now_ts, persist=False) or {}
            snapshot = (core.snapshot() if hasattr(core, "snapshot") else {}) or {}
        except Exception:
            state, snapshot = {}, {}
        relationship = getattr(core, "relationship_context", None) or {}
        try:
            _params = self._autonomy_params()
        except Exception:
            _params = {}
        parts = (state.get("parts") if isinstance(state.get("parts"), dict) else {}) or (
            snapshot.get("parts") if isinstance(snapshot.get("parts"), dict) else {}) or (
            _am.parts_from_state(core, relationship, now=now_ts, acc=acc_state,
                                 params=_params,
                                 social_baseline=(getattr(self, "profile", {}) or {}).get(
                                     "social_baseline")))
        reason = _reason.extract(parts)
        try:
            _block = _estate.render_state_block(snapshot or state, relationship, now=now_ts)
            state_block = str((_block or {}).get("text") or "") if isinstance(_block, dict) else str(_block or "")
        except Exception:
            state_block = ""
        try:
            _last = float(acc_state.get("last_user_msg_ts", 0.0) or 0.0)
            gap = ("间隔：已 %.1f 小时没说话" % max(0.0, (float(now_ts) - _last) / 3600.0)) if _last else ""
        except Exception:
            gap = ""
        try:
            try:
                from .biocore_model import prompt_rules as _pr
            except Exception:
                from biocore_model import prompt_rules as _pr
            _target = int(getattr(self, "reply_soft_target_chars", 10) or 10)
            _maxc = int(getattr(self, "reply_soft_max_chars", 30) or 30)
            _speak_style = ""
            if bool(getattr(self, "reply_soft_limit_enabled", True)):
                _speak_style = str(_pr.render_length_rule(_target, _maxc))
        except Exception:
            _speak_style = str(getattr(self, "speak_style", "") or "")
        built = _etpl.build_proactive(
            snapshot, relationship=relationship,
            state_ctx={"state_block": state_block, "gap": gap,
                       "numeric_legend": (lambda _st: (
                           __import__("biocore_model.schema", fromlist=["numeric_legend"])
                           .numeric_legend(_st) if _st else ""))(
                               snapshot if isinstance(snapshot, dict) else {})},
            intent=acc_state.get("intent"), tone=acc_state.get("tone"),
            opts={"persona": str(getattr(self, "persona_text", "") or ""),
                  "speak_style": _speak_style,
                  "output_protocol": _etpl.PROMPT_OUTPUT_PROTOCOL})
        prompt = "\n\n".join(x for x in (built.get("system"), built.get("user")) if x)
        return {"prompt": prompt, "system": str(built.get("system") or ""),
                "max_chars": 0,
                "text": _reason.fallback_text(reason, self._autonomy_template(core))}

    def _sanitize_proactive_text(self, text, max_chars=0) -> str:
        """Proactive text: strip protocol tags, collapse duplicate punctuation, cap."""
        value = str(text or "").strip()
        try:
            value = str(interpretation.parse_response(value)[0] or "")
        except Exception:
            pass
        value = re.sub(r"([。！？!?；;，,])(?:[\s。！？!?；;，,])+", r"\1", value)
        value = re.sub(r"[ \t]+", " ", value).strip()
        try:
            cap = int(max_chars or 0)
        except Exception:
            cap = 0
        if cap > 0 and len(value) > cap:
            value = value[:cap].rstrip(" \t，,；;、")
        return value.strip()


    def _readiness_text(self, event) -> str:
        """Task-15: read-only /biocore readiness report (no side effects when off)."""
        if not getattr(self, "proactive_autonomy", False):
            return ("[BioCore] readiness: disabled (proactive_autonomy=false)\n"
                    "proactive_send=%s" % bool(getattr(self, "proactive_send", False)))
        try:
            core = self._core(event)
            try:
                user_data = self._user_record(event)
            except Exception:
                user_data = {}
            state = core.autonomy_state(self._relationship_of(user_data), persist=False)
            sources = state.get("sources") or {}
            noise = sources.get("noise") or {}
            return ("[BioCore] readiness: threshold=%.3f max_chars=%d impulse=%.3f "
                    "ema=%.3f ready=%s enabled=true send=%s\n"
                    "sources: chaos=%.3f echo=%.3f stress_load=%.3f drive_dev=%.3f "
                    "trust=%.3f closeness=%.3f gain=%.3f noise_seed=%s "
                    "noise(st=%s en=%s so=%s at=%s va=%s)" % (
                        float(state.get("threshold", 0.0)),
                        int(state.get("max_chars", 0)),
                        float(state.get("impulse", 0.0)),
                        float(state.get("impulse_ema", 0.0)),
                        bool(state.get("ready")),
                        bool(getattr(self, "proactive_send", False)),
                        float(state.get("chaos", 0.0)),
                        float(sources.get("echo_trace", 0.0)),
                        float(sources.get("stress_load", 0.0)),
                        float(sources.get("drive_dev", 0.0)),
                        float(sources.get("trust", 0.5)),
                        float(sources.get("closeness", 0.5)),
                        float(sources.get("autonomy_gain", 1.0)),
                        state.get("noise_seed", 0),
                        noise.get("stress", 0.0), noise.get("energy", 0.0),
                        noise.get("social", 0.0), noise.get("attention", 0.0),
                        noise.get("valence", 0.0)))
        except Exception as exc:
            logger.warning("[biocore] readiness report failed: %s", exc)
            return "[BioCore] readiness: error"

    @filter.command("biocore")
    async def biocore_command(self, event: AstrMessageEvent):
        """Task-15: /biocore readiness read-only output."""
        try:
            raw = str(getattr(event, "message_str", "") or "").strip()
        except Exception:
            raw = ""
        parts = raw.split(None, 1)
        sub = parts[1].strip().lower() if len(parts) > 1 else ""
        if sub == "readiness":
            event.set_result(MessageEventResult().message(
                self._readiness_text(event)).use_t2i(False))
            return
        if sub == "learning" or sub.startswith("learning "):
            core = self._core(event)
            if sub == "learning reset":
                try:
                    core._learning = {"version": 1,
                                      "params": {"regulation_q": {}, "trust_alpha": 0.30,
                                                 "learning_rate": LEARNING_Q_ALPHA},
                                      "last_update": 0.0, "updates_count": 0, "log": []}
                    event.set_result(MessageEventResult().message(
                        "[BioCore] learning reset done").use_t2i(False))
                except Exception:
                    event.set_result(MessageEventResult().message(
                        "[BioCore] learning reset failed").use_t2i(False))
                return
            try:
                state = json.dumps(core._learning, ensure_ascii=False)[:1500]
            except Exception:
                state = "{}"
            event.set_result(MessageEventResult().message(
                "[BioCore] learning enabled=%s retention=%s\n%s" % (
                    bool(getattr(core, "bio_learning", False)),
                    str(getattr(core, "retention_model", "power_law")), state)).use_t2i(False))
            return
        event.set_result(MessageEventResult().message(
            "用法：/biocore readiness | /biocore learning | /biocore learning reset").use_t2i(False))

    async def _ensure_profile(self, event):
        if not self.profile and self.first_run_persona_compile:
            await self._compile_profile(event)
        elif not self.profile:
            self.profile = dict(DEFAULT_PROFILE)
            self.persona_text = ""

    def _settings_path(self):
        return DATA_DIR / "settings.json"

    def _load_settings(self):
        try:
            p = self._settings_path()
            if p.exists():
                d = json.loads(p.read_text(encoding="utf-8"))
                # Single source of truth = AstrBot plugin config. Legacy dashboard
                # toggles in settings.json only apply when config does not define
                # the key (otherwise they silently overrode plugin config).
                for key in ("proactive_reply", "memory_dedup_embedding", "inject_intent",
                            "kb_enabled", "hybrid_retrieval", "safety_enabled",
                            "llm_memory_candidates", "llm_only_reply_summary",
                            "we_memory_enabled"):
                    if key in d and key not in self.config:
                        setattr(self, key, bool(d[key]))
                if "safety_enabled" in d and "safety_enabled" not in self.config:
                    self.safety_enabled = bool(d.get("safety_enabled"))
                    self.cross_session_memory = not self.safety_enabled
                    self.sensitive_memory_protection = self.safety_enabled
                if "persona_id" in d and "persona_id" not in self.config:
                    self.persona_id = str(d.get("persona_id") or "").strip()
                if isinstance(d.get("kb_names"), list) and "kb_names" not in self.config:
                    self.kb_names = [str(x) for x in d.get("kb_names") if str(x).strip()]
        except Exception as exc:
            logger.warning("[biocore] settings load failed: %s", exc)

    def _save_settings(self):
        try:
            self._settings_path().write_text(json.dumps({
                "proactive_reply": bool(self.proactive_reply),
                "memory_dedup_embedding": bool(self.memory_dedup_embedding),
                "hybrid_retrieval": bool(getattr(self, "hybrid_retrieval", True)),
                "safety_enabled": bool(getattr(self, "safety_enabled", False)),
                "llm_memory_candidates": bool(
                    getattr(self, "llm_memory_candidates", True)),
                "we_memory_enabled": bool(getattr(self, "we_memory_enabled", False)),
            "bc_prompt_mode": str(getattr(self, "bc_prompt_mode", "telemetry") or "telemetry"),
            "summary_max_chars": int(getattr(self, "summary_max_chars", 0) or 0),
            "llm_only_reply_summary": bool(
                    getattr(self, "llm_only_reply_summary", True)),
                "persona_id": str(getattr(self, "persona_id", "") or ""),
                "inject_intent": bool(self.inject_intent),
                "kb_enabled": bool(getattr(self, "kb_enabled", False)),
                "kb_names": list(getattr(self, "kb_names", [])),
            }, ensure_ascii=False, indent=1), encoding="utf-8")
        except Exception as exc:
            logger.warning("[biocore] settings save failed: %s", exc)

    async def _persist_plugin_config(self, updates: dict):
        try:
            if isinstance(self.config, dict):
                self.config.update(updates)
                saver = getattr(self.config, "save_config_async", None)
                if saver:
                    await saver(updates)
                else:
                    saver2 = getattr(self.config, "save_config", None)
                    if saver2:
                        saver2(updates)
        except Exception as exc:
            logger.warning("[biocore] plugin config sync failed: %s", exc)

    def _load_api_config(self):
        try:
            if API_CONFIG_PATH.exists():
                d = json.loads(API_CONFIG_PATH.read_text(encoding="utf-8"))
                if isinstance(d, dict):
                    self.api_config = d
        except Exception as exc:
            logger.warning("[biocore] api config load failed: %s", exc)
            self.api_config = {}
        self._load_llm_functions()

    def _load_llm_functions(self):
        """Load per-function LLM switches and provider overrides.

        Embedding/rerank model selection is intentionally NOT per-function:
        the deterministic event-ranking pipeline always follows the API 接入
        defaults (global embedding, global rerank with deterministic local
        fallback). Legacy configs that stored embedding_provider/rerank_provider
        are migrated by dropping those keys.
        """
        _defaults = {
            _name: {"enabled": LLM_FUNCTION_DEFAULTS[_name],
                    "provider": "follow_llm"}
            for _name in LLM_FUNCTIONS
        }
        _saved = self.api_config.get("functions") if isinstance(self.api_config.get("functions"), dict) else None
        if _saved is None:
            # Legacy migration: strict=true meant "summaries only"; strict=false
            # meant all capabilities available.
            _legacy = bool(getattr(self, "llm_only_reply_summary", True))
            _defaults = {
                _name: {"enabled": (LLM_FUNCTION_DEFAULTS[_name] if _legacy else True),
                         "provider": "follow_llm"}
                for _name in LLM_FUNCTIONS
            }
            self.llm_functions = _defaults
            self.api_config["functions"] = _defaults
            self._save_api_config()
            return
        _merged = {}
        _dropped_legacy = False
        for _name in LLM_FUNCTIONS:
            _raw = _saved.get(_name)
            _item = _raw if isinstance(_raw, dict) else {}
            if isinstance(_raw, dict) and (
                    "embedding_provider" in _raw or "rerank_provider" in _raw):
                _dropped_legacy = True
            _merged[_name] = {
                "enabled": bool(_item.get("enabled", LLM_FUNCTION_DEFAULTS[_name])),
                "provider": str(_item.get("provider") or "follow_llm"),
            }
        self.llm_functions = _merged
        self.api_config["functions"] = _merged
        if _dropped_legacy:
            # Persist the migration once so the dead per-function model keys go
            # away from data/api_config.json.
            self._save_api_config()

    def _save_api_config(self):
        try:
            API_CONFIG_PATH.write_text(json.dumps(self.api_config, ensure_ascii=False, indent=1),
                                        encoding="utf-8")
        except Exception as exc:
            logger.warning("[biocore] api config save failed: %s", exc)

    def _config_providers(self):
        try:
            cfg = self.context.get_config()
            if isinstance(cfg, dict):
                return list(cfg.get("provider") or [])
            getter = getattr(cfg, "get", None)
            if getter:
                return list(getter("provider") or [])
        except Exception:
            pass
        return []

    def _config_provider_sources(self):
        try:
            cfg = self.context.get_config()
            if isinstance(cfg, dict):
                return list(cfg.get("provider_sources") or [])
            getter = getattr(cfg, "get", None)
            if getter:
                return list(getter("provider_sources") or [])
        except Exception:
            pass
        return []

    def _speaker(self, event):
        """Return the current sender's (id, display name) if available."""
        sid = ""
        name = ""
        try:
            fn = getattr(event, "get_sender_id", None)
            if callable(fn):
                sid = str(fn() or "")
        except Exception:
            pass
        try:
            fn = getattr(event, "get_sender_name", None)
            if callable(fn):
                name = str(fn() or "")
        except Exception:
            pass
        try:
            obj = getattr(event, "message_obj", None)
            sender = getattr(obj, "sender", None) if obj is not None else None
            if sender is not None:
                if not sid:
                    sid = str(getattr(sender, "user_id", "") or "")
                if not name:
                    name = str(getattr(sender, "nickname", "") or "")
        except Exception:
            pass
        return sid.strip(), name.strip()

    @staticmethod
    def _image_ref(img) -> str:
        if not isinstance(img, Image):
            return ""
        return str(getattr(img, "url", "") or getattr(img, "file", "") or getattr(img, "path", "") or "").strip()

    def _text_from_components(self, event) -> str:
        parts = []
        try:
            for msg in event.get_messages() or []:
                text = getattr(msg, "text", None)
                if isinstance(text, str):
                    parts.append(text)
        except Exception:
            pass
        return " ".join(parts)

    def _image_refs(self, event) -> list:
        if not getattr(self, "image_recognition_enabled", True):
            return []
        try:
            messages = event.get_messages() or []
        except Exception:
            return []
        refs = []
        private = bool(getattr(event, "is_private_chat", lambda: False)())
        raw_text = str(getattr(event, "message_str", "") or "") + " " + self._text_from_components(event)
        if private:
            for msg in messages:
                if isinstance(msg, Image):
                    ref = self._image_ref(msg)
                    if ref:
                        refs.append(ref)
                if isinstance(msg, Reply):
                    for child in (getattr(msg, "chain", None) or []):
                        ref = self._image_ref(child)
                        if ref:
                            refs.append(ref)
        else:
            if not any(w and w in raw_text for w in (getattr(self, "image_trigger_words", None) or [])):
                return []
            for msg in messages:
                if isinstance(msg, Reply):
                    for child in (getattr(msg, "chain", None) or []):
                        ref = self._image_ref(child)
                        if ref:
                            refs.append(ref)
        seen = set()
        out = []
        for ref in refs:
            if ref not in seen:
                seen.add(ref)
                out.append(ref)
        return out

    def _load_image_cache(self) -> dict:
        try:
            if IMAGE_CACHE_PATH.exists():
                d = json.loads(IMAGE_CACHE_PATH.read_text(encoding="utf-8"))
                if isinstance(d, dict):
                    return d
        except Exception:
            pass
        return {}

    def _save_image_cache(self, cache: dict) -> None:
        try:
            if len(cache) > self.image_cache_max_entries:
                items = sorted(cache.items(), key=lambda kv: float(kv[1].get("ts", 0) or 0), reverse=True)
                cache = dict(items[:self.image_cache_max_entries])
            IMAGE_CACHE_PATH.write_text(json.dumps(cache, ensure_ascii=False), encoding="utf-8")
        except Exception as exc:
            logger.warning("[biocore] image cache save failed: %s", exc)

    async def _image_health_ok(self) -> bool:
        if int(self.image_service_port or 0) <= 0:
            return False
        def _check() -> bool:
            try:
                req = urllib.request.Request(
                    f"http://127.0.0.1:{self.image_service_port}/v1/models",
                    headers={"Accept": "application/json"})
                with urllib.request.urlopen(req, timeout=2) as resp:
                    return 200 <= int(resp.status) < 300
            except Exception:
                return False
        try:
            return await asyncio.to_thread(_check)
        except Exception:
            return False

    def _image_idle_watch(self):
        if self._image_proc is None:
            return
        if self._image_idle_task is not None and not self._image_idle_task.done():
            return
        self._image_idle_task = asyncio.create_task(self._image_idle_loop())

    async def _image_idle_loop(self):
        try:
            while True:
                await asyncio.sleep(5)
                if self._image_proc is None:
                    return
                if time.time() - float(self._image_last_used or 0.0) >= self.image_service_idle_seconds:
                    await self._stop_image_service()
                    return
        finally:
            self._image_idle_task = None

    async def _stop_image_service(self):
        proc = self._image_proc
        self._image_proc = None
        if proc is None:
            return
        try:
            if proc.poll() is None:
                subprocess.run(["taskkill", "/PID", str(proc.pid), "/T", "/F"],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                               timeout=10, check=False)
        except Exception as exc:
            logger.warning("[biocore] image service stop failed: %s", exc)
        try:
            proc.wait(timeout=5)
        except Exception:
            pass
        logger.info("[biocore] image service stopped after idle")

    async def _ensure_image_service(self) -> bool:
        if int(self.image_service_port or 0) <= 0:
            return False
        self._image_last_used = time.time()
        if await self._image_health_ok():
            return True
        if self._image_service_lock is None:
            self._image_service_lock = asyncio.Lock()
        async with self._image_service_lock:
            if await self._image_health_ok():
                self._image_last_used = time.time()
                return True
            try:
                if (not self.image_llama_server or not self.image_llama_model
                        or not self.image_llama_server.is_file()
                        or not self.image_llama_model.is_file()):
                    logger.warning("[biocore] image service paths missing; configure image_llama_server / image_llama_model")
                    return False
                args = [str(self.image_llama_server), "-m", str(self.image_llama_model)]
                if self.image_llama_mmproj and self.image_llama_mmproj.is_file():
                    args += ["--mmproj", str(self.image_llama_mmproj)]
                args += ["--host", "127.0.0.1", "--port", str(self.image_service_port),
                         "-ngl", "99", "-c", "8192", "-np", "1", "-lm", "none",
                         "-cram", "0", "-ctxcp", "0", "--no-warmup"]
                flags = 0x08000000 if os.name == "nt" else 0
                self._image_proc = subprocess.Popen(args, stdout=subprocess.DEVNULL,
                                                    stderr=subprocess.DEVNULL,
                                                    creationflags=flags)
                logger.info("[biocore] image service starting pid=%s", self._image_proc.pid)
                # P0-4: never block the reply path >5s; background start continues.
                for _ in range(20):
                    if await self._image_health_ok():
                        self._image_last_used = time.time()
                        self._image_idle_watch()
                        return True
                    await asyncio.sleep(0.25)
                self._image_fail_count = int(getattr(self, "_image_fail_count", 0)) + 1
                logger.warning("[biocore] image service did not become ready (5s)")
                await self._stop_image_service()
                return False
            except Exception as exc:
                logger.warning("[biocore] image service start failed: %s", exc)
                self._image_proc = None
                return False

    def _load_self_model(self) -> dict:
        d = {
            "who_am_i": "一个会持续受聊天影响、但不会被单条消息完全定义的角色。",
            "boundaries": ["不接受被当作没有感受的工具", "不会被一次互动改写全部立场"],
            "consistency": ["情绪会变，但核心立场不因单次互动翻转"],
            "narrative": "",
            "version": 0,
            "_history": [],
        }
        try:
            if SELF_MODEL_PATH.exists():
                raw = json.loads(SELF_MODEL_PATH.read_text(encoding="utf-8"))
                if isinstance(raw, dict):
                    for k in d:
                        if k in raw:
                            d[k] = raw[k]
        except Exception:
            pass
        try:
            if not SELF_MODEL_PATH.exists():
                self.self_model = d
                self._save_self_model()
        except Exception:
            pass
        return d

    def _save_self_model(self) -> None:
        try:
            SELF_MODEL_PATH.parent.mkdir(parents=True, exist_ok=True)
            self.self_model["version"] = int(self.self_model.get("version", 0) or 0) + 1
            _h = list(self.self_model.get("_history") or [])[-20:]
            _h.append({"ts": __import__("time").time(),
                       "who_am_i": self.self_model.get("who_am_i", ""),
                       "narrative": self.self_model.get("narrative", "")})
            self.self_model["_history"] = _h[-20:]
            SELF_MODEL_PATH.write_text(json.dumps(self.self_model, ensure_ascii=False, indent=1), encoding="utf-8")
        except Exception:
            pass

    def _update_self_narrative(self, title: str, reflection: str) -> None:
        try:
            if not (title or reflection):
                return
            line = ("%s：%s" % (title, reflection)).strip("： ")
            old = str(self.self_model.get("narrative") or "").strip()
            self.self_model["narrative"] = (line + ("；" + old if old else ""))[:600]
            self._save_self_model()
        except Exception:
            pass

    def _user_path(self, event) -> Path:
        sid, _ = self._speaker(event)
        safe = "".join(c if c.isalnum() or c in "-_" else "_" for c in (sid or "unknown"))[:60]
        return USER_DIR / (safe + ".json")

    def _we_memory_candidates(self, entries) -> list:
        """Deterministic, evidence-gated we-memory proposals (default off)."""
        out = []
        patterns = (
            ("nickname", ("叫你", "喊你", "外号", "昵称")),
            ("ritual", ("每天", "每次", "习惯", "约好", "固定")),
            ("anniversary", ("纪念日", "周年", "第一次")),
            ("inside_joke", ("梗", "暗号", "约定")),
            ("shared_object", ("我们的", "一起买", "一起做", "送给")),
        )
        for entry in (entries if isinstance(entries, list) else [])[-100:]:
            if not isinstance(entry, dict):
                continue
            text = str(entry.get("text") or "").strip()
            if not text:
                continue
            for mtype, words in patterns:
                if not any(w in text for w in words):
                    continue
                snippet = text[:40]
                out.append({"type": mtype, "text": snippet, "confidence": 0.6,
                            "evidence_refs": [str(entry.get("id") or entry.get("ts") or "m")[:80]]})
                break
        return relationship_meta.merge_we_memory([], out)

    def _summary_cap(self, text) -> str:
        value = str(text or "")
        try:
            cap = int(getattr(self, "summary_max_chars", 0) or 0)
        except Exception:
            cap = 0
        return value[:cap] if cap > 0 else value

    def _event_excerpt(self, text, limit: int = 220) -> str:
        """Compact deterministic-event display text; raw evidence stays in source_texts."""
        value = re.sub(r"\s+", " ", str(text or "").replace("\n", " ")).strip()
        if len(value) <= limit:
            return value
        cut = value[:limit]
        pos = max(cut.rfind("。"), cut.rfind("！"), cut.rfind("？"), cut.rfind("；"))
        if pos >= int(limit * 0.5):
            return cut[:pos + 1].strip()
        return cut.rstrip() + "…"

    @staticmethod
    def _first_sentence(text) -> str:
        """First sentence of a raw event excerpt (used for <=80 summaries)."""
        value = re.sub(r"\s+", " ", str(text or "")).strip()
        if not value:
            return ""
        match = re.search(r"[。！？；!?;]", value)
        return value[:match.end()] if match else value

    def _dual_event_summary_fallback(self, text, title: str = ""):
        """Deterministic bounded big/small summary fallback for event records.

        No LLM is used here: big_summary is a bounded excerpt (<=220 chars) and
        small_summary is the first sentence (or the title) bounded to 80 chars.
        These records are marked summary_status="fallback" by the writers.
        """
        big = self._mask_if_safety(self._event_excerpt(text, 220))[:220]
        small = self._mask_if_safety(
            self._first_sentence(text) or str(title or "").strip())[:80]
        if not big:
            big = small
        if not small:
            small = big[:80]
        return big, small

    def _secondary_emotion(self, core) -> str:
        """Second-highest spectrum emotion excluding the current primary label."""
        if core is None:
            return ""
        try:
            primary = str((getattr(core, "labels", {}) or {}).get("emotion") or "neutral")
            probs = core._spectrum_probs() if callable(getattr(core, "_spectrum_probs", None)) else []
            for item in (probs or []):
                if not isinstance(item, dict):
                    continue
                key = str(item.get("key") or "").strip()[:32]
                if key and key != primary:
                    return key
        except Exception:
            pass
        return ""

    def _event_emotion_layers(self, core) -> list:
        """Emotion layers snapshot for the memory-ball rings (task-65).

        Top-4 EMOTION_SPECTRUM probabilities including the primary emotion,
        normalized to sum 1: [{"emotion": key, "p": weight}, ...]. The field
        is stored once with the archive record, so a later regenerate does not
        rewrite the historical layers. No spectrum data -> [] (rings then use
        the old secondary/inferred fallback; nothing is fabricated).
        """
        try:
            if core is None:
                return []
            probs = core._spectrum_probs() if callable(getattr(core, "_spectrum_probs", None)) else []
            rows = []
            for item in (probs or []):
                if not isinstance(item, dict):
                    continue
                key = str(item.get("key") or "").strip().lower()[:32]
                if not key:
                    continue
                try:
                    weight = float(item.get("p", 0) or 0)
                except Exception:
                    weight = 0.0
                if weight <= 0:
                    continue
                rows.append((key, weight))
            primary = str((getattr(core, "labels", {}) or {}).get("emotion") or "").strip().lower()
            if not rows:
                return [{"emotion": primary, "p": 1.0}] if primary else []
            merged = {}
            for key, weight in rows:
                merged[key] = merged.get(key, 0.0) + weight
            ordered = sorted(merged.items(), key=lambda pair: pair[1], reverse=True)[:4]
            picked = [{"emotion": key, "p": weight} for key, weight in ordered]
            if primary and primary not in [x["emotion"] for x in picked]:
                # The primary emotion must be part of the snapshot even when its
                # spectrum probability is missing/zero; give it a minimal weight
                # so normalization keeps it at the tail.
                picked = picked[:3] + [{"emotion": primary,
                                       "p": max(0.01, merged.get(primary, 0.0))}]
            total = sum(x["p"] for x in picked)
            if total <= 0:
                return []
            out = [{"emotion": x["emotion"], "p": round(x["p"] / total, 4)}
                   for x in picked if x["p"] > 0]
            out.sort(key=lambda x: x["p"], reverse=True)
            return out
        except Exception:
            return []

    def _event_emotion_intensity(self, core) -> float:
        """Emotion-intensity snapshot for ring speed (task-66).

        Prefers the core's own intensity(); otherwise arousal + |valence|.
        None / no core -> 0.0; the orb then falls back to importance or
        emotion_layers[0].p instead of fabricating a value.
        """
        try:
            if core is None:
                return 0.0
            fn = getattr(core, "_intensity", None)
            if callable(fn):
                raw = float(fn())
                if math.isfinite(raw):
                    return round(max(0.0, min(1.0, raw)), 4)
            arousal = float(getattr(core, "a", 0.4) or 0.4)
            valence = abs(float(getattr(core, "v", 0.0) or 0.0))
            return round(max(0.0, min(1.0, 0.5 * arousal + 0.5 * valence)), 4)
        except Exception:
            return 0.0

    def _event_secondary_for_record(self, record) -> str:
        """Secondary emotion for an archived event, from its session core.

        Only used to fill a MISSING emotion_secondary on regenerate: the
        highest spectrum probability is excluded (the primary emotion) and the
        next one wins. No core / no spectrum data -> "" (never fabricated).
        """
        try:
            rec = record if isinstance(record, dict) else {}
            session = str(rec.get("session") or "").strip()
            if not session:
                return ""
            core = None
            cores = getattr(self, "cores", None)
            if isinstance(cores, dict):
                core = cores.get(session)
            if core is None:
                try:
                    core = self._core(types.SimpleNamespace(unified_msg_origin=session))
                except Exception:
                    core = None
            if core is None:
                return ""
            primary = str((getattr(core, "labels", {}) or {}).get("emotion") or "neutral")
            probs = core._spectrum_probs() if callable(getattr(core, "_spectrum_probs", None)) else []
            ordered = []
            for item in (probs or []):
                if not isinstance(item, dict):
                    continue
                key = str(item.get("key") or "").strip()[:32]
                if not key:
                    continue
                try:
                    weight = float(item.get("p", 0) or 0)
                except Exception:
                    weight = 0.0
                ordered.append((weight, key))
            ordered.sort(key=lambda pair: pair[0], reverse=True)
            for _weight, key in ordered:
                if key != primary:
                    return key
        except Exception as exc:
            logger.warning("[biocore] event secondary lookup failed: %s", exc)
        return ""

    @staticmethod
    def _normalize_emotion_nuance(value) -> list:
        """Hidden/composite emotion layer from event_summary (task-64).

        Delegates to the interpretation-layer cleaner: max 3 short Chinese
        labels, deduped, empties dropped. Unknown/garbage input returns [] so
        the deterministic fallback never fabricates a nuance layer.
        """
        try:
            return interpretation.clean_emotion_nuance(value, 3)
        except Exception:
            return []

    def _mask_if_safety(self, text) -> str:
        value = str(text or "")
        try:
            if getattr(self, "safety_enabled", False):
                return memory_meta.mask_sensitive(value)
        except Exception:
            pass
        return value

    def _touch_user(self, event, core=None) -> dict:
        try:
            sid, name = self._speaker(event)
            USER_DIR.mkdir(parents=True, exist_ok=True)
            path = self._user_path(event)
            d = {}
            if path.exists():
                try:
                    d = json.loads(path.read_text(encoding="utf-8"))
                except Exception:
                    d = {}
            d["sender_id"] = sid
            d["sender_name"] = name or d.get("sender_name", "")
            try:
                _prev_last_seen = float(d.get("last_seen", 0) or 0)
            except Exception:
                _prev_last_seen = 0.0
            d["interactions"] = int(d.get("interactions", 0) or 0) + 1
            _now_seen = time.time()
            d["absence"] = relationship_meta.absence_state(_prev_last_seen, _now_seen)
            d["last_seen"] = _now_seen
            d.setdefault("first_seen", time.time())
            _session_key = str(getattr(event, "unified_msg_origin", "") or "").strip()
            if _session_key:
                _sessions = d.get("sessions") if isinstance(d.get("sessions"), list) else []
                _sessions = [str(x) for x in _sessions if str(x) and str(x) != _session_key]
                d["sessions"] = (_sessions[-19:] + [_session_key])[-20:]
            try:
                _ct = float(getattr(core, "trust", 0.5)) if core is not None else 0.5
                _old_trust = float(d.get("trust", 0.5) or 0.5)
                if core is not None and getattr(core, "bio_learning", False):
                    # Nassar 2010 adaptive alpha for the trust EMA.
                    _alpha = memory_meta.nassar_alpha(_ct - _old_trust)
                else:
                    _alpha = 0.30
                _new_trust = _old_trust + _alpha * (_ct - _old_trust)
                if getattr(self, "anchor_update_enabled", False):
                    try:
                        _new_trust = core.blend_prior(
                            _new_trust, _old_trust,
                            float(getattr(core, "anchor_weight", 0.25) or 0.25))
                    except Exception:
                        pass
                d["trust"] = round(max(0.0, min(1.0, _new_trust)), 3)
            except Exception:
                d["trust"] = d.get("trust", 0.5)
            try:
                _prev_rel = d.get("relationship") if isinstance(d.get("relationship"), dict) else {}
                _prev_state = _prev_rel.get("state") if isinstance(_prev_rel.get("state"), dict) else None
                _opp = getattr(core, "opponent", {}) if core is not None else {}
                _opp_v = _opp.get("v", 0.0) if isinstance(_opp, dict) else 0.0
                _rel_state = relationship_meta.relationship_state(
                    trust=d.get("trust", 0.5),
                    social=getattr(core, "social", 0.5) if core is not None else 0.5,
                    stress=getattr(core, "stress", 0.5) if core is not None else 0.5,
                    opponent=_opp_v,
                    previous=_prev_state,
                )
                _mem_doc = self._load_memory(event)
                _entries = _mem_doc.get("entries") if isinstance(_mem_doc, dict) else []
                try:
                    _social_world = relationship_meta.build_social_world(_entries)
                except Exception:
                    _social_world = []
                _we_memory = []
                try:
                    if getattr(self, "we_memory_enabled", False):
                        _we_memory = self._we_memory_candidates(_entries)
                except Exception:
                    _we_memory = []
                _milestones = []
                try:
                    for _ev in self._event_archive(20):
                        _mk = relationship_meta.milestone_from_text(
                            str(_ev.get("title") or "") + " " + str(_ev.get("event") or ""))
                        if _mk:
                            _mk["ts"] = float(_ev.get("ts", 0) or 0)
                            _milestones.append(_mk)
                except Exception:
                    _milestones = []
                d["relationship"] = relationship_meta.update_relationship_record(
                    _prev_rel,
                    state=_rel_state,
                    ts=d.get("last_seen", time.time()),
                    transactive_map=relationship_meta.build_transactive_map(_entries),
                    destination_map=relationship_meta.build_destination_map(_entries),
                    absence=d.get("absence"),
                    social_world=_social_world,
                    milestones=_milestones,
                    we_memory=_we_memory,
                    interactions=d.get("interactions", 0),
                    repair_success=int((_prev_rel.get("repair_state") or {}).get("repair_attempts", 0) or 0),
                    promises_kept=len([x for x in _milestones if x.get("type") == "promise_kept"]),
                    annotations=(_prev_rel.get("annotations")
                                 if isinstance(_prev_rel.get("annotations"), list) else None),
                )
                if core is not None:
                    try:
                        core.set_relationship_context(d.get("relationship"))
                    except Exception:
                        pass
                    # Task-15: relationship delta feeds L1 social/valence noise.
                    try:
                        _rel_now = d.get("relationship") if isinstance(d.get("relationship"), dict) else {}
                        _rel_st = _rel_now.get("state") if isinstance(_rel_now.get("state"), dict) else {}
                        core.integrate_noise(
                            "relationship",
                            social=0.004 * (float(_rel_st.get("closeness", 0.5) or 0.5) - 0.5),
                            valence=0.004 * (float(_rel_st.get("trust", 0.5) or 0.5) - 0.5))
                    except Exception:
                        pass
            except Exception:
                pass
            path.write_text(json.dumps(d, ensure_ascii=False, indent=1), encoding="utf-8")
            return d
        except Exception:
            return {}

    def _event_archive(self, limit: int = 5, read_only: bool = False) -> list:
        try:
            if not EVENT_ARCHIVE_PATH.exists():
                return []
            lines = EVENT_ARCHIVE_PATH.read_text(encoding="utf-8").splitlines()
            out = []
            forgotten = []
            for line in lines[-max(1, limit * 3):]:
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                if not isinstance(d, dict):
                    continue
                if not d.get("peripheral_forgotten"):
                    try:
                        _age_days = (time.time() - float(d.get("ts", 0) or 0)) / 86400.0
                        _central = float(d.get("centrality", 0.5) or 0.5)
                        if _age_days > (14.0 - 10.0 * _central):
                            d["peripheral_details"] = ""
                            d["peripheral_retention"] = min(float(d.get("peripheral_retention", 1.0) or 1.0), 0.05)
                            d["peripheral_forgotten"] = True
                            forgotten.append(dict(d))
                    except Exception:
                        pass
                # task-46: old records never carried summary_status. Mark them
                # legacy on read only (no rewrite of the stored full text).
                if not str(d.get("summary_status") or "").strip():
                    d["summary_status"] = "legacy"
                out.append(d)
            if forgotten and not read_only:
                self._persist_peripheral_forgetting(forgotten)
            # Recall/event_context are de-duplicated by normalized event_key,
            # newest first; appended duplicates from older versions collapse here.
            dedup = []
            seen = set()
            for d in out[-max(1, limit) * 3:][::-1]:
                key = self._normalize_event_key(
                    str(d.get("event_key") or d.get("title") or ""),
                    str(d.get("title") or ""))
                if key in seen:
                    continue
                seen.add(key)
                dedup.append(d)
                if len(dedup) >= limit:
                    break
            return dedup
        except Exception:
            return []

    @staticmethod
    def _same_archive_event(obj: dict, target: dict) -> bool:
        try:
            if not isinstance(obj, dict) or not isinstance(target, dict):
                return False
            tid = str(target.get("id") or "").strip()
            did = str(obj.get("id") or "").strip()
            if tid and did:
                return tid == did
            if str(obj.get("title") or "") != str(target.get("title") or ""):
                return False
            return abs(float(obj.get("ts", 0) or 0) - float(target.get("ts", 0) or 0)) <= 1.0
        except Exception:
            return False

    def _rewrite_jsonl_atomic(self, path, mutate) -> int:
        """Rewrite a JSONL archive through a sibling temp file + os.replace.

        mutate(obj) returns True when it changed the row. Unparsable lines are
        preserved verbatim and nothing is written unless a row changed.
        """
        tmp = None
        try:
            path = Path(path)
            if not path.exists():
                return 0
            rows = []
            changed = 0
            for line in path.read_text(encoding="utf-8").splitlines():
                if not line.strip():
                    continue
                try:
                    obj = json.loads(line)
                except Exception:
                    rows.append(("raw", line))
                    continue
                try:
                    _changed = bool(mutate(obj))
                except Exception:
                    _changed = False
                if _changed:
                    changed += 1
                rows.append(("obj", obj))
            if not changed:
                return 0
            tmp = path.with_name(path.name + ".tmp_%s_%s" % (os.getpid(), int(time.time() * 1000)))
            with open(tmp, "w", encoding="utf-8") as f:
                for kind, value in rows:
                    if kind == "raw":
                        f.write(str(value) + "\n")
                    else:
                        f.write(json.dumps(value, ensure_ascii=False) + "\n")
            os.replace(tmp, path)
            tmp = None
            return changed
        except Exception as exc:
            logger.warning("[biocore] archive rewrite failed %s: %s", path, exc)
            return 0
        finally:
            try:
                if tmp is not None and Path(tmp).exists():
                    Path(tmp).unlink()
            except Exception:
                pass

    # ---- task-33: deterministic memory-point worthiness + feedback ----
    @staticmethod
    def _worth_num(value, default: float = 0.0, lo: float = 0.0,
                   hi: float = 1.0) -> float:
        """Finite bounded float for worthiness inputs (NaN/Inf -> default)."""
        try:
            number = float(value)
        except Exception:
            return default
        if number != number or number in (float("inf"), float("-inf")):
            return default
        return max(lo, min(hi, number))

    def _worthiness_inputs_for(self, record, core, relationship=None, *,
                               text: str = "", title: str = "",
                               schema=None) -> dict:
        """Build the raw deterministic inputs for compute_worthiness (no LLM)."""
        rec = record if isinstance(record, dict) else {}
        body = str(text or rec.get("event") or rec.get("title") or "")
        heading = str(title or rec.get("title") or "")
        if schema is None:
            try:
                schema = memory_meta.schema_congruence(
                    body or heading, self._self_schema_texts(core))
            except Exception:
                schema = 0.0
        try:
            intensity = float(core._intensity()) if core is not None else 0.0
        except Exception:
            intensity = 0.0
        appraisal = (getattr(core, "appraisal", None)
                     if core is not None else None)
        appraisal = appraisal if isinstance(appraisal, dict) else {}
        importance = self._worth_num(rec.get("importance"), 0.5)
        schema_v = self._worth_num(schema, 0.0)
        self_defining = memory_meta.event_self_defining(schema_v, importance)
        try:
            milestone = 1.0 if relationship_meta.milestone_from_text(
                heading + " " + body) else 0.0
        except Exception:
            milestone = 0.0
        rel = relationship if isinstance(relationship, dict) else {}
        rel_state = rel.get("state") if isinstance(rel.get("state"), dict) else {}
        trust = self._worth_num(rel_state.get("trust"), 0.5)
        closeness = self._worth_num(rel_state.get("closeness"), 0.5)
        conflict = self._worth_num(rel_state.get("conflict"), 0.0)
        repair = self._worth_num(rel_state.get("repair"), 0.0)
        novelty = self._worth_num(appraisal.get("novelty"), 0.0)
        routine = False
        try:
            routine = bool(memory_meta.is_routine_event(
                body or heading, intensity=intensity, novelty=novelty,
                schema=schema_v))
        except Exception:
            routine = False
        # K (core-impact) proxies from existing L1 state.
        momentum = getattr(core, "momentum", None) if core is not None else None
        momentum = momentum if isinstance(momentum, dict) else {}
        pad_delta = self._worth_num(
            2.0 * (abs(self._worth_num(momentum.get("v"), 0.0, -1.0, 1.0))
                   + abs(self._worth_num(momentum.get("a"), 0.0, -1.0, 1.0))
                   + abs(self._worth_num(momentum.get("d"), 0.0, -1.0, 1.0))),
            0.0)
        self_delta = self._worth_num(
            abs(self._worth_num(getattr(core, "boundary_pressure", 0.0), 0.0))
            + abs(self._worth_num(getattr(core, "refusal_readiness", 0.0), 0.0)))
        homeo = getattr(core, "homeostasis", None) if core is not None else None
        homeo = homeo if isinstance(homeo, dict) else {}
        drives_delta = self._worth_num(homeo.get("L_int"), 0.0)
        trust_dev = abs(trust - 0.5) * 2.0
        close_dev = abs(closeness - 0.5) * 2.0
        rel_delta = self._worth_num(
            0.50 * (trust_dev + close_dev) / 2.0
            + 0.30 * conflict + 0.20 * repair)
        persistence = self._worth_num(
            0.40 + 0.60 * max(intensity, drives_delta, self_delta, rel_delta))
        return {
            "intensity": intensity, "schema_congruence": schema_v,
            "self_defining": self_defining, "milestone": milestone,
            "boundary_score": rec.get("boundary_score", 0.0),
            "recall_count": rec.get("recall_count", 0),
            "merge_count": rec.get("merge_count", 0),
            "goal_relevance": appraisal.get("goal_relevance", 0.0),
            "novelty": novelty, "rel_trust": trust, "rel_closeness": closeness,
            "rel_conflict": conflict, "rel_repair": repair, "routine": routine,
            "pad_delta": pad_delta, "self_delta": self_delta,
            "rel_delta": rel_delta, "drives_delta": drives_delta,
            "persistence": persistence,
        }

    @staticmethod
    def _worthiness_inputs_public(inputs) -> dict:
        """Bounded JSON-safe raw inputs stored on the event (task-34 re-eval)."""
        src = inputs if isinstance(inputs, dict) else {}
        out = {}
        for key in ("intensity", "schema_congruence", "milestone", "boundary_score",
                    "goal_relevance", "novelty", "rel_trust", "rel_closeness",
                    "rel_conflict", "rel_repair", "pad_delta", "self_delta",
                    "rel_delta", "drives_delta", "persistence"):
            out[key] = round(BioCorePlugin._worth_num(src.get(key), 0.0), 4)
        out["self_defining"] = bool(src.get("self_defining", False))
        out["routine"] = bool(src.get("routine", False))
        out["recall_count"] = max(0, int(BioCorePlugin._worth_num(
            src.get("recall_count"), 0.0, 0.0, 10 ** 6)))
        out["merge_count"] = max(0, int(BioCorePlugin._worth_num(
            src.get("merge_count"), 0.0, 0.0, 10 ** 6)))
        return out

    def _worth_k_proxies(self, core, rel_delta: float = 0.0) -> dict:
        """Live core proxies for K (task-34 re-evaluation); bounded."""
        momentum = getattr(core, "momentum", None) if core is not None else None
        momentum = momentum if isinstance(momentum, dict) else {}
        pad_delta = self._worth_num(
            2.0 * (abs(self._worth_num(momentum.get("v"), 0.0, -1.0, 1.0))
                   + abs(self._worth_num(momentum.get("a"), 0.0, -1.0, 1.0))
                   + abs(self._worth_num(momentum.get("d"), 0.0, -1.0, 1.0))))
        self_delta = self._worth_num(
            abs(self._worth_num(getattr(core, "boundary_pressure", 0.0), 0.0))
            + abs(self._worth_num(getattr(core, "refusal_readiness", 0.0), 0.0)))
        homeo = getattr(core, "homeostasis", None) if core is not None else None
        homeo = homeo if isinstance(homeo, dict) else {}
        drives_delta = self._worth_num(homeo.get("L_int"), 0.0)
        try:
            intensity = float(core._intensity()) if core is not None else 0.0
        except Exception:
            intensity = 0.0
        persistence = self._worth_num(
            0.40 + 0.60 * max(intensity, drives_delta, self_delta,
                              self._worth_num(rel_delta, 0.0)))
        # NOTE (P1-1): this helper is K-only on purpose. Re-evaluation must keep
        # the archived intensity (stored inputs) instead of overwriting it with
        # the live core value; intensity here only feeds the persistence factor.
        return {"pad_delta": pad_delta, "self_delta": self_delta,
                "drives_delta": drives_delta, "persistence": persistence}

    def _event_worthiness_bundle(self, record, core, relationship=None, *,
                                 text: str = "", title: str = "",
                                 schema=None):
        """(worthiness, public raw inputs) or (None, None) when the gate is OFF."""
        if not getattr(self, "memory_worthiness_enabled", True):
            return None, None
        inputs = self._worthiness_inputs_for(
            record, core, relationship, text=text, title=title, schema=schema)
        return (memory_meta.compute_worthiness(**inputs),
                self._worthiness_inputs_public(inputs))

    def _event_worthiness_for(self, record, core, relationship=None, **kw):
        """task-33/34: deterministic W/W_her/K for one event (None when OFF)."""
        worth, _inputs = self._event_worthiness_bundle(
            record, core, relationship, **kw)
        return worth

    # ---- task-59: reevaluate evidence guard (insufficient / protected) ----
    _REEVALUATE_PROTECT_CUES = ("表白", "喜欢", "爱上", "承诺", "发誓", "誓言",
                                "纪念日", "求婚", "身份", "我是谁")
    _REEVALUATE_TOOL_CUES = ("翻译", "查询", "天气", "现在几点", "计算", "命令",
                             "帮我查", "搜索", "提醒我", "定时")

    @staticmethod
    def _reevaluate_text(record) -> str:
        rec = record if isinstance(record, dict) else {}
        return " ".join(str(rec.get(k) or "") for k in
                        ("title", "event", "big_summary", "small_summary")).strip()

    def _reevaluate_tool_cue(self, record) -> bool:
        rec = record if isinstance(record, dict) else {}
        text = self._reevaluate_text(rec)
        return any(cue in text for cue in self._REEVALUATE_TOOL_CUES)

    def _reevaluate_protection_reason(self, record) -> str:
        """Relationship/self/milestone events must not vanish on low W.

        P2: a tool-Q&A whitelist wins over the weaker keyword list (a weather
        query must not be "protected" just because it contains a common word);
        explicit relationship/self markers still always protect.
        """
        rec = record if isinstance(record, dict) else {}
        text = self._reevaluate_text(rec)
        markers = (rec.get("relationship_event") or rec.get("self_defining")
                   or rec.get("milestone") or rec.get("identity_relevant"))
        kind = str(rec.get("event_type") or rec.get("type") or "").lower()
        if markers or kind in ("relationship", "self", "milestone", "identity"):
            return "type_marker"
        if self._reevaluate_tool_cue(rec):
            return ""
        if any(cue in text for cue in self._REEVALUATE_PROTECT_CUES):
            return "keyword"
        return ""

    def _reevaluate_insufficient_reason(self, record, inputs, source) -> str:
        """Do not rewrite when evidence is absent/degenerate (or test data)."""
        rec = record if isinstance(record, dict) else {}
        text = self._reevaluate_text(rec)
        if not text:
            return "no_text"
        sess = str(rec.get("session") or "").lower()
        if "test" in sess or "测试" in text:
            return "test_event"
        if source == "recomputed":
            return "missing_inputs"
        if not isinstance(inputs, dict):
            return "missing_fields"
        required = ("I", "S", "C", "G", "PE", "R", "P", "N")
        if not all(k in inputs for k in required):
            return "missing_fields"
        try:
            strong = sum(1 for k in ("I", "S", "G", "PE", "R")
                         if float(inputs.get(k) or 0.0) >= 0.05)
        except Exception:
            return "bad_inputs"
        if strong == 0:
            # All evidence dimensions are ~zero: this is missing evidence, not
            # a genuine "not worth remembering" judgement.
            return "degenerate_inputs"
        return ""

    def _reevaluate_tool_only(self, record) -> bool:
        rec = record if isinstance(rec := record, dict) else {}
        if self._reevaluate_protection_reason(rec):
            return False
        return self._reevaluate_tool_cue(rec)

    def _reevaluate_worthiness(self, record, core=None):
        """task-34: recompute worthiness from stored inputs/parts + core proxies.

        Returns (worthiness, public_inputs|None, source) or (None, None, None)
        when memory_worthiness_enabled=false. Deterministic, never calls an LLM
        and never writes biological state.
        """
        if not getattr(self, "memory_worthiness_enabled", True):
            return None, None, None
        rec = record if isinstance(record, dict) else {}
        stored = rec.get("worthiness_inputs")
        if isinstance(stored, dict):
            inputs = self._worthiness_inputs_public(stored)
            if core is not None:
                # P1-1: refresh ONLY the K proxies (pad/self/drives/persistence);
                # the archived I/S/C/G/PE/R/P/N must stay exactly as stored.
                _k = self._worth_k_proxies(
                    core, self._worth_num(inputs.get("rel_delta"), 0.0))
                for _key in ("pad_delta", "self_delta", "drives_delta",
                             "persistence"):
                    if _key in _k:
                        inputs[_key] = _k[_key]
            return (memory_meta.compute_worthiness(**inputs),
                    self._worthiness_inputs_public(inputs), "inputs")
        parts = rec.get("worthiness")
        if isinstance(parts, dict) and all(
                key in parts for key in ("I", "S", "C", "G", "PE", "R", "P", "N")):
            k_vals = {"pad_delta": 0.0, "self_delta": 0.0, "rel_delta": 0.0,
                      "drives_delta": 0.0, "persistence": 0.4}
            if core is not None:
                proxies = self._worth_k_proxies(
                    core, self._worth_num(parts.get("R"), 0.0))
                k_vals.update(proxies)
            k_raw = _clip(0.35 * k_vals["pad_delta"] + 0.25 * k_vals["self_delta"]
                          + 0.20 * k_vals["rel_delta"]
                          + 0.20 * k_vals["drives_delta"], 0.0, 1.0)
            k_val = _clip(k_raw * k_vals["persistence"], 0.0, 1.0)
            worth = memory_meta.worthiness_from_parts(
                I=parts.get("I", 0.0), S=parts.get("S", 0.0),
                C=parts.get("C", 0.0), G=parts.get("G", 0.0),
                PE=parts.get("PE", 0.0), R=parts.get("R", 0.0),
                P=parts.get("P", 0.0), N=parts.get("N", 0), K=k_val)
            return worth, None, "parts"
        inputs = self._worthiness_inputs_for(
            rec, core, None, text=str(rec.get("event") or ""),
            title=str(rec.get("title") or ""))
        return (memory_meta.compute_worthiness(**inputs),
                self._worthiness_inputs_public(inputs), "recomputed")

    def _event_worthiness_decision(self, record, core, relationship=None, **kw):
        """Gate wrapper -> (worthiness|None, decision); OFF => legacy memory_point."""
        worth = self._event_worthiness_for(record, core, relationship, **kw)
        if worth is None:
            return None, "memory_point"
        return worth, str(worth.get("decision") or "archive_only")

    @staticmethod
    def _memory_point_snapshot(record) -> dict:
        rec = record if isinstance(record, dict) else {}
        worth = rec.get("worthiness") if isinstance(rec.get("worthiness"), dict) else None
        return {"importance": rec.get("importance", 0.5),
                "user_marked": bool(rec.get("user_marked", False)),
                "title": str(rec.get("title") or "")[:80],
                "small_summary": str(rec.get("small_summary") or "")[:80],
                # task-34: restore must undo a reevaluate downgrade too.
                "memory_point": bool(rec.get("memory_point", True)),
                "worthiness": dict(worth) if worth is not None else None}

    def _apply_memory_point_feedback(self, record, event_id: str,
                                     action: str, body=None) -> bool:
        """Atomic-mutation helper for the feedback API (audit/snapshot kept)."""
        if not isinstance(record, dict):
            return False
        if str(record.get("id") or "") != str(event_id or ""):
            return False
        action = str(action or "").strip().lower()
        data = body if isinstance(body, dict) else {}
        if action not in MEMORY_POINT_FEEDBACK_ACTIONS:
            return False
        if action in ("important", "unimportant") and getattr(
                self, "learning_worthiness_enabled", False):
            try:
                self._learning_worthiness_step(
                    None, str(record.get("session") or record.get("user_id") or "default"),
                    action == "important")
            except Exception:
                pass
        if action == "reevaluate":
            # Handled by _apply_memory_point_reevaluate (needs the verdict).
            return False
        if action == "restore":
            # Prefer the most recent pre-change snapshot: reevaluate_prev (with
            # its ts) over a manual feedback_prev; restore supports both.
            _cands = []
            _hist = record.get("reevaluate_history")
            if isinstance(_hist, list) and _hist and isinstance(_hist[0], dict)                     and isinstance(_hist[0].get("snapshot"), dict):
                _cands.append((float(_hist[0].get("ts") or 0.0),
                               _hist[0]["snapshot"]))
            _re = record.get("reevaluate_prev")
            if isinstance(_re, dict) and isinstance(_re.get("snapshot"), dict):
                _cands.append((float(_re.get("ts") or 0.0), _re["snapshot"]))
            _fb = record.get("feedback_prev")
            if isinstance(_fb, dict):
                _cands.append((float(_fb.get("ts") or 0.0), _fb))
            if not _cands:
                return False
            prev = max(_cands, key=lambda item: item[0])[1]
            for key in ("importance", "user_marked", "title", "small_summary",
                        "memory_point", "worthiness"):
                if key in prev:
                    record[key] = prev[key]
            record.pop("downgraded_by_reevaluate", None)
            if isinstance(_hist, list) and _hist and isinstance(_hist[0], dict):
                record["reevaluate_history"] = _hist[1:]
            else:
                record.pop("reevaluate_prev", None)
            record["reevaluate_restored_ts"] = round(time.time(), 3)
            record["last_feedback_action"] = "restore"
            record["feedback_ts"] = round(time.time(), 3)
            return True
        before = self._memory_point_snapshot(record)
        record["feedback_prev"] = before
        if action == "important":
            base = self._worth_num(record.get("importance"), 0.5)
            record["importance"] = round(min(1.0, base + 0.15), 4)
            record["user_marked"] = True
            record["memory_point"] = True
        elif action == "unimportant":
            record["importance"] = 0.15
            record["user_marked"] = False
        elif action == "edit_label":
            title = re.sub(r"\s+", " ", str(data.get("title") or "")).strip()
            small = str(data.get("small_summary") or "").strip()
            if not title and not small:
                return False
            if title:
                record["title"] = self._mask_if_safety(title)[:80]
            if small:
                record["small_summary"] = self._mask_if_safety(small)[:80]
            elif data.get("small_summary") is not None:
                record["small_summary"] = ""
            record["label_edited"] = True
            record["user_marked"] = True
        history = record.get("feedback_history")
        history = history if isinstance(history, list) else []
        record["feedback_history"] = ([{"action": action,
                                        "ts": round(time.time(), 3),
                                        "before": before}]
                                      + [h for h in history if isinstance(h, dict)])[:20]
        record["last_feedback_action"] = action
        record["feedback_ts"] = round(time.time(), 3)
        return True

    def _apply_memory_point_reevaluate(self, record, event_id: str,
                                       worth: dict, verdict: dict,
                                       inputs=None) -> bool:
        """task-34 atomic mutation: write verdict, downgrade when not a point."""
        if not isinstance(record, dict):
            return False
        if str(record.get("id") or "") != str(event_id or ""):
            return False
        if not isinstance(worth, dict) or not isinstance(verdict, dict):
            return False
        before = self._memory_point_snapshot(record)
        now = round(time.time(), 3)
        # Always keep a dedicated reevaluate snapshot; never overwrite a manual
        # feedback_prev (that one belongs to the user's earlier edit).
        # P1-7: keep the FIRST reevaluate snapshot; append newest to history.
        if not isinstance(record.get("reevaluate_prev"), dict):
            record["reevaluate_prev"] = {"snapshot": dict(before), "ts": now,
                                         "source": "reevaluate"}
        _hist = record.get("reevaluate_history")
        _hist = _hist if isinstance(_hist, list) else []
        record["reevaluate_history"] = (
            [{"snapshot": dict(before), "ts": now}]
            + [x for x in _hist if isinstance(x, dict)])[:5]
        if not isinstance(record.get("feedback_prev"), dict):
            record["feedback_prev"] = dict(before)
        decision = str(verdict.get("decision") or worth.get("decision") or "archive_only")
        record["worthiness"] = dict(worth)
        if isinstance(inputs, dict):
            record["worthiness_inputs"] = dict(inputs)
        record["reevaluate_ts"] = now
        record["reevaluate_verdict"] = {
            "decision": decision,
            "W": worth.get("W", 0.0),
            "W_her": worth.get("W_her", 0.0),
            "K": worth.get("K", 0.0),
            "reasons": list(verdict.get("reasons") or [worth.get("reason") or ""]),
            "ts": now,
        }
        if decision in ("archive_only", "skip"):
            # Downgrade in place: keep the row (no physical delete) so 恢复 works.
            record["memory_point"] = False
            record["importance"] = 0.15
            record["user_marked"] = False
            record["downgraded_by_reevaluate"] = True
        else:
            record["memory_point"] = True
            record["downgraded_by_reevaluate"] = False
        history = record.get("feedback_history")
        history = history if isinstance(history, list) else []
        record["feedback_history"] = ([{"action": "reevaluate", "ts": now,
                                        "before": before, "decision": decision}]
                                      + [h for h in history if isinstance(h, dict)])[:20]
        record["last_feedback_action"] = "reevaluate"
        record["feedback_ts"] = now
        return True

    @staticmethod
    def _parse_memory_point_feedback_request(body):
        data = body if isinstance(body, dict) else {}
        event_id = str(data.get("event_id") or "").strip()
        action = str(data.get("action") or "").strip().lower()
        if not event_id:
            return "", "", "缺少 event_id"
        if action not in MEMORY_POINT_FEEDBACK_ACTIONS:
            return event_id, action, "未知操作"
        return event_id, action, ""

    def _memory_point_public(self, record) -> dict:
        rec = record if isinstance(record, dict) else {}
        worth = rec.get("worthiness") if isinstance(rec.get("worthiness"), dict) else None
        _re_prev = rec.get("reevaluate_prev")
        return {"event_id": str(rec.get("id") or ""),
                "downgraded_by_reevaluate": bool(
                    rec.get("downgraded_by_reevaluate", False)),
                "can_restore": bool(isinstance(rec.get("feedback_prev"), dict)
                                    or isinstance(_re_prev, dict)
                                    or (isinstance(rec.get("reevaluate_history"), list)
                                        and bool(rec.get("reevaluate_history")))),
                "reevaluate_verdict": (dict(rec.get("reevaluate_verdict"))
                                       if isinstance(rec.get("reevaluate_verdict"), dict)
                                       else None),
                "title": str(rec.get("title") or "")[:80],
                "small_summary": str(rec.get("small_summary") or "")[:80],
                "big_summary": str(rec.get("big_summary") or "")[:EVENT_SUMMARY_HARD_MAX],
                "importance": round(self._worth_num(rec.get("importance"), 0.5), 4),
                "user_marked": bool(rec.get("user_marked", False)),
                "memory_point": bool(rec.get("memory_point", True)),
                "label_edited": bool(rec.get("label_edited", False)),
                "last_feedback_action": str(rec.get("last_feedback_action") or "")[:20],
                "worthiness": dict(worth) if worth is not None else None,
                "reevaluate_ts": round(self._worth_num(
                    rec.get("reevaluate_ts"), 0.0, 0.0, 10 ** 12), 3),
                "reevaluate_verdict": (dict(rec.get("reevaluate_verdict"))
                                       if isinstance(rec.get("reevaluate_verdict"), dict)
                                       else None),
                "summary_status": str(rec.get("summary_status") or "legacy"),
                "summary_edited": bool(rec.get("summary_edited", False)),
                "summary_updated_ts": round(self._worth_num(
                    rec.get("summary_updated_ts"), 0.0, 0.0, 10 ** 12), 3)}

    async def _page_memory_point_reevaluate(self, record, event_id: str):
        """task-34: recompute W/W_her/K, downgrade/keep, return record+verdict."""
        if not getattr(self, "memory_worthiness_enabled", True):
            return {"status": "error",
                    "message": "判定关闭（memory_worthiness_enabled=false），未修改记录"}
        core = None
        try:
            cores = getattr(self, "cores", None)
            if isinstance(cores, dict):
                core = cores.get(str(record.get("session") or ""))
        except Exception:
            core = None
        worth, inputs, source = self._reevaluate_worthiness(record, core)
        if not isinstance(worth, dict):
            return {"status": "error",
                    "message": "判定关闭（memory_worthiness_enabled=false），未修改记录"}
        # P0: insufficient evidence or protected/test event => never rewrite.
        _insufficient = self._reevaluate_insufficient_reason(record, worth, source)
        if _insufficient:
            verdict = {"decision": "insufficient_data",
                       "W": worth.get("W", 0.0), "W_her": worth.get("W_her", 0.0),
                       "K": worth.get("K", 0.0), "source": source,
                       "reason": _insufficient,
                       "reasons": [_insufficient]}
            return {"status": "ok",
                    "data": {"record": self._memory_point_public(record),
                             "verdict": verdict, "changed": False,
                             "message": "证据不足，未修改"}}
        _protect = self._reevaluate_protection_reason(record)
        if _protect and str(worth.get("decision") or "") in ("archive_only", "skip")                 and not self._reevaluate_tool_only(record):
            verdict = {"decision": "retained_protected",
                       "W": worth.get("W", 0.0), "W_her": worth.get("W_her", 0.0),
                       "K": worth.get("K", 0.0), "source": source,
                       "reason": _protect, "reasons": [_protect]}
            return {"status": "ok",
                    "data": {"record": self._memory_point_public(record),
                             "verdict": verdict, "changed": False,
                             "message": "关系/自我相关事件，已保留（待人工确认）"}}
        verdict = {"decision": str(worth.get("decision") or "archive_only"),
                   "W": worth.get("W", 0.0),
                   "W_her": worth.get("W_her", 0.0),
                   "K": worth.get("K", 0.0),
                   "reasons": [str(worth.get("reason") or "")],
                   "source": source}
        try:
            changed = self._rewrite_jsonl_atomic(
                EVENT_ARCHIVE_PATH,
                lambda obj: self._apply_memory_point_reevaluate(
                    obj, event_id, worth, verdict, inputs))
        except Exception as exc:
            logger.warning("[biocore] memory point reevaluate failed: %s", exc)
            changed = 0
        if changed <= 0:
            return {"status": "error", "message": "事件不存在或写入失败"}
        try:
            session = str(record.get("session") or "")
            if session:
                self._rewrite_jsonl_atomic(
                    self._event_session_file(session),
                    lambda obj: self._apply_memory_point_reevaluate(
                        obj, event_id, worth, verdict, inputs))
        except Exception:
            pass
        saved = self._find_event_summary_record(event_id) or {}
        return {"status": "ok",
                "data": {"record": self._memory_point_public(saved),
                         "verdict": verdict}}

    async def page_memory_point_feedback(self):
        """POST memory-point feedback: important/unimportant/edit_label/restore/reevaluate."""
        from quart import request
        try:
            body = await request.get_json(silent=True) or {}
        except Exception:
            body = {}
        event_id, action, error = self._parse_memory_point_feedback_request(body)
        if error:
            return {"status": "error", "message": error}
        record = self._find_event_summary_record(event_id)
        if record is None:
            return {"status": "error", "message": "事件不存在"}
        if action == "reevaluate":
            return await self._page_memory_point_reevaluate(record, event_id)
        if action == "edit_label":
            title = str(body.get("title") or "").strip()
            small = str(body.get("small_summary") or "").strip()
            if not title and not small:
                return {"status": "error", "message": "至少提供标题或小标签"}
            if len(title) > 80:
                return {"status": "error", "message": "标题不能超过 80 字"}
            if len(small) > 80:
                return {"status": "error", "message": "小标签不能超过 80 字"}
        if (action == "restore"
                and not isinstance(record.get("feedback_prev"), dict)
                and not isinstance(record.get("reevaluate_prev"), dict)):
            return {"status": "error", "message": "没有可恢复的反馈前版本"}
        try:
            changed = self._rewrite_jsonl_atomic(
                EVENT_ARCHIVE_PATH,
                lambda obj: self._apply_memory_point_feedback(obj, event_id, action, body))
        except Exception as exc:
            logger.warning("[biocore] memory point feedback rewrite failed: %s", exc)
            changed = 0
        if changed <= 0:
            return {"status": "error", "message": "事件不存在或写入失败"}
        # Per-session copy stays in sync (best effort; same atomic rewrite).
        try:
            session = str(record.get("session") or "")
            if session:
                self._rewrite_jsonl_atomic(
                    self._event_session_file(session),
                    lambda obj: self._apply_memory_point_feedback(
                        obj, event_id, action, body))
        except Exception:
            pass
        saved = self._find_event_summary_record(event_id) or {}
        return {"status": "ok", "data": self._memory_point_public(saved)}

    # ---- task-47: regenerate / edit one archived event summary ----
    @staticmethod
    def _parse_event_summary_request(body):
        """Validate an event_summary POST body -> (event_id, action, error)."""
        data = body if isinstance(body, dict) else {}
        event_id = str(data.get("event_id") or "").strip()
        action = str(data.get("action") or "").strip().lower()
        if not event_id:
            return "", "", "缺少 event_id"
        if action not in EVENT_SUMMARY_ACTIONS:
            return event_id, action, "未知操作"
        return event_id, action, ""

    @staticmethod
    def _validate_edited_event_summary(big, small, max_chars: int = 0):
        """Validate a manual summary edit -> (big, small, error)."""
        big_text = str(big or "").strip()
        small_text = str(small or "").strip()
        if not big_text:
            return "", "", "大总结不能为空"
        if len(small_text) > EVENT_SUMMARY_SMALL_MAX:
            return "", "", "小总结不能超过 %d 字" % EVENT_SUMMARY_SMALL_MAX
        try:
            cap = int(max_chars or 0)
        except Exception:
            cap = 0
        limit = EVENT_SUMMARY_HARD_MAX
        if cap > 0:
            limit = min(cap, EVENT_SUMMARY_HARD_MAX)
        return big_text[:limit], small_text, ""

    @staticmethod
    def _validate_edited_event_title(title):
        """Validate a manual event title -> (title, error); 1-80 chars."""
        text = re.sub(r"\s+", " ", str(title or "")).strip()
        if not text:
            return "", "标题不能为空"
        if len(text) > 80:
            return "", "标题不能超过 80 字"
        return text[:80], ""

    @staticmethod
    def _apply_event_summary_fields(record, event_id: str, updates: dict) -> bool:
        """Mutation for _rewrite_jsonl_atomic: touch only the target row."""
        if not isinstance(record, dict) or not isinstance(updates, dict):
            return False
        if str(record.get("id") or "") != str(event_id or ""):
            return False
        record.update(updates)
        return True

    @staticmethod
    def _event_summary_history_source(record) -> str:
        """Where the OLD summary came from: edit / regenerate / legacy."""
        if not isinstance(record, dict):
            return "legacy"
        status = str(record.get("summary_status") or "legacy").strip().lower()
        if record.get("summary_edited") is True or status == "edited":
            return "edit"
        if not status or status == "legacy":
            return "legacy"
        return "regenerate"

    def _event_summary_history_entry(self, record) -> dict:
        rec = record if isinstance(record, dict) else {}
        try:
            ts = float(rec.get("summary_updated_ts") or rec.get("ts") or time.time())
        except Exception:
            ts = time.time()
        status = str(rec.get("summary_status") or "legacy").strip().lower() or "legacy"
        return {"ts": ts,
                "title": str(rec.get("title") or "")[:80],
                "summary_status": status,
                "big_summary": str(rec.get("big_summary") or "")[:EVENT_SUMMARY_HARD_MAX],
                "small_summary": str(rec.get("small_summary") or "")[:EVENT_SUMMARY_SMALL_MAX],
                "source": self._event_summary_history_source(rec)}

    def _apply_event_summary_with_history(self, record, event_id: str, updates: dict) -> bool:
        """Mutation for the atomic rewrite: archive the old summary, then update.

        Keeps the newest 20 versions (newest first) so regenerating/editing never
        loses what the panel used to show.
        """
        if not isinstance(record, dict) or not isinstance(updates, dict):
            return False
        if str(record.get("id") or "") != str(event_id or ""):
            return False
        old_big = str(record.get("big_summary") or "").strip()
        old_small = str(record.get("small_summary") or "").strip()
        if old_big or old_small:
            entry = self._event_summary_history_entry(record)
            history = record.get("summary_history")
            if not isinstance(history, list):
                history = []
            kept = [h for h in history if isinstance(h, dict)]
            record["summary_history"] = [entry] + kept
            record["summary_history"] = record["summary_history"][:EVENT_SUMMARY_HISTORY_MAX]
        elif "summary_history" in record and not isinstance(record.get("summary_history"), list):
            record["summary_history"] = []
        record.update(updates)
        return True

    def _find_event_summary_record(self, event_id: str):
        try:
            target = str(event_id or "").strip()
            if not target or not EVENT_ARCHIVE_PATH.exists():
                return None
            for line in EVENT_ARCHIVE_PATH.read_text(encoding="utf-8").splitlines():
                if not line.strip():
                    continue
                try:
                    row = json.loads(line)
                except Exception:
                    continue
                if isinstance(row, dict) and str(row.get("id") or "") == target:
                    return row
        except Exception as exc:
            logger.warning("[biocore] event summary lookup failed: %s", exc)
        return None

    @staticmethod
    def _event_summary_source_texts(record) -> list:
        try:
            source = [str(t or "").strip() for t in (record.get("source_texts") or [])
                      if str(t or "").strip()]
            if source:
                return source[:12]
        except Exception:
            pass
        out = []
        for value in (record.get("event"), record.get("central_details"),
                      record.get("title")):
            text = str(value or "").strip()
            if text:
                out.append(text)
        return out[:12]

    async def _regenerate_event_summary_fields(self, record) -> dict:
        """Regenerate big/small: LLM when enabled+available, else bounded fallback."""
        record = record if isinstance(record, dict) else {}
        title = str(record.get("title") or "").strip()
        texts = self._event_summary_source_texts(record)
        source_text = "\n".join(texts) if texts else str(record.get("event") or "")
        now = time.time()
        big = small = ""
        new_title = ""
        nuance = []
        summary_layers = []
        status = "fallback"
        llm_ok = False
        try:
            if self._llm_allowed("event_summary"):
                provider = await self._provider_for("event_summary", None)
                if provider is not None:
                    prompt = interpretation.event_summary_prompt(texts or [source_text])
                    resp = await self._bg_llm_direct(
                        "event_summary", provider, prompt,
                        timeout_ms=getattr(self, "summary_llm_timeout_ms", 8000))
                    raw = str(getattr(resp, "completion_text", "") or "").strip()
                    data = interpretation.parse_event_summary(
                        raw, getattr(self, "summary_max_chars", 0))
                    llm_big = str(data.get("big_summary") or "").strip()
                    llm_small = str(data.get("small_summary") or "").strip()
                    llm_title = interpretation.clean_event_title(
                        data.get("title"), 80)
                    if llm_big or llm_small:
                        try:
                            cap = int(getattr(self, "summary_max_chars", 0) or 0)
                        except Exception:
                            cap = 0
                        limit = EVENT_SUMMARY_HARD_MAX
                        if cap > 0:
                            limit = min(cap, EVENT_SUMMARY_HARD_MAX)
                        big = self._mask_if_safety(str(llm_big or llm_small))[:limit]
                        small = self._mask_if_safety(
                            str(llm_small or llm_big))[:EVENT_SUMMARY_SMALL_MAX]
                        if llm_title:
                            new_title = llm_title[:80]
                        nuance = interpretation.clean_emotion_nuance(
                            data.get("emotion_nuance"))
                        summary_layers = interpretation.clean_emotion_layers(
                            data.get("emotion_layers"))
                        llm_ok = True
        except Exception as exc:
            logger.warning("[biocore] event summary regenerate via LLM failed: %s", exc)
            llm_ok = False
        if not llm_ok:
            big, small = self._dual_event_summary_fallback(source_text, title)
            status = "fallback"
            nuance = []   # deterministic fallback never fabricates a nuance layer
            summary_layers = []
            self._record_llm_telemetry("event_summary", "fallback")
        else:
            status = "llm"
        if not new_title:
            # deterministic title: cleaned first sentence -> meaning -> old title
            new_title = (interpretation.clean_event_title(source_text)
                         or interpretation.clean_event_title(record.get("meaning_to_her"))
                         or interpretation.clean_event_title(title)
                         or "对话事件")
        updates = {"title": str(new_title or "对话事件")[:80],
                   "big_summary": str(big or "")[:EVENT_SUMMARY_HARD_MAX],
                   "small_summary": str(small or "")[:EVENT_SUMMARY_SMALL_MAX],
                   "emotion_nuance": interpretation.clean_emotion_nuance(nuance),
                   "summary_status": status,
                   "summary_edited": False,
                   "summary_updated_ts": now}
        # task-68 correction: emotion proportions come from the summary itself
        # (normalized p, including the primary emotion). No fixed 50/30/20
        # weights and no fabrication: no layers in the output -> keep the old
        # value (possibly null) untouched.
        if summary_layers:
            updates["emotion_layers"] = summary_layers
            updates["emotion_layers_source"] = "summary"
        return updates

    async def page_event_summary(self):
        """Regenerate (LLM/fallback) or manually edit one archived event summary."""
        from quart import request
        try:
            body = await request.get_json(silent=True) or {}
        except Exception:
            body = {}
        event_id, action, error = self._parse_event_summary_request(body)
        if error:
            return {"status": "error", "message": error}
        record = self._find_event_summary_record(event_id)
        if record is None:
            return {"status": "error", "message": "事件不存在"}
        try:
            if action == "regenerate":
                updates = await self._regenerate_event_summary_fields(record)
            else:
                big, small, error = self._validate_edited_event_summary(
                    body.get("big_summary"), body.get("small_summary"),
                    getattr(self, "summary_max_chars", 0))
                if error:
                    return {"status": "error", "message": error}
                updates = {"big_summary": big, "small_summary": small,
                           "summary_status": "edited", "summary_edited": True,
                           "summary_updated_ts": time.time()}
                if body.get("title") is not None:
                    checked_title, title_error = self._validate_edited_event_title(
                        body.get("title"))
                    if title_error:
                        return {"status": "error", "message": title_error}
                    updates["title"] = checked_title
        except Exception as exc:
            logger.warning("[biocore] event summary %s failed: %s", action, exc)
            return {"status": "error", "message": "处理失败"}
        # task-51: a regenerate fills a missing secondary emotion from the live
        # core spectrum (primary excluded). update never rewrites it; no core
        # data keeps the field empty instead of fabricating one.
        if action == "regenerate" and not str(record.get("emotion_secondary") or "").strip():
            _secondary = self._event_secondary_for_record(record)
            if _secondary:
                updates["emotion_secondary"] = _secondary
        try:
            changed = self._rewrite_jsonl_atomic(
                EVENT_ARCHIVE_PATH,
                lambda obj: self._apply_event_summary_with_history(obj, event_id, updates))
        except Exception as exc:
            logger.warning("[biocore] event summary rewrite failed: %s", exc)
            changed = 0
        if changed <= 0:
            return {"status": "error", "message": "事件不存在或写入失败"}
        saved = self._find_event_summary_record(event_id) or {}
        history = saved.get("summary_history")
        payload = dict({"event_id": event_id, "action": action}, **updates)
        if "emotion_secondary" not in payload and str(saved.get("emotion_secondary") or "").strip():
            payload["emotion_secondary"] = str(saved.get("emotion_secondary") or "").strip()
        if isinstance(saved.get("emotion_nuance"), list):
            payload["emotion_nuance"] = list(saved.get("emotion_nuance") or [])[:3]
        if isinstance(saved.get("emotion_layers"), list):
            payload["emotion_layers"] = [dict(x) for x in (saved.get("emotion_layers") or [])[:4]
                                         if isinstance(x, dict)]
        try:
            payload["emotion_intensity"] = round(
                float(saved.get("emotion_intensity", 0.0) or 0.0), 4)
        except Exception:
            pass
        if str(saved.get("emotion_layers_source") or "").strip():
            payload["emotion_layers_source"] = str(
                saved.get("emotion_layers_source") or "").strip()
        payload["summary_history"] = history if isinstance(history, list) else []
        return {"status": "ok", "data": payload}

    def _event_pair_duplicate(self, row, prev,
                              window: float = EVENT_DEDUPE_CLEANUP_WINDOW) -> bool:
        """Multi-signal duplicate test for two rows of one canonical session.

        The two real rows from the ":"/"_" key generations share the same
        original conversation but their archive timestamps can be days apart,
        so the comparison uses the real event time (time_span) and accepts a
        merge when source texts overlap strongly or the summaries/titles are
        near-identical. False positives are limited by requiring the text
        signals, not just the canonical session.
        """
        try:
            gap = abs(event_effective_time(row) - event_effective_time(prev))
        except Exception:
            gap = 0.0
        if gap > window:
            return False
        try:
            title_sim = self._text_similarity(str(row.get("title") or ""),
                                              str(prev.get("title") or ""))
            body_sim = self._text_similarity(str(row.get("event") or ""),
                                             str(prev.get("event") or ""))
            summary_sim = max(
                self._text_similarity(str(row.get("big_summary") or ""),
                                      str(prev.get("big_summary") or "")),
                self._text_similarity(str(row.get("small_summary") or ""),
                                      str(prev.get("small_summary") or "")))
            left = {str(x) for x in (row.get("source_texts") or []) if str(x)}
            right = {str(x) for x in (prev.get("source_texts") or []) if str(x)}
            source_overlap = (len(left & right) / float(len(left | right))
                              if (left and right) else 0.0)
        except Exception:
            return False
        if source_overlap >= 0.5:
            return True
        if body_sim >= 0.6:
            return True
        if summary_sim >= 0.5 and (source_overlap >= 0.2 or title_sim >= 0.25
                                   or body_sim >= 0.3):
            return True
        if title_sim >= 0.5 and body_sim >= 0.2:
            return True
        return False

    @staticmethod
    def _drop_ids_from_jsonl(path, ids) -> int:
        """Remove rows with the given ids from a JSONL file atomically."""
        try:
            target = Path(path)
            drop = {str(x) for x in (ids or []) if str(x)}
            if not drop or not target.exists():
                return 0
            kept = []
            dropped = 0
            for line in target.read_text(encoding="utf-8").splitlines():
                if not line.strip():
                    continue
                try:
                    obj = json.loads(line)
                except Exception:
                    kept.append(line)
                    continue
                if isinstance(obj, dict) and str(obj.get("id") or "") in drop:
                    dropped += 1
                    continue
                kept.append(json.dumps(obj, ensure_ascii=False))
            if not dropped:
                return 0
            tmp = target.with_name(target.name + ".tmp_%s_%s" % (
                os.getpid(), int(time.time() * 1000)))
            tmp.write_text("\n".join(kept) + ("\n" if kept else ""), encoding="utf-8")
            os.replace(tmp, target)
            return dropped
        except Exception:
            return 0

    def _cleanup_duplicate_events(self, force: bool = False) -> int:
        """One-time cross-key duplicate cleanup for events.jsonl (task-56).

        Canonical sessions unify ":"/"_" key generations. Rows of one real
        conversation are grouped by canonical session + real event time
        (time_span) + text signals (source_texts/title/summary/body); the
        richer/newer row is kept and the poorer row is merged into it
        (source_texts union, importance/centrality/recall maxima, provenance,
        summary_history). Group sessions -- including the 664198103 test group
        -- and unrelated rows are never touched. The global archive and every
        affected per-session archive are rewritten atomically; each merge is
        appended to dedupe_log.jsonl and a marker keeps the migration
        idempotent.
        """
        try:
            EVENT_ARCHIVE_DIR.mkdir(parents=True, exist_ok=True)
            marker = EVENT_ARCHIVE_DIR / "dedupe_v1.done"
            if not force and marker.exists():
                return 0
            if not EVENT_ARCHIVE_PATH.exists():
                return 0
            rows, raw_keep = [], []
            for line in EVENT_ARCHIVE_PATH.read_text(encoding="utf-8").splitlines():
                if not line.strip():
                    continue
                try:
                    obj = json.loads(line)
                except Exception:
                    raw_keep.append(line)
                    continue
                (rows if isinstance(obj, dict) else raw_keep).append(obj)
        except Exception:
            return 0

        def _score(row):
            status = str(row.get("summary_status") or "").lower()
            score = {"llm": 2.0, "edited": 1.5, "fallback": 0.5}.get(status, 0.0)
            try:
                score += float(row.get("importance", 0) or 0) * 0.5
            except Exception:
                pass
            if isinstance(row.get("summary_history"), list) and row.get("summary_history"):
                score += 0.20
            if row.get("event_embedding"):
                score += 0.10
            if isinstance(row.get("time_span"), dict):
                score += 0.10
            try:
                score += float(row.get("summary_updated_ts", 0) or 0) * 1e-9
            except Exception:
                pass
            try:
                score += float(row.get("ts", 0) or 0) * 1e-10
            except Exception:
                pass
            return score

        def _merge_into(rich, poor):
            try:
                src = [str(x) for x in (rich.get("source_texts") or []) if str(x)]
                for text in [str(x) for x in (poor.get("source_texts") or []) if str(x)]:
                    if text not in src:
                        src.append(text)
                rich["source_texts"] = src[-24:]
            except Exception:
                pass
            for key in ("importance", "centrality", "recall_count", "strength",
                        "confidence", "source_count", "last_recall"):
                try:
                    rich[key] = max(float(rich.get(key, 0) or 0),
                                    float(poor.get(key, 0) or 0))
                except Exception:
                    continue
            try:
                hist = []
                for item in (list(poor.get("summary_history") or [])
                             + list(rich.get("summary_history") or [])):
                    if isinstance(item, dict) and item not in hist:
                        hist.append(item)
                if hist:
                    rich["summary_history"] = hist[:EVENT_SUMMARY_HISTORY_MAX]
            except Exception:
                pass
            try:
                merged = [str(x) for x in (rich.get("merged_event_keys") or [])]
                for item in (poor.get("merged_event_keys") or []):
                    if str(item) and str(item) not in merged:
                        merged.append(str(item))
                poor_key = str(poor.get("event_key") or "")
                if poor_key and poor_key not in merged:
                    merged.append(poor_key)
                if merged:
                    rich["merged_event_keys"] = merged[:12]
            except Exception:
                pass
            try:
                prov = dict(rich.get("provenance") or {})
                sources = [x for x in (prov.get("sources") or [])
                           if isinstance(x, dict)][-24:]
                for item in ((poor.get("provenance") or {}).get("sources") or []):
                    if isinstance(item, dict) and item not in sources:
                        sources.append(item)
                prov["sources"] = sources[-24:]
                refs = [str(x) for x in (prov.get("message_refs") or []) if str(x)]
                for ref in ((poor.get("provenance") or {}).get("message_refs") or []):
                    ref = str(ref or "")
                    if ref and ref not in refs:
                        refs.append(ref)
                if refs:
                    prov["message_refs"] = refs[:12]
                rich["provenance"] = prov
            except Exception:
                pass
            try:
                rich["merge_count"] = int(rich.get("merge_count", 0) or 0) + 1
                merged_from = [str(x) for x in (rich.get("merged_from") or [])]
                poor_id = str(poor.get("id") or "")
                if poor_id and poor_id not in merged_from:
                    merged_from.append(poor_id)
                if merged_from:
                    rich["merged_from"] = merged_from[-8:]
            except Exception:
                pass

        kept, dropped_ids, dropped_sessions, log_rows = [], set(), set(), []
        for row in rows:
            session = canonical_session_key(row.get("session"))
            row_id = str(row.get("id") or "")
            if not session or not row_id:
                kept.append(row)
                continue
            # Requirement: group events (the 664198103 test group and other
            # group chats) are out of scope for this private-session migration.
            if ":GroupMessage:" in session or ":GuildMessage:" in session:
                kept.append(row)
                continue
            current = None
            for prev in kept:
                if canonical_session_key(prev.get("session")) != session:
                    continue
                if self._event_pair_duplicate(row, prev):
                    current = prev
                    break
            if current is None:
                kept.append(row)
                continue
            keep_new = _score(row) > _score(current)
            rich = row if keep_new else current
            poor = current if keep_new else row
            rich_id = str(rich.get("id") or "")
            poor_id = str(poor.get("id") or "")
            if not rich_id or not poor_id:
                kept.append(row)
                continue
            try:
                gap_seconds = round(abs(event_effective_time(rich)
                                        - event_effective_time(poor)), 3)
            except Exception:
                gap_seconds = 0.0
            _merge_into(rich, poor)
            if keep_new:
                try:
                    kept[kept.index(current)] = row
                except Exception:
                    kept.append(row)
            dropped_ids.add(poor_id)
            dropped_sessions.add(canonical_session_key(poor.get("session")))
            log_rows.append({
                "ts": round(time.time(), 3),
                "action": "dedupe_merge",
                "reason": "canonical_cross_key_duplicate",
                "session": session,
                "kept_id": rich_id,
                "kept_title": str(rich.get("title") or "")[:80],
                "dropped_id": poor_id,
                "dropped_title": str(poor.get("title") or "")[:80],
                "dropped_sessions": sorted({str(poor.get("session") or ""),
                                            str(rich.get("session") or "")}),
                "gap_seconds": gap_seconds,
                "merged_importance": rich.get("importance"),
                "merged_source_texts": len(rich.get("source_texts") or []),
            })
        if not dropped_ids:
            try:
                marker.write_text(str(time.time()), encoding="utf-8")
            except Exception:
                pass
            return 0
        removed = 0
        try:
            out = [json.dumps(r, ensure_ascii=False) for r in rows
                   if str(r.get("id") or "") not in dropped_ids]
            out += raw_keep
            tmp = EVENT_ARCHIVE_PATH.with_name(
                EVENT_ARCHIVE_PATH.name + ".tmp_%s_%s" % (
                    os.getpid(), int(time.time() * 1000)))
            tmp.write_text("\n".join(out) + ("\n" if out else ""), encoding="utf-8")
            os.replace(tmp, EVENT_ARCHIVE_PATH)
            removed = len(dropped_ids)
        except Exception as exc:
            logger.warning("[biocore] dedupe global rewrite failed: %s", exc)
            return 0
        # ":" and "_" variants sanitize to the same per-session file name.
        for session in dropped_sessions:
            if not session:
                continue
            try:
                safe = "".join(c if c.isalnum() or c in "-_" else "_"
                               for c in session)[:80]
                self._drop_ids_from_jsonl(EVENT_SESSION_DIR / safe / "events.jsonl",
                                          dropped_ids)
            except Exception:
                continue
        try:
            with open(EVENT_ARCHIVE_DIR / "dedupe_log.jsonl", "a",
                      encoding="utf-8") as log:
                for entry in log_rows:
                    log.write(json.dumps(entry, ensure_ascii=False) + "\n")
        except Exception:
            pass
        try:
            marker.write_text(str(time.time()), encoding="utf-8")
        except Exception:
            pass
        logger.info("[biocore] canonical duplicate cleanup removed %s event(s)",
                    removed)
        return removed

    def _decayed_merge_count(self, event) -> int:
        """G11: merge_count decays on the same schedule as peripheral forgetting."""
        try:
            count = int(event.get("merge_count", 0) or 0)
            if count <= 0:
                return 0
            ts = float(event.get("ts", 0) or 0)
            if ts <= 0:
                return count
            age_days = max(0.0, (time.time() - ts) / 86400.0)
            decay = memory_meta.time_decay(age_days)
            return max(0, int(round(count * decay)))
        except Exception:
            return 0

    def _persist_peripheral_forgetting(self, events) -> None:
        """Persist periphery forgetting to both archive layers.

        The returned view already hides forgotten details; this keeps the
        global events.jsonl and archives/sessions/<session>/events.jsonl in
        sync through atomic rewrites instead of append-only drift. G11: the
        event merge_count is decayed (30-day half-life) in the same rewrite.
        """
        try:
            targets = [d for d in (events or []) if isinstance(d, dict)]
            if not targets:
                return

            def _mutate(obj):
                for target in targets:
                    if not self._same_archive_event(obj, target):
                        continue
                    obj["merge_count"] = self._decayed_merge_count(obj)
                    obj["peripheral_details"] = ""
                    obj["peripheral_retention"] = min(
                        float(obj.get("peripheral_retention", 1.0) or 1.0), 0.05)
                    obj["peripheral_forgotten"] = True
                    return True
                return False

            self._rewrite_jsonl_atomic(EVENT_ARCHIVE_PATH, _mutate)
            seen = set()
            for target in targets:
                _sess = str(target.get("session") or "default")
                _safe = "".join(c if c.isalnum() or c in "-_" else "_" for c in _sess)[:80]
                if _safe in seen:
                    continue
                seen.add(_safe)
                self._rewrite_jsonl_atomic(EVENT_SESSION_DIR / _safe / "events.jsonl", _mutate)
        except Exception as exc:
            logger.warning("[biocore] peripheral forgetting persist failed: %s", exc)

    def _bump_event_recall(self, ids) -> None:
        try:
            if not EVENT_ARCHIVE_PATH.exists() or not ids:
                return
            wanted = set(ids)
            rows = []
            for line in EVENT_ARCHIVE_PATH.read_text(encoding="utf-8").splitlines():
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                if isinstance(d, dict) and d.get("id") in wanted:
                    d["recall_count"] = int(d.get("recall_count", 0) or 0) + 1
                    d["last_recall"] = time.time()
                rows.append(d)
            EVENT_ARCHIVE_PATH.write_text(
                "\n".join(json.dumps(r, ensure_ascii=False) for r in rows) + "\n",
                encoding="utf-8")
        except Exception:
            pass

    def _event_context(self, event) -> str:
        events = self._event_archive(9)
        if not events:
            return ""
        events = sorted(events, key=lambda e: float(e.get("importance", 0.0) or 0.0) *
                        (0.5 + 0.5 * float(e.get("centrality", 0.5) or 0.5)), reverse=True)[:3]
        lines = []
        for ev in events:
            title = str(ev.get("title") or "").strip()
            body = str(ev.get("central_details") or ev.get("event") or "").strip()
            meaning = str(ev.get("meaning_to_her") or "").strip()
            reflection = str(ev.get("reflection") or "").strip()
            if body:
                lines.append("- %s：%s%s%s" % (
                    title or "事件", body,
                    ("；意义：" + meaning) if meaning else "",
                    ("；反思：" + reflection) if reflection else ""))
        if not lines:
            return ""
        self._bump_event_recall([str(e.get("id") or "") for e in events])
        return "\n".join(lines)

    def _insights(self, limit: int = 5) -> list:
        try:
            if not INSIGHT_ARCHIVE_PATH.exists():
                return []
            out = []
            for line in INSIGHT_ARCHIVE_PATH.read_text(encoding="utf-8").splitlines()[-limit * 2:]:
                try:
                    d = json.loads(line)
                    if isinstance(d, dict):
                        try:
                            _age_days = (time.time() - float(d.get("ts", 0) or 0)) / 86400.0
                            _central = float(d.get("centrality", 0.5) or 0.5)
                            if _age_days > (14.0 - 10.0 * _central):
                                d["peripheral_details"] = ""
                                d["peripheral_retention"] = min(float(d.get("peripheral_retention", 1.0) or 1.0), 0.05)
                                d["peripheral_forgotten"] = True
                        except Exception:
                            pass
                        out.append(d)
                except Exception:
                    continue
            return out[-limit:][::-1]
        except Exception:
            return []

    def _append_insight(self, record: dict) -> None:
        try:
            EVENT_ARCHIVE_DIR.mkdir(parents=True, exist_ok=True)
            with open(INSIGHT_ARCHIVE_PATH, "a", encoding="utf-8") as f:
                f.write(json.dumps(record, ensure_ascii=False) + "\n")
        except Exception:
            pass

    def _insight_state_path(self):
        try:
            DATA_DIR.mkdir(parents=True, exist_ok=True)
        except Exception:
            pass
        return DATA_DIR / "insight_trigger.json"

    def _load_insight_state(self) -> dict:
        try:
            path = self._insight_state_path()
            if path.exists():
                data = json.loads(path.read_text(encoding="utf-8"))
                if isinstance(data, dict):
                    return data
        except Exception:
            pass
        return {"last_run_ts": 0.0, "last_event_ts": 0.0, "seen_ids": []}

    def _save_insight_state(self, state: dict) -> None:
        try:
            self._insight_state_path().write_text(
                json.dumps(state, ensure_ascii=False, indent=1), encoding="utf-8")
        except Exception as exc:
            logger.warning("[biocore] insight trigger state save failed: %s", exc)

    def _insight_trigger_decision(self, state: dict, events: list, now: float | None = None) -> dict:
        """Decide whether the unified insight entry should fire.

        Rules:
        - dedupe by event id + event ts (only events newer than last_event_ts count);
        - >= insight_min_new_events (default 3) new important events
          (importance >= 0.6) AND cooldown >= insight_cooldown_minutes (default 60);
        - 24h ultra-long fallback can fire with at least 1 new important event.
        """
        current = time.time() if now is None else float(now)
        st = state if isinstance(state, dict) else {}
        try:
            last_run = float(st.get("last_run_ts", 0.0) or 0.0)
        except Exception:
            last_run = 0.0
        try:
            last_event_ts = float(st.get("last_event_ts", 0.0) or 0.0)
        except Exception:
            last_event_ts = 0.0
        seen = st.get("seen_ids") if isinstance(st.get("seen_ids"), list) else []
        seen_set = {str(x) for x in seen}
        new_events = []
        for ev in (events or []):
            if not isinstance(ev, dict):
                continue
            try:
                imp = float(ev.get("importance", 0) or 0)
            except Exception:
                imp = 0.0
            if imp < 0.6:
                continue
            eid = str(ev.get("id") or "")
            try:
                ets = float(ev.get("ts", 0) or 0)
            except Exception:
                ets = 0.0
            if eid and eid in seen_set:
                continue
            if ets and ets <= last_event_ts:
                continue
            new_events.append(ev)
        count = len(new_events)
        elapsed = current - last_run if last_run > 0 else None
        _min_new = max(1, int(getattr(self, "_insight_min_new_events",
                                      INSIGHT_MIN_NEW_EVENTS) or INSIGHT_MIN_NEW_EVENTS))
        _cooldown_s = max(60, int(getattr(self, "_insight_cooldown_minutes",
                                          INSIGHT_COOLDOWN_SECONDS // 60)
                                  or (INSIGHT_COOLDOWN_SECONDS // 60)) * 60)
        cooldown_ok = (last_run <= 0) or (elapsed is not None and elapsed >= _cooldown_s)
        fallback_ok = (last_run > 0 and elapsed is not None and
                       elapsed >= self._insight_fallback_hours * 3600)
        ready = (count >= _min_new and cooldown_ok) or (count >= 1 and fallback_ok)
        return {"ready": bool(ready), "new_count": count,
                "new_events": new_events,
                "last_run_ts": last_run, "last_event_ts": last_event_ts}

    async def _maybe_archive_insight(self, event, core, trigger: str = "event_archive"):
        """Automatic long-term insight entry (compression / event archive).

        Only runs when the opt-in auto switch is ON *and* the insight LLM
        switch is ON. There is no silent deterministic fallback: with either
        switch off nothing is written in the background.
        """
        if not bool(getattr(self, "insight_auto_enabled", False)):
            return False
        if not self._llm_allowed("insight"):
            return False
        try:
            state = self._load_insight_state()
            events = self._event_archive(50)
            decision = self._insight_trigger_decision(state, events)
            if not decision["ready"]:
                logger.info("[biocore] insight trigger skipped (%s): new=%s cooldown/fallback not met",
                            trigger, decision["new_count"])
                return False
            new_events = decision["new_events"]
            # BUG-05: _event_archive returns newest-first; use [:6], not [-6:].
            recent = (events[:6] if len(events) >= 3 else new_events[:6])
            ok = await self._generate_insight(event, core, recent)
            if not ok:
                logger.info("[biocore] insight trigger produced nothing (%s); state not advanced", trigger)
                return False
            now = time.time()
            latest_ts = max([decision["last_event_ts"]] +
                            [float(e.get("ts", 0) or 0) for e in events] or [0.0])
            seen = [str(e.get("id") or "") for e in events if str(e.get("id") or "")]
            self._save_insight_state({
                "last_run_ts": now,
                "last_event_ts": latest_ts,
                "seen_ids": seen[-100:],
            })
            logger.info("[biocore] insight triggered (%s): new=%s events=%s",
                        trigger, decision["new_count"], len(recent))
            return True
        except Exception as exc:
            logger.warning("[biocore] insight trigger failed: %s", exc)
            return False

    async def _generate_insight(self, event, core, events):
        """Generate one long-term pattern insight from the given events.

        LLM-only: when the insight switch is off this returns False and writes
        nothing (no silent deterministic note in the background).
        """
        try:
            events = [e for e in (events or []) if isinstance(e, dict)]
            if not events:
                return False
            if not self._llm_allowed("insight"):
                return False
            provider = await self._provider_for("insight", event)
            if provider is None:
                return False
            prompt = interpretation.insight_prompt(events[:6])
            resp = await self._bg_llm_direct(
                "insight", provider, prompt,
                timeout_ms=getattr(self, "summary_llm_timeout_ms", 8000))
            raw = str(getattr(resp, "completion_text", "") or "").strip()
            insight = interpretation.parse_insight(raw)
            if not insight:
                return False
            self._append_insight({
                "ts": time.time(), "insight": insight,
                "emotion": str(getattr(core, "labels", {}).get("emotion") or "neutral") if core else "neutral",
            })
            try:
                if core is not None:
                    tree = getattr(core, "reflection_tree", None)
                    if not isinstance(tree, dict):
                        tree = {"roots": [], "count": 0}
                    node = {"ts": time.time(), "insight": insight,
                            "emotion": str(getattr(core, "labels", {}).get("emotion") or "neutral"),
                            "children": []}
                    roots = tree.get("roots") or []
                    if roots:
                        roots[-1].setdefault("children", []).append(node)
                    else:
                        roots.append(node)
                    tree["roots"] = roots[-10:]
                    tree["count"] = int(tree.get("count", 0)) + 1
                    core.reflection_tree = tree
                    core.integrate_noise("reflection", attention=0.006, valence=0.003)
            except Exception:
                pass
            logger.info("[biocore] long-term insight archived")
            return True
        except Exception as exc:
            logger.warning("[biocore] insight generation failed: %s", exc)
            return False

    async def _archive_cross_event_insight(self, event, core):
        """Compatibility wrapper for direct callers: uses the last 6 events."""
        events = self._event_archive(6)
        if len(events) < 3:
            return
        await self._generate_insight(event, core, events[:6])

    def _segment_event_texts(self, entries) -> list:
        try:
            rows = []
            for e in entries:
                txt = str(e.get("text", "")).strip()
                cap = str(e.get("image_caption", "") or "").strip()
                if cap:
                    txt = (txt + "\n[图片内容] " + cap).strip() if txt else ("[图片内容] " + cap)
                if txt:
                    rows.append((float(e.get("ts", 0) or 0), txt, e))
            rows.sort(key=lambda x: x[0])
        except Exception:
            return []
        segments = []
        current = []
        last = None
        for ts, txt, e in rows:
            _changed = False
            if current:
                try:
                    _changed = self._text_similarity(str(current[-1][0]), str(txt)) < 0.045 and len(str(txt)) > 8
                except Exception:
                    _changed = False
            if last is not None and ((ts - last > 1800) or _changed) and current:
                segments.append(current)
                current = []
            current.append((txt, e))
            last = ts
        if current:
            segments.append(current)
        out = []
        for seg in segments[-3:]:
            out.append([x[0] for x in seg])
        return out

    def _append_event_archive(self, record: dict) -> None:
        try:
            EVENT_ARCHIVE_DIR.mkdir(parents=True, exist_ok=True)
            if isinstance(record, dict):
                _raw_key = str(record.get("event_key") or record.get("title") or "")
                _norm_key = self._normalize_event_key(_raw_key, str(record.get("title") or ""))
                if _norm_key:
                    record["event_key"] = _norm_key
                # Batch5 H2-1: <=3 event-event edges (time proximity 1800s +
                # causal words), Radvansky & Zacks 2014; Trabasso 1985.
                if getattr(self, "memory_chain_enabled", False):
                    try:
                        _sess = str(record.get("session") or "default")
                        _recent = self._recent_session_events(_sess, 3)
                        _text = " ".join(str(record.get(k) or "") for k in
                                         ("title", "event", "big_summary"))
                        _causal = any(w in _text for w in
                                      ("因为", "所以", "导致", "于是", "结果", "因此", "然后", "后来"))
                        _rts = float(record.get("ts", 0) or 0)
                        _links = []
                        for _prev in _recent[-3:]:
                            if not isinstance(_prev, dict) or not _prev.get("id"):
                                continue
                            _gap = abs(_rts - float(_prev.get("ts", 0) or 0))
                            if _gap > 1800.0:
                                continue
                            _w = 1.0 if _causal else max(0.5, 1.0 - 0.5 * _gap / 1800.0)
                            _links.append({"id": str(_prev["id"]), "weight": round(_w, 3),
                                           "ts": _rts, "kind": "causal" if _causal else "temporal"})
                            if len(_links) >= 3:
                                break
                        if _links:
                            record["chain_links"] = _links
                    except Exception:
                        pass
            line = json.dumps(record, ensure_ascii=False)
            with open(EVENT_ARCHIVE_PATH, "a", encoding="utf-8") as f:
                f.write(line + "\n")
            _sess = str(record.get("session") or "default")
            _safe = "".join(c if c.isalnum() or c in "-_" else "_" for c in _sess)[:80]
            _dir = EVENT_SESSION_DIR / _safe
            _dir.mkdir(parents=True, exist_ok=True)
            with open(_dir / "events.jsonl", "a", encoding="utf-8") as f:
                f.write(line + "\n")
        except Exception as exc:
            logger.warning("[biocore] event archive failed: %s", exc)

    def _chain_event_lines(self, session: str, query: str, limit: int = 2) -> list:
        """H2-1 read path: decayed event-chain expansion (default OFF).

        Only called when memory_chain_enabled. Seeds = same-session event with
        the highest character overlap with the query; follows its chain_links
        (hop<=1), applies 30-day decay, returns <=limit lines (no avalanche).
        """
        if not getattr(self, "memory_chain_enabled", False):
            return []
        try:
            events = [e for e in self._event_archive(100) if isinstance(e, dict)]
            sess = str(session or "")
            same = [e for e in events if str(e.get("session") or "default") == sess]
            if not same:
                return []
            q = set(str(query or ""))
            def _overlap(e):
                txt = str(e.get("title") or "") + " " + str(e.get("big_summary") or "")
                return len(q & set(txt))
            same.sort(key=lambda e: (-_overlap(e), -float(e.get("ts", 0) or 0)))
            seed = same[0]
            # task-35 H2-3: bounded multi-hop expansion (default OFF; hop<=2,
            # fan<=3, decay .5, new<=6). Off => the legacy 1-hop path below.
            if getattr(self, "memory_chain_multihop", False):
                try:
                    # activation decays 0.5/hop; min_weight 0.2 keeps hop-2
                    # reachable while hop-3 still fails (hop_limit=2).
                    # chain_expand consumes memory-entry "links"; archived events
                    # store the same edges as "chain_links", so map them here.
                    _nodes = [{
                        "id": str(e.get("id") or ""),
                        "text": (str(e.get("title") or "") + " "
                                 + str(e.get("big_summary") or "")).strip()[:160],
                        "links": [x for x in (e.get("chain_links") or [])
                                  if isinstance(x, dict)],
                    } for e in same]
                    rows = memory_meta.chain_expand(
                        _nodes, [str(seed.get("id") or "")], hop_limit=2,
                        fan_out=3, decay=0.5, min_weight=0.2, max_new=6)
                except Exception:
                    rows = []
                out = []
                for row in rows:
                    text = str(row.get("text") or "").strip().replace("\n", " ")
                    if text:
                        out.append("- 关联事件(多跳 %.2f)：%s" % (
                            float(row.get("activation") or 0.0), text[:160]))
                    if len(out) >= limit:
                        break
                return out
            out = []
            for link in (seed.get("chain_links") or [])[:3]:
                if not isinstance(link, dict):
                    continue
                lid = str(link.get("id") or "")
                target = next((e for e in same if str(e.get("id") or "") == lid), None)
                if not target:
                    continue
                w = memory_meta.decayed_chain_weight(link.get("weight", 1.0), link.get("ts", 0))
                if w < 0.1:
                    continue
                text = str(target.get("title") or target.get("big_summary") or "").strip().replace("\n", " ")
                if text:
                    out.append("- 关联事件(链 %.2f)：%s" % (w, text[:160]))
                if len(out) >= limit:
                    break
            return out
        except Exception:
            return []

    def _attachments_from_messages(self, event) -> list:
        out = []
        try:
            for m in event.get_messages() or []:
                if isinstance(m, Image):
                    ref = str(getattr(m, "url", "") or getattr(m, "file", "") or getattr(m, "path", "") or "").strip()
                    if ref:
                        out.append({"type": "image", "ref": ref[:500]})
                elif isinstance(m, Record):
                    ref = str(getattr(m, "url", "") or getattr(m, "file", "") or "").strip()
                    if ref:
                        out.append({"type": "voice", "ref": ref[:500]})
        except Exception:
            pass
        return out

    def _message_refs(self, event) -> list:
        refs = []
        try:
            for msg in event.get_messages() or []:
                got = False
                for attr in ("id", "message_id", "msg_id", "message_seq"):
                    try:
                        value = getattr(msg, attr, None)
                    except Exception:
                        value = None
                    if value:
                        refs.append(str(value)[:80])
                        got = True
                        break
                if not got:
                    text = str(getattr(msg, "text", "") or "")
                    if text:
                        refs.append(_sha256(text)[:16])
        except Exception:
            pass
        return refs[:8]

    def _memory_provenance(self, event, ts=None) -> dict:
        try:
            _sid, _sname = self._speaker(event)
        except Exception:
            _sid, _sname = "", ""
        return {"sender_id": _sid, "sender_name": _sname,
                "session": str(getattr(event, "unified_msg_origin", "") or ""),
                "ts": float(ts if ts is not None else time.time()),
                "message_refs": self._message_refs(event)}

    def _event_provenance(self, event, entries=None, ts=None) -> dict:
        prov = self._memory_provenance(event, ts)
        sources = []
        refs = list(prov.get("message_refs") or [])
        senders = {str(prov.get("sender_id") or "")}
        if entries:
            for e in entries[-24:]:
                p = e.get("provenance") if isinstance(e, dict) else None
                if not isinstance(p, dict):
                    continue
                item = {"sender_id": str(p.get("sender_id") or ""),
                        "sender_name": str(p.get("sender_name") or ""),
                        "session": str(p.get("session") or ""),
                        "ts": float(p.get("ts", 0) or 0),
                        "message_refs": list(p.get("message_refs") or [])[:6]}
                sources.append(item)
                senders.add(item["sender_id"])
                refs.extend(item["message_refs"])
        prov["sources"] = sources[-24:]
        prov["message_refs"] = list(dict.fromkeys([str(x) for x in refs if x]))[:12]
        prov["senders"] = sorted([x for x in senders if x])
        return prov

    @staticmethod
    def _source_check(text: str, texts, provenance=None, record_ts=None) -> dict:
        try:
            src = "".join(str(t) for t in texts)
            src_chars = {c for c in src if not c.isspace() and c not in "，。！？、；：,.!?;:"}
            body = {c for c in str(text or "") if not c.isspace() and c not in "，。！？、；：,.!?;:"}
            if not body:
                return {"overlap": 0.0, "coverage": 0.0, "novelty": 0.0,
                        "length_ratio": 0.0, "status": "empty",
                        "source_items": [], "time_ok": True, "speaker_ok": True,
                        "cross_ref": 0}
            overlap = sum(1 for c in body if c in src_chars) / max(1, len(body))
            covered = sum(1 for c in src_chars if c in body) / max(1, len(src_chars))
            novelty = max(0.0, len(body - src_chars) / max(1, len(body)))
            ratio = len(str(text or "")) / max(1, len(src))
            source_items = []
            try:
                prov = provenance if isinstance(provenance, dict) else {}
                _srcs = prov.get("sources") if isinstance(prov.get("sources"), list) else []
                if _srcs:
                    source_items = [dict(x) for x in _srcs if isinstance(x, dict)][:24]
                elif prov:
                    source_items = [{
                        "sender_id": str(prov.get("sender_id") or ""),
                        "sender_name": str(prov.get("sender_name") or ""),
                        "session": str(prov.get("session") or ""),
                        "ts": float(prov.get("ts", 0) or 0),
                        "message_refs": list(prov.get("message_refs") or []),
                    }]
            except Exception:
                source_items = []
            # time_ok: evidence cannot postdate the record and must be near it.
            time_ok = True
            try:
                _rts = float(record_ts if record_ts is not None else 0.0)
                _ts = [float(x.get("ts", 0) or 0) for x in source_items
                       if float(x.get("ts", 0) or 0) > 0]
                if _rts > 0 and _ts:
                    time_ok = (max(_ts) <= _rts + 300.0) and ((_rts - min(_ts)) <= 7 * 86400.0)
            except Exception:
                time_ok = True
            # speaker_ok: the claimed speaker must appear among the sources.
            speaker_ok = True
            try:
                _claim_sid = str((provenance or {}).get("sender_id") or "") if isinstance(provenance, dict) else ""
                _sids = {str(x.get("sender_id") or "") for x in source_items if str(x.get("sender_id") or "")}
                if _claim_sid and _sids:
                    speaker_ok = _claim_sid in _sids
            except Exception:
                speaker_ok = True
            # cross_ref: count independent evidence items / message refs.
            cross_ref = 0
            try:
                _refs = set()
                for x in source_items:
                    for r in (x.get("message_refs") or []):
                        _refs.add(str(r))
                cross_ref = max(len(source_items), len(_refs))
            except Exception:
                cross_ref = len(source_items)
            if overlap >= 0.55 and novelty <= 0.25 and ratio <= 1.6:
                status = "ok"
            elif overlap >= 0.35 and novelty <= 0.45:
                status = "weak"
            else:
                status = "suspect"
            if not time_ok or not speaker_ok:
                if status == "ok":
                    status = "weak"
            return {"overlap": round(overlap, 3), "coverage": round(covered, 3),
                    "novelty": round(novelty, 3), "length_ratio": round(ratio, 3),
                    "status": status, "source_items": source_items[:24],
                    "time_ok": bool(time_ok), "speaker_ok": bool(speaker_ok),
                    "cross_ref": int(cross_ref)}
        except Exception:
            return {"overlap": 0.0, "status": "unknown"}

    @staticmethod
    def _event_session_file(session: str) -> Path:
        _safe = "".join(c if c.isalnum() or c in "-_" else "_" for c in str(session or "default"))[:80]
        return EVENT_SESSION_DIR / _safe / "events.jsonl"

    def _last_session_event(self, session: str):
        try:
            path = self._event_session_file(session)
            if not path.exists():
                return None
            for line in reversed(path.read_text(encoding="utf-8").splitlines()):
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                if isinstance(d, dict):
                    return d
        except Exception:
            pass
        return None

    def _event_boundary(self, session: str, body: str, ts: float) -> dict:
        """Zacks et al. (2007) event segmentation for the event archive.

        Boundary = weighted elapsed-time gap + content dissimilarity against
        the previous event in the same session. A boundary below the split
        threshold continues the previous episode and inherits its id as
        parent_event_id; a strong boundary starts a new root event.
        """
        prev = self._last_session_event(session)
        if not isinstance(prev, dict):
            return {"boundary_score": 0.0, "parent_event_id": "",
                    "gap_seconds": 0.0, "similarity": 0.0}
        try:
            gap = max(0.0, float(ts) - float(prev.get("ts", 0) or 0))
        except Exception:
            gap = 0.0
        try:
            sim = float(self._text_similarity(str(body or ""), str(prev.get("event") or prev.get("title") or "")))
        except Exception:
            sim = 0.0
        gap_norm = max(0.0, min(1.0, gap / EVENT_BOUNDARY_WINDOW_SECONDS))
        score = max(0.0, min(1.0, EVENT_BOUNDARY_TIME_WEIGHT * gap_norm
                            + EVENT_BOUNDARY_TEXT_WEIGHT * (1.0 - sim)))
        parent = ""
        if score < EVENT_BOUNDARY_PARENT_THRESHOLD:
            parent = str(prev.get("id") or "")
        return {"boundary_score": round(score, 3), "parent_event_id": parent,
                "gap_seconds": round(gap, 3), "similarity": round(sim, 3)}

    @staticmethod
    def _text_similarity(a: str, b: str) -> float:
        """Bigram Jaccard similarity shared by archive/dedupe paths (task-56).

        BioCore keeps its own copy for the state machine; the plugin-level
        archive code calls this through ``self`` so duplicate detection and
        event boundary scoring actually run instead of raising AttributeError
        inside the surrounding try/except.
        """
        return UtilMixin._text_similarity(a, b)

    @staticmethod
    def _normalize_event_key(key: str, title: str = "") -> str:
        """Normalize event identity: NFKC, lowercase, punctuation/joiners removed."""
        import unicodedata

        def _norm(value) -> str:
            s = unicodedata.normalize("NFKC", str(value or "")).strip().lower()
            s = s.replace("／", "/").replace("·", "")
            s = re.sub(r"[\s\-_/\\|｜&＆+＋~～,，.。、;；:：!！?？'\"“”‘’()（）\[\]【】<>《》]+", "", s)
            return s[:120]

        out = _norm(key)
        if not out:
            out = _norm(title)
        if not out:
            out = "evt_" + _sha256(str(key) + "|" + str(title))[:12]
        return out

    def _recent_session_events(self, session: str, limit: int = 20) -> list:
        try:
            path = self._event_session_file(session)
            if not path.exists():
                return []
            rows = []
            for line in reversed(path.read_text(encoding="utf-8").splitlines()):
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                if isinstance(d, dict):
                    rows.append(d)
                if len(rows) >= limit:
                    break
            return rows
        except Exception:
            return []

    def _find_duplicate_event(self, session: str, event_key: str, body: str, ts: float):
        """Return the same-session archived event this record duplicates."""
        try:
            for prev in self._recent_session_events(session, 20):
                prev_key = self._normalize_event_key(
                    str(prev.get("event_key") or prev.get("title") or ""),
                    str(prev.get("title") or ""))
                if not prev_key:
                    continue
                try:
                    # task-56: compare against the real event time so a
                    # re-archived row is not treated as a new event.
                    gap = abs(float(ts) - event_effective_time(prev))
                except Exception:
                    gap = 0.0
                if gap > EVENT_DUP_WINDOW_SECONDS:
                    continue
                if prev_key == event_key:
                    return prev
                if self._text_similarity(prev_key, event_key) >= EVENT_KEY_SIM_THRESHOLD:
                    body_sim = self._text_similarity(str(body or ""), str(prev.get("event") or ""))
                    if body_sim >= 0.45:
                        return prev
            # task-57: the same real session may be archived under ":" and "_"
            # variants; compare canonical keys across the archive too.
            target_session = canonical_session_key(session)
            try:
                _event_key = self._normalize_event_key(str(event_key or ""), "")
            except Exception:
                _event_key = str(event_key or "")
            for prev in self._event_archive(200):
                if canonical_session_key(prev.get("session")) != target_session:
                    continue
                try:
                    gap = abs(float(ts) - event_effective_time(prev))
                except Exception:
                    gap = 0.0
                if gap > EVENT_DUP_WINDOW_SECONDS:
                    continue
                prev_key = self._normalize_event_key(
                    str(prev.get("event_key") or prev.get("title") or ""),
                    str(prev.get("title") or ""))
                if prev_key and prev_key == _event_key:
                    return prev
                if prev_key and self._text_similarity(prev_key, _event_key) >= EVENT_KEY_SIM_THRESHOLD:
                    if self._text_similarity(str(body or ""), str(prev.get("event") or "")) >= 0.45:
                        return prev
                if self._text_similarity(str(body or ""), str(prev.get("event") or "")) >= 0.60:
                    return prev
        except Exception:
            pass
        return None

    def _find_global_duplicate_event(self, event_key: str, body: str, ts: float):
        """Cross-session event identity: same normalized key + body within window."""
        try:
            if not EVENT_ARCHIVE_PATH.exists():
                return None
            event_key = self._normalize_event_key(str(event_key or ""), "")
            lines = EVENT_ARCHIVE_PATH.read_text(encoding="utf-8").splitlines()
            for line in reversed(lines[-200:]):
                try:
                    prev = json.loads(line)
                except Exception:
                    continue
                if not isinstance(prev, dict):
                    continue
                prev_key = self._normalize_event_key(
                    str(prev.get("event_key") or prev.get("title") or ""),
                    str(prev.get("title") or ""))
                if not prev_key:
                    continue
                try:
                    gap = abs(float(ts) - event_effective_time(prev))
                except Exception:
                    gap = 0.0
                if gap > EVENT_DUP_WINDOW_SECONDS:
                    continue
                if prev_key == event_key:
                    return prev
                if self._text_similarity(prev_key, event_key) >= EVENT_KEY_SIM_THRESHOLD:
                    if self._text_similarity(str(body or ""),
                                             str(prev.get("event") or "")) >= 0.45:
                        return prev
        except Exception:
            pass
        return None

    def _find_any_duplicate_event(self, session: str, event_key: str, body: str, ts: float):
        """Same-session duplicate first, then cross-session global duplicate."""
        prev = self._find_duplicate_event(session, event_key, body, ts)
        if prev is not None:
            return prev
        return self._find_global_duplicate_event(event_key, body, ts)

    def _merge_archive_duplicate(self, prev: dict, record: dict) -> None:
        """Merge a duplicate event into the existing archive row atomically."""
        try:
            prev_id = str(prev.get("id") or "")
            if not prev_id:
                return
            _new_key = str(record.get("event_key") or "")
            _new_ts = float(record.get("ts", 0) or 0)
            _new_sources = list((record.get("provenance") or {}).get("sources") or [])[:12]
            _new_texts = list(record.get("source_texts") or [])[:12]

            def _mutate(obj):
                if str(obj.get("id") or "") != prev_id:
                    return False
                merged = [str(x) for x in (obj.get("merged_event_keys") or [])]
                if _new_key and _new_key not in merged:
                    merged.append(_new_key)
                obj["merged_event_keys"] = merged[:12]
                try:
                    obj["ts"] = max(float(obj.get("ts", 0) or 0), _new_ts)
                except Exception:
                    obj["ts"] = _new_ts
                obj["importance"] = round(max(float(obj.get("importance", 0) or 0),
                                              float(record.get("importance", 0) or 0)), 3)
                obj["centrality"] = round(max(float(obj.get("centrality", 0) or 0),
                                              float(record.get("centrality", 0) or 0)), 3)
                obj["merge_count"] = int(obj.get("merge_count", 0) or 0) + 1
                src = [str(x) for x in (obj.get("source_texts") or [])[-24:]]
                for _t in _new_texts:
                    if _t and _t not in src:
                        src.append(str(_t))
                obj["source_texts"] = src[-24:]
                prov = dict(obj.get("provenance") or {})
                sources = [x for x in (prov.get("sources") or []) if isinstance(x, dict)][-24:]
                for _item in _new_sources:
                    if isinstance(_item, dict) and _item not in sources:
                        sources.append(_item)
                prov["sources"] = sources[-24:]
                obj["provenance"] = prov
                return True

            session = str(prev.get("session") or record.get("session") or "default")
            self._rewrite_jsonl_atomic(EVENT_ARCHIVE_PATH, _mutate)
            self._rewrite_jsonl_atomic(self._event_session_file(session), _mutate)
            logger.info("[biocore] duplicate event merged: %s key=%s", prev.get("title"), _new_key)
        except Exception as exc:
            logger.warning("[biocore] duplicate merge failed: %s", exc)

    async def _archive_ranked_events_deterministic(self, event, core, entries):
        """Deterministic event candidate generation + embedding ranking.

        Used when the LLM event_ranking function is off (the default): split
        recent messages into event segments, score them with importance /
        self-schema congruence / embedding novelty / commitment cues, and
        archive the top candidates. The LLM is still optional via event_summary.
        """
        try:
            segments = self._segment_event_texts(entries)
            if not segments:
                return
            now = time.time()
            recent_events = self._event_archive(10)
            candidates = []
            for seg_texts in segments:
                seg_text = "\n".join(str(t) for t in seg_texts if str(t).strip()).strip()
                if len(seg_text) < 8:
                    continue
                seg_set = {str(t).strip() for t in seg_texts if str(t).strip()}
                seg_entries = [e for e in entries
                               if str(e.get("text", "")).strip() in seg_set]
                imp = 0.5
                vecs = []
                for e in seg_entries:
                    try:
                        imp = max(imp, float(e.get("importance", 0.5) or 0.5))
                    except Exception:
                        pass
                    _v = e.get("vector") if isinstance(e.get("vector"), list) else []
                    if _v:
                        vecs.append(_v)
                try:
                    schema = memory_meta.schema_congruence(
                        seg_text, self._self_schema_texts(core))
                except Exception:
                    schema = 0.0
                try:
                    # M1: an event segment that contains an already-tagged
                    # sensitive memory is withheld from the provider when safety
                    # is on (default off => identical to 1.2.98).
                    _seg_sensitive = any(bool(e.get("sensitive")) for e in seg_entries)
                    vec = await self._embedding_for(
                        "event_ranking", seg_text[:600],
                        sensitive=self._embed_skip_sensitive(_seg_sensitive))
                except Exception:
                    vec = []
                if not vec and vecs:
                    try:
                        dim = len(vecs[0])
                        vec = [sum(float(v[i]) for v in vecs if i < len(v)) / len(vecs)
                               for i in range(dim)]
                    except Exception:
                        vec = []
                novelty = 0.6
                max_cos = 0.0
                for ev in recent_events:
                    _ev = ev.get("event_embedding") if isinstance(ev, dict) else None
                    if isinstance(_ev, list) and _ev:
                        max_cos = max(max_cos, self._cosine(vec, _ev))
                if vec and max_cos > 0:
                    novelty = max(0.0, min(1.0, 1.0 - max_cos))
                cues = sum(1 for w in ("承诺", "答应", "喜欢", "讨厌", "对不起", "谢谢",
                                        "以后", "永远", "骗", "害怕", "难过", "别")
                           if w in seg_text)
                cue_score = min(1.0, cues / 3.0)
                score = 0.35 * imp + 0.25 * schema + 0.20 * novelty + 0.20 * cue_score
                if imp < 0.55 or score < 0.40:
                    continue
                candidates.append((score, seg_text, seg_entries, vec, schema, imp))
            if len(candidates) > 1 and getattr(self, "event_ranking_llm", False):
                _docs = [c[1] for c in candidates]
                _rs = await self._rerank_scores(
                    "event_ranking", "最近对话中值得记住的重要事件", _docs)
                if _rs:
                    candidates = [
                        (round(0.6 * c[0] + 0.4 * float(_rs.get(i, 0.0)), 4),
                         c[1], c[2], c[3], c[4], c[5])
                        for i, c in enumerate(candidates)
                    ]
            candidates.sort(key=lambda x: x[0], reverse=True)
            _digest_event_ids = []
            for score, body, seg_entries, vec, schema, imp in candidates[:2]:
                title = interpretation.clean_event_title(body) or "对话事件"
                _ekey = self._normalize_event_key(title, title)
                prov = self._event_provenance(event, entries, ts=now)
                check = self._source_check(body, [str(t) for t in seg_entries],
                                           provenance=prov, record_ts=now)
                # task-56: duplicate detection compares the real message time
                # (time_span end), not the archival moment, so a delayed
                # re-archive of the same conversation still dedupes.
                try:
                    _real_ts = max(float(e.get("ts", 0) or 0) for e in seg_entries
                                   if float(e.get("ts", 0) or 0) > 0)
                except Exception:
                    _real_ts = now
                dup = self._find_any_duplicate_event(
                    str(getattr(event, "unified_msg_origin", "") or ""), _ekey, body, _real_ts)
                if dup is not None:
                    continue
                _imp = round(max(0.55, min(1.0, imp * 0.7 + score * 0.3)), 3)
                _safe_title = self._mask_if_safety(title)
                _safe_body = self._mask_if_safety(self._event_excerpt(body, 220))
                _safe_big, _safe_small = self._dual_event_summary_fallback(body, title)
                record = {
                    "id": "evt_" + str(int(now)) + "_" + str(abs(hash(title + body)) % 100000),
                    "ts": now,
                    "session": str(getattr(event, "unified_msg_origin", "") or ""),
                    "title": _safe_title,
                    "event": _safe_body[:600],
                    "big_summary": _safe_big,
                    "small_summary": _safe_small,
                    "summary_status": "fallback",
                    "event_key": _ekey,
                    "centrality": round(max(0.0, min(1.0, schema)), 3),
                    "central_details": _safe_body[:180],
                    "peripheral_details": "",
                    "meaning_to_her": "",
                    "reflection": "",
                    "emotion": str((getattr(core, "labels", {}) or {}).get("emotion") or "neutral") if core else "neutral",
                    "emotion_secondary": self._secondary_emotion(core),
                    "emotion_nuance": [],
                    "emotion_layers": self._event_emotion_layers(core),
                    "emotion_layers_source": "core",
                    "emotion_intensity": self._event_emotion_intensity(core),
                    "importance": _imp,
                    "appraisal": dict(core.appraisal) if core is not None else {},
                    "confidence": round(max(0.2, min(1.0, 0.55 + 0.45 * float(check.get("overlap", 0)))), 3),
                    "source_count": len(seg_entries),
                    "source_check": check,
                    "provenance": prov,
                    "attachments": [],
                    "modalities": [],
                    "recall_count": 0,
                    "last_recall": now,
                    "strength": _imp,
                    "source_texts": [self._mask_if_safety(t) for t in seg_texts[:12]],
                    "ranking_mode": "deterministic_embedding",
                    "milestone": relationship_meta.milestone_from_text(title + " " + body),
                }
                if vec:
                    record["event_embedding"] = [round(float(x), 5) for x in vec]
                try:
                    times = [float(e.get("ts", 0) or 0) for e in seg_entries]
                    times = [t for t in times if t > 0]
                    if times:
                        record["time_span"] = {"start_ts": round(min(times), 3),
                                               "end_ts": round(max(times), 3),
                                               "span_seconds": round(max(times) - min(times), 3)}
                except Exception:
                    pass
                # task-33: worthiness gate (OFF => legacy: archive everything).
                _memory_point = True
                try:
                    _rel = self._relationship_of(self._user_record(event))
                except Exception:
                    _rel = {}
                _worth_inputs = None
                try:
                    _worth, _worth_inputs = self._event_worthiness_bundle(
                        record, core, _rel, text=body, title=title, schema=schema)
                except Exception as exc:
                    logger.warning("[biocore] worthiness failed: %s", exc)
                    _worth = None
                if _worth is not None:
                    record["worthiness"] = _worth
                    if _worth_inputs is not None:
                        record["worthiness_inputs"] = _worth_inputs
                    _memory_point = _worth.get("decision") == "memory_point"
                    record["memory_point"] = bool(_memory_point)
                    if _worth.get("decision") == "skip":
                        logger.info("[biocore] event below worthiness floor: %s W=%.3f reason=%s",
                                    title, _worth.get("W", 0.0), _worth.get("reason", ""))
                        continue
                self._append_event_archive(record)
                if _memory_point:
                    _digest_event_ids.append(record.get("id"))
                    if core is not None:
                        try:
                            core.integrate_noise("event_summary", attention=0.005)
                        except Exception:
                            pass
                logger.info("[biocore] deterministic event archived: %s score=%.2f mp=%s",
                            title, score, _memory_point)
        except Exception as exc:
            logger.warning("[biocore] deterministic event ranking failed: %s", exc)
        try:
            if core is not None:
                core.update_daily_digest(event_ids=_digest_event_ids)
        except Exception:
            pass
        await self._maybe_archive_insight(event, core, "event_archive")

    async def _archive_ranked_events(self, event, core, entries):
        """Deterministic embedding/rule event extraction (LLM is never used here).

        The event_ranking switch merely enables/disables this local pipeline;
        event summarization stays a separate optional function (event_summary).
        """
        if not entries:
            return
        if not self._llm_allowed("event_ranking"):
            return
        await self._archive_ranked_events_deterministic(event, core, entries)

    async def _archive_strong_event(self, event, core, texts, summary, attachments=None):
        if core is None:
            return
        intensity = float(core._intensity())
        strong = (intensity >= 0.35 or abs(float(core.v)) >= 0.40 or
                  float(core.a) >= 0.75 or float(core.stress) >= 0.65 or
                  (abs(float(core.v)) >= 0.28 and float(core.a) >= 0.60))
        if not strong or not texts:
            return
        if not self._llm_allowed("event_summary"):
            return
        texts = [self._mask_if_safety(t) for t in texts if str(t).strip()]
        try:
            provider = await self._provider_for("event_summary", event)
            data = {}
            if provider is not None:
                prompt = interpretation.event_summary_prompt(texts)
                resp = await self._bg_llm_direct(
                    "event_summary", provider, prompt,
                    timeout_ms=getattr(self, "summary_llm_timeout_ms", 8000))
                raw = str(getattr(resp, "completion_text", "") or "").strip()
                data = interpretation.parse_event_summary(
                    raw, getattr(self, "summary_max_chars", 0))
            else:
                # P2: provider missing => deterministic fallback record, never drop.
                _fb_big, _fb_small = self._dual_event_summary_fallback(
                    " ".join(texts), str(summary or ""))
                data = {"big_summary": _fb_big, "small_summary": _fb_small}
                self._record_llm_telemetry("event_summary", "fallback_no_provider")
            _llm_big = str(data.get("big_summary") or "").strip()
            _llm_small = str(data.get("small_summary") or "").strip()
            title = str(data.get("title") or summary or "重要事件").strip()[:80]
            title = self._mask_if_safety(title)
            ev = self._mask_if_safety(self._summary_cap(str(data.get("event") or summary or "").strip()))
            big_summary = self._mask_if_safety(self._summary_cap(
                str(_llm_big or ev or summary or "").strip()))
            small_summary = self._mask_if_safety(
                str(_llm_small or big_summary or ev).strip())[:80]
            summary_status = "llm" if (_llm_big or _llm_small) else "fallback"
            meaning = self._mask_if_safety(self._summary_cap(str(data.get("meaning_to_her") or "").strip()))
            reflection = self._mask_if_safety(self._summary_cap(str(data.get("reflection") or "").strip()))
            if not ev:
                return
            _prov = self._event_provenance(event, None, ts=time.time())
            _check = self._source_check(ev, texts, provenance=_prov, record_ts=_prov.get("ts"))
            _ekey = self._normalize_event_key(title, title)
            _conf = round(max(0.2, min(1.0, 0.55 + 0.45 * float(_check.get("overlap", 0)))), 3)
            record = {
                "id": "evt_" + str(int(time.time())) + "_" + str(abs(hash(summary)) % 100000),
                "ts": time.time(),
                "session": str(getattr(event, "unified_msg_origin", "") or ""),
                "title": title,
                "event": ev,
                "big_summary": big_summary,
                "small_summary": small_summary,
                "summary_status": summary_status,
                "event_key": _ekey,
                "meaning_to_her": meaning,
                "reflection": reflection,
                "emotion": str(core.labels.get("emotion") or "neutral"),
                "emotion_secondary": self._secondary_emotion(core),
                "emotion_nuance": self._normalize_emotion_nuance(
                    data.get("emotion_nuance")),
                "emotion_layers": (interpretation.clean_emotion_layers(
                    data.get("emotion_layers")) or None),
                "emotion_layers_source": ("summary"
                    if interpretation.clean_emotion_layers(
                        data.get("emotion_layers")) else ""),
                "emotion_intensity": self._event_emotion_intensity(core),
                "importance": round(max(0.5, min(1.0, intensity)), 3),
                "appraisal": dict(core.appraisal),
                "confidence": _conf,
                "source_count": len(texts),
                "source_check": _check,
                "provenance": _prov,
                "attachments": (attachments or [])[:20],
                "modalities": sorted(set(["图片"] if any(a.get("type") == "image" for a in (attachments or [])) else []) | set(["语音"] if any(a.get("type") == "voice" for a in (attachments or [])) else [])),
                "recall_count": 0,
                "last_recall": time.time(),
                "strength": round(max(0.5, min(1.0, intensity)), 3),
                "source_texts": [self._mask_if_safety(t) for t in texts[:12]],
            }
            # task-33: same worthiness gate as the deterministic path.
            _memory_point = True
            try:
                _rel = self._relationship_of(self._user_record(event))
            except Exception:
                _rel = {}
            _worth_inputs = None
            try:
                _worth, _worth_inputs = self._event_worthiness_bundle(
                    record, core, _rel, text=ev, title=title)
            except Exception as exc:
                logger.warning("[biocore] worthiness failed: %s", exc)
                _worth = None
            if _worth is not None:
                record["worthiness"] = _worth
                if _worth_inputs is not None:
                    record["worthiness_inputs"] = _worth_inputs
                _memory_point = _worth.get("decision") == "memory_point"
                record["memory_point"] = bool(_memory_point)
                if _worth.get("decision") == "skip":
                    logger.info("[biocore] strong event below worthiness floor: %s W=%.3f",
                                title, _worth.get("W", 0.0))
                    return
            _dup = self._find_any_duplicate_event(record.get("session") or "", _ekey, ev,
                                                 record.get("ts") or time.time())
            if _dup is not None:
                record["duplicate_of"] = str(_dup.get("id") or "")
                self._merge_archive_duplicate(_dup, record)
                return
            _bnd = self._event_boundary(record.get("session") or "", ev, record.get("ts") or time.time())
            record["boundary_score"] = _bnd.get("boundary_score", 0.0)
            record["parent_event_id"] = _bnd.get("parent_event_id", "")
            self._append_event_archive(record)
            if core is not None:
                try:
                    core.integrate_noise("event_summary", attention=0.005)
                except Exception:
                    pass
            await self._maybe_archive_insight(event, core, "event_archive")
            try:
                if core is not None:
                    core.update_daily_digest(event_ids=[record.get("id")])
            except Exception:
                pass
            if _memory_point:
                self._update_self_narrative(title, reflection or meaning)
            logger.info("[biocore] strong event archived: %s mp=%s", title, _memory_point)
        except Exception as exc:
            logger.warning("[biocore] strong event summary failed: %s", exc)
            self._record_llm_telemetry("event_summary", "error", str(exc))

    async def _maybe_archive_events(self, event, core=None):
        """Request-path hook: make deterministic event archive reachable."""
        if not self._llm_allowed("event_ranking"):
            return
        now = time.time()
        if now - float(getattr(self, "_last_event_archive", 0.0)) < 300:
            return
        try:
            doc = self._load_memory(event)
            entries = doc.get("entries") if isinstance(doc, dict) else []
            if not isinstance(entries, list) or not entries:
                return
            self._last_event_archive = now
            await self._archive_ranked_events(event, core, entries)
        except Exception as exc:
            logger.warning("[biocore] request-path event archive failed: %s", exc)

    async def _maybe_archive_strong_event(self, event, core, text=""):
        """Request-path hook: wire the single-event summary path (BUG-01)."""
        if not self._llm_allowed("event_summary"):
            return
        key = str(getattr(event, "unified_msg_origin", "") or "")
        now = time.time()
        try:
            last_map = getattr(self, "_last_strong_event_summary", None)
            if not isinstance(last_map, dict):
                last_map = {}
                self._last_strong_event_summary = last_map
            if now - float(last_map.get(key, 0.0) or 0.0) < 600:
                return
            texts = [str(h.get("text") or "").strip() for h in (getattr(core, "history", None) or [])[-6:]
                     if isinstance(h, dict) and str(h.get("text") or "").strip()]
            if str(text or "").strip():
                texts.append(str(text).strip())
            if not texts:
                return
            last_map[key] = now
            await self._archive_strong_event(event, core, texts, str(text or texts[-1])[:160])
        except Exception as exc:
            logger.warning("[biocore] request-path strong event failed: %s", exc)

    async def _voice_context(self, event) -> str:
        if not getattr(self, "voice_transcription_enabled", True):
            return ""
        try:
            provider = await self.context.get_using_stt_provider_async(
                getattr(event, "unified_msg_origin", "") or "")
            if provider is None:
                return ""
            texts = []
            for m in event.get_messages() or []:
                if not isinstance(m, Record):
                    continue
                ref = str(getattr(m, "url", "") or getattr(m, "file", "") or getattr(m, "path", "") or "").strip()
                if not ref:
                    continue
                try:
                    txt = await provider.get_text(ref)
                    if str(txt or "").strip():
                        texts.append(str(txt).strip()[:300])
                except Exception as exc:
                    logger.warning("[biocore] voice transcribe failed: %s", exc)
            return "；".join(texts)[:600]
        except Exception as exc:
            logger.warning("[biocore] voice context failed: %s", exc)
            return ""

    async def _image_context(self, event) -> str:
        refs = self._image_refs(event)
        if not refs:
            return ""
        if not self._llm_allowed("image_caption"):
            return ""
        # Local llama-server is optional. A general AstrBot vision provider
        # must work without image_llama_* / image_service_port.
        _local_vlm = bool(self.image_llama_server and self.image_llama_model
                          and int(self.image_service_port or 0) > 0)
        if _local_vlm:
            if not await self._ensure_image_service():
                logger.warning("[biocore] local VLM unavailable; falling back to configured vision provider")
        self._image_last_used = time.time()
        cache = self._load_image_cache()
        missing = [r for r in refs if _sha256(r) not in cache]
        if missing:
            try:
                cfg = self.context.get_config()
                provider_settings = cfg.get("provider_settings", {}) if isinstance(cfg, dict) else {}
                prompt = interpretation.image_caption_prompt(
                    provider_settings.get("image_caption_prompt"))
                # Image caption always uses the vision provider, never a text LLM.
                provider = self._vision_provider_for(event)
                if provider is not None:
                    for ref in missing[:3]:
                        try:
                            _ctmo = max(2000, min(20000, int(
                                getattr(self, "image_caption_timeout_ms", 8000) or 8000))) / 1000.0
                            resp = await asyncio.wait_for(
                                provider.text_chat(prompt=prompt, image_urls=[ref]),
                                timeout=_ctmo)
                            caption = interpretation.parse_image_caption(
                                str(getattr(resp, "completion_text", "") or ""))
                        except asyncio.TimeoutError:
                            self._image_caption_timeouts = int(
                                getattr(self, "_image_caption_timeouts", 0) or 0) + 1
                            logger.warning("[biocore] image caption timeout (%sms)", _ctmo * 1000)
                            caption = ""
                        except Exception as exc:
                            logger.warning("[biocore] image caption failed: %s", exc)
                            caption = ""
                        if caption:
                            cache[_sha256(ref)] = {"ref": ref, "caption": caption, "ts": time.time()}
                    self._save_image_cache(cache)
            except Exception as exc:
                logger.warning("[biocore] image provider failed: %s", exc)
        lines = []
        for ref in refs[:3]:
            item = cache.get(_sha256(ref))
            if item and item.get("caption"):
                lines.append(str(item["caption"]))
        self._image_last_used = time.time()
        if not lines:
            return ""
        return "\n".join(lines)

    def _astrbot_tts_default(self):
        try:
            provs = self.context.get_all_tts_providers()
        except Exception:
            provs = []
        p = provs[0] if provs else None
        if p:
            cfg = getattr(p, "provider_config", {}) or {}
            base = str(cfg.get("api_base") or cfg.get("tts_api_base") or "").strip()
            model = str(cfg.get("model") or cfg.get("tts_model") or getattr(p, "model", "") or "").strip()
            key = str(cfg.get("api_key") or cfg.get("tts_api_key") or "").strip()
            if base:
                return {"provider_id": str(cfg.get("id") or ""), "base_url": base,
                        "model": model, "has_key": bool(key), "_key": key}
        for item in self._config_providers():
            if str(item.get("provider_type") or "") != "tts" or item.get("enable") is False:
                continue
            base = str(item.get("api_base") or item.get("tts_api_base") or "").strip()
            model = str(item.get("model") or item.get("tts_model") or "").strip()
            key = str(item.get("api_key") or item.get("tts_api_key") or "").strip()
            if base:
                return {"provider_id": str(item.get("id") or ""), "base_url": base,
                        "model": model, "has_key": bool(key), "_key": key}
        return None

    def _astrbot_image_default(self):
        try:
            provs = self.context.get_all_providers()
        except Exception:
            provs = []
        sources = {str(x.get("id") or ""): x for x in self._config_provider_sources()}
        candidates = []
        for p in provs:
            cfg = getattr(p, "provider_config", {}) or {}
            pid = str(cfg.get("id") or "").lower()
            model = str(getattr(p, "get_model", lambda: "")() or cfg.get("model") or "").lower()
            if "img" in pid or "image" in pid or "img" in model or "image" in model:
                candidates.append((p, cfg))
        if candidates:
            p, cfg = candidates[0]
            src = sources.get(str(cfg.get("provider_source_id") or ""), {})
            base = str(cfg.get("api_base") or src.get("api_base") or "").strip()
            model = str(getattr(p, "get_model", lambda: "")() or cfg.get("model") or "").strip()
            raw = src.get("key") or cfg.get("key") or ""
            if isinstance(raw, list):
                raw = raw[0] if raw else ""
            key = str(raw or "").strip()
            if base:
                return {"provider_id": str(cfg.get("id") or ""), "base_url": base,
                        "model": model, "has_key": bool(key), "_key": key}
        for item in self._config_providers():
            pid = str(item.get("id") or "").lower()
            if item.get("enable") is False or ("img" not in pid and "image" not in pid):
                continue
            src = sources.get(str(item.get("provider_source_id") or ""), {})
            base = str(item.get("api_base") or src.get("api_base") or "").strip()
            model = str(item.get("model") or item.get("id") or "").strip()
            raw = src.get("key") or item.get("key") or ""
            if isinstance(raw, list):
                raw = raw[0] if raw else ""
            key = str(raw or "").strip()
            if base:
                return {"provider_id": str(item.get("id") or ""), "base_url": base,
                        "model": model, "has_key": bool(key), "_key": key}
        return None

    def _astrbot_llm_default(self):
        try:
            provs = self.context.get_all_providers()
        except Exception:
            provs = []
        p = provs[0] if provs else None
        if p:
            cfg = getattr(p, "provider_config", {}) or {}
            base = str(cfg.get("api_base") or "").strip()
            model = str(getattr(p, "get_model", lambda: "")() or cfg.get("model") or "").strip()
            try:
                key = str(p.get_current_key() or "").strip()
            except Exception:
                key = ""
            if base:
                return {"provider_id": str(cfg.get("id") or ""), "base_url": base,
                        "model": model, "has_key": bool(key), "_key": key}
        # fall back to the AstrBot config table (+ provider source)
        sources = {str(x.get("id") or ""): x for x in self._config_provider_sources()}
        for item in self._config_providers():
            if item.get("enable") is False:
                continue
            ptype = str(item.get("provider_type") or "")
            if ptype and ptype != "chat_completion":
                continue
            src = sources.get(str(item.get("provider_source_id") or ""), {})
            base = str(item.get("api_base") or src.get("api_base") or "").strip()
            model = str(item.get("model") or item.get("id") or "").strip()
            raw_key = src.get("key") or item.get("key") or ""
            if isinstance(raw_key, list):
                raw_key = raw_key[0] if raw_key else ""
            key = str(raw_key or "").strip()
            if base:
                return {"provider_id": str(item.get("id") or ""), "base_url": base,
                        "model": model, "has_key": bool(key), "_key": key}
        return None

    def _astrbot_embedding_default(self):
        try:
            provs = self.context.get_all_embedding_providers()
        except Exception:
            provs = []
        p = provs[0] if provs else None
        if p:
            cfg = getattr(p, "provider_config", {}) or {}
            base = str(cfg.get("embedding_api_base") or "").strip()
            model = str(cfg.get("embedding_model") or getattr(p, "model", "") or "").strip()
            key = str(cfg.get("embedding_api_key") or "").strip()
            if base:
                return {"provider_id": str(cfg.get("id") or ""), "base_url": base,
                        "model": model, "has_key": bool(key), "_key": key}
        # fall back to the AstrBot config table
        for item in self._config_providers():
            if str(item.get("provider_type") or "") != "embedding":
                continue
            if item.get("enable") is False:
                continue
            base = str(item.get("embedding_api_base") or "").strip()
            model = str(item.get("embedding_model") or "").strip()
            key = str(item.get("embedding_api_key") or "").strip()
            if base:
                return {"provider_id": str(item.get("id") or ""), "base_url": base,
                        "model": model, "has_key": bool(key), "_key": key}
        return None

    def _astrbot_rerank_default(self):
        try:
            provs = getattr(getattr(self.context, "provider_manager", None),
                            "rerank_provider_insts", []) or []
        except Exception:
            provs = []
        p = provs[0] if provs else None
        if p:
            cfg = getattr(p, "provider_config", {}) or {}
            base = str(cfg.get("rerank_api_base") or "").strip()
            suffix = str(cfg.get("rerank_api_suffix") or "")
            if suffix and base and not base.endswith(suffix):
                base = base.rstrip("/") + "/" + suffix.lstrip("/")
            model = str(cfg.get("rerank_model") or getattr(p, "model", "") or "").strip()
            key = str(cfg.get("rerank_api_key") or "").strip()
            if base:
                return {"provider_id": str(cfg.get("id") or ""), "base_url": base,
                        "model": model, "has_key": bool(key), "_key": key}
        for item in self._config_providers():
            if str(item.get("provider_type") or "") != "rerank":
                continue
            if item.get("enable") is False:
                continue
            base = str(item.get("rerank_api_base") or "").strip()
            suffix = str(item.get("rerank_api_suffix") or "")
            if suffix and base and not base.endswith(suffix):
                base = base.rstrip("/") + "/" + suffix.lstrip("/")
            model = str(item.get("rerank_model") or "").strip()
            key = str(item.get("rerank_api_key") or "").strip()
            if base:
                return {"provider_id": str(item.get("id") or ""), "base_url": base,
                        "model": model, "has_key": bool(key), "_key": key}
        return None

    def _public_api_config(self):
        llm = self._astrbot_llm_default()
        emb = self._astrbot_embedding_default()
        rrk = self._astrbot_rerank_default()
        tts = self._astrbot_tts_default()
        img = self._astrbot_image_default()
        def one(kind, default):
            saved = self.api_config.get(kind) if isinstance(self.api_config.get(kind), dict) else {}
            source = saved.get("source") or ("astrbot" if default else "custom")
            base = saved.get("base_url")
            model = saved.get("model")
            if not base:
                base = (default or {}).get("base_url", "")
            if not model:
                model = (default or {}).get("model", "")
            enabled = saved.get("enabled")
            if enabled is None:
                enabled = bool(default) if kind != "llm" else True
            return {
                "source": source if source in ("astrbot", "custom") else "custom",
                "base_url": base,
                "model": model,
                "key_saved": bool(saved.get("api_key")) or bool((default or {}).get("has_key")),
                "provider_id": (default or {}).get("provider_id", ""),
                "enabled": bool(enabled),
                "voice": str(saved.get("voice") or ""),
                "size": str(saved.get("size") or ""),
                "format": str(saved.get("format") or ""),
            }
        compression = self.api_config.get("compression") if isinstance(self.api_config.get("compression"), dict) else {}
        return {
            "functions": self._functions_public(),
            "llm": one("llm", llm),
            "embedding": one("embedding", emb),
            "rerank": one("rerank", rrk),
            "tts": one("tts", tts),
            "image": one("image", img),
            "compression": {
                "enabled": bool(compression.get("enabled", False)),
                "threshold": int(compression.get("threshold", 6000) or 6000),
                "max_chars": int(compression.get("max_chars", 800) or 800),
            },
        }

    def _functions_public(self) -> dict:
        out = {}
        for _name in LLM_FUNCTIONS:
            _cfg = self._function_cfg(_name)
            out[_name] = {
                "enabled": bool(_cfg["enabled"]),
                "provider": str(_cfg["provider"]),
                "default_enabled": bool(LLM_FUNCTION_DEFAULTS[_name]),
            }
        return out

    def _llm_provider_options(self) -> list:
        out = []
        try:
            for _p in self.context.get_all_providers():
                _cfg = getattr(_p, "provider_config", {}) or {}
                _pid = str(_cfg.get("id") or getattr(_p, "provider_id", "") or "")
                if not _pid:
                    continue
                try:
                    _model = str(getattr(_p, "get_model", lambda: "")() or _cfg.get("model") or "")
                except Exception:
                    _model = str(_cfg.get("model") or "")
                _ptype = str(_cfg.get("provider_type") or getattr(_p, "provider_type", "") or "")
                out.append({"id": _pid, "model": _model, "type": _ptype})
        except Exception:
            out = []
        return out

    @staticmethod
    def _models_url(base: str) -> str:
        b = str(base or "").strip().rstrip("/")
        if b.endswith("/rerank"):
            b = b[:-7].rstrip("/")
        if not b.endswith("/v1"):
            b = b + "/v1"
        return b + "/models"

    async def _fetch_models(self, kind: str, source: str, base_url: str, api_key: str):
        if kind == "llm":
            default = self._astrbot_llm_default()
        elif kind == "embedding":
            default = self._astrbot_embedding_default()
        elif kind == "tts":
            default = self._astrbot_tts_default()
        elif kind == "image":
            default = self._astrbot_image_default()
        else:
            default = self._astrbot_rerank_default()
        if source == "astrbot" and default:
            base_url = default.get("base_url") or base_url
            api_key = default.get("_key") or api_key
        if not base_url:
            return {"status": "error", "message": "no api base"}
        url = self._models_url(base_url)
        def do_request():
            headers = {"Accept": "application/json"}
            if api_key:
                headers["Authorization"] = "Bearer " + api_key
            req = urllib.request.Request(url, headers=headers)
            with urllib.request.urlopen(req, timeout=20) as resp:
                return json.loads(resp.read().decode("utf-8", "replace"))
        try:
            payload = await asyncio.to_thread(do_request)
        except Exception as exc:
            return {"status": "error", "message": "%s: %s" % (type(exc).__name__, exc)}
        items = payload.get("data") if isinstance(payload, dict) else payload
        if isinstance(items, dict):
            items = items.get("models") or items.get("data") or []
        models = []
        if isinstance(items, list):
            for item in items:
                if isinstance(item, dict):
                    mid = item.get("id") or item.get("model") or item.get("name")
                else:
                    mid = item
                if mid:
                    models.append(str(mid))
        return {"status": "ok", "data": {"models": sorted(set(models))}}

