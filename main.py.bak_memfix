    async def generate_manual_insight(self) -> dict:
        """Manual long-term insight (dashboard button), bypass threshold once.

        Never writes a deterministic fallback: when the insight LLM switch is
        off it only returns a message telling the user to enable it.
        """
        if not self._llm_allowed("insight"):
            return {"generated": False, "insight": "",
                    "message": "请先开启「长期模式洞察」LLM 开关再生成"}
        events = self._event_archive(12)
        if not events:
            return {"generated": False, "insight": "", "message": "还没有归档事件"}
        core = next(iter(self.cores.values()), None)
        if core is None:
            core = BioCore(dict(DEFAULT_PROFILE))
        key = next(iter(self.cores), "") or ""
        ev = types.SimpleNamespace(unified_msg_origin=key)
        ok = await self._generate_insight(ev, core, events[:6])
        insight = ""
        try:
            if INSIGHT_ARCHIVE_PATH.exists():
                lines = [x for x in INSIGHT_ARCHIVE_PATH.read_text(encoding="utf-8").splitlines() if x.strip()]
                if lines:
                    insight = str(json.loads(lines[-1]).get("insight") or "")
        except Exception:
            insight = ""
        if ok:
            try:
                # A manual generation also advances the auto dedupe state so
                # the background trigger does not immediately duplicate it.
                now = time.time()
                latest_ts = max([float(e.get("ts", 0) or 0) for e in events] or [0.0])
                seen = [str(e.get("id") or "") for e in events if str(e.get("id") or "")]
                self._save_insight_state({"last_run_ts": now, "last_event_ts": latest_ts,
                                          "seen_ids": seen[-100:]})
            except Exception:
                pass
        return {"generated": bool(ok), "insight": insight, "events": len(events),
                "message": "" if ok else "生成失败，请查看日志"}

    async def page_insight(self):
        """Manual '生成长期洞察' button: bypass threshold/cooldown once."""
        from quart import request
        _ = await request.get_json(silent=True) or {}
        return {"status": "ok", "data": await self.generate_manual_insight()}

    async def page_api_config(self):
        from quart import request
        body = await request.get_json(silent=True) or {}
        for kind in ("llm", "embedding", "rerank", "tts", "image"):
            incoming = body.get(kind)
            if not isinstance(incoming, dict):
                continue
            source = str(incoming.get("source") or "custom").strip()
            if source not in ("astrbot", "custom"):
                source = "custom"
            old = self.api_config.get(kind) if isinstance(self.api_config.get(kind), dict) else {}
            key = str(incoming.get("api_key") or "").strip()
            if not key:
                key = str(old.get("api_key") or "")
            entry = {
                "source": source,
                "base_url": str(incoming.get("base_url") or "").strip(),
                "api_key": key,
                "model": str(incoming.get("model") or "").strip(),
                "enabled": bool(incoming.get("enabled", True)),
            }
            for extra in ("voice", "size", "format"):
                if extra in incoming:
                    entry[extra] = str(incoming.get(extra) or "").strip()
            self.api_config[kind] = entry
        _incoming_functions = body.get("functions")
        if isinstance(_incoming_functions, dict):
            for _name in LLM_FUNCTIONS:
                _item = _incoming_functions.get(_name)
                if not isinstance(_item, dict):
                    continue
                _cur = dict(self.llm_functions.get(_name) or {})
                if "enabled" in _item:
                    _cur["enabled"] = bool(_item.get("enabled"))
                if "provider" in _item:
                    _cur["provider"] = str(_item.get("provider") or "follow_llm").strip() or "follow_llm"
                _cur.pop("embedding_provider", None)
                _cur.pop("rerank_provider", None)
                self.llm_functions[_name] = _cur
            self.api_config["functions"] = dict(self.llm_functions)
        comp = body.get("compression")
        if isinstance(comp, dict):
            self.api_config["compression"] = {
                "enabled": bool(comp.get("enabled", False)),
                "threshold": max(1000, int(comp.get("threshold", 6000) or 6000)),
                "max_chars": max(120, int(comp.get("max_chars", 800) or 800)),
            }
        self._save_api_config()
        logger.info("[biocore] api config saved")
        return {"status": "ok", "data": self._public_api_config()}

    async def page_kb_config(self):
        from quart import request
        body = await request.get_json(silent=True) or {}
        self.kb_enabled = bool(body.get("enabled", False))
        names = body.get("names") if isinstance(body.get("names"), list) else []
        self.kb_names = [str(x).strip() for x in names if str(x).strip()]
        self._save_settings()
        await self._persist_plugin_config({"kb_enabled": self.kb_enabled,
                                           "kb_names": self.kb_names})
        logger.info("[biocore] kb config enabled=%s names=%s", self.kb_enabled, self.kb_names)
        return {"status": "ok", "data": {"enabled": self.kb_enabled, "names": self.kb_names}}

    async def page_models(self):
        from quart import request
        body = await request.get_json(silent=True) or {}
        kind = str(body.get("kind") or "embedding").strip()
        source = str(body.get("source") or "custom").strip()
        return await self._fetch_models(kind, source,
                                        str(body.get("base_url") or ""),
                                        str(body.get("api_key") or ""))

    @staticmethod
    def _ipv4_json(url: str, headers: dict, payload: dict, timeout: float = 12.0) -> dict:
        parsed = urlparse(url)
        host = parsed.hostname or ""
        if not host:
            raise ValueError("invalid url")
        port = parsed.port or (443 if parsed.scheme == "https" else 80)
        path = parsed.path or "/"
        if parsed.query:
            path += "?" + parsed.query
        body = json.dumps(payload, ensure_ascii=False).encode("utf-8")

        class _IPv4HTTPSConnection(http.client.HTTPSConnection):
            def connect(self):
                infos = socket.getaddrinfo(self.host, self.port, socket.AF_INET, socket.SOCK_STREAM)
                ip = infos[0][4][0]
                sock = socket.create_connection((ip, self.port), self.timeout)
                self.sock = self._context.wrap_socket(sock, server_hostname=self.host)

        if parsed.scheme == "https":
            conn = _IPv4HTTPSConnection(host, port, timeout=timeout,
                                         context=ssl.create_default_context())
        else:
            conn = http.client.HTTPConnection(host, port, timeout=timeout)
        try:
            conn.request("POST", path, body=body, headers=headers)
            resp = conn.getresponse()
            raw = resp.read()
            if resp.status >= 400:
                raise RuntimeError("http %s: %s" % (resp.status, raw[:300].decode("utf-8", "replace")))
            return json.loads(raw.decode("utf-8", "replace"))
        finally:
            conn.close()

    def _embedding_runtime_config(self):
        saved = self.api_config.get("embedding") if isinstance(self.api_config.get("embedding"), dict) else {}
        if saved.get("source") == "custom" and saved.get("base_url"):
            return {"base_url": saved.get("base_url"), "api_key": saved.get("api_key", ""),
                    "model": saved.get("model", "")}
        d = self._astrbot_embedding_default()
        if d and d.get("base_url"):
            return {"base_url": d.get("base_url"), "api_key": d.get("_key", ""),
                    "model": d.get("model", "")}
        if saved.get("base_url"):
            return {"base_url": saved.get("base_url"), "api_key": saved.get("api_key", ""),
                    "model": saved.get("model", "")}
        return None

    def _embed_skip_sensitive(self, sensitive) -> bool:
        """Whether a tagged-sensitive payload must be withheld from embedding.

        Privacy filtering belongs to the safety switch (default OFF), so the
        1.2.98 behaviour stays a bitwise no-op unless ``safety_enabled`` is on.
        """
        # P1-2: sensitive text is withheld from external embeddings by default.
        return bool(sensitive) and not bool(
            getattr(self, "embedding_sensitive_allowed", False))

    async def _embed_text_guarded(self, text: str, sensitive: bool = False):
        """Embedding for already-stored memory/event text (M1 privacy gate).

        When safety is on and the payload is tagged sensitive the text is NEVER
        sent to the embedding provider: the caller receives ``None`` and keeps
        the entry/text untouched (it just has no vector). Default (safety off)
        is a no-op, identical to ``_embed_text(text)``. The TypeError fallback
        keeps one-argument ``_embed_text`` overrides used by legacy evals working.
        """
        try:
            return await self._embed_text(
                text, sensitive=self._embed_skip_sensitive(sensitive))
        except TypeError:
            return await self._embed_text(text)

    async def _embedding_for(self, kind: str, text: str, sensitive: bool = False):
        """Embedding for one function; always follows the API 接入 default.

        Per-function embedding model selection was removed by user request:
        every function uses the same global embedding configuration. ``kind``
        is kept for call-site clarity and tests.
        """
        try:
            return await self._embed_text(text, sensitive=sensitive)
        except TypeError:
            # Backward-compatible test/legacy override without the sensitive kwarg.
            return await self._embed_text(text)

    async def _rerank_scores(self, kind: str, query: str, documents: list):
        """Optional global rerank scores keyed by candidate index (None = local).

        Event ranking never asks the user to pick a model: it follows the
        API 接入 / AstrBot default rerank provider and falls back to the
        deterministic local ranking when no provider is configured or the call
        fails. ``kind`` is kept for call-site clarity and tests.
        """
        try:
            _provs = getattr(getattr(self.context, "provider_manager", None),
                             "rerank_provider_insts", []) or []
        except Exception:
            _provs = []
        _target = _provs[0] if _provs else None
        if _target is None:
            return None
        if getattr(self, "safety_enabled", False):
            # P1-2: safety on => no rerank payload leaves the process.
            return None
        try:
            _call = _target.rerank(query, [str(d) for d in documents],
                                   top_n=len(documents))
            _rto = float(getattr(self, "outbound_timeout_ms", 3000)) / 1000.0
            if _SERVICES is not None:
                _results = await _SERVICES.rerank(_call, _rto)
            else:
                _results = await asyncio.wait_for(_call, timeout=_rto)
            out = {}
            for _r in (_results or []):
                try:
                    _idx = int(getattr(_r, "index", None))
                    _score = float(getattr(_r, "relevance_score", 0.0) or 0.0)
                except Exception:
                    continue
                out[_idx] = max(0.0, min(1.0, _score))
            return out or None
        except Exception as exc:
            logger.warning("[biocore] global rerank failed; fallback to local ranking: %s", exc)
            return None

    async def _embed_text(self, text: str, sensitive: bool = False):
        text = (text or "").strip()
        if not text or sensitive:
            return None
        # P1-5: direct callers often omit the sensitive flag; classify at the
        # single entry point so sensitive payloads never leave by default.
        if not bool(getattr(self, "embedding_sensitive_allowed", False)):
            try:
                if memory_meta.classify_sensitivity(text).get("sensitive"):
                    return None
            except Exception:
                pass
        conf = self._embedding_runtime_config()
        if not conf:
            return None
        model = str(conf.get("model") or "").strip()
        # M4: the cache key hashes exactly the payload that is sent (one
        # truncation constant for both), so two texts that only differ after the
        # truncation point can never share a stale vector.
        payload_text = text[:EMBED_TEXT_MAX_CHARS]
        # P1-1: cache key includes base_url + model + configured dimension.
        base = str(conf.get("base_url") or "").rstrip("/")
        if base.endswith("/embeddings"):
            base = base[:-11]
        _dim_hint = str(conf.get("dimensions") or conf.get("dim") or "")
        _sig = (base + "|" + model + "|" + _dim_hint)
        if getattr(self, "_embed_cache_sig", None) != _sig:
            EMBED_CACHE.clear()
            self._embed_cache_sig = _sig
        cache_key = (base, model, _dim_hint, _sha256(payload_text))
        _cache_on = bool(getattr(self, "embedding_cache_enabled", True))
        if _cache_on and cache_key in EMBED_CACHE:
            EMBED_CACHE.move_to_end(cache_key)
            return EMBED_CACHE[cache_key]
        url = base + "/embeddings"
        headers = {"Content-Type": "application/json", "Accept": "application/json"}
        if conf.get("api_key"):
            headers["Authorization"] = "Bearer " + str(conf.get("api_key"))
        payload = {"model": model, "input": [payload_text], "encoding_format": "float"}
        try:
            # Embedding timeout is a config key (embedding_timeout_ms, default
            # 1500 ms) so a remote provider's real p95 can be accommodated;
            # a timed-out call returns None and never blocks the reply loop.
            _timeout_ms = getattr(self, "embedding_timeout_ms", EMBED_TIMEOUT_MS_DEFAULT)
            try:
                _timeout_s = max(0.1, min(15.0, float(_timeout_ms) / 1000.0))
            except Exception:
                _timeout_s = EMBED_TIMEOUT_S
            _call = asyncio.to_thread(self._ipv4_json, url, headers, payload, _timeout_s)
            if _SERVICES is not None:
                data = await _SERVICES.embed(_call, _timeout_s)
            else:
                data = await asyncio.wait_for(_call, timeout=_timeout_s)
            vec = data["data"][0]["embedding"]
            if not isinstance(vec, list) or not vec:
                return None
            # P2: dimension mismatch is REJECTED (not logged-and-used).
            try:
                _expected_dim = int(conf.get("dimensions") or conf.get("dim") or 0)
            except Exception:
                _expected_dim = 0
            if _expected_dim and len(vec) != _expected_dim:
                global EMBED_DIM_MISMATCH
                EMBED_DIM_MISMATCH += 1
                logger.warning("[biocore] embedding dimension rejected: got %d expected %d",
                               len(vec), _expected_dim)
                return None
            if _cache_on:
                EMBED_CACHE[cache_key] = vec
                EMBED_CACHE.move_to_end(cache_key)
                while len(EMBED_CACHE) > EMBED_CACHE_MAX:
                    EMBED_CACHE.popitem(last=False)
            return vec
        except Exception as exc:
            logger.warning("[biocore] embedding failed: %s", exc)
            return None

    @staticmethod
    def _cosine(a, b) -> float:
        if not a or not b:
            return 0.0
        if len(a) != len(b):
            # P1-1: dimension mismatch is an anomaly, never a silent zero.
            global EMBED_DIM_MISMATCH
            EMBED_DIM_MISMATCH += 1
            logger.warning("[biocore] embedding dimension mismatch: %d vs %d",
                           len(a), len(b))
            return 0.0
        dot = sum(x * y for x, y in zip(a, b))
        na = math.sqrt(sum(x * x for x in a))
        nb = math.sqrt(sum(y * y for y in b))
        return dot / (na * nb) if na and nb else 0.0

    def _dedupe_sentences(self, text: str) -> str:
        """C-S1 deterministic sentence dedup (char-bigram Jaccard >= 0.92).

        M5: only the deterministic fallback is implemented. The LIT/spec
        "embedding 0.90" + quote/code-block whitelist variants are NOT
        implemented and are no longer claimed in ACC/LIT.
        """
        if not getattr(self, "sentence_dedup_enabled", False):
            return text
        try:
            import re as _re
            parts = [p for p in _re.split(r"(?<=[。！？；！？;\n])", str(text or "")) if p.strip()]
            kept = []

            def _bigrams(s):
                s = "".join(_re.findall(r"[\u4e00-\u9fffA-Za-z0-9]", s))
                return {s[i:i + 2] for i in range(max(0, len(s) - 1))} if len(s) >= 2 else {s}

            def _jac(a, b):
                if not a and not b:
                    return 1.0
                return len(a & b) / max(1, len(a | b))

            for sent in parts:
                must = bool(_re.search(r"[0-9０-９]|不|没|别|未|无", sent))
                dup = False
                if not must:
                    b = _bigrams(sent)
                    for prev in kept:
                        if _jac(b, _bigrams(prev)) >= SENTENCE_DEDUP_THRESHOLD:
                            dup = True
                            break
                if not dup:
                    kept.append(sent)
            out = "".join(kept).strip()
            return out or str(text or "")
        except Exception:
            return text

    @staticmethod
    def _usable_memory_text(text: str) -> bool:
        t = (text or "").strip()
        if not t:
            return False
        if t.startswith("注意，你正在社交媒体"):
            return False
        if t.startswith("[BioCore]"):
            return False
        return True

    def _memory_path(self, event):
        key = str(getattr(event, "unified_msg_origin", "default") or "default")
        safe = "".join(c if c.isalnum() or c in "-_" else "_" for c in key)[:80]
        MEMORY_DIR.mkdir(parents=True, exist_ok=True)
        return MEMORY_DIR / (safe + ".json")

    def _memory_module_engine(self, event):
        """Thin AstrBot adapter: per-session shadow engine (default OFF)."""
        if not getattr(self, "memory_module_enabled", False) or MemoryEngine is None:
            return None
        try:
            key = str(getattr(event, "unified_msg_origin", "default") or "default")
            engine = getattr(self, "_memory_module_engines", {}).get(key)
            if engine is None:
                base = self._memory_path(event)
                path = base.with_suffix(base.suffix + ".module.json")
                engine = MemoryEngine(path=path, affect=None, embedder=None)
                self._memory_module_engines[key] = engine
            return engine
        except Exception:
            return None

    def _load_memory(self, event):
        try:
            d = json.loads(self._memory_path(event).read_text(encoding="utf-8"))
            if isinstance(d, dict) and isinstance(d.get("entries"), list):
                d["entries"] = [e for e in d["entries"]
                                if isinstance(e, dict)
                                and self._usable_memory_text(str(e.get("text", "")))]
                try:
                    for entry in d["entries"]:
                        entry.setdefault("inhibition", 0.0)
                        entry.setdefault("suppression_count", 0)
                        entry.setdefault("memory_tier", "warm")
                        # Lazy migration: pre-provenance data is direct user/
                        # model input, not "unknown". This runs for every old
                        # entry on load, then persists on the next save.
                        if not entry.get("memory_source") and not entry.get("memory_confidence"):
                            entry["memory_source"] = "direct"
                            entry["memory_confidence"] = 0.7
                            entry["legacy_backfilled"] = True
                    if int(d.get("schema_version", 0) or 0) < MEMORY_SCHEMA_VERSION:
                        d["schema_version"] = MEMORY_SCHEMA_VERSION
                except Exception:
                    pass
                return d
        except Exception:
            try:
                _p = self._memory_path(event)
                if _p.exists():
                    _bak = _p.with_suffix(_p.suffix + ".corrupt.bak")
                    _bak.write_bytes(_p.read_bytes())
                    self._corrupt_backups = int(getattr(self, "_corrupt_backups", 0) or 0) + 1
                    logger.warning("[biocore] memory JSON corrupt; backup saved to %s", _bak)
            except Exception:
                pass
        return {"entries": []}

    def _merge_memory_doc(self, doc, latest) -> dict:
        """Merge concurrently-written entries into the consolidation doc (BUG-03)."""
        if not isinstance(doc, dict):
            return doc
        if not isinstance(latest, dict):
            return doc
        cur = doc.get("entries") if isinstance(doc.get("entries"), list) else []
        new = latest.get("entries") if isinstance(latest.get("entries"), list) else []
        known_ids = {str(x.get("id") or "") for x in cur if isinstance(x, dict)}
        known_keys = {(str(x.get("text") or ""), round(float(x.get("ts", 0) or 0), 3))
                      for x in cur if isinstance(x, dict)}
        for entry in new:
            if not isinstance(entry, dict):
                continue
            eid = str(entry.get("id") or "")
            key = (str(entry.get("text") or ""), round(float(entry.get("ts", 0) or 0), 3))
            if (eid and eid in known_ids) or (not eid and key in known_keys):
                continue
            cur.append(entry)
            if eid:
                known_ids.add(eid)
            known_keys.add(key)
        doc["entries"] = cur
        if isinstance(latest.get("write_log"), list):
            logs = doc.get("write_log") if isinstance(doc.get("write_log"), list) else []
            for row in latest["write_log"]:
                if isinstance(row, dict) and row not in logs:
                    logs.append(row)
            doc["write_log"] = logs[-200:]
        if isinstance(latest.get("working_set"), list):
            ws = doc.get("working_set") if isinstance(doc.get("working_set"), list) else []
            for item in latest["working_set"]:
                if str(item) and str(item) not in {str(x) for x in ws}:
                    ws.append(str(item))
            doc["working_set"] = ws[-32:]
        return doc

    def _save_memory(self, event, doc):
        try:
            if isinstance(doc, dict):
                doc["schema_version"] = MEMORY_SCHEMA_VERSION
            self._memory_path(event).write_text(json.dumps(doc, ensure_ascii=False), encoding="utf-8")
        except Exception as exc:
            logger.warning("[biocore] memory save failed: %s", exc)

    def _memory_bio(self, core):
        if core is None:
            return None
        return core

    def _memory_importance(self, core, role: str) -> float:
        if core is None:
            return 0.5
        salience = 0.25 + 0.35 * float(getattr(core, "a", 0.5)) + 0.25 * abs(float(getattr(core, "v", 0.0)))
        salience += 0.15 * (1.0 - float(getattr(core, "trust", 0.5)))
        if role == "assistant":
            salience *= 0.9
        return max(0.15, min(1.0, salience))

    @staticmethod
    def _restabilize_if_expired(entry: dict, now=None) -> bool:
        """Nader reconsolidation: an expired labile window restabilizes.

        Recall is the moment the memory is re-touched, so it is also the
        moment a stale destabilized window must be closed and timestamped.
        """
        try:
            if not isinstance(entry, dict):
                return False
            if entry.get("reconsolidation_state") != "destabilized":
                return False
            _now = time.time() if now is None else float(now)
            if float(entry.get("destabilized_until", 0) or 0) >= _now:
                return False
            entry["reconsolidation_state"] = "restabilized"
            entry["restabilized_ts"] = _now
            return True
        except Exception:
            return False


    def _memory_score_parts(self, core, entry: dict, cosine: float, *,
                            query_text: str = "", hybrid: bool = False,
                            sensitive_protect: bool = False) -> dict:
        """Return the deterministic score plus its bounded component factors.

        L-T02/C-T01: storing the factors here lets the runtime expose an
        auditable retrieval-contribution trace without the LLM ever generating
        one and without changing the ranking math.
        """
        # G8: slow 30-day decay with a 0.15 floor, computed on read only.
        importance = memory_meta.effective_importance(entry)
        age = max(0.0, time.time() - float(entry.get("ts", 0) or 0))
        age_days = age / 86400.0
        _retention_model = getattr(core, "retention_model", "power_law") if core is not None else "power_law"
        # Task-20 P0-3: power law / multi-scale retention (both kept; single=legacy).
        if _retention_model in ("power_law", "multi_scale"):
            recency = memory_meta.retention_weight(age_days, _retention_model)
        else:
            recency = 1.0 / math.pow(1.0 + max(0.0, age_days) * 0.35, 0.55)
        try:
            recall_count = int(entry.get("recall_count", 0) or 0)
        except Exception:
            recall_count = 0
        # G7: co-recall counts are read through a 30-day half-life decay so
        # an old association cannot stay permanently boosted.
        assoc = memory_meta.decayed_assoc(entry)
        try:
            due = 1.15 if 0 < float(entry.get("next_review_ts", 0) or 0) <= time.time() else 1.0
        except Exception:
            due = 1.0
        try:
            stability = max(0.2, float(entry.get("stability_days", 1.0) or 1.0))
        except Exception:
            stability = 1.0
        retention = math.exp(-age_days / stability)
        try:
            _d = ACT_R_DECAY
            _b = math.log(max(1e-9, (age_days + 0.05) ** (-_d)))
            base = 1.0 / (1.0 + math.exp(-(_b + 1.0)))
        except Exception:
            base = 0.5
        try:
            # G9: read-time decay so an old self-model match cannot stay maxed.
            schema = memory_meta.effective_schema_congruence(entry)
        except Exception:
            schema = 0.0
        inhibition = memory_meta.retrieval_inhibition(entry)
        regulation = str(getattr(core, "regulation", "none") or "none") if core is not None else "none"
        regulation_mod = memory_meta.regulation_memory_modifier(entry, regulation)
        lexical_mod = 1.0
        if hybrid and query_text:
            try:
                entry_text = str(entry.get("text") or "")
                variants = memory_meta.expand_query(query_text)
                lexical = max(memory_meta.lexical_overlap(variant, entry_text)
                              for variant in variants) if variants else 0.0
                lexical_mod = 1.0 + 0.12 * lexical
            except Exception:
                lexical_mod = 1.0
        sensitive_mod = 1.0
        if sensitive_protect:
            sensitive_mod = memory_meta.sensitivity_weight(entry)
        source_weight = memory_meta.retrieval_weight(entry)
        score = (cosine * (0.40 + 0.60 * importance) * recency
                 * (0.65 + 0.35 * retention)
                 * (0.85 + 0.15 * base)
                 * (1.0 + 0.10 * math.log1p(max(0, recall_count)))
                 * due
                 * (1.0 + 0.05 * math.log1p(max(0, assoc)))
                 * source_weight
                 * (1.0 + 0.10 * schema)
                 * (1.0 - 0.15 * inhibition)
                 * regulation_mod
                 * lexical_mod
                 * sensitive_mod)
        # C-S2: retrieval salience 0.9-1.1 x mask (Seeley 2007 inspired; not attention).
        _sal_factor = 1.0
        if getattr(self, "salience_boost_enabled", False):
            try:
                _c = max(0.0, min(1.0, float(cosine)))
                if _c > 0.0:
                    _sal_factor = 0.90 + 0.20 * _c
                    score *= _sal_factor
            except Exception:
                _sal_factor = 1.0
        # Batch4 L18: Anderson & Reder 1999 (10.1037/0096-3445.128.2.186)
        # fan penalty S=S-ln(fan): score *= 1/(1+g*ln(1+assoc+links)), floor.
        if getattr(self, "fan_penalty_enabled", False):
            try:
                _links = entry.get("links") if isinstance(entry.get("links"), list) else []
                try:
                    _raw_assoc = sum(int(v) for v in (entry.get("assoc") or {}).values())
                except Exception:
                    _raw_assoc = 0
                _fan = min(int(getattr(self, "fan_cap", 32) or 32), _raw_assoc + len(_links))
                _pen = max(float(getattr(self, "fan_floor", 0.70)),
                           1.0 / (1.0 + float(getattr(self, "fan_gain", 0.10)) * math.log1p(max(0, _fan))))
                score *= _pen
            except Exception:
                pass
        return {
            "score": float(score),
            "salience": round(_sal_factor, 4),
            "cosine": round(float(cosine), 6),
            "importance": round(importance, 4),
            "recency": round(recency, 4),
            "retention": round(0.65 + 0.35 * retention, 4),
            "base": round(0.85 + 0.15 * base, 4),
            "recall_boost": round(1.0 + 0.10 * math.log1p(max(0, recall_count)), 4),
            "assoc_boost": round(1.0 + 0.05 * math.log1p(max(0, assoc)), 4),
            "due": round(due, 4),
            "source_weight": round(float(source_weight), 4),
            "schema": round(schema, 4),
            "inhibition": round(float(inhibition), 4),
            "regulation": round(float(regulation_mod), 4),
            "lexical": round(float(lexical_mod), 4),
            "sensitive": round(float(sensitive_mod), 4),
        }

    def _memory_trace_components(self, parts: dict) -> dict:
        """Read-only ranking factors for the retrieval trace (M6).

        ``salience`` is exposed only when C-S2 is enabled, so the default-off
        trace stays byte-identical to 1.2.98; the factor itself is always 1.0
        when the switch is off.
        """
        keys = ("recency", "retention", "schema", "inhibition", "regulation",
                "lexical", "sensitive", "source_weight")
        out = {k: parts[k] for k in keys if k in parts}
        if getattr(self, "salience_boost_enabled", False) and "salience" in parts:
            out["salience"] = parts["salience"]
        return out

    def _memory_score(self, core, entry: dict, cosine: float, *,
                      query_text: str = "", hybrid: bool = False,
                      sensitive_protect: bool = False) -> float:
        parts = self._memory_score_parts(
            core, entry, cosine, query_text=query_text,
            hybrid=hybrid, sensitive_protect=sensitive_protect)
        score = float(parts.get("score", 0.0))
        try:
            trace = getattr(core, "_last_memory_trace", None) if core is not None else None
            if isinstance(trace, dict):
                eid = str(entry.get("id") or "")
                if eid and eid in [str(x) for x in (trace.get("entry_ids") or [])]:
                    valence = max(-1.0, min(1.0, float(trace.get("valence", 0.0) or 0.0)))
                    score *= 1.0 + 0.04 * valence
        except Exception:
            pass
        return max(0.0, score)

    def _attention_gate_admit(self, score: float, entry_id: str = "") -> bool:
        """L17 hard/probabilistic gate (Anderson et al. 2004, 10.1037/0033-295X.111.4.1036)."""
        try:
            _a = math.log(max(1e-9, float(score)))
            _tau = math.log(RETRIEVAL_THRESHOLD) + float(getattr(self, "attention_gate_shift", 0.0) or 0.0)
            _s = max(1e-6, float(getattr(self, "attention_gate_s", 0.30) or 0.30))
            _p = 1.0 / (1.0 + math.exp(-((_a - _tau) / _s)))
            if str(getattr(self, "attention_gate_mode", "hard")) == "probabilistic":
                _seed = int(getattr(self, "attention_seed", 0) or 0)
                if _seed > 0:
                    _h = 0
                    for _ch in str(entry_id):
                        _h = (_h * 131 + ord(_ch)) % 2147483647
                    _rng = __import__("random").Random(_seed * 1000003 + _h)
                else:
                    _rng = __import__("random").Random()
                return float(_rng.random()) < _p
            return _p >= 0.5
        except Exception:
            return float(score) >= RETRIEVAL_THRESHOLD

    def _working_set_capacity(self, core) -> int:
        """Batch4 L19: Cowan 2001 capacity (default 8 legacy; flag -> cowan)."""
        if getattr(self, "cowan_capacity_enabled", False):
            return max(3, min(6, int(getattr(self, "cowan_capacity", 4) or 4)))
        return 8  # task-51: working-set capacity stays legacy 8; top-k=3 separately

    def _memory_top_k(self, core) -> int:
        """task-51: default recall top-k = 3 (not only in savings mode).

        Attention/stress still modulates downward (2..3); cowan-style capacity
        remains an engineering proxy (Ma 2014), never an absolute "4".
        """
        k = 3
        if core is not None:
            if float(getattr(core, "stress", 0.0)) > 0.65:
                k -= 1
            if float(getattr(core, "energy", 1.0)) < 0.35:
                k -= 1
            if float(getattr(core, "attention", 0.5)) < 0.3:
                k -= 1
        k = max(2, min(3, k))
        if getattr(self, "attention_topk_cap_enabled", False):
            k = min(k, int(getattr(self, "attention_topk_cap", 4) or 4))
        return k

    def _memory_thresholds(self, core):
        compression = self.api_config.get("compression") if isinstance(self.api_config.get("compression"), dict) else {}
        threshold = max(1000, int(compression.get("threshold", 6000) or 6000))
        limit = max(120, int(compression.get("max_chars", 800) or 800))
        if core is not None:
            stress = float(getattr(core, "stress", 0.0))
            threshold = int(threshold * (1.0 + 0.5 * stress))
            limit = int(limit * (1.0 + 0.2 * stress))
        return bool(compression.get("enabled")), threshold, limit

    @staticmethod
    def _select_overflow_archive(entries, room, importance_max=0.5):
        """task-38: pick low-importance unpinned rows for deterministic archive."""
        rows = [e for e in (entries or []) if isinstance(e, dict)]
        rows.sort(key=lambda e: float(e.get("ts", 0) or 0))
        try:
            keep_n = max(0, int(room or 0))
        except Exception:
            keep_n = 80
        keep = rows[-keep_n:] if keep_n else []
        overflow = []
        for row in rows:
            if row in keep:
                continue
            try:
                importance = float(row.get("importance", 0.5) or 0.5)
            except Exception:
                importance = 0.5
            if importance < float(importance_max) and not memory_meta.is_pinned(row):
                overflow.append(row)
            else:
                keep.append(row)
        keep.sort(key=lambda e: float(e.get("ts", 0) or 0))
        return keep, overflow

    def _calibration_step(self, error, samples=1) -> float:
        """task-38: adaptive calibration weight (default OFF => fixed 0.05)."""
        if getattr(self, "calibration_adaptive_enabled", False):
            return memory_meta.calibration_adaptive_delta(error, samples)
        return 0.05

    def _trim_memory(self, doc, core=None):
        entries = doc.get("entries")
        if not isinstance(entries, list):
            entries = []
            doc["entries"] = entries
        if not entries:
            return
        enabled, threshold, summary_limit = self._memory_thresholds(core)
        _pinned, _rest = memory_meta.split_pinned(entries)
        if not enabled:
            # task-38: pinned facts escape the 80-entry cap (no pin => legacy).
            if getattr(self, "memory_overflow_compact_enabled", False) and not _pinned:
                _keep, _overflow = self._select_overflow_archive(_rest, 80)
                if _overflow:
                    _archive = doc.get("overflow_archive")
                    _archive = _archive if isinstance(_archive, list) else []
                    doc["overflow_archive"] = (_archive + _overflow)[-100:]
                    entries[:] = sorted(_keep, key=lambda e: float(e.get("ts", 0) or 0))
                    return
            if _pinned:
                _room = max(0, 80 - len(_pinned))
                _tail = _rest[-_room:] if _room > 0 else []
                entries[:] = sorted(_pinned + _tail,
                                    key=lambda e: float(e.get("ts", 0) or 0))
            else:
                entries[:] = entries[-80:]
            return
        # Keep summarized originals for provenance; only trim active entries.
        # Pinned facts are always retained regardless of the active cap.
        _archived = [e for e in entries if e.get("summarized")]
        _active = [e for e in _rest if not e.get("summarized")]
        _active = _active[-200:]
        entries[:] = sorted(_archived + _pinned + _active,
                            key=lambda e: float(e.get("ts", 0) or 0))

    def _schedule_consolidation(self, event, core=None):
        enabled, threshold, _ = self._memory_thresholds(core)
        if not enabled:
            return
        try:
            doc = self._load_memory(event)
            total = sum(len(str(e.get("text", ""))) for e in (doc.get("entries") or []))
            if total <= threshold:
                return
        except Exception:
            return
        if getattr(self, "_consolidating", False):
            return
        if time.time() - float(getattr(self, "_last_consolidation", 0.0)) < 300:
            return
        self._last_consolidation = time.time()
        self._consolidating = True
        asyncio.create_task(self._consolidate_memory(event, core))

    async def _consolidate_memory(self, event, core=None, force=False):
        try:
            doc = self._load_memory(event)
            entries = doc.get("entries")
            if not isinstance(entries, list) or len(entries) < 2:
                return
            enabled, threshold, _ = self._memory_thresholds(core)
            if not enabled and not force:
                return
            total = sum(len(str(e.get("text", ""))) for e in entries)
            if total <= threshold and not force:
                return
            _delay_s = int(getattr(self, "event_summary_delay_hours", 6) or 0) * 3600
            try:
                _last_summary = float(doc.get("last_event_summary_ts", 0) or 0)
            except Exception:
                _last_summary = 0.0
            if not force and _delay_s > 0 and (_last_summary <= 0 or time.time() - _last_summary < _delay_s):
                if _last_summary <= 0:
                    doc["last_event_summary_ts"] = time.time()
                    self._save_memory(event, doc)
                return
            doc["last_event_summary_ts"] = time.time()
            _summary_use_llm = self._llm_allowed("memory_summary")
            provider = await self._provider_for("memory_summary", event) if _summary_use_llm else None
            now = time.time()
            _segments = self._segment_event_texts(entries)
            if not _segments:
                _segments = [[str(e.get("text", "")).strip() for e in entries if str(e.get("text", "")).strip()]]
            _attachments = []
            for _e in entries:
                try:
                    _attachments.extend(_e.get("attachments") or [])
                except Exception:
                    pass
            used = set()
            groups = []
            for i, e in enumerate(entries):
                if i in used or e.get("role") == "summary":
                    continue
                group = [i]
                used.add(i)
                for j in range(i + 1, len(entries)):
                    if j in used or entries[j].get("role") == "summary":
                        continue
                    if self._cosine(e.get("vector") or [], entries[j].get("vector") or []) >= 0.86:
                        group.append(j)
                        used.add(j)
                if len(group) >= 2:
                    # BUG-06: summarize in batches, never drop entries beyond 8.
                    for _off in range(0, len(group), 8):
                        _chunk = group[_off:_off + 8]
                        if len(_chunk) >= 2:
                            groups.append(_chunk)
                if len(groups) >= 9:
                    break
            if not groups:
                if time.time() - float(getattr(self, "_last_event_archive", 0.0)) > 300:
                    self._last_event_archive = time.time()
                    await self._archive_ranked_events(event, core, entries)
                    await self._maybe_archive_insight(event, core, "compression")
                return
            changed = False
            for group in groups:
                _raw_texts = [self._mask_if_safety(str(entries[i].get("text", "")).strip()) for i in group
                              if str(entries[i].get("text", "")).strip()]
                # Dedupe near-identical memories before spending summary tokens;
                # grouping above already uses embedding cosine (>=0.86).
                texts = memory_meta.dedupe_texts(_raw_texts, threshold=0.88, limit=0)
                if len(texts) < 2:
                    continue
                payload = {"summary": "", "candidates": []}
                if _summary_use_llm and provider is not None:
                    prompt = interpretation.memory_summary_prompt(texts)
                    try:
                        resp = await self._bg_llm_direct(
                            "memory_summary", provider, prompt,
                            timeout_ms=getattr(self, "summary_llm_timeout_ms", 8000))
                        payload = interpretation.parse_memory_summary_payload(
                            str(getattr(resp, "completion_text", "") or ""),
                            getattr(self, "summary_max_chars", 0))
                    except Exception as exc:
                        logger.warning("[biocore] memory summary failed: %s", exc)
                        self._record_llm_telemetry("memory_summary", "error", str(exc))
                else:
                    # Deterministic extractive summary from embedding-grouped and
                    # deduped representatives; no LLM involved.
                    payload["summary"] = "；".join(texts[:5])
                summary = self._mask_if_safety(self._summary_cap(str(payload.get("summary") or "")))
                candidates = payload.get("candidates") or []
                if not getattr(self, "llm_memory_candidates", True):
                    candidates = []
                if not summary:
                    continue
                # M1: a summary of tagged-sensitive memories is withheld from
                # the provider when safety is on (default off => unchanged).
                _summary_sens = memory_meta.classify_sensitivity(summary)
                _group_sensitive = any(bool(entries[i].get("sensitive")) for i in group)
                vec = await self._embed_text_guarded(
                    summary, _group_sensitive or bool(_summary_sens.get("sensitive")))
                if not vec:
                    continue
                importance = max(float(entries[i].get("importance", 0.5) or 0.5) for i in group)
                _sum_id = "sum_" + str(int(now)) + "_" + str(len(entries))
                for i in sorted(group, reverse=True):
                    _old = entries[i]
                    _old["summarized"] = True
                    _old["summary_id"] = _sum_id
                    _old["summarized_ts"] = now
                _src_prov = []
                for i in group:
                    _p = entries[i].get("provenance") if isinstance(entries[i], dict) else None
                    if isinstance(_p, dict):
                        _src_prov.append(_p)
                _summary_prov = {
                    "sender_id": "summary", "sender_name": "她",
                    "session": str(getattr(event, "unified_msg_origin", "") or ""),
                    "ts": now, "message_refs": [],
                    "sources": [{
                        "sender_id": str(_p.get("sender_id") or ""),
                        "sender_name": str(_p.get("sender_name") or ""),
                        "session": str(_p.get("session") or ""),
                        "ts": float(_p.get("ts", 0) or 0),
                        "message_refs": list(_p.get("message_refs") or [])[:6],
                    } for _p in _src_prov][-24:],
                }
                _summary_source = "inferred"
                _summary_conf = memory_meta.initial_confidence(_summary_source, importance)
                entries.append({"id": _sum_id, "text": self._summary_cap(summary), "role": "summary",
                                "scope": "session",
                                "vector": vec, "ts": now, "hits": 1,
                                "importance": importance, "last_used": now,
                                "summary_id": _sum_id, "provenance": _summary_prov,
                                "memory_source": _summary_source,
                                "memory_confidence": _summary_conf,
                                "memory_tier": "warm", "conflict": False,
                                "last_write_op": "ADD", "last_write_ts": now,
                                "write_ops": {"ADD": 1}, "schema_congruence": 0.0,
                                "self_defining": False, "inhibition": 0.0,
                                "suppression_count": 0,
                                "encoding_regulation": str(getattr(core, "regulation", "none") or "none"),
                                "encoding_emotion": str((getattr(core, "labels", {}) or {}).get("emotion") or "neutral"),
                                "encoding_emotion_secondary": self._secondary_emotion(core),
                                "sensitive": bool(_summary_sens.get("sensitive")),
                                "pii_types": list(_summary_sens.get("types") or []),
                                "sensitivity": float(_summary_sens.get("score") or 0.0)})
                memory_meta.append_write_log(doc, op="ADD", entry_id=_sum_id,
                                             reason="summary", ts=now)
                # LLM proposes candidate facts; the deterministic policy here
                # decides ADD/UPDATE/NOOP and can never DELETE. Confidence is
                # capped below direct-user confidence by memory_meta.
                _cand_applied = 0
                for _cand in (candidates or [])[:memory_meta.CANDIDATE_MAX]:
                    try:
                        _ctext = str(_cand.get("text") or "").strip()
                        if len(_ctext) < 4:
                            continue
                        _cvec = await self._embed_text(_ctext)
                        if not _cvec:
                            continue
                        _best, _best_cos = None, 0.0
                        for _ce in entries:
                            if not isinstance(_ce, dict) or _ce.get("deleted") or _ce.get("summarized"):
                                continue
                            _cos = self._cosine(_cvec, _ce.get("vector") or [])
                            if _cos > _best_cos:
                                _best, _best_cos = _ce, _cos
                        _res = memory_meta.apply_memory_candidate(
                            entries, _cand, match=_best, cosine=_best_cos,
                            vector=_cvec, now=now, provenance=_summary_prov)
                        _entry = _res.get("entry")
                        if _res.get("op") in ("ADD", "UPDATE") and isinstance(_entry, dict):
                            self._apply_memory_encoding(_entry, core, now, _ctext)
                            memory_meta.append_write_log(
                                doc, op=_res["op"], entry_id=str(_entry.get("id") or ""),
                                reason="candidate", ts=now)
                            _cand_applied += 1
                    except Exception:
                        continue
                if _cand_applied:
                    logger.info("[biocore] llm memory candidates applied=%s", _cand_applied)
                changed = True
            if changed:
                await self._archive_ranked_events(event, core, entries)
                await self._maybe_archive_insight(event, core, "compression")
                try:
                    self._merge_memory_doc(doc, self._load_memory(event))
                except Exception:
                    pass
                self._trim_memory(doc, core)
                if core is not None:
                    try:
                        core.integrate_noise("memory_summary", attention=0.004,
                                             energy=-0.002)
                    except Exception:
                        pass
                self._save_memory(event, doc)
                logger.info("[biocore] memory consolidated groups=%s entries=%s", len(groups), len(entries))
        finally:
            self._consolidating = False


    @staticmethod
    def _memory_command_line(cmd: dict) -> str:
        """Deterministic one-line data hint describing an executed memory command."""
        cmd = cmd or {}
        op = str(cmd.get("op") or "NOOP")
        target = str(cmd.get("target") or "").strip()[:40]
        if op == "PENDING":
            return "- 待确认：用户要求删除关于「%s」的记忆；用户回复“确认”后才执行。" % target
        if op == "DELETE":
            return "- 已删除关于「%s」的记忆（软删除，可恢复）。" % target
        if op == "RESTORE":
            return "- 已恢复最近删除的一条记忆。"
        if op == "ROLLBACK":
            _text = str((cmd.get("entry") or {}).get("text") or "")[:40]
            return "- 已把一条记忆回滚到上一版本：%s" % _text
        reason = str(cmd.get("reason") or "")
        if reason == "ambiguous":
            return "- 删除请求匹配到多条记忆，未执行；需要用户说得更具体。"
        if reason == "vague_target":
            return "- 删除请求缺少具体对象，未执行；需要用户说明要删除哪条记忆。"
        if reason == "no_match":
            # Silent: ordinary sentences containing delete words must not inject
            # a fake memory line into the prompt.
            return ""
        if reason == "no_restore_target":
            return "- 没有可恢复的已删除记忆。"
        if reason == "no_rollback_target":
            return "- 没有可回滚的记忆修改。"
        return ""

    def _self_schema_texts(self, core) -> list:
        """Bounded self-schema corpus for deterministic schema congruence."""
        texts = list(getattr(self, "schema_texts", []) or [])
        try:
            model = self.self_model or {}
            for key in ("who_am_i", "narrative"):
                value = str(model.get(key) or "").strip()
                if value:
                    texts.append(value)
            for key in ("boundaries", "consistency"):
                for item in (model.get(key) or []):
                    item = str(item or "").strip()
                    if item:
                        texts.append(item)
            if core is not None:
                for key in ("core_self", "narrative_self"):
                    value = str(getattr(core, key, "") or "").strip()
                    if value:
                        texts.append(value)
                for item in (getattr(core, "autobiography", []) or [])[-8:]:
                    if isinstance(item, dict):
                        value = str(item.get("title") or item.get("meaning") or "").strip()
                        if value:
                            texts.append(value)
        except Exception:
            pass
        return texts[:24]

    def _apply_memory_encoding(self, entry, core, now, text="") -> None:
        """Store deterministic encoding context: schema, regulation, affect."""
        if not isinstance(entry, dict):
            return
        try:
            schema = memory_meta.schema_congruence(
                text or str(entry.get("text") or ""), self._self_schema_texts(core))
            previous = 0.0
            try:
                previous = float(entry.get("schema_congruence", 0.0) or 0.0)
            except Exception:
                previous = 0.0
            entry["schema_congruence"] = round(max(previous, schema), 4)
            entry["self_defining"] = bool(
                memory_meta.is_self_defining(entry, entry["schema_congruence"]))
        except Exception:
            pass
        if core is not None:
            try:
                entry["encoding_regulation"] = str(getattr(core, "regulation", "none") or "none")
                entry["encoding_emotion"] = str((getattr(core, "labels", {}) or {}).get("emotion") or "neutral")
                entry["encoding_emotion_secondary"] = self._secondary_emotion(core)
                entry["encoding_valence"] = round(float(getattr(core, "v", 0.0) or 0.0), 3)
                entry["encoding_arousal"] = round(float(getattr(core, "a", 0.5) or 0.5), 3)
            except Exception:
                pass
        _body = text or str(entry.get("text") or "")
        try:
            sensitivity = memory_meta.classify_sensitivity(_body)
            entry["sensitive"] = bool(sensitivity.get("sensitive"))
            entry["pii_types"] = list(sensitivity.get("types") or [])
            entry["sensitivity"] = float(sensitivity.get("score") or 0.0)
        except Exception:
            pass
        try:
            poison = memory_meta.detect_poisoning(_body)
            entry["poison_risk"] = bool(poison.get("poison_risk"))
            entry["poison_signals"] = list(poison.get("signals") or [])
            entry["poison_score"] = float(poison.get("risk") or 0.0)
            if entry["poison_risk"]:
                try:
                    entry["memory_confidence"] = min(
                        float(entry.get("memory_confidence", 0.5) or 0.5), 0.25)
                except Exception:
                    entry["memory_confidence"] = 0.25
        except Exception:
            pass
        # Memory permission scope: user facts may be shared across the same
        # sender's sessions; assistant summaries stay session-local.
        _role = str(entry.get("role") or "user")
        entry.setdefault("scope", "session" if _role in ("assistant", "summary") else "user")
        try:
            entry["verification"] = memory_meta.verify_entry(entry)
        except Exception:
            pass
        entry.setdefault("inhibition", 0.0)
        entry.setdefault("suppression_count", 0)


    # ------------------------------------------------------------------
    # Privacy / deletion semantics
    # ------------------------------------------------------------------
    def _redact_archive_text(self, needle: str, session: str = "") -> int:
        """Redact a deleted memory text from event archives and insights.

        Best-effort, bounded and atomic per file: matching event fields and
        source_texts are replaced/dropped, insight rows are replaced. Source
        ids/message refs are left intact because they carry no raw text.
        """
        needle = str(needle or "").strip()
        if len(needle) < 4:
            return 0
        replacement = "[已删除]"
        fields = ("title", "event", "central_details", "peripheral_details",
                  "meaning_to_her", "reflection", "event_key")
        total = 0

        def _mutate_event(obj):
            nonlocal total
            hit = False
            for field in fields:
                value = obj.get(field)
                if isinstance(value, str) and needle in value:
                    obj[field] = value.replace(needle, replacement)
                    hit = True
            sources = obj.get("source_texts")
            if isinstance(sources, list):
                kept = [str(x) for x in sources if needle not in str(x)]
                if len(kept) != len(sources):
                    obj["source_texts"] = kept
                    obj["source_redacted"] = True
                    hit = True
            if hit:
                total += 1
            return hit

        try:
            self._rewrite_jsonl_atomic(EVENT_ARCHIVE_PATH, _mutate_event)
            if session:
                safe = "".join(c if c.isalnum() or c in "-_" else "_" for c in str(session))[:80]
                self._rewrite_jsonl_atomic(EVENT_SESSION_DIR / safe / "events.jsonl",
                                           _mutate_event)
        except Exception:
            pass

        def _mutate_insight(obj):
            nonlocal total
            value = obj.get("insight")
            if isinstance(value, str) and needle in value:
                obj["insight"] = value.replace(needle, replacement)
                total += 1
                return True
            return False

        try:
            self._rewrite_jsonl_atomic(INSIGHT_ARCHIVE_PATH, _mutate_insight)
        except Exception:
            pass
        return total

    def _propagate_memory_deletion(self, event, entry, doc, reason: str = "user_delete") -> None:
        """Propagate one memory deletion to derived summaries/events/insights."""
        try:
            if not isinstance(entry, dict) or not isinstance(doc, dict):
                return
            raw_text = str(entry.get("text") or "")
            needle = raw_text.split("\n[再巩固]")[0].strip()
            if len(needle) < 4:
                return
            now = time.time()
            # 1) summaries derived from the deleted entry in the same doc.
            for summary in (doc.get("entries") or []):
                if not isinstance(summary, dict) or summary.get("role") != "summary":
                    continue
                text = str(summary.get("text") or "")
                if needle not in text:
                    continue
                summary["text"] = text.replace(needle, "[已删除]")[:1200]
                summary["source_deleted"] = True
                try:
                    summary["memory_confidence"] = min(
                        float(summary.get("memory_confidence", 0.4) or 0.4), 0.25)
                except Exception:
                    summary["memory_confidence"] = 0.25
                memory_meta.append_write_log(doc, op="REDACT",
                                             entry_id=str(summary.get("id") or ""),
                                             reason="summary_derived", ts=now)
            # 2) event archive + insights.
            session = str(getattr(event, "unified_msg_origin", "") or "")
            changed = self._redact_archive_text(needle, session)
            if changed:
                memory_meta.append_write_log(
                    doc, op="REDACT", entry_id=str(entry.get("id") or ""),
                    reason="%s:%d" % (reason, changed), ts=now)
        except Exception as exc:
            logger.warning("[biocore] deletion propagation failed: %s", exc)

    def _cross_session_memory_entries(self, event) -> list:
        """Active memories from the same sender's other sessions (opt-in).

        Requires `cross_session_memory` and a sender id whose user file has a
        bounded `sessions` list (written by `_touch_user`). Returns
        [(session_key, entry), ...] and never mutates other docs.
        """
        if not getattr(self, "cross_session_memory", False):
            return []
        try:
            sid, _name = self._speaker(event)
            if not sid:
                return []
            path = self._user_path(event)
            if not path.exists():
                return []
            user = json.loads(path.read_text(encoding="utf-8"))
            if not isinstance(user, dict):
                return []
            current = str(getattr(event, "unified_msg_origin", "") or "")
            out = []
            for key in (user.get("sessions") or [])[-20:]:
                key = str(key or "").strip()
                if not key or key == current:
                    continue
                safe = "".join(c if c.isalnum() or c in "-_" else "_" for c in key)[:80]
                mpath = MEMORY_DIR / (safe + ".json")
                if not mpath.exists():
                    continue
                try:
                    other = json.loads(mpath.read_text(encoding="utf-8"))
                except Exception:
                    continue
                if not isinstance(other, dict):
                    continue
                for entry in (other.get("entries") or [])[-200:]:
                    if not isinstance(entry, dict):
                        continue
                    if entry.get("deleted") or entry.get("summarized"):
                        continue
                    out.append((key, entry))
            return out
        except Exception:
            return []

    def _apply_memory_trace(self, core, entries) -> dict:
        """Bounded memory-trace -> body nudge from recalled entries; trace read-only."""
        if core is None:
            return {}
        selected = [e for e in (entries or []) if isinstance(e, dict)][:8]
        if not selected:
            return {}
        total_w = 0.0
        val_sum = 0.0
        loop_count = 0
        ids = []
        for entry in selected:
            try:
                imp = max(0.05, min(1.0, float(entry.get("importance", 0.5) or 0.5)))
            except Exception:
                imp = 0.5
            try:
                val = float(entry.get("encoding_valence", entry.get("valence", 0.0)) or 0.0)
            except Exception:
                val = 0.0
            val = max(-1.0, min(1.0, val))
            val_sum += val * imp
            total_w += imp
            try:
                loop_count += max(0, int(entry.get("open_loop", 0) or 0))
            except Exception:
                pass
            eid = str(entry.get("id") or "")[:20]
            if eid:
                ids.append(eid)
        avg_val = (val_sum / total_w) if total_w > 0 else 0.0
        v_delta = max(-0.05, min(0.05, 0.05 * avg_val))
        stress_delta = max(-0.02, min(0.05, 0.005 * abs(avg_val) + 0.01 * min(3, loop_count)))
        try:
            core.apply_memory_trace(v_delta, stress_delta)
        except Exception:
            pass
        trace = {"count": len(selected), "valence": round(avg_val, 3),
                 "stress_delta": round(stress_delta, 4),
                 "entry_ids": ids[:8], "ts": round(time.time(), 3)}
        self._last_memory_trace = trace
        try:
            core._last_memory_trace = trace
        except Exception:
            pass
        return trace

    async def _memory_recall(self, event, text: str, core=None, extra: str = "", vec=None, voice: str = "", user_data=None) -> str:
        self._last_memory_meta = {"count": 0, "confidence": 0.0, "source": "unknown",
                                  "abstain": False, "tiers": {}, "answer_confidence": 0.0,
                                  "gate": "none", "conflicts": 0}
        if not self.memory_dedup_embedding or not self._usable_memory_text(text):
            return ""
        doc = self._load_memory(event)
        entries = doc.get("entries")
        if not isinstance(entries, list):
            entries = []
            doc["entries"] = entries
        # Explicit memory write commands (DELETE/RESTORE/ROLLBACK) run before
        # retrieval. A staged delete only executes on an explicit confirmation
        # turn; the command text is never stored as a new memory.
        try:
            _cmd = memory_meta.handle_delete_command(doc, text, time.time())
        except Exception:
            _cmd = {"handled": False}
        if _cmd.get("handled"):
            if str(_cmd.get("op") or "") == "DELETE":
                try:
                    self._propagate_memory_deletion(
                        event, _cmd.get("entry"), doc, reason="nl_delete")
                except Exception:
                    pass
            self._save_memory(event, doc)
            self._last_memory_meta = {"count": 0, "confidence": 0.0, "source": "unknown",
                                      "abstain": False, "tiers": {}, "answer_confidence": 0.0,
                                      "gate": "none", "conflicts": 0,
                                      "write_op": str(_cmd.get("op") or "NOOP")}
            return self._memory_command_line(_cmd)
        if vec is None:
            vec = await self._embed_text(text)
        if not vec:
            return ""
        # M1 shadow adapter (default OFF): engine recall is read-only trace.
        _mod_engine = self._memory_module_engine(event)
        if _mod_engine is not None:
            try:
                self._memory_module_last_recall = _mod_engine.recall(
                    text, budget=3, vector=vec)
            except Exception:
                self._memory_module_last_recall = None
        scored = []
        retrieval_pairs = []
        duplicate = None
        now = time.time()
        _just_restabilized = set()
        _working_set = doc.get("working_set") if isinstance(doc.get("working_set"), list) else []
        # task-38: temporal validity filter (default OFF; missing invalid_at is
        # treated as valid, so old data keeps the legacy behaviour).
        _temporal = bool(getattr(self, "temporal_validity_enabled", False))
        _mood = bool(getattr(self, "mood_congruence_enabled", False))
        _mood_factor = 1.0
        if _mood:
            try:
                _mood_factor = self._mood_multiplier(getattr(core, "v", 0.0))
            except Exception:
                _mood_factor = 1.0
        for e in entries:
            if e.get("summarized") or e.get("deleted"):
                continue
            if _temporal and not memory_meta.entry_is_valid(e, now):
                continue
            if getattr(self, "safety_enabled", False) and e.get("poison_risk"):
                continue
            if self._restabilize_if_expired(e, now):
                _just_restabilized.add(id(e))
            cosine = self._cosine(vec, e.get("vector") or [])
            score = self._memory_score(
                core, e, cosine, query_text=text,
                hybrid=bool(getattr(self, "hybrid_retrieval", True)),
                sensitive_protect=bool(getattr(self, "sensitive_memory_protection", True)))
            try:
                score *= memory_meta.working_set_boost(
                e, _working_set, ttl_seconds=memory_meta.WORKING_SET_TTL_SECONDS)
            except Exception:
                pass
            if _mood and score:
                score *= _mood_factor
            retrieval_pairs.append((e, cosine))
            if cosine >= 0.93:
                duplicate = e
            # ACT-R partial matching + retrieval threshold (named constants).
            if cosine >= PARTIAL_MATCH_THRESHOLD:
                _threshold = RETRIEVAL_THRESHOLD
                if (getattr(core, "conflict_gate_enabled", False)
                        and float(getattr(core, "conflict_ema", 0.0) or 0.0) >= 0.60):
                    _threshold += 0.05
                _admit = score >= _threshold
                if getattr(self, "attention_gate_enabled", False):
                    _admit = self._attention_gate_admit(score, str(e.get("id") or ""))
                if _admit:
                    scored.append((score, e))
        _sid, _sname = self._speaker(event)
        try:
            from .biocore_model import scheduler as _sched
            _now = time.time()
            _loops = [dict(row, id=str(row.get("topic") or index),
                           due_ts=float(row.get("due_ts") or _now),
                           last_ts=float(row.get("last_ts") or 0.0),
                           weight=float(row.get("weight") or 1.0))
                      for index, row in enumerate(getattr(core, "open_loops", None) or [])]
            _speaker_label = (("%s（%s）" % (_sname or "未知", _sid)) if _sid else (_sname or ""))
            if core is not None:
                core.open_loops_due_ranked = [r["id"] for r in
                                              _sched.due(_loops, _now, entity=_speaker_label)]
        except Exception:
            pass
        _source = memory_meta.source_for_input(text=text, extra=extra, voice=voice)
        # Mem0 UPDATE path: an explicit correction is an update request even
        # when embedding similarity is below the exact-duplicate threshold.
        # Only the conservative correction detector can nominate this target.
        _update_target = None
        _explicit_update = False
        if duplicate is None:
            try:
                _scored_ids = {id(_entry) for _score, _entry in scored}
                _best = None
                for _pair in retrieval_pairs:
                    _cand, _cos = _pair
                    if id(_cand) not in _scored_ids:
                        continue
                    if _cos < MEMORY_UPDATE_MATCH_THRESHOLD:
                        continue
                    if not memory_meta.detect_conflict(_cand.get("text", ""), text):
                        continue
                    if _best is None or _cos > _best[1]:
                        _best = (_cand, _cos)
                if _best is not None:
                    _update_target = _best[0]
            except Exception:
                _update_target = None
        if duplicate is None and _update_target is not None:
            duplicate = _update_target
            _explicit_update = True
        if duplicate is not None:
            _entry_age = max(0.0, (now - float(duplicate.get("ts", now) or now)) / 86400.0)
            duplicate["ts"] = now
            duplicate["last_used"] = now
            duplicate["hits"] = int(duplicate.get("hits", 0)) + 1
            if _sid:
                duplicate["sender_id"] = _sid
            if _sname:
                duplicate["sender_name"] = _sname
            if extra:
                duplicate["image_caption"] = str(extra).strip()[:1600]
            if voice:
                duplicate["voice_text"] = str(voice).strip()[:1200]
            duplicate["memory_source"] = memory_meta.merge_sources(duplicate.get("memory_source"), _source)
            duplicate["memory_confidence"] = memory_meta.update_confidence(
                duplicate.get("memory_confidence"),
                duplicate["memory_source"],
                hits=int(duplicate.get("hits", 0) or 0),
                review_count=int(duplicate.get("review_count", 0) or 0),
                age_days=_entry_age,
            )
            if not isinstance(duplicate.get("destination"), dict):
                duplicate["destination"] = memory_meta.build_destination(_sid, _sname)
            _conflict = (memory_meta.detect_conflict(duplicate.get("text", ""), text)
                         or _explicit_update)
            if _conflict:
                _old_text = str(duplicate.get("text", ""))
                memory_meta.merge_version(duplicate, _old_text)
                _new_text = str(text or "").strip()[:1200]
                if _new_text and _new_text != _old_text:
                    duplicate["text"] = _new_text
                    duplicate["vector"] = vec
                    duplicate["vec_updated_ts"] = now
                duplicate["conflict"] = True
                duplicate["conflict_resolved"] = bool(_explicit_update)
                try:
                    # G1/L12: key the sample by memory provenance so the
                    # bounded confidence consumer can match entries later.
                    self._record_calibration(
                        event,
                        memory_meta.normalize_source(duplicate.get("memory_source")),
                        duplicate.get("memory_confidence", 0.5),
                        0.0,
                    )
                except Exception:
                    pass
                if _explicit_update:
                    # The user explicitly corrected the fact: trust the newer
                    # direct statement, but keep the old version for rollback.
                    try:
                        _base_conf = float(duplicate.get("memory_confidence", 0.5) or 0.5)
                    except Exception:
                        _base_conf = 0.5
                    duplicate["memory_confidence"] = round(max(_base_conf, 0.78), 4)
                else:
                    try:
                        duplicate["memory_confidence"] = min(float(duplicate.get("memory_confidence", 0.5) or 0.5), 0.55)
                    except Exception:
                        duplicate["memory_confidence"] = 0.55
            if not duplicate.get("id"):
                duplicate["id"] = _sha256(str(duplicate.get("text", ""))[:300])[:12]
            duplicate["memory_tier"] = memory_meta.memory_tier(duplicate, now)
            _write_op = memory_meta.classify_write_op(
                duplicate, {"text": text[:1200]}, 1.0, conflict=_conflict or bool(duplicate.get("conflict"))
            )
            duplicate["last_write_op"] = _write_op
            _ops = duplicate.get("write_ops") if isinstance(duplicate.get("write_ops"), dict) else {}
            _ops[_write_op] = int(_ops.get(_write_op, 0) or 0) + 1
            duplicate["write_ops"] = _ops
            duplicate["provenance"] = self._memory_provenance(event, now)
            duplicate["last_write_ts"] = now
            self._apply_memory_encoding(duplicate, core, now, text)
            if _write_op != "NOOP":
                memory_meta.append_write_log(doc, op=_write_op, entry_id=duplicate.get("id", ""),
                                             reason="conflict" if _conflict else "duplicate", ts=now)
        else:
            _importance = self._memory_importance(core, "user")
            _new_entry = {"id": _sha256(str(text)[:300])[:12], "text": text[:1200],
                          "role": "user", "vector": vec, "ts": now, "hits": 1,
                          "sender_id": _sid, "sender_name": _sname,
                          "attachments": self._attachments_from_messages(event),
                          "image_caption": str(extra or "").strip()[:1600],
                          "voice_text": str(voice or "").strip()[:1200],
                          "provenance": self._memory_provenance(event, now),
                          "importance": _importance,
                          "memory_source": _source,
                          "memory_confidence": memory_meta.initial_confidence(_source, _importance),
                          "destination": memory_meta.build_destination(_sid, _sname),
                          "conflict": False,
                          "last_write_op": "ADD",
                          "last_write_ts": now,
                          "write_ops": {"ADD": 1},
                          "memory_tier": "hot",
                          "schema_congruence": 0.0,
                          "self_defining": False,
                          "inhibition": 0.0,
                          "suppression_count": 0,
                          "last_used": now, "next_review_ts": now + 86400, "review_count": 0}
            self._apply_memory_encoding(_new_entry, core, now, text)
            entries.append(_new_entry)
            memory_meta.append_write_log(doc, op="ADD", entry_id=_new_entry["id"],
                                         reason="new", ts=now)
            self._trim_memory(doc, core)
        # Task-15: memory write fill feeds L1 energy/social noise.
        if core is not None:
            try:
                core.integrate_noise("memory_write", energy=0.003, social=0.002)
            except Exception:
                pass
        self._save_memory(event, doc)
        try:
            _recent_ids = [str(_e.get("id") or "") for _e in entries[-3:]
                           if isinstance(_e, dict)]
            doc["working_set"] = memory_meta.update_working_set(
                doc.get("working_set") if isinstance(doc.get("working_set"), list) else [],
                _recent_ids, capacity=self._working_set_capacity(core),
                priorities={str(_e.get("id") or ""): float(_e.get("importance", 0.5) or 0.5)
                            for _e in entries
                            if isinstance(_e, dict) and str(_e.get("id") or "")})
            self._save_memory(event, doc)
        except Exception:
            pass
        self._schedule_consolidation(event, core)
        # task-37/38: recall budget cap, emotion gating and optional rerank are
        # all default OFF; with every switch off this block is the legacy path.
        _top_k = self._memory_top_k(core)
        if getattr(self, "memory_recall_budget_enabled", False):
            try:
                _top_k = min(_top_k, max(1, int(getattr(self, "recall_top_k", 3) or 3)))
            except Exception:
                pass
        if (getattr(self, "rumination_effect_enabled", False) and core is not None
                and float(getattr(core, "rumination_ema", 0.0) or 0.0) >= 0.60):
            _top_k = max(1, _top_k - 1)
        if getattr(self, "emotion_gating_enabled", False) and core is not None:
            try:
                _gate = self._emotion_gate_params(
                    getattr(core, "stress", 0.0), getattr(core, "v", 0.0))
                if _gate["active"]:
                    _top_k = min(_top_k, int(_gate["top_k_cap"] or 2))
                    _floor = RETRIEVAL_THRESHOLD + float(_gate["threshold_bonus"] or 0.0)
                    scored = [(s, e) for s, e in scored if float(s) >= _floor]
            except Exception:
                pass
        if getattr(self, "rerank_enabled", False) and len(scored) > 1:
            try:
                _n = min(max(1, int(getattr(self, "rerank_top_n", 5) or 5)),
                         len(scored))
                _head = scored[:_n]
                _docs = [str(e.get("text") or "")[:300] for _s, e in _head]
                _rs = await self._rerank_scores("memory_recall", text, _docs)
                if _rs:
                    _head = sorted(
                        [(_rs.get(i, 0.0), e) for i, (_s, e) in enumerate(_head)],
                        key=lambda x: x[0], reverse=True)
                    scored = _head + scored[_n:]
                    self._rerank_stats = {"calls": int(
                        getattr(self, "_rerank_stats", {}).get("calls", 0) or 0) + 1,
                        "last_n": _n, "fallback": 0}
                else:
                    self._rerank_stats = dict(
                        getattr(self, "_rerank_stats", {}) or {}, fallback=int(
                            (getattr(self, "_rerank_stats", {}) or {}).get("fallback", 0) or 0) + 1)
            except Exception:
                pass
        try:

            from biocore_model import memory_dual as _md

            _dual = _md.select([_e for _s, _e in scored], now=float(now),

                               limit=len(scored), min_score=0.0,

                               context=getattr(self, "_last_memory_context", None))

            _dual_rank = {str(row["id"]): row["score"] for row in _dual["picked"]}

            scored.sort(key=lambda x: (-_dual_rank.get(str(x[1].get("id") or ""), 0.0),

                                       -float(x[0])))

        except Exception:

            scored.sort(key=lambda x: x[0], reverse=True)
        top = memory_meta.select_top(
            scored, _top_k,
            lambda_=(0.72 if getattr(self, "hybrid_retrieval", True) else 1.0))
        try:
            self._apply_memory_trace(core, [e for _s, e in top])
        except Exception as exc:
            logger.warning("[biocore] memory trace apply failed: %s", exc)
        # L-T02 / C-T01: auditable retrieval-contribution trace (deterministic,
        # bounded to 8 rows, no text beyond the entry id). This is a trace of
        # ranking factors, not a claim of psychological causation, and it is
        # never produced by the LLM.
        try:
            _cos_by_id = {id(_e): _cos for _e, _cos in retrieval_pairs}
            _trace = []
            for _rank, (_score, _entry) in enumerate(top[:8], start=1):
                _eid = str(_entry.get("id") or "").strip()[:20]
                if not _eid:
                    continue
                _parts = self._memory_score_parts(
                    core, _entry, _cos_by_id.get(id(_entry), 0.0),
                    query_text=text,
                    hybrid=bool(getattr(self, "hybrid_retrieval", True)),
                    sensitive_protect=bool(getattr(self, "sensitive_memory_protection", False)))
                _trace.append({
                    "entry_id": _eid,
                    "rank": _rank,
                    "score": round(float(_score), 4),
                    "cosine": _parts["cosine"],
                    "importance": _parts["importance"],
                    "source": str(_entry.get("memory_source") or "direct")[:12],
                    "tier": str(_entry.get("memory_tier") or "warm")[:8],
                    "conflict": bool(_entry.get("conflict")),
                    "components": self._memory_trace_components(_parts),
                })
            self._last_cause_trace = _trace
            self._last_memory_entries = [str(e.get("id") or "")
                                         for _s, e in top if str(e.get("id") or "")][:8]
            doc["last_recall_trace"] = _trace
            self._save_memory(event, doc)
        except Exception as _trace_exc:
            logger.warning("[biocore] recall trace failed: %s", _trace_exc)
        # Nader reconsolidation + Ebbinghaus review: recalling an item makes
        # it labile, strengthens it slightly, and schedules the next review.
        _intervals = [1, 2, 4, 7, 15, 30, 60]
        _ids = []
        for _score, e in top:
            if id(e) in _just_restabilized:
                # The expired labile window was just closed in this pass; do
                # not re-open it on the same recall.
                continue
            try:
                e["recall_count"] = int(e.get("recall_count", 0) or 0) + 1
                e["last_recall"] = now
                e["reconsolidated_ts"] = now
                e["destabilized_until"] = now + float(getattr(self, "reconsolidation_seconds", 600.0))
                e["reconsolidation_state"] = "destabilized"
                _imp = float(e.get("importance", 0.5) or 0.5)
                e["importance"] = max(0.0, min(1.0, _imp + 0.015))
                _rc = int(e.get("review_count", 0) or 0) + 1
                e["review_count"] = _rc
                _st = max(1.0, min(365.0, float(e.get("stability_days", 1.0) or 1.0) * 1.8))
                e["stability_days"] = round(_st, 3)
                _days = max(_intervals[min(_rc - 1, len(_intervals) - 1)], _st)
                e["next_review_ts"] = now + _days * 86400
                # Keep the persisted id stable: dashboard delete/rollback and
                # write_log reference it; only assign one for legacy entries.
                _eid = str(e.get("id") or "").strip()
                if not _eid:
                    _eid = _sha256(str(e.get("text", ""))[:300])[:12]
                    e["id"] = _eid
                e["last_recall_regulation"] = str(getattr(core, "regulation", "none") or "none")
                _ids.append(e)
                try:
                    from biocore_model import memory_dual as _memdual_recall
                    _upd = _memdual_recall.on_recall(e, now)
                    e["storage_s"] = _upd["storage_s"]
                    e["retrieval_s"] = _upd["retrieval_s"]
                    e["access_count"] = _upd["access_count"]
                    e["last_access_ts"] = _upd["last_access_ts"]
                except Exception:
                    pass
            except Exception:
                pass
        # ACT-R-style spreading activation: co-recalled items become associated.
        for _i in range(len(_ids)):
            for _j in range(_i + 1, len(_ids)):
                try:
                    _a = _ids[_i].setdefault("assoc", {})
                    _b = _ids[_j].setdefault("assoc", {})
                    _aid = _ids[_i].get("id") or str(_i)
                    _bid = _ids[_j].get("id") or str(_j)
                    _a[_bid] = int(_a.get(_bid, 0)) + 1
                    _b[_aid] = int(_b.get(_aid, 0)) + 1
                except Exception:
                    pass
        # Memory graph links (A-MEM-like): co-recalled memories get weighted
        # directed links; the working set keeps a bounded read set per session.
        _link_lines = []
        _consistency = memory_meta.answer_consistency(top)
        try:
            for _i in range(len(_ids)):
                for _j in range(_i + 1, len(_ids)):
                    _aid = str(_ids[_i].get("id") or "").strip()
                    _bid = str(_ids[_j].get("id") or "").strip()
                    if _aid and _bid:
                        memory_meta.add_link(_ids[_i], _bid, now=now)
                        memory_meta.add_link(_ids[_j], _aid, now=now)
            _ws_current = doc.get("working_set") if isinstance(doc.get("working_set"), list) else _working_set
            doc["working_set"] = memory_meta.update_working_set(
                _ws_current, [str(e.get("id") or "") for _score, e in top],
                capacity=self._working_set_capacity(core),
                priorities={str(_e.get("id") or ""): float(_e.get("importance", 0.5) or 0.5)
                            for _e in entries
                            if isinstance(_e, dict) and str(_e.get("id") or "")})
            _top_ids = {id(e) for _score, e in top}
            _by_id = {str(e.get("id") or ""): e for e in entries
                      if isinstance(e, dict) and str(e.get("id") or "")}
            for _score, e in top:
                _chain_budget = bool(getattr(self, "chain_budget_enabled", False))
                for _lid in memory_meta.linked_ids(
                        e, limit=2, now=now,
                        min_weight=(0.5 if _chain_budget else 1.0)):
                    _nb = _by_id.get(_lid)
                    if _nb is None or id(_nb) in _top_ids:
                        continue
                    if _nb.get("deleted") or _nb.get("summarized"):
                        continue
                    if getattr(self, "safety_enabled", False) and _nb.get("poison_risk"):
                        continue
                    _nb_text = str(_nb.get("text") or "").strip().replace("\n", " ")
                    if not _nb_text:
                        continue
                    if getattr(self, "safety_enabled", False) and _nb.get("sensitive"):
                        _nb_text = memory_meta.mask_sensitive(_nb_text)
                    _link_lines.append("- 关联记忆：%s" % _nb_text[:200])
            try:
                _umo = str(getattr(event, "unified_msg_origin", "") or "")
                _chain_lines = self._chain_event_lines(_umo, text, limit=2)
                if _chain_lines:
                    _link_lines.extend(_chain_lines)
            except Exception:
                pass
            self._save_memory(event, doc)
        except Exception:
            _link_lines = []
            _consistency = 1.0
        # Retrieval-induced forgetting: similar memories that lost this
        # competition become temporarily inhibited (they are not deleted and
        # the inhibition decays over days).
        try:
            memory_meta.apply_retrieval_inhibition(
                retrieval_pairs, [str(e.get("id") or "") for _score, e in top], now)
        except Exception:
            pass
        try:
            self._save_memory(event, doc)
        except Exception:
            pass
        # Opt-in cross-session recall: promote the same sender's memories from
        # other sessions into this session (marked, capped, never leaking to
        # other senders). Default off in config.
        _foreign_lines = []
        try:
            if getattr(self, "cross_session_memory", False):
                _known_texts = {str(e.get("text") or "") for e in entries
                                if isinstance(e, dict) and not e.get("deleted")}
                _foreign = []
                for _skey, _entry in self._cross_session_memory_entries(event):
                    _etext = str(_entry.get("text") or "").strip()
                    if not _etext or _etext in _known_texts:
                        continue
                    if getattr(self, "safety_enabled", False):
                        if _entry.get("sensitive"):
                            continue
                        if str(_entry.get("role") or "") in ("assistant", "summary"):
                            continue
                        if str(_entry.get("scope") or "user") == "session":
                            continue
                    _evec = _entry.get("vector") or []
                    _ecos = self._cosine(vec, _evec) if _evec else 0.0
                    if _ecos < PARTIAL_MATCH_THRESHOLD:
                        continue
                    _escore = self._memory_score(core, _entry, _ecos)
                    if _escore < RETRIEVAL_THRESHOLD:
                        continue
                    _foreign.append((_escore, _skey, _entry))
                _foreign.sort(key=lambda item: item[0], reverse=True)
                for _escore, _skey, _entry in _foreign[:2]:
                    _copy = dict(_entry)
                    _copy["id"] = _sha256(_skey + "|" + str(_entry.get("text"))[:200])[:12]
                    _copy["shared_from_session"] = _skey
                    _copy["ts"] = now
                    _copy["hits"] = 1
                    _copy["last_used"] = now
                    _copy["memory_tier"] = "warm"
                    try:
                        _copy["memory_confidence"] = min(
                            0.55, float(_entry.get("memory_confidence", 0.6) or 0.6))
                    except Exception:
                        _copy["memory_confidence"] = 0.5
                    if not _copy.get("memory_source"):
                        _copy["memory_source"] = "inferred"
                    entries.append(_copy)
                    _known_texts.add(_etext)
                    _foreign_lines.append("- （其他会话）%s：%s" % (
                        str(_copy.get("memory_source") or "inferred"), _etext[:200]))
                    memory_meta.append_write_log(doc, op="ADD",
                                                 entry_id=_copy["id"],
                                                 reason="cross_session", ts=now)
                if _foreign_lines:
                    self._save_memory(event, doc)
        except Exception:
            _foreign_lines = []
        # G1/L12: bounded calibration -> confidence consumer. The recalled
        # top entries get a <=0.05 per-source adjustment (relationship.
        # calibration EWMA matched on memory_source) on a transient copy; the
        # stored entries and ranking are untouched, so hit@k cannot regress.
        _calibration_meta = {}
        _meta_top = top
        try:
            _calibration = self._relationship_of(user_data).get("calibration")
            if isinstance(_calibration, dict) and _calibration.get("sources") and top:
                _adjusted_top = []
                _deltas = []
                for _score, _entry in top:
                    _delta = memory_meta.calibration_confidence_delta(
                        _calibration, _entry.get("memory_source"))
                    if _delta:
                        _copy = dict(_entry)
                        try:
                            _base_conf = float(_copy.get("memory_confidence", 0.5) or 0.5)
                        except Exception:
                            _base_conf = 0.5
                        _copy["memory_confidence"] = round(
                            max(0.0, min(1.0, _base_conf + _delta)), 4)
                        _adjusted_top.append((_score, _copy))
                        _deltas.append(_delta)
                    else:
                        _adjusted_top.append((_score, _entry))
                if _deltas:
                    _meta_top = _adjusted_top
                    _calibration_meta = {
                        "calibration_delta": round(sum(_deltas) / len(_deltas), 4),
                        "calibration_entries": len(_deltas),
                    }
        except Exception:
            _meta_top = top
            _calibration_meta = {}
        self._last_memory_meta = memory_meta.summarize_recall(
            _meta_top, now, consistency=_consistency)
        if _calibration_meta:
            self._last_memory_meta.update(_calibration_meta)
        # Task-15: recall hit/confidence feeds L1 noise (no-op when off).
        if core is not None:
            try:
                _cnt = int(self._last_memory_meta.get("count", 0) or 0)
                _conf = float(self._last_memory_meta.get("confidence", 0.0) or 0.0)
                core.integrate_noise(
                    "memory_recall",
                    attention=0.006 * min(1.0, _cnt / 3.0),
                    valence=0.004 * (_conf - 0.5))
            except Exception:
                pass
        _gate = str(self._last_memory_meta.get("gate") or "none")
        lines = []
        for score, e in top:
            _entry_role = str(e.get("role") or "user")
            role = "你(已总结)" if _entry_role == "summary" else ("你" if _entry_role == "assistant" else "用户")
            if _entry_role not in ("assistant", "summary"):
                who = str(e.get("sender_name") or e.get("sender_id") or "").strip()
                if who:
                    role = who
            snippet = str(e.get("text", "")).strip().replace("\n", " ")
            if getattr(self, "sentence_dedup_enabled", False):
                snippet = self._dedupe_sentences(snippet)
            if getattr(self, "safety_enabled", False) and snippet and e.get("sensitive"):
                snippet = memory_meta.mask_sensitive(snippet)
            if snippet:
                _cap = 220
                if getattr(self, "memory_recall_budget_enabled", False):
                    try:
                        _cap = max(40, min(240, int(
                            getattr(self, "recall_single_chars", 120) or 120)))
                    except Exception:
                        _cap = 120
                lines.append("- %s：%s" % (role, snippet[:_cap]))
        lines.extend(_link_lines)
        lines.extend(_foreign_lines)
        memory_text = "\n".join(lines)
        if getattr(self, "safety_enabled", False) and _gate == "force":
            self._last_memory_meta["withheld"] = True
            self._last_memory_meta["abstain"] = True
            return ""
        return memory_text

    async def _remember(self, event, text: str, role: str = "user", core=None):
        if not self.memory_dedup_embedding or not self._usable_memory_text(text):
            return
        text = str(text).strip()
        if len(text) < 4:
            return
        vec = await self._embed_text(text)
        if not vec:
            return
        # M1 shadow adapter (default OFF): same event into the module engine.
        _mod_engine = self._memory_module_engine(event)
        if _mod_engine is not None:
            try:
                _mod_engine.remember(MemoryEvent(
                    text=text, role=role,
                    session=str(getattr(event, "unified_msg_origin", "") or ""),
                    ts=time.time(), vector=list(vec), importance=0.5))
            except Exception:
                pass
        doc = self._load_memory(event)
        entries = doc.get("entries")
        if not isinstance(entries, list):
            entries = []
            doc["entries"] = entries
        now = time.time()
        for e in entries:
            if e.get("summarized") or e.get("deleted"):
                continue
            self._restabilize_if_expired(e, now)
            _cos = self._cosine(vec, e.get("vector") or [])
            # Nader reconsolidation: a recalled memory is labile for a window;
            # new related information can update it before restabilization.
            try:
                _window = float(e.get("destabilized_until", 0) or 0)
            except Exception:
                _window = 0.0
            if _window > now and _cos >= 0.80:
                _old_text = str(e.get("text", ""))
                e["text"] = (_old_text + "\n[再巩固] " + text)[:1200]
                try:
                    _ov = [float(x) for x in (e.get("vector") or [])]
                    e["vector"] = [0.8 * a + 0.2 * b for a, b in zip(_ov, vec)]
                except Exception:
                    pass
                e["reconsolidated_ts"] = now
                e["reconsolidation_count"] = int(e.get("reconsolidation_count", 0) or 0) + 1
                e["reconsolidation_state"] = "rewritten"
                e["destabilized_until"] = 0
                self._save_memory(event, doc)
                return
            if _cos >= 0.93:
                e["ts"] = now
                e["last_used"] = now
                e["hits"] = int(e.get("hits", 0)) + 1
                self._save_memory(event, doc)
                return
        _sid, _sname = self._speaker(event)
        if role == "assistant":
            _prov = {"sender_id": "self", "sender_name": "她",
                     "session": str(getattr(event, "unified_msg_origin", "") or ""),
                     "ts": now, "message_refs": []}
        else:
            _prov = self._memory_provenance(event, now)
        entries.append({"text": text[:1200], "role": role, "vector": vec,
                        "ts": now, "hits": 1,
                        "sender_id": _sid if role == "user" else "",
                        "sender_name": _sname if role == "user" else "",
                        "attachments": self._attachments_from_messages(event) if role == "user" else [],
                        "provenance": _prov,
                        "importance": self._memory_importance(core, role),
                        "last_used": now, "next_review_ts": now + 86400, "review_count": 0})
        self._apply_memory_encoding(entries[-1], core, now, text)
        memory_meta.append_write_log(doc, op="ADD", entry_id=str(entries[-1].get("id") or ""),
                                     reason=role, ts=now)
        self._trim_memory(doc, core)
        self._save_memory(event, doc)
        self._schedule_consolidation(event, core)

    # ------------------------------------------------------------------
    # A4 continuity opener ("上次聊到").
    #
    # Deterministic only: no LLM call, no new line, no reply generation. The
    # three data sources are already persisted bio data:
    #   1) the latest consolidated memory summary / last archived session event
    #      (fallback: self_timeline past / autobiography title);
    #   2) unfinished open loops captured *before* the current turn;
    #   3) relationship state (closeness/conflict/repair/phase/absence).
    # It is injected only when the user returns after A4_CONTINUITY_GAP_SECONDS
    # and at least one of the three sources is non-empty.
    # ------------------------------------------------------------------
    def _record_continuity_feedback(self, event, continuity) -> None:
        """Persist A4 continuity usage/feedback into the memory doc (bounded)."""
        if not isinstance(continuity, dict) or not continuity:
            return
        try:
            doc = self._load_memory(event)
            loops = continuity.get("open_loops") if isinstance(continuity.get("open_loops"), list) else []
            doc["last_continuity"] = {
                "ts": round(time.time(), 3),
                "summary": str(continuity.get("summary") or "")[:80],
                "open_loops": [str(x.get("text") or "")[:60] for x in loops[:3] if isinstance(x, dict)],
                "relationship_used": bool(continuity.get("relationship")),
            }
            doc["continuity_feedback_count"] = int(doc.get("continuity_feedback_count", 0) or 0) + 1
            self._save_memory(event, doc)
            try:
                for loop in (getattr(self, "_continuity_last_loops", None) or [])[:3]:
                    if isinstance(loop, dict):
                        loop["last_mentioned_ts"] = time.time()
            except Exception:
                pass
        except Exception as exc:
            logger.warning("[biocore] continuity feedback write failed: %s", exc)

    def _continuity_summary(self, event, core):
        """Return a bounded last-session summary text, or "" when none exists."""
        try:
            doc = self._load_memory(event)
            entries = doc.get("entries") if isinstance(doc, dict) else []
            summaries = [e for e in (entries or [])
                         if isinstance(e, dict)
                         and str(e.get("role") or "") == "summary"
                         and str(e.get("text") or "").strip()]
            if summaries:
                summaries.sort(key=lambda e: float(e.get("ts", 0) or 0), reverse=True)
                text = str(summaries[0].get("text") or "")
                text = text.split("\n[再巩固]")[0]
                text = re.sub(r"\s+", " ", text).strip()
                if text:
                    return text[:80]
        except Exception:
            pass
        try:
            last = self._last_session_event(
                str(getattr(event, "unified_msg_origin", "") or ""))
            if isinstance(last, dict):
                title = str(last.get("title") or "").strip()
                detail = str(last.get("meaning_to_her")
                             or last.get("reflection")
                             or last.get("event") or "").strip()
                text = (title + ("：" + detail if detail else "")).strip()
                text = re.sub(r"\s+", " ", text)
                if text:
                    return text[:80]
        except Exception:
            pass
        try:
            timeline = getattr(core, "self_timeline", {}) if core is not None else {}
            past = timeline.get("past") if isinstance(timeline, dict) else None
            for item in reversed(past or []):
                text = re.sub(r"\s+", " ", str(item or "")).strip()
                if text:
                    return text[:80]
        except Exception:
            pass
        try:
            for item in reversed(list(getattr(core, "autobiography", []) or [])):
                if isinstance(item, dict):
                    text = str(item.get("title") or item.get("meaning") or "").strip()
                    if text:
                        return re.sub(r"\s+", " ", text)[:80]
        except Exception:
            pass
        return ""

    def _continuity_context(self, event, core, user_data, prior_loops=None):
        """Build raw A4 continuity data; returns {} when there is no history."""
        data = user_data if isinstance(user_data, dict) else {}
        absence = data.get("absence") if isinstance(data.get("absence"), dict) else {}
        try:
            gap_days = float(absence.get("gap_days", 0.0) or 0.0)
        except Exception:
            gap_days = 0.0
        if gap_days * 86400.0 < A4_CONTINUITY_GAP_SECONDS:
            return {}
        summary = self._continuity_summary(event, core)
        loops = []
        try:
            source = prior_loops if isinstance(prior_loops, list) else (
                getattr(core, "open_loops", []) if core is not None else [])
            open_loops = []
            for item in (source or []):
                if not isinstance(item, dict):
                    continue
                if str(item.get("status") or "open") != "open":
                    continue
                text = str(item.get("text") or "").strip()
                if not text:
                    continue
                due = str(item.get("due_hint") or "")
                try:
                    seen = float(item.get("last_mentioned_ts")
                                 or item.get("created_ts") or 0.0)
                except Exception:
                    seen = 0.0
                open_loops.append((0 if due in ("soon", "tomorrow") else 1,
                                   -seen, text[:60], due))
            open_loops.sort(key=lambda row: (row[0], row[1]))
            for _rank, _neg_ts, text, due in open_loops[:A4_CONTINUITY_MAX_LOOPS]:
                loops.append({"text": text, "due_hint": due})
        except Exception:
            loops = []
        relationship = data.get("relationship") if isinstance(data.get("relationship"), dict) else {}
        state = relationship.get("state") if isinstance(relationship.get("state"), dict) else {}
        rel = {}
        if state:
            for key in ("closeness", "conflict", "repair"):
                try:
                    rel[key] = round(max(0.0, min(1.0, float(state.get(key, 0.0) or 0.0))), 3)
                except Exception:
                    pass
            repair_state = relationship.get("repair_state")
            if isinstance(repair_state, dict):
                phase = str(repair_state.get("phase") or "stable")
                if phase and phase != "stable":
                    rel["phase"] = phase
            bucket = str(absence.get("bucket") or "")
            if bucket and bucket != "same_day":
                rel["absence"] = bucket
        if not summary and not loops and not rel:
            return {}
        return {"summary": summary, "loops": loops, "relationship": rel}

    @filter.on_llm_request()
    async def on_llm_request(self, event: AstrMessageEvent, req: ProviderRequest):
        try:
            from biocore_model import policy_learning as _pl_recv
            _pending = getattr(self, "_policy_pending", None)
            if isinstance(_pending, dict) and _pending.get("action"):
                _gap = max(0.0, time.time() - float(_pending.get("ts") or 0.0))
                _table = _pl_recv.update(self._load_policy_q(),
                                         _pending.get("ctx") or "",
                                         _pending["action"],
                                         _pl_recv.reward(True, _gap, 0.0))
                self._save_policy_q(_table)
                self._policy_pending = None
        except Exception:
            pass
        if not self.enabled or not self.inject_intent:
            return
        await self._ensure_profile(event)
        core = self._core(event)
        try:
            self._seed_trust_from_user(event, core)
        except Exception:
            pass
        # A4: capture open loops from *before* this turn so the continuity
        # opener cannot echo a loop created by the current message.
        _prior_open_loops = [dict(x) for x in (getattr(core, "open_loops", []) or [])
                             if isinstance(x, dict)]
        text = str(getattr(event, "message_str", "") or "").strip()
        if not text:
            text = str(getattr(req, "prompt", "") or "")
        if not text:
            for item in reversed(getattr(req, "contexts", []) or []):
                if isinstance(item, dict) and item.get("role") == "user":
                    c = item.get("content")
                    if isinstance(c, str):
                        text = c
                        break
        # P1-2: unconditional before any branch that reads it.
        _learn_session = str(getattr(event, "unified_msg_origin", "default") or "default")
        # The core must observe the incoming message; otherwise v/a/stress and
        # fallback labels only change when the model emits a hidden <biocore> tag.
        _query_vec = None
        if text and self.memory_dedup_embedding:
            try:
                _query_vec = await self._embed_text(text)
            except Exception:
                _query_vec = None
        if text:
            core.observe(text, embedding=_query_vec)
            # task-43: deterministic L1 scalars (read-only state; behaviour
            # effects are separately gated and default OFF). No LLM/token cost.
            try:
                core.update_conflict_ema(
                    text, novelty=float(core.appraisal.get("novelty", 0.0) or 0.0))
                core.update_rumination_ema(
                    text, emotion=str((core.labels or {}).get("emotion") or "neutral"),
                    intensity=float(core._intensity()),
                    novelty=float(core.appraisal.get("novelty", 0.0) or 0.0))
                core.apply_identity_threat(text)
            except Exception:
                pass
        _user_data = self._touch_user(event, core)
        # Always-on life loop: the first message is a guaranteed async context
        # (or a retry after plugin construction saw no running loop).
        try:
            self._ensure_life_task()
        except Exception:
            pass
        # Task-15: readiness is computed by L1 only when autonomy is enabled;
        # remember private sessions and start the P0-1 generator lazily.
        if (getattr(self, "proactive_autonomy", False)
                or getattr(self, "autonomy_loop_enabled", False)):
            try:
                self._update_autonomy_readiness(core, _user_data)
                if self._is_private_event(event):
                    self._register_autonomy_session(event)
                    self._ensure_life_task()
            except Exception:
                pass
        _continuity = {}
        try:
            _continuity = self._continuity_context(event, core, _user_data,
                                                   prior_loops=_prior_open_loops)
        except Exception as exc:
            logger.warning("[biocore] continuity context failed: %s", exc)
            _continuity = {}
        try:
            self._record_continuity_feedback(event, _continuity)
        except Exception:
            pass
        _img = await self._image_context(event)
        _voice = await self._voice_context(event)
        try:
            _sat_ts = time.time()
            try:
                from .biocore_model import ui_settings as _ui_sat
            except Exception:
                from biocore_model import ui_settings as _ui_sat
            _store_sat = _ui_sat.load(self)
            _acc_sat = dict((_store_sat.get('autonomy') or {}).get('accumulator') or {})
            _v_old = float(_acc_sat.get('V', 0.0) or 0.0)
            _acc_sat['V'] = round(_v_old * 0.3, 4)
            _acc_sat['last_user_msg_ts'] = round(_sat_ts, 3)
            _ui_sat.save(self, {'autonomy': {'accumulator': _acc_sat}})
            logger.info('[biocore] social satiety V %.3f -> %.3f', _v_old, _acc_sat['V'])
        except Exception:
            pass
        _appraisal_used = False
        try:
            try:
                from .biocore_model import appraisal as _appraisal_mod
            except Exception:
                from biocore_model import appraisal as _appraisal_mod

            async def _user_appraisal_llm(_prompt):
                _tmo_ms = max(8000, int(getattr(self, "outbound_timeout_ms", 3000) or 3000))
                _raw = await self._llm_v2_call(
                    "reply", _prompt, lambda raw: raw, event=event, timeout_ms=_tmo_ms)
                if not isinstance(_raw, str):
                    _raw = str(getattr(_raw, "completion_text", "") or _raw or "")
                return _raw

            _appraisal = await _appraisal_mod.probe(
                text, "", _user_appraisal_llm, timeout=None, core=core, now=time.time())
            if _appraisal:
                _dims = _appraisal.get("dims") or {}
                _ac = float(_appraisal.get("confidence", 0.0) or 0.0)
                _deltas = _appraisal_mod.appraise(_dims, confidence=_ac)
                if _deltas:
                    try:
                        from .biocore_model import feedback_flow as _fb_flow_a
                    except Exception:
                        from biocore_model import feedback_flow as _fb_flow_a
                    _payload = _appraisal_mod.feedback_payload(_deltas, _ac, source="user")
                    _fb_flow_a.apply_llm(_payload, core, time.time())
                    try:
                        _need = _appraisal_mod.needs_deltas(_dims)
                        if _need and isinstance(getattr(core, "needs", None), dict):
                            _needs = dict(core.needs)
                            for _nk, _nv in _need.items():
                                _needs[_nk] = round(max(0.0, min(1.0, float(
                                    _needs.get(_nk, 0.6) or 0.6) + _nv)), 4)
                            core.needs = _needs
                    except Exception:
                        pass
                    logger.info("[biocore] appraisal src=user dims=%s deltas=%s c=%.2f",
                                _dims, _deltas, _ac)
                    _appraisal_used = True
        except Exception as _appr_exc:
            logger.warning("[biocore] user appraisal failed: %s", _appr_exc)
        if not _appraisal_used and getattr(self, "lexical_fallback_enabled", True):
            try:
                try:
                    from .biocore_model import feedback_flow as _fb_flow_u
                except Exception:
                    from biocore_model import feedback_flow as _fb_flow_u
                _msg_class = interpretation.classify_user_msg(text)
                _kind = str(_msg_class.get("kind") or "neutral")
                _conf = float(_msg_class.get("confidence", 0.0) or 0.0)
                if _conf < 0.4:
                    _kind = "neutral"
                _msg_ts = time.time()
                if _kind == "insult":
                    self._last_insult_ts = _msg_ts
                _event_id = str(getattr(event, "message_id", "") or "")
                _fb_u = _fb_flow_u.apply_user({
                    "kind": _kind, "id": _event_id, "ts": _msg_ts}, core, _msg_ts)
                _merged = dict(_fb_u.get("deltas") or {})
                if _kind == "sad":
                    _extra = _fb_flow_u.apply_user(
                        {"kind": "sad_empathy", "id": _event_id, "ts": _msg_ts},
                        core, _msg_ts)
                    for _k, _v in (_extra.get("deltas") or {}).items():
                        _merged[_k] = round(_merged.get(_k, 0.0) + _v, 4)
                elif _kind == "affectionate":
                    _extra = _fb_flow_u.apply_user(
                        {"kind": "affection", "id": _event_id, "ts": _msg_ts},
                        core, _msg_ts)
                    for _k, _v in (_extra.get("deltas") or {}).items():
                        _merged[_k] = round(_merged.get(_k, 0.0) + _v, 4)
                logger.info("[biocore] user kind=%s conf=%.2f deltas=%s",
                            _kind, _conf, _merged)
            except Exception as _fb_u_exc:
                logger.warning("[biocore] fb.user failed: %s", _fb_u_exc)
        _mem = await self._memory_recall(event, text, core, _img, vec=_query_vec, voice=_voice,
                                         user_data=_user_data)
        try:
            from .biocore_model import runtime as _bc_reply_runtime
            _bc_reply_runtime.run_reply(_bc_reply_runtime.make_request_ctx(self, event, core, text, _user_data, _mem))
        except Exception as _bc_pipe_exc:
            logger.warning("[biocore] reply pipeline fallback: %s", _bc_pipe_exc)
        try:
            asyncio.create_task(self._maybe_archive_events(event, core))
            asyncio.create_task(self._maybe_archive_strong_event(event, core, text))
        except Exception:
            pass
        try:
            _recent_turns = [str(h.get("text") or "") for h in (core.history or [])[-6:]]
            core.bind_goal_context(memory_text=_mem, self_model=self.self_model,
                                   recent=_recent_turns, text=text)
        except Exception:
            pass
        _events = self._event_context(event)
        # L-T02..L-T12: one bounded strategy/cause/receipt token, plus optional
        # proposal-only LLM refinements (each function default OFF).
        _events_raw = self._event_archive(9)
        # Phase-1 text mode: 1-2 strongest event links (no-op for other modes).
        _event_links = []
        if (str(getattr(self, "bc_prompt_mode", "telemetry")).lower() == "text"
                and _bc_render is not None):
            try:
                _event_links = _bc_render.derive_event_links(
                    _events_raw, now=time.time())
            except Exception:
                _event_links = []
        _strategy_hint = ""
        try:
            _strategy_hint = await self._maybe_llm_hints(
                event, core, _user_data, _events_raw,
                getattr(self, "_last_memory_meta", {}) or {}, text)
        except Exception as exc:
            logger.warning("[biocore] strategy hint failed: %s", exc)
        try:
            await self._maybe_tom_probe(event, core, text, _user_data,
                                        getattr(self, "_last_memory_meta", {}) or {})
        except Exception as exc:
            logger.warning("[biocore] tom probe call failed: %s", exc)
        # task-35: proposal-only outputs get ONE deterministic [BC] consumer;
        # only built when the corresponding function switch is ON => the
        # default (all proposal functions OFF) renders nothing (1.2.99 parity).
        try:
            _proposal = {}
            _rel_data = self._relationship_of(_user_data)
            if self._llm_allowed("relationship_impression"):
                _proposal["impression"] = _rel_data
            if self._llm_allowed("tom_probe"):
                _proposal["tom"] = (_user_data.get("belief_state")
                                    if isinstance(_user_data, dict) else {})
            if self._llm_allowed("diary"):
                _diary = (self.self_model.get("diary")
                          if isinstance(getattr(self, "self_model", None), dict) else None)
                if isinstance(_diary, list) and _diary and isinstance(_diary[-1], dict):
                    _proposal["diary"] = str(_diary[-1].get("date") or "today")
            if self._llm_allowed("relationship_narrative"):
                _narr = (self.self_model.get("relationship_narratives")
                         if isinstance(getattr(self, "self_model", None), dict) else None)
                if isinstance(_narr, list) and _narr and isinstance(_narr[-1], dict):
                    _proposal["narrative"] = str(_narr[-1].get("text") or "")[:40]
            _proposal_hint = interpretation.proposal_hint_block(**_proposal) if _proposal else ""
            if _proposal_hint:
                _strategy_hint = interpretation.combine_strategy_hint(
                    _strategy_hint, _proposal_hint)
        except Exception as exc:
            logger.warning("[biocore] proposal hint failed: %s", exc)
        # task-35: workspace token only when the autonomy loop is enabled.
        _ws_token = ""
        try:
            if getattr(core, "autonomy_loop_enabled", False):
                _loop_state = getattr(core, "autonomy_loop", None)
                if isinstance(_loop_state, dict):
                    _ws_token = str(_loop_state.get("workspace_token") or "")[:16]
        except Exception:
            _ws_token = ""
        # task-35: refusal posture -> brevity (L2 truncation), default OFF.
        _brevity = "normal"
        if getattr(self, "refusal_brevity_enabled", False):
            try:
                _brevity = str(core.refusal_posture(
                    self._relationship_of(_user_data)).get("brevity") or "normal")
            except Exception:
                _brevity = "normal"
            if _brevity != "normal" and _strategy_hint:
                _strategy_hint = _strategy_hint[:60 if _brevity == "short" else 90]
        if getattr(self, "learning_bandit_enabled", False):
            try:
                _pending = (getattr(self, "_learning_pending", {}) or {}).pop(_learn_session, None)
                if isinstance(_pending, dict):
                    _same_emo = str(_pending.get("emotion") or "") == str(
                        (getattr(core, "labels", {}) or {}).get("emotion") or "")
                    _reward = self._learning_reward(
                        _pending.get("reply_len", 0), len(str(text or "")),
                        same_emotion=_same_emo)
                    self._learning_bandit_update(core, _learn_session, _reward)
            except Exception:
                pass
        self._last_user_text = str(text or "")
        if any(getattr(self, k, False) for k in (
                "learning_bandit_enabled", "learning_relationship_enabled",
                "learning_worthiness_enabled")):
            try:
                self._learning_publish(core, _learn_session)
            except Exception:
                pass
        # 1.3.1: consume last round's F3/F2 hints (bounded, inside strategy_hint).
        # P1-1: the F1 "avoid X" hint is separate (only when hint switch is ON)
        # and is NOT merged into strategy_hint.
        for _extra_hint in (getattr(self, "_repeat_hint", ""),
                            getattr(self, "_reflect_hint", "")):
            if _extra_hint:
                _strategy_hint = interpretation.combine_strategy_hint(
                    _strategy_hint, _extra_hint)
        _pending_f1_hint = str(getattr(self, "_reverse_check_hint", "") or "")[:140]
        if not getattr(self, "think_selfcheck_hint_enabled", False):
            _pending_f1_hint = ""
        self._reverse_check_hint = ""
        self._repeat_hint = ""
        self._reflect_hint = ""
        if getattr(self, "expression_chain_enabled", False):
            try:
                _expr_hint = self._expression_hint(core, _learn_session, text)
                if _expr_hint:
                    _strategy_hint = interpretation.combine_strategy_hint(
                        _strategy_hint, _expr_hint)
            except Exception:
                pass
        _kb = ""
        if getattr(self, "kb_enabled", False) and getattr(self, "kb_names", None) and self._usable_memory_text(text):
            try:
                _r = await asyncio.wait_for(
                    self.context.kb_manager.retrieve(query=text, kb_names=self.kb_names, top_m_final=3),
                    timeout=10.0)
                _kb = str((_r or {}).get("context_text") or "").strip()
            except Exception as exc:
                logger.warning("[biocore] kb retrieve failed: %s", exc)
        _base = str(getattr(req, "system_prompt", "") or "")
        # Fixed legend: once per system prompt, never inside the per-turn [BC].
        if (str(getattr(self, "bc_prompt_mode", "telemetry")).lower() == "text"
                and getattr(self, "bc_text_legend_enabled", True)
                and _bc_render is not None):
            try:
                _legend = _bc_render.text_legend()
                if _legend and _legend.split("\n")[0] not in _base:
                    _base = (_base + "\n\n" + _legend).strip()
            except Exception:
                pass
        _sid, _sname = self._speaker(event)
        _speaker = (("%s（%s）" % (_sname or "未知", _sid)) if _sid else (_sname or ""))
        _open_loops_due = sum(
            1 for _loop in (getattr(core, "open_loops", None) or [])
            if isinstance(_loop, dict)
            and str(_loop.get("status") or "open") == "open"
            and str(_loop.get("due_hint") or "") in ("soon", "tomorrow"))
        _render_args = (
            core,
            _mem.replace("[BioCore Memory]", "").strip(),
            _events.replace("[BioCore Events]", "").strip(),
            self.self_model,
            _user_data,
            _img.replace("[BioCore Image]", "").strip(),
            _kb,
            _speaker,
            _voice,
        )
        _render_kwargs = dict(
            memory_meta=getattr(self, "_last_memory_meta", {}) or {},
            open_loops=getattr(core, "open_loops", None),
            open_loops_due=_open_loops_due,
            answer_confidence=(getattr(self, "_last_memory_meta", {}) or {}).get("answer_confidence"),
            strategy_hint=_strategy_hint,
            continuity=_continuity,
            prompt_mode=getattr(self, "bc_prompt_mode", "telemetry"),
            workspace_token=_ws_token,
            brevity=_brevity,
        )
        # Phase-1 modularisation: render lives in biocore_model.render; the
        # interpretation wrapper stays for old imports/eval.
        if _bc_render is not None:
            _compact = _bc_render.render_compact(
                *_render_args, event_links=_event_links, **_render_kwargs).strip()
        else:
            _compact = interpretation.render_compact(
                *_render_args, **_render_kwargs).strip()
        # PIPE-4: active mode may take over prompt assembly (config switch only).
        # Any failure or empty result falls back to the original render path.
        try:
            _bc_mode = _bc_reply_runtime.get_mode()
        except Exception:
            _bc_mode = "shadow"
        if _bc_mode == "active":
            try:
                _bc_pipe_ctx = _bc_reply_runtime.make_request_ctx(
                    self, event, core, text, _user_data, _mem,
                    meta={"pipeline_mode": "active", "observe_core": bool(
                        getattr(self, "pipeline_observe_core", False))})
                _bc_prompt = _bc_reply_runtime.run_active(_bc_pipe_ctx)
                _bc_user = str((_bc_prompt or {}).get("prompt_user") or "").strip()
                _bc_system = str((_bc_prompt or {}).get("prompt_system") or "").strip()
                if _bc_user or _bc_system:
                    _compact = (_bc_system + "\n" + _bc_user).strip()
                    logger.info("[biocore] pipeline active prompt adopted chars=%d",
                                len(_compact))
                else:
                    logger.warning("[biocore] pipeline active empty prompt; fallback")
            except Exception as _bc_pipe_exc:
                logger.warning("[biocore] pipeline active fallback: %s", _bc_pipe_exc)
        # 1.3.1: deterministic [BC] budget + duplicate-line removal.
        _umo = str(getattr(event, "unified_msg_origin", "default") or "default")
        _budget_chars = (int(getattr(self, "bc_budget_chars", 700) or 700)
                         if getattr(self, "bc_budget_enabled", True) else 0)
        try:
            _hist_n = max(1, int(getattr(self, "bc_dedupe_history", 5) or 5))
        except Exception:
            _hist_n = 5
        _dedupe_on = bool(getattr(self, "bc_dedupe_enabled", True))
        if not getattr(self, "bc_budget_enabled", True):
            # P1-2: budget OFF => full bypass: no apply_bc_budget, no reorder,
            # no dedupe, no extract_hint_line (legacy hint position preserved).
            _block = _compact
            if _pending_f1_hint:
                _block = (_block + "\n[BH] " + _pending_f1_hint).strip()
            _inj = {"budget_enabled": False, "chars": len(_block),
                    "tokens_estimate": interpretation.estimate_bc_tokens(_block),
                    "truncated": [], "dropped_duplicates": [],
                    "essential_chars": 0, "optional_chars": 0,
                    "essential_over_budget": False, "alert": "",
                    "hint_line": _pending_f1_hint,
                    "format_version": interpretation.BC_FORMAT_VERSION}
            _compact = _block
        else:
            _compact, _inj = interpretation.compose_bc_block(
                _compact, budget_chars=_budget_chars,
                history=list(getattr(self, "_bc_history", []) or [])[-_hist_n:],
                dedupe=_dedupe_on,  # task-51: never reorder (memory-layer order wins)
                hints_enabled=bool(getattr(self, "bc_hints_enabled", True)),
                f1_hint=_pending_f1_hint, budget_enabled=True)
        _inj["ts"] = round(time.time(), 3)
        _inj["session"] = _umo
        self._last_injection_trace = _inj
        if getattr(self, "bc_trace_enabled", False):
            try:
                core.injection_trace = dict(_inj, text=_compact[:4000])
                _tn = interpretation.thought_note(
                    {"labels": getattr(core, "labels", {}),
                     "intensity": float(core._intensity())},
                    memory_count=int(((getattr(self, "_last_memory_meta", {}) or {}).get("count", 0) or 0)),
                    hint=_strategy_hint[:40], now=time.time())
                self._thought_note_current = str(_tn.get("text") or "")
                core.thought_note = self._thought_note_current
            except Exception:
                pass
        if getattr(self, "token_budget_enabled", True):
            try:
                _req_text = (str(getattr(req, "prompt", "") or "")
                             + _base + _compact)
                self._record_token_budget(
                    _umo, input_tokens=interpretation.estimate_text_tokens(_req_text),
                    estimated=True, count_call=False)
            except Exception:
                pass
        if _compact:
            self._bc_history = (list(getattr(self, "_bc_history", []) or [])
                                + [_compact])[-20:]
            # Market compliance: never mutate req.system_prompt. Inject the
            # single [BC]/[BH] block as a temporary content part instead.
            self._attach_compact(req, _compact)

    def _attach_compact(self, req, block) -> bool:
        """Market compliance: inject via a TEMP content part only.

        Never touches req.system_prompt. If TextPart is unavailable the
        injection is skipped (warning logged), never falling back to
        system_prompt mutation.
        """
        try:
            from astrbot.core.agent.message import TextPart
        except Exception as exc:
            logger.warning("[biocore] TextPart unavailable; skip [BC] injection: %s", exc)
            return False
        try:
            parts = getattr(req, "extra_user_content_parts", None)
            if parts is None:
                req.extra_user_content_parts = []
                parts = req.extra_user_content_parts
            if not isinstance(parts, list):
                logger.warning("[biocore] extra_user_content_parts unsupported; skip [BC]")
                return False
            part = TextPart(text=str(block))
            try:
                part.mark_as_temp()
            except Exception:
                pass
            parts.append(part)
            return True
        except Exception as exc:
            logger.warning("[biocore] temp content part injection failed: %s", exc)
            return False

    def _emotion_probe_acquire(self) -> bool:
        """True when a probe slot is free (busy -> False, no queueing)."""
        limit = max(1, int(getattr(self, "emotion_probe_max_inflight", 1) or 1))
        current = int(getattr(self, "_probe_inflight", 0) or 0)
        if current >= limit:
            return False
        self._probe_inflight = current + 1
        return True

    def _emotion_probe_release(self) -> None:
        self._probe_inflight = max(
            0, int(getattr(self, "_probe_inflight", 0) or 0) - 1)

    @filter.on_llm_response()
    async def on_llm_response(self, event: AstrMessageEvent, response: LLMResponse):
        if not self.enabled:
            return
        core = self._core(event)
        _reply = str(getattr(response, "completion_text", "") or "")
        _clean, _meta = interpretation.parse_response(_reply)
        if _meta:
            core.apply_affect(_meta)
        if _meta:
            try:
                try:
                    from .biocore_model import feedback_flow as _fb_flow
                except Exception:
                    from biocore_model import feedback_flow as _fb_flow
                _fb = _fb_flow.apply_llm(_meta or {}, core, time.time())
                logger.info('[biocore] fb.llm deltas=%s summary=%s',
                            _fb.get('deltas'), _fb.get('summary'))
            except Exception as _fb_exc:
                logger.warning('[biocore] fb.llm failed: %s', _fb_exc)
        # 1.3.4: always write the cleaned text back. Unknown labels drop the
        # affect update, but the visible reply must still be sanitized.
        if _clean != _reply:
            try:
                response.completion_text = _clean
                chain = getattr(response, "result_chain", None)
                if chain is not None and getattr(chain, "chain", None):
                    for comp in chain.chain:
                        if hasattr(comp, "text"):
                            comp.text = _clean
            except Exception:
                pass
        _reply = _clean
        # emotion probe: one tiny async second call; never blocks the reply.
        if getattr(self, "emotion_probe_enabled", True):
            try:
                try:
                    from .biocore_model import appraisal as _appraisal_mod
                except Exception:
                    from biocore_model import appraisal as _appraisal_mod

                async def _emotion_probe_task(_core=core, _reply_text=_reply,
                                             _user_text=str(getattr(event, "message_str", "") or "")):
                    logger.info("[biocore] emotion probe start")
                    try:
                        _probe_raw = {"value": None}

                        async def _probe_llm(_prompt):
                            _tmo_ms = max(8000, int(getattr(
                                self, "outbound_timeout_ms", 3000) or 3000))
                            logger.info("[biocore] probe llm call kind=reply timeout=%s",
                                        _tmo_ms)
                            _raw = None
                            try:
                                _raw = await self._llm_v2_call(
                                    "reply", _prompt, lambda raw: raw,
                                    event=event, timeout_ms=_tmo_ms)
                            except Exception as _probe_llm_exc:
                                logger.warning("[biocore] probe llm exc: %r",
                                               _probe_llm_exc, exc_info=True)
                            logger.info("[biocore] probe llm result type=%s len=%s",
                                        type(_raw).__name__, len(str(_raw or "")))
                            try:
                                _tele = getattr(self, "_llm_telemetry", {}) or {}
                                _rows = [row for row in (_tele.get("recent") or [])
                                         if isinstance(row, dict)
                                         and row.get("kind") == "reply"]
                                if _rows:
                                    logger.info("[biocore] probe llm telemetry=%s", _rows[0])
                            except Exception:
                                pass
                            if _raw is None:
                                logger.warning("[biocore] emotion probe llm returned None"
                                               " (provider/budget/timeout/empty)")
                            if not isinstance(_raw, str):
                                _raw = str(getattr(_raw, "completion_text", "") or _raw or "")
                            _probe_raw["value"] = _raw
                            return _raw
                        _probe = await _appraisal_mod.probe(
                            _reply_text, _user_text, _probe_llm,
                            timeout=None, core=_core, now=time.time())
                        _dims = (_probe or {}).get("dims") or {}
                        _conf = float((_probe or {}).get("confidence", 0.0) or 0.0)
                        _deltas = (_appraisal_mod.appraise(_dims, confidence=_conf)
                                   if _probe else {})
                        _applied = False
                        if _deltas:
                            _probe_meta = _appraisal_mod.feedback_payload(
                                _deltas, _conf, source="reply")
                            if _probe_meta:
                                try:
                                    from .biocore_model import feedback_flow as _probe_flow
                                except Exception:
                                    from biocore_model import feedback_flow as _probe_flow
                                _fb = _probe_flow.apply_llm(_probe_meta, _core, time.time())
                                _applied = bool(_fb.get("written") or _fb.get("changed"))
                        if not _deltas:
                            logger.info("[biocore] emotion probe raw=%r type=%s",
                                        str(_probe_raw.get("value") or "")[:200],
                                        type(_probe_raw.get("value")).__name__)
                        logger.info("[biocore] appraisal src=reply dims=%s deltas=%s c=%.2f",
                                    _dims, _deltas, _conf)
                    except Exception as _probe_exc:
                        logger.warning("[biocore] emotion probe task failed: %s",
                                       _probe_exc, exc_info=True)
                    finally:
                        try:
                            self._emotion_probe_release()
                        except Exception:
                            pass

                if not self._emotion_probe_acquire():
                    logger.debug("[biocore] emotion probe skipped (inflight)")
                else:
                    try:
                        asyncio.create_task(_emotion_probe_task())
                    except Exception as _probe_create_exc:
                        self._emotion_probe_release()
                        logger.warning("[biocore] emotion probe create_task failed: %s",
                                       _probe_create_exc, exc_info=True)
            except Exception as _probe_outer_exc:
                logger.warning("[biocore] emotion probe setup failed: %s",
                               _probe_outer_exc, exc_info=True)
        # P1-3: opt-in REAL truncation when the L1 refusal posture is active.
        # Default OFF => the reply/result_chain are untouched (1.2.99 parity).
        if getattr(self, "refusal_brevity_enabled", False):
            try:
                _posture = core.refusal_posture(
                    self._relationship_of(self._user_record(event)))
                if str(_posture.get("mode") or "comply") in ("negotiate", "decline"):
                    _cap = max(40, min(400, int(
                        getattr(self, "refusal_brevity_max_chars", 160) or 160)))
                    _cut = self._truncate_at_sentence(_reply, _cap)
                    if _cut != _reply:
                        _reply = _cut
                        response.completion_text = _reply
                        _chain = getattr(response, "result_chain", None)
                        if _chain is not None and getattr(_chain, "chain", None):
                            for _comp in _chain.chain:
                                if hasattr(_comp, "text"):
                                    _comp.text = _reply
            except Exception:
                pass
        # task-36: opt-in read-only reply-consistency projection (default OFF).
        if getattr(self, "reply_consistency_enabled", False):
            try:
                core.reply_consistency = core.evaluate_reply_consistency(_reply)
            except Exception:
                pass
        # task-36: provider usage counters (only when the provider reports it;
        # otherwise the projection stays "available": false -- never guessed).
        if getattr(self, "token_usage_enabled", False):
            try:
                _usage = self._extract_token_usage(response)
                if _usage:
                    self._record_token_usage(
                        str(getattr(event, "unified_msg_origin", "default") or "default"),
                        _usage)
            except Exception:
                pass
        _umo = str(getattr(event, "unified_msg_origin", "default") or "default")
        # P1-1: F1 split — trace writes state only (default ON, no token cost);
        # hint (default OFF) is the only path that injects next round.
        _f1_trace = bool(getattr(self, "think_selfcheck_trace_enabled", True))
        _f1_hint_on = bool(getattr(self, "think_selfcheck_hint_enabled", False))
        if _f1_trace or _f1_hint_on:
            try:
                _rc = interpretation.reverse_check(
                    _reply,
                    core_state={"intensity": float(core._intensity()),
                                "v": float(getattr(core, "v", 0.0) or 0.0),
                                "stress": float(getattr(core, "stress", 0.0) or 0.0)},
                    previous_replies=list(getattr(self, "_recent_replies", []) or [])[-3:],
                    low_confidence=bool((getattr(self, "_last_memory_meta", {}) or {}).get("abstain")),
                    boundary_pressure=float(getattr(core, "boundary_pressure", 0.0) or 0.0))
                self._last_reverse_check = _rc
                if _f1_trace:
                    core.reverse_check = _rc
                # P2: disabled hint must not leave a stale pending line.
                self._reverse_check_hint = (str(_rc.get("hint") or "")[:140]
                                            if _f1_hint_on else "")
            except Exception:
                self._reverse_check_hint = ""
        else:
            # both switches off mid-flight: drop any pending F1 hint.
            self._reverse_check_hint = ""
        # task-39 F3: repeat guard (default OFF) — mark only, never rewrite.
        if getattr(self, "think_repeat_guard_enabled", False):
            try:
                _rg = interpretation.repeat_guard(
                    _reply, list(getattr(self, "_recent_replies", []) or [])[-3:])
                self._repeat_guard = _rg
                if _rg.get("flag") == "repeat":
                    self._repeat_streak = int(getattr(self, "_repeat_streak", 0) or 0) + 1
                else:
                    self._repeat_streak = 0
                # §6: hint only after 2 consecutive repeats.
                self._repeat_hint = ("不要重复上一句，换一种说法"
                                     if self._repeat_streak >= 2 else "")
            except Exception:
                pass
        # task-39 F2: triggered reflection (default OFF, silent fallback).
        if getattr(self, "think_reflect_enabled", False):
            try:
                await self._maybe_think_reflect(event, core, _reply, text)
            except Exception:
                pass
        # §6: read-only sycophancy / risky-agreement trace (never rewrites text).
        if getattr(self, "sycophancy_check_enabled", True):
            try:
                _syco = interpretation.sycophancy_check(
                    _reply,
                    core_state={"intensity": float(core._intensity())},
                    risky=bool((getattr(core, "labels", {}) or {}).get("emotion")
                               in ("anger", "fear")))
                core.sycophancy_check = _syco
            except Exception:
                pass
                # task-54/55: relationship chain + Big5 effect + bandit pending (default OFF).
        try:
            if (getattr(self, "relationship_chain_enabled", False)
                    or getattr(self, "gottman_enabled", False)
                    or getattr(self, "big5_effect_enabled", False)
                    or getattr(self, "learning_relationship_enabled", False)):
                self._apply_relationship_chain(
                    event, core, str(getattr(self, "_last_user_text", "") or ""), _reply)
            if getattr(self, "learning_bandit_enabled", False):
                self._learning_pending[_umo] = {
                    "reply_len": len(_reply),
                    "emotion": str((getattr(core, "labels", {}) or {}).get("emotion") or ""),
                    "ts": time.time()}
                self._learning_publish(core, _umo)
        except Exception:
            pass
# task-37 token/cost measurement (read-only; real usage else estimate).
        if getattr(self, "token_budget_enabled", True):
            try:
                _usage = self._extract_token_usage(response)
                if _usage:
                    self._record_token_budget(
                        _umo,
                        output_tokens=int(_usage.get("completion_tokens", 0) or 0),
                        cached_tokens=int(_usage.get("cached_tokens", 0) or 0),
                        estimated=False, core=core)
                else:
                    self._record_token_budget(
                        _umo, output_tokens=interpretation.estimate_text_tokens(_reply),
                        estimated=True, core=core)
            except Exception:
                pass
        # task-39/40: path-dependence monitors (default OFF, read-only).
        if getattr(self, "path_monitor_enabled", False):
            try:
                _labels = list(getattr(self, "_label_history", []) or [])
                _labels.append(str((getattr(core, "labels", {}) or {}).get("emotion") or ""))
                self._label_history = _labels[-8:]
                self._path_monitor = interpretation.path_dependence_metrics(
                    list(getattr(self, "_recent_replies", []) or []) + [_reply],
                    self._label_history,
                    [str(_e.get("big_summary") or "")
                     for _e in self._event_archive(2) if isinstance(_e, dict)])
                core.path_monitor = dict(self._path_monitor)
            except Exception:
                pass
        # thought note lives for this turn only: clear before the next round.
        core.thought_note = None
        self._thought_note_current = ""
        if _reply:
            self._recent_replies = ([str(_reply)]
                                    + list(getattr(self, "_recent_replies", []) or []))[:5]
        # Final exit guard (double insurance): sanitize once more before output.
        try:
            _final = _sanitize_output(_reply)
            if _final != _reply:
                _reply = _final
                response.completion_text = _reply
                _chain = getattr(response, "result_chain", None)
                if _chain is not None and getattr(_chain, "chain", None):
                    for _comp in _chain.chain:
                        if hasattr(_comp, "text"):
                            _comp.text = _reply
        except Exception:
            pass
        try:
            core.record_reply(_reply, _meta)
        except Exception:
            pass
        try:
            homeostasis.metabolize_reply(core, _reply)
        except Exception:
            pass
        try:
            if _reply:
                asyncio.create_task(self._remember(event, _reply, "assistant", core))
        except Exception:
            pass
        try:
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            key = str(getattr(event, "unified_msg_origin", "default") or "default")
            safe = "".join(c if c.isalnum() or c in "-_" else "_" for c in key)[:80]
            (STATE_DIR / (safe + ".json")).write_text(
                json.dumps(core.snapshot(), ensure_ascii=False, indent=1), encoding="utf-8")
        except Exception:
            pass
        # L-T01/L-T08/L-T12: background proposal-only tasks. They self-check
        # the per-function switch + cooldown, so default OFF means zero calls.
        try:
            asyncio.create_task(self._maybe_relationship_impression(event, core))
            asyncio.create_task(self._maybe_diary(event, core))
            asyncio.create_task(self._maybe_relationship_narrative(event, core))
        except Exception:
            pass


# ---------------------------------------------------------------- block assembly
# main.py declares no assembly logic: biocore_model/blocks.py owns the block
# list (11 core mixins + routes/config plugin mixins + pipeline + feedback) and
# assemble() builds the effective classes from ui_settings.blocks.enabled
# (missing switch = enabled). The mixin implementation is the only copy now.
try:
    _ASSEMBLY_HOST = types.SimpleNamespace(data_dir=str(DATA_DIR))
    _ASSEMBLY = _bc_blocks.assemble(_ASSEMBLY_HOST, BioCore, BioCorePlugin,
                                    host_globals=globals())
    BioCore = _ASSEMBLY["core_cls"]
except Exception as _assembly_exc:  # pragma: no cover
    logger.warning("[biocore] block assembly failed: %s", _assembly_exc)
