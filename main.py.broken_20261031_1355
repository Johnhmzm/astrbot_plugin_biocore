    def _latest_private_core(self):
        try:
            for key, core in reversed(list(self.cores.items())):
                if "GroupMessage" not in str(key) and core is not None:
                    return key, core
        except Exception:
            pass
        # Fallback: after a restart the in-memory registry is empty, but the
        # per-session state file still exists. Rebuild the newest private core
        # so /page/autonomy_check works without waiting for a new message.
        try:
            files = sorted(
                STATE_DIR.glob("*FriendMessage*.json"),
                key=lambda path: path.stat().st_mtime, reverse=True)
            if files:
                state_file = files[0]
                key = state_file.stem
                core = BioCore(self.profile or DEFAULT_PROFILE)
                core.load_state(json.loads(state_file.read_text(encoding="utf-8")))
                core.autonomy_enabled = bool(getattr(self, "proactive_autonomy", False))
                core.autonomy_loop_enabled = bool(
                    getattr(self, "autonomy_loop_enabled", False))
                self.cores[key] = core
                return key, core
        except Exception:
            pass
        return "", None

    def _autonomy_template(self, core) -> str:
        """Task-15: state-style deterministic proactive text (no summaries/LLM).

        Uses only need + current emotion + closeness band, so the send cannot
        leak event titles or stale summaries and stays reproducible.
        """
        labels = getattr(core, "labels", {}) or {}
        need = str(labels.get("need") or "talk")
        emotion = str(labels.get("emotion") or "neutral")
        need_txt = {"space": "你先忙，我不打扰。",
                    "share": "想听听你今天的碎片。",
                    "vent": "要是想说，我在。",
                    "be_heard": "我在听。",
                    "talk": "想和你说两句。"}.get(need, "想和你说两句。")
        emotion_txt = {"joy": "心情还算轻",
                       "sadness": "心里有点沉",
                       "anger": "有点憋着火",
                       "fear": "有点不安",
                       "loneliness": "有点想人陪",
                       "neutral": "情绪平稳"}.get(emotion, "情绪平稳")
        try:
            rel = getattr(core, "relationship_context", None) or {}
            closeness = float((rel.get("state") or {}).get("closeness", 0.5) or 0.5)
        except Exception:
            closeness = 0.5
        if closeness >= 0.65:
            close_txt = "和你还挺亲近"
        elif closeness <= 0.35:
            close_txt = "和你有点距离"
        else:
            close_txt = "和你平常"
        return ("%s%s，%s。" % (need_txt, emotion_txt, close_txt))[:AUTONOMY_MAX_CHARS_MAX]

    def _autonomy_gate(self, core, relationship, now=None):
        """Task-15: L3 applies send gates to an L1 readiness result."""
        if core is None:
            return None, {"enabled": False}
        try:
            current = float(now if now is not None else time.time())
            state = core.autonomy_state(relationship, now=current)
            if not state.get("enabled") or not state.get("ready"):
                return None, state or {}
            # Stage-2: refusal_protocol is now a real gate, not a posture token.
            rel_state = relationship.get("state") if isinstance(relationship, dict) else {}
            rel_state = rel_state if isinstance(rel_state, dict) else {}
            try:
                protocol = relationship_meta.refusal_protocol({
                    "boundary_pressure": float(getattr(core, "boundary_pressure", 0.0) or 0.0),
                    "trust": float(rel_state.get("trust", 0.5) or 0.5),
                    "conflict": float(rel_state.get("conflict", 0.0) or 0.0),
                })
            except Exception:
                protocol = {"mode": "comply"}
            if str(protocol.get("mode") or "comply") == "decline":
                return None, state
            if str(protocol.get("mode") or "comply") == "negotiate":
                state = dict(state)
                _cap = 90
                # task-35: opt-in refusal brevity also tightens proactive output.
                if getattr(self, "refusal_brevity_enabled", False):
                    _cap = 60
                state["max_chars"] = min(int(state.get("max_chars") or 120), _cap)
            hour = time.localtime(current).tm_hour
            if AUTONOMY_QUIET_START_HOUR <= hour < AUTONOMY_QUIET_END_HOUR:
                return None, state
            last_ts = float(state.get("last_sent_ts", 0.0) or 0.0)
            if last_ts > 0 and (current - last_ts) < AUTONOMY_COOLDOWN_SECONDS:
                return None, state
            day = time.strftime("%Y-%m-%d", time.localtime(current))
            sent_count = int(state.get("sent_count", 0) or 0)
            if str(state.get("sent_day") or "") != day:
                sent_count = 0
            if sent_count >= AUTONOMY_DAILY_CAP:
                return None, state
            max_chars = int(state.get("max_chars") or 120)
            text = self._autonomy_template(core)[:max(1, max_chars)].strip()
            return (text or None), state
        except Exception:
            return None, {"enabled": False}

    async def _maybe_proactive_send(self, event, core, now=None) -> bool:
        """Task-15: private-only send of the deterministic template."""
        if not getattr(self, "proactive_autonomy", False):
            return False
        if not getattr(self, "proactive_send", False) or core is None:
            return False
        if not self._is_private_event(event):
            return False
        try:
            current = float(now if now is not None else time.time())
            try:
                user_data = self._user_record(event)
            except Exception:
                user_data = {}
            text, state = self._autonomy_gate(
                core, self._relationship_of(user_data), now=current)
            if not text:
                return False
            await event.send(MessageChain([Plain(text)]))
            day = time.strftime("%Y-%m-%d", time.localtime(current))
            sent_count = int(state.get("sent_count", 0) or 0)
            if str(state.get("sent_day") or "") != day:
                sent_count = 0
            core._proactive_autonomy.update({
                "last_sent_ts": round(current, 3),
                "sent_day": day,
                "sent_count": sent_count + 1,
                "last_sent_chars": len(text),
            })
            return True
        except Exception as exc:
            logger.warning("[biocore] proactive send failed: %s", exc)
            return False

    def _register_autonomy_session(self, event) -> None:
        """Task-15: remember one private session for the background generator."""
        try:
            try:
                from .biocore_model import ui_settings as _ui
            except Exception:
                from biocore_model import ui_settings as _ui
            _store = _ui.load(self)
            try:
                from .biocore_model import autonomy_loop as _loop
            except Exception:
                from biocore_model import autonomy_loop as _loop
            _acc = dict((_store.get("autonomy") or {}).get("accumulator") or {})
            try:
                _acc["last_user_text"] = str(getattr(event, "message_str", "") or getattr(event, "raw_message", "") or "")[:120]
            except Exception:
                pass
            _acc["last_user_msg_ts"] = round(time.time(), 3)
            _acc["self_blame_reply_ts"] = round(time.time(), 3)
            _v_before = float(_acc.get("V", 0.0) or 0.0)
            _acc = _loop.on_user_reply(_acc, time.time())
            try:
                try:
                    from .biocore_model import attribution as _attr
                except Exception:
                    from biocore_model import attribution as _attr
                _inferred = _attr.infer({"text": _acc.get("last_user_text", "")})
                _acc["attribution"] = _inferred
                _deltas = _attr.apply(_acc.get("attribution_state") or {}, _inferred, time.time())
                if _deltas:
                    _acc["attribution_state"] = dict(_deltas)
            except Exception:
                pass
            try:
                try:
                    from .biocore_model import self_esteem as _se
                except Exception:
                    from biocore_model import self_esteem as _se
                _acc["self_esteem_state"] = _se.update(_acc.get("self_esteem_state") or _se.initial(time.time()), "replied", time.time())
                try:
                    try:
                        from .biocore_model import social_pain as _sp
                    except Exception:
                        from biocore_model import social_pain as _sp
                    _acc["social_pain_state"] = _sp.update(_acc.get("social_pain_state") or _sp.initial(time.time()), "replied", time.time())
                except Exception:
                    pass
                try:
                    try:
                        _core_user = self._core(event)
                    except Exception:
                        _core_user = None
                    if _core_user is not None:
                        self._apply_user_feedback(_core_user, {"kind": "reply", "id": str(getattr(event, "message_id", "") or ""), "ts": time.time()}, time.time())
                except Exception:
                    pass
            except Exception:
                pass
            logger.info("[biocore] autonomy user-reply hook V %.3f -> %.3f", _v_before, float(_acc.get("V", 0.0) or 0.0))
            _ui.save(self, {"autonomy": {"accumulator": _acc}})
            try:
                _core = self._core(event)
                _core.v = max(-1.0, min(1.0, float(getattr(_core, "v", 0.0) or 0.0) + 0.04))
                _core.social = max(0.0, min(1.0, float(getattr(_core, "social", 0.0) or 0.0) + 0.05))
            except Exception:
                pass
        except Exception:
            pass
        try:
            umo = str(getattr(event, "unified_msg_origin", "") or "").strip()
            if not umo:
                return
            sid, sname = self._speaker(event)
            self._autonomy_private_sessions[umo] = {
                "umo": umo, "sender_id": sid, "sender_name": sname,
                "ts": round(time.time(), 3),
            }
            if len(self._autonomy_private_sessions) > 20:
                _items = sorted(self._autonomy_private_sessions.items(),
                                key=lambda kv: float(kv[1].get("ts", 0.0) or 0.0),
                                reverse=True)[:20]
                self._autonomy_private_sessions = dict(_items)
        except Exception:
            pass

    def _ensure_autonomy_task(self) -> None:
        """P0-1: start the generator only when task-15 or task-28 is on."""
        if not (getattr(self, "proactive_autonomy", False)
                or getattr(self, "autonomy_loop_enabled", False)):
            return
        try:
            task = getattr(self, "_autonomy_task", None)
            if task is None or task.done():
                self._autonomy_task = asyncio.create_task(self._autonomy_loop())
                logger.info("[biocore] autonomy task started")
        except Exception as exc:
            logger.warning("[biocore] autonomy task start failed: %s", exc)

    async def _autonomy_loop(self) -> None:
        """P0-1: 5-minute deterministic tick; exits immediately when disabled."""
        if getattr(self, "_autonomy_loop_alive", False):
            logger.warning("[biocore] autonomy loop already running; skip duplicate")
            return
        self._autonomy_loop_alive = True
        logger.info("[biocore] autonomy loop entered")
        try:
            while (getattr(self, "proactive_autonomy", False)
                   or getattr(self, "autonomy_loop_enabled", False)):
                await asyncio.sleep(AUTONOMY_TICK_SECONDS)
                if not (getattr(self, "proactive_autonomy", False)
                        or getattr(self, "autonomy_loop_enabled", False)):
                    break
                try:
                    await self._autonomy_tick()
                except Exception:
                    pass
        except asyncio.CancelledError:
            self._autonomy_loop_alive = False
            return
        except Exception as exc:
            logger.warning("[biocore] autonomy loop crashed: %s", exc)
            self._autonomy_loop_alive = False
            return
        finally:
            self._autonomy_loop_alive = False

    @staticmethod
    def _autonomy_exit_plan(acted: bool, loop_on: bool, proactive_on: bool,
                            proactive_send: bool, token_only: bool) -> str:
        """Single-exit decision for one autonomy tick (spec §7.1 / S20).

        Returns "token" (loop broadcast only; nothing is sent), "send" (the
        existing task-15 send gate may run) or "none". It can never return two
        exits for the same session/tick.
        """
        if not proactive_on or not proactive_send:
            return "token" if acted else "none"
        if acted and loop_on and token_only:
            return "token"
        return "send"

    def _load_self_model(self) -> dict:
        """L0 self model: persisted narrative/diary/relationship narratives."""
        try:
            if SELF_MODEL_PATH.exists():
                data = json.loads(SELF_MODEL_PATH.read_text(encoding="utf-8"))
                if isinstance(data, dict):
                    return data
        except Exception:
            pass
        return {"narrative": "", "consistency": [], "diary": [], "relationship_narratives": []}

    def _save_self_model(self) -> None:
        try:
            SELF_MODEL_PATH.parent.mkdir(parents=True, exist_ok=True)
            tmp = SELF_MODEL_PATH.with_suffix(".tmp")
            tmp.write_text(json.dumps(getattr(self, "self_model", {}) or {},
                                      ensure_ascii=False, indent=1), encoding="utf-8")
            tmp.replace(SELF_MODEL_PATH)
        except Exception:
            pass

    @staticmethod
    def _sanitize_proactive_text(text: str) -> str:
        """Strip <bc> tags / stray tag fragments from a proactive message."""
        value = str(text or "")
        # closed or unclosed <bc ...> payloads
        value = re.sub(r"<bc\b[^>]*>[\s\S]*?(?:</bc>|$)", "", value, flags=re.I)
        # stray fragments such as "<bc>?" or "</bc"
        value = re.sub(r"</?bc\b[^>]*>?", "", value, flags=re.I)
        value = re.sub(r"\[\[mood:[^\]]*\]\]", "", value, flags=re.I)
        return value.strip()

    async def _autonomy_tick_legacy(self, now=None) -> list:
        """One autonomous tick over remembered PRIVATE sessions (task-15+task-28).

        Task-28 adds the candidate/arbitration token broadcast. Exit mutual
        exclusion (S20): per session per tick, either the loop broadcasts one
        token (token-only => nothing sent) or the existing task-15 send gate may
        send at most once -- never both.
        """
        try:
            try:
                from .biocore_model import ui_settings as _ui_settings
            except Exception:
                from biocore_model import ui_settings as _ui_settings
            _acc = dict((_ui_settings.load(self).get("autonomy") or {}).get("accumulator") or {})
            logger.info("[biocore] autonomy tick V=%s theta=%s ticks=%s",
                        round(float(_acc.get("V", 0) or 0), 4),
                        round(float(_acc.get("theta", 0.55) or 0.55), 3),
                        _acc.get("ticks_since_fire"))
        except Exception:
            pass
        sent = []
        loop_on = bool(getattr(self, "autonomy_loop_enabled", False))
        proactive_on = bool(getattr(self, "proactive_autonomy", False))
        if not (loop_on or proactive_on):
            return sent
        try:
            current = float(now if now is not None else time.time())
        except Exception:
            current = time.time()
        _sessions = dict(getattr(self, "_autonomy_private_sessions", {}) or {})
        if not _sessions:
            # After a restart the registry is empty; rebuild from stored state so
            # the tick (and the panel test trigger) still has a target.
            try:
                _key, _core = self._latest_private_core()
                if _key and _core is not None:
                    # state files use ":"->"_" for the canonical key; AstrBot
                    # target needs the original "platform:type:id" form.
                    _umo = str(_key)
                    _m = re.match(r"^(.+?)_(FriendMessage|GroupMessage|GuildMessage|TempMessage)_(.+)$", _umo)
                    if _m:
                        _umo = _m.group(1) + ":" + _m.group(2) + ":" + _m.group(3)
                    _sid = str(_key).rsplit("_", 1)[-1]
                    _sessions = {_umo: {"ts": current, "sender_id": _sid, "sender_name": ""}}
                    # the loop looks cores up by the AstrBot umo, so register the
                    # rebuilt core under BOTH keys.
                    if isinstance(getattr(self, "cores", None), dict):
                        self.cores.setdefault(_umo, _core)
            except Exception:
                _sessions = {}
        logger.info("[biocore] autonomy tick sessions=%d", len(_sessions))
        for umo, info in list(_sessions.items()):
            try:
                if current - float(info.get("ts", 0.0) or 0.0) > 86400:
                    logger.info("[biocore] autonomy skip %s: stale session", umo)
                    continue
                cores = getattr(self, "cores", None)
                core = cores.get(umo) if isinstance(cores, dict) else None
                if core is None or not (getattr(core, "autonomy_enabled", False)
                                        or getattr(core, "autonomy_loop_enabled", False)):
                    logger.info("[biocore] autonomy skip %s: core=%s enabled=%s loop=%s", umo,
                                core is not None,
                                bool(getattr(core, "autonomy_enabled", False)) if core is not None else None,
                                bool(getattr(core, "autonomy_loop_enabled", False)) if core is not None else None)
                    continue
                # Unified noise model: one update point per tick.
                try:
                    core.noise_tick(now=current)
                except Exception:
                    pass
                target = _AutonomySendTarget(
                    self, umo, info.get("sender_id", ""),
                    info.get("sender_name", ""), private=True)
                acted = False
                v3_fired = False
                try:
                    try:
                        from .biocore_model import ui_settings as _ui
                    except Exception:
                        from biocore_model import ui_settings as _ui
                    try:
                        from .biocore_model import autonomy_model as _am
                    except Exception:
                        from biocore_model import autonomy_model as _am
                    _store = _ui.load(self)
                    _acc = dict((_store.get("autonomy") or {}).get("accumulator") or {})
                    try:
                        from .biocore_model import autonomy_loop as _loop
                    except Exception:
                        from biocore_model import autonomy_loop as _loop
                    _acc = _loop.settle(_acc, current)
                    try:
                        try:
                            from .biocore_model import memory_forgetting as _mem
                        except Exception:
                            from biocore_model import memory_forgetting as _mem
                        _acc["rumination"] = _mem.tick_rumination(_acc.get("rumination"), current)
                    except Exception:
                        pass
                    try:
                        try:
                            from .biocore_model import sleep_circadian as _sleep
                        except Exception:
                            from biocore_model import sleep_circadian as _sleep
                        _sleep_state = _sleep.sleep_state(current, getattr(self, "sleep_at", "00:30"),
                                                          getattr(self, "wake_at", "07:30"))
                        _sleep_state["energy"] = round(float(getattr(core, "energy", 0.7) or 0.7), 4)
                        try:
                            from .biocore_model import connection_bids as _bids
                        except Exception:
                            from biocore_model import connection_bids as _bids
                        _acc["bids"] = _bids.settle_bids(_acc.get("bids"), current)
                        _acc["bid_frequency"] = _bids.bid_frequency(_acc.get("bids"), _acc.get("bid_frequency", 1.0))
                    except Exception:
                        pass
                        _acc["sleep"] = _sleep_state
                    try:
                        try:
                            from .biocore_model import feedback_memory as _fmem
                        except Exception:
                            from biocore_model import feedback_memory as _fmem
                        if _acc.get("memory_entries"):
                            _decayed = _fmem.decay_all(_acc.get("memory_entries"), current)
                            _acc["memory_entries"] = _decayed["entries"]
                            _acc["memory_forgotten"] = _decayed["forgotten_ids"]
                    except Exception:
                        pass
                        if _sleep_state.get("sleeping"):
                            _acc["ticks_since_fire"] = int(_acc.get("ticks_since_fire", 0) or 0) + 1
                            _ui.save(self, {"autonomy": {"accumulator": _acc}})
                            logger.info("[biocore] autonomy skipped_sleep hour=%.2f", _sleep_state.get("hour", 0))
                            continue
                        if _acc.get("was_sleeping"):
                            _acc["wake_check"] = True
                            logger.info("[biocore] autonomy woke: checking overnight messages")
                        _acc["was_sleeping"] = False
                    except Exception:
                        pass
                    _cap = int(getattr(self, "autonomy_hourly_cap", 2) or 2)
                    _acc["daily_cap"] = int(getattr(self, "autonomy_daily_cap", 5) or 5)
                    _acc["hourly_cap"] = _cap
                    try:
                        try:
                            from .biocore_model import relationship_stage as _stage_mod
                        except Exception:
                            from biocore_model import relationship_stage as _stage_mod
                        _stage_cfg = _stage_mode_cfg = _stage_mod.stage_config(_acc.get("hours_total", 0.0))
                        _acc["relationship"] = _stage_cfg
                        _acc["daily_cap"] = int(_stage_cfg.get("daily_cap", _acc.get("daily_cap", 5)))
                        _cap = max(1, min(12, int(_acc.get("hourly_cap", 2))))
                    except Exception:
                        pass
                    _allowed, _acc, _cap = _am.hourly_allowed(_acc, current, _cap)
                    _acc["hourly_cap"] = _cap
                    if not _allowed:
                        _fb = _am.block_feedback(_acc, current, "hourly_cap")
                        _acc = _fb["acc"]
                        try:
                            core.stress = max(0.0, min(1.0, float(getattr(core, "stress", 0.0) or 0.0) + _fb["stress"]))
                            core.a = max(0.0, min(1.0, float(getattr(core, "a", 0.0) or 0.0) + _fb["arousal"]))
                            core.v = max(-0.6, min(1.0, float(getattr(core, "v", 0.0) or 0.0) + _fb["valence"]))
                        except Exception:
                            pass
                        _ui.save(self, {"autonomy": {"accumulator": _acc}})
                        logger.info("[biocore] autonomy blocked reason=hourly_cap frustration=%s drive_mult=%.2f",
                                    _acc.get("frustration", 0), float(_fb.get("drive_mult", 1.0)))
                        continue
                    try:
                        _ud = self._user_record(target)
                    except Exception:
                        _ud = {}
                    _state = core.autonomy_state(self._relationship_of(_ud), now=current, persist=False)
                    _parts = dict(_state.get("parts") or {})
                    _clingy = bool(getattr(self, "autonomy_clingy", True))
                    _silence = _am.silence_view(_acc.get("last_proactive_ts", _acc.get("last_sent_ts", 0.0)),
                                                _acc.get("last_user_msg_ts", 0.0), current, clingy=_clingy)
                    _blame = _am.self_blame_value(_silence.get("hours", 0.0),
                                                  getattr(self, "rejection_sensitivity", 0.4),
                                                  getattr(self, "attachment_style", "secure"))
                    _acc["self_blame"] = _blame
                    _motive = _am.motive_view(_silence.get("hours", 0.0),
                                              _acc.get("frustration", 0),
                                              getattr(self, "autonomy_clingy", True),
                                              getattr(self, "attachment_style", "secure"),
                                              self_blame=_blame,
                                              rejection_sensitivity=getattr(self, "rejection_sensitivity", 0.4))
                    # feedback learning: scale drift weights by per-reason response rate
                    _weights = None
                    try:
                        try:
                            from .biocore_model import autonomy_loop as _loop_mod
                        except Exception:
                            from biocore_model import autonomy_loop as _loop_mod
                        _learn = dict(((_ui.load(self).get("autonomy") or {}).get("learning")) or {})
                        if _learn:
                            _base_w = dict(getattr(_am, "DRIFT_WEIGHTS", {}) or {})
                            _tuned, _learn = _loop_mod.tune_weights(_learn, _base_w, current,
                                                                    total_sent=int(_acc.get("sent_count", 0) or 0))
                            _weights = {k: v for k, v in _tuned.items() if k in _base_w}
                            _ui.save(self, {"autonomy": {"learning": _learn}})
                    except Exception:
                        _weights = None
                    _drift = _am.drift_value(_parts, _weights) * float(_motive["total_mult"])
                    _acc["motive"] = _motive
                    _dt = min(6.0, max(0.0, (current - float(_acc.get("last_tick_ts", 0.0) or current)) / 3600.0))
                    try:
                        try:
                            from .biocore_model import autonomy_affect as _affect
                        except Exception:
                            from biocore_model import autonomy_affect as _affect
                        _, _acc = _affect.apply(core, _acc, current, _silence.get("hours", 0.0),
                                                _silence.get("phase_weight", 0.0),
                                                float(_acc.get("self_blame", 0.0) or 0.0))
                    except Exception:
                        pass
                    # relationship stage -> social-gap time constant (Hall 2019)
                    try:
                        _rel_stage = _acc.get("relationship") or {}
                        _tau = float(_rel_stage.get("tau_hours", 0) or 0)
                        if _tau > 0:
                            _weights_now = dict(getattr(core, "autonomy_weights", {}) or {})
                            _weights_now["tau_hours"] = _tau
                            core.autonomy_weights = _weights_now
                    except Exception:
                        pass
                    try:
                        try:
                            from .biocore_model import attachment_regulation as _attach
                        except Exception:
                            from biocore_model import attachment_regulation as _attach
                        _style = getattr(self, "attachment_style", "secure")
                        _attach_state = _attach.activation(_style, threat=float(_acc.get("self_blame", 0.0) or 0.0),
                                                           current=float(_acc.get("attachment_activation", 0.0) or 0.0),
