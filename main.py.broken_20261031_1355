    def _seed_trust_from_user(self, event, core) -> None:
        """G3: seed core.trust from the user record once per session core.

        Runs only on the first turn after a core is (re)built in this process;
        the core-side method caps the single-step delta at 0.05 and marks the
        core as seeded, so later turns cannot oscillate. User doc is read-only.
        """
        if core is None or getattr(core, "_user_trust_seeded", False):
            return
        try:
            path = self._user_path(event)
            if not path.exists():
                return
            data = json.loads(path.read_text(encoding="utf-8"))
            if not isinstance(data, dict):
                return
            core.seed_trust_from_user(
                data.get("trust", 0.5), TRUST_SEED_WEIGHT, TRUST_SEED_MAX_DELTA)
        except Exception:
            pass

    def _is_private_event(self, event) -> bool:
        """Task-15: only private chats can ever trigger autonomy output."""
        try:
            umo = str(getattr(event, "unified_msg_origin", "") or "")
            if "GroupMessage" in umo or "GuildMessage" in umo:
                return False
            check = getattr(event, "is_private_chat", None)
            if callable(check):
                return bool(check())
            return False
        except Exception:
            return False

    def _loop_cfg_float(self, key: str, default: float,
                        lo: float, hi: float) -> float:
        """Read one numeric autonomy-loop config value (finite + clamped)."""
        try:
            value = float(self.config.get(key, default))
        except Exception:
            return float(default)
        if value != value or value in (float("inf"), float("-inf")):
            return float(default)
        return max(float(lo), min(float(hi), value))

    def _guard_feedback(self, core, deltas, source, now):
        """FB-4: single write gate for every delta (vet -> apply)."""
        try:
            try:
                from .biocore_model import feedback_guard as _fg
            except Exception:
                from biocore_model import feedback_guard as _fg
            state = {"v": float(getattr(core, "v", 0.0) or 0.0),
                     "a": float(getattr(core, "a", 0.0) or 0.0),
                     "stress": float(getattr(core, "stress", 0.0) or 0.0),
                     "social": float(getattr(core, "social", 0.0) or 0.0),
                     "confidence": float(getattr(core, "confidence", 1.0) or 1.0),
                     "needs": dict(getattr(core, "needs_state", {}) or {})}
            seen = getattr(self, "_feedback_guard_seen", {})
            vetted = _fg.vet(deltas or {}, state, source, now, seen=seen)
            self._feedback_guard_seen = seen
            for row in vetted.get("rejected", []):
                logger.info("[biocore] feedback rejected field=%s reason=%s", row.get("field"), row.get("reason"))
            applied = _fg.apply(state, vetted.get("accepted") or {})
            new_state = applied["state"]
            for field in ("v", "a", "stress", "social", "confidence"):
                if field in applied["changed"]:
                    setattr(core, field, float(new_state[field]))
            if "needs" in applied["changed"]:
                core.needs_state = dict(new_state.get("needs") or {})
            if vetted.get("audit"):
                core.feedback_audit = (list(getattr(core, "feedback_audit", []) or []) + vetted["audit"])[-100:]
            return vetted
        except Exception as exc:
            logger.warning("[biocore] feedback guard failed: %s", exc)
            return {"accepted": {}, "rejected": [], "audit": []}

    def _apply_user_feedback(self, core, msg_meta, now=None):
        """FB-2: user behaviour deltas (merged into core.feedback_audit)."""
        try:
            try:
                from .biocore_model import feedback_user as _fu
            except Exception:
                from biocore_model import feedback_user as _fu
            state = {"v": float(getattr(core, "v", 0.0) or 0.0),
                     "social": float(getattr(core, "social", 0.0) or 0.0),
                     "stress": float(getattr(core, "stress", 0.0) or 0.0),
                     "social_pain": float((getattr(core, "social_pain_state", {}) or {}).get("value", 0.0) or 0.0),
                     "self_esteem": float((getattr(core, "self_esteem_state", {}) or {}).get("value", 0.55) or 0.55),
                     "mood_valence": float((getattr(core, "mood_state", {}) or {}).get("valence", 0.0) or 0.0)}
            seen = getattr(self, "_user_feedback_seen", {})
            result = _fu.on_message(state, msg_meta or {}, now or time.time(), seen)
            self._user_feedback_seen = seen
            deltas = result.get("deltas") or {}
            self._guard_feedback(core, {k: v for k, v in deltas.items() if k in ("v", "social", "stress")}, "user", now or time.time())
            if "social_pain" in deltas:
                try:
                    from .biocore_model import social_pain as _sp
                except Exception:
                    from biocore_model import social_pain as _sp
                core.social_pain_state = _sp.update(core.social_pain_state or _sp.initial(now or time.time()), "replied" if deltas["social_pain"] < 0 else "rejected", now or time.time())
            if "self_esteem" in deltas:
                try:
                    from .biocore_model import self_esteem as _se
                except Exception:
                    from biocore_model import self_esteem as _se
                core.self_esteem_state = _se.update(core.self_esteem_state or _se.initial(now or time.time()), "praised" if deltas["self_esteem"] > 0 else "insulted", now or time.time())
            if result.get("audit"):
                core.feedback_audit = (list(getattr(core, "feedback_audit", []) or []) + result["audit"])[-50:]
            return result
        except Exception as exc:
            logger.warning("[biocore] user feedback failed: %s", exc)
            return {"deltas": {}, "audit": []}

    def _apply_llm_feedback(self, core, meta, now=None):
        """FB-1: bounded structured deltas from the LLM payload; never raw assignment."""
        try:
            try:
                from .biocore_model import feedback_llm as _fb
            except Exception:
                from biocore_model import feedback_llm as _fb
            state = {
                "v": float(getattr(core, "v", 0.0) or 0.0),
                "a": float(getattr(core, "a", 0.0) or 0.0),
                "stress": float(getattr(core, "stress", 0.0) or 0.0),
                "confidence": float(getattr(core, "confidence", 1.0) or 1.0),
                "needs": dict(getattr(core, "needs_state", {}) or {}),
            }
            seen = getattr(self, "_feedback_seen", {})
            result = _fb.parse_to_deltas(meta or {}, state=state, now=now or time.time(), seen=seen)
            self._feedback_seen = seen
            deltas = result.get("deltas") or {}
            self._guard_feedback(core, deltas, "llm", now or time.time())
            if "needs" in deltas and isinstance(deltas["needs"], dict):
                needs = dict(getattr(core, "needs_state", {}) or {})
                for key, delta in deltas["needs"].items():
                    needs[key] = max(0.0, min(1.0, float(needs.get(key, 0.6) or 0.6) + float(delta)))
                core.needs_state = needs
            if result.get("rejected"):
                logger.info("[biocore] feedback rejected fields: %s", ",".join(result["rejected"]))
            if result.get("audit"):
                core.feedback_audit = result["audit"]
            return result
        except Exception as exc:
            logger.warning("[biocore] feedback apply failed: %s", exc)
            return {"deltas": {}, "rejected": ["error"], "audit": []}

    def _update_autonomy_readiness(self, core, user_data=None) -> dict:
        """Task-15: ask L1 to compute readiness only when autonomy is enabled."""
        if not getattr(self, "proactive_autonomy", False) or core is None:
            return {}
        try:
            try:
                from .biocore_model import autonomy_model as _am
            except Exception:
                from biocore_model import autonomy_model as _am
            weights = {}
            for key, cfg_key in _am.CONFIG_KEYS.items():
                value = (self.config or {}).get(cfg_key)
                if value is not None:
                    weights[key] = float(value)
            if weights:
                core.autonomy_weights = weights
        except Exception:
            pass
        try:
            result = core.autonomy_state(self._relationship_of(user_data))
            if isinstance(result, dict) and result:
                self._proactive_autonomy = dict(result)
                return result
            return {}
        except Exception:
            return {}

