    def _load_profile(self):
        try:
            if PROFILE_PATH.exists():
                d = json.loads(PROFILE_PATH.read_text(encoding="utf-8"))
                self.profile = dict(d.get("profile") or {})
                self.persona_text = str(d.get("persona") or "")
                _ph = str(d.get("persona_hash") or "")
                self._persona_compiled_hash = _ph or (_sha256(self.persona_text) if self.persona_text else "")
                _schema = d.get("schema")
                if isinstance(_schema, list):
                    self.schema_texts = [str(x).strip()[:60] for x in _schema
                                         if str(x).strip()][:6]
                _style = d.get("style")
                if isinstance(_style, dict):
                    _tag = str(_style.get("intimacy_style") or "neutral")
                    if _tag not in ("neutral", "playful", "gentle", "reserved"):
                        _tag = "neutral"
                    _terms = [str(x).strip()[:12] for x in (_style.get("address_terms") or [])
                              if str(x).strip()][:3]
                    self.persona_style = {"intimacy_style": _tag, "address_terms": _terms}
                logger.info("[biocore] loaded profile %s", PROFILE_PATH)
        except Exception as exc:
            logger.warning("[biocore] profile load failed: %s", exc)

    async def _persona_text(self, event) -> str:
        try:
            pm = self.context.persona_manager
            _pid = str(getattr(self, "persona_id", "") or self.config.get("persona_id") or "").strip()
            if _pid:
                try:
                    _p = pm.get_persona_v3_by_id(_pid)
                except Exception:
                    _p = None
                if _p:
                    if isinstance(_p, dict):
                        return str(_p.get("prompt") or _p.get("system_prompt") or "")
                    return str(getattr(_p, "prompt", "") or getattr(_p, "system_prompt", "") or "")
            p = await pm.get_default_persona_v3(getattr(event, "unified_msg_origin", None))
            if isinstance(p, dict):
                return str(p.get("prompt") or p.get("system_prompt") or "")
            return str(getattr(p, "prompt", "") or getattr(p, "system_prompt", "") or "")
        except Exception as exc:
            logger.warning("[biocore] persona read failed: %s", exc)
            return ""

    def _function_cfg(self, kind: str) -> dict:
        _name = LLM_FUNCTION_ALIASES.get(str(kind or ""), str(kind or ""))
        _all = getattr(self, "llm_functions", None)
        if not isinstance(_all, dict):
            return {"enabled": True, "provider": "follow_llm"}
        _cfg = _all.get(_name)
        if not isinstance(_cfg, dict):
            _cfg = {}
        return {
            "enabled": bool(_cfg.get("enabled", LLM_FUNCTION_DEFAULTS.get(_name, True))),
            "provider": str(_cfg.get("provider") or "follow_llm"),
        }

    def _llm_allowed(self, kind: str) -> bool:
        """Per-function LLM switch (replaces the old global strict flag)."""
        _all = getattr(self, "llm_functions", None)
        if not isinstance(_all, dict):
            # Test harness / legacy object created before this feature: keep
            # the old llm_only_reply_summary semantics when present.
            _strict = getattr(self, "llm_only_reply_summary", None)
            if _strict is None:
                return True
            return (not bool(_strict)) or str(kind or "") in ("reply", "summary")
        if not self._function_cfg(kind)["enabled"]:
            return False
        # P1-3: global background-LLM daily budget (calls + estimated cost).
        if str(kind) in LLM_BACKGROUND_KINDS:
            try:
                _today = time.strftime("%Y-%m-%d")
                if str(self._bg_llm_usage.get("day") or "") != _today:
                    self._bg_llm_usage = {"day": _today, "calls": 0, "cost": 0.0}
                _limit_calls = int(getattr(self, "bg_llm_daily_calls", 200) or 0)
                _limit_cost = float(getattr(self, "bg_llm_daily_cost", 2.0) or 0.0)
                if ((_limit_calls and int(self._bg_llm_usage.get("calls", 0)) >= _limit_calls)
                        or (_limit_cost and float(self._bg_llm_usage.get("cost", 0.0)) >= _limit_cost)):
                    self._bg_budget_blocked = True
                    self._record_llm_telemetry(kind, "budget_blocked")
                    return False
            except Exception:
                pass
        return True

    def _provider_kind(self, provider) -> str:
        """Classify a provider by id/model/type (chat / vision / embedding / tts / rerank)."""
        try:
            cfg = getattr(provider, "provider_config", {}) or {}
            raw = " ".join(str(x or "") for x in (
                cfg.get("id"), cfg.get("model"),
                cfg.get("provider_type"), type(provider).__name__,
            )).lower()
        except Exception:
            raw = ""
        if any(x in raw for x in ("img", "image", "vision", "t2i", "dall", "stable", "midjourney", "exusiai-img")):
            return "vision"
        if any(x in raw for x in ("tts", "speech", "voice")):
            return "tts"
        if any(x in raw for x in ("embed", "bge", "text-embedding")):
            return "embedding"
        if "rerank" in raw:
            return "rerank"
        return "chat"

    async def _provider_for(self, kind: str, event=None):
        """Resolve the LLM provider for one function.

        Default ("follow_llm") uses AstrBot's current chat provider. A configured
        provider_id is looked up via get_provider_by_id; if it is missing we log
        a warning and fall back to the main LLM instead of failing the feature.
        """
        _cfg = self._function_cfg(kind)
        _override = _cfg["provider"]
        _umo = str(getattr(event, "unified_msg_origin", "") or "") if event is not None else ""
        if _override and _override not in ("follow_llm", "main", "default", ""):
            _p = None
            try:
                _p = self.context.get_provider_by_id(_override)
            except Exception as exc:
                logger.warning("[biocore] provider lookup failed for %s (%s): %s", kind, _override, exc)
                _p = None
            if _p is not None:
                if self._provider_kind(_p) == "chat":
                    return _p
                logger.warning("[biocore] llm function %s provider %s is not a chat provider; fallback to main LLM",
                               kind, _override)
            else:
                logger.warning("[biocore] llm function %s provider %s not found; fallback to main LLM", kind, _override)
        try:
            return await self.context.get_using_provider_async(_umo)
        except Exception as exc:
            logger.warning("[biocore] main LLM provider lookup failed for %s: %s", kind, exc)
            return None


    # ------------------------------------------------------------------
    # LLM v2 (L-T01..L-T12): proposal-only model calls.
    #
    # Contract:
    #   * every function is registered in LLM_FUNCTIONS and defaults to OFF;
    #   * prompt text + output parsing only live in interpretation.py;
    #   * a model output is validated before storage (relationship_meta);
    #   * no function writes core v/a/d/trust/goals or generates a reply;
    #   * strict/legacy mode (_llm_allowed) skips every extra call.
    # ------------------------------------------------------------------
    @staticmethod
    def _truncate_at_sentence(text, cap) -> str:
        """P1-3: bounded sentence-boundary truncation for refusal brevity."""
        value = str(text or "").strip()
        try:
            limit = max(1, int(cap or 0))
        except Exception:
            limit = 160
        if len(value) <= limit:
            return value
        head = value[:limit]
        idx = -1
        for boundary in ("。", "！", "？", "；", "…", "\n", ".", "!", "?"):
            pos = head.rfind(boundary)
            if pos > idx:
                idx = pos
        if idx >= max(1, int(limit * 0.4)):
            return head[:idx + 1].strip()
        return head.rstrip()

    def _cost_for(self, input_tokens=0, output_tokens=0,
                  cached_tokens=0) -> float:
        """task-37: CNY cost from the configurable price table (per 1M tokens)."""
        try:
            tin = max(0, int(input_tokens or 0))
            tout = max(0, int(output_tokens or 0))
            tcached = max(0, min(tin, int(cached_tokens or 0)))
        except Exception:
            return 0.0
        price_in = float(getattr(self, "cost_input_per_1m", 2.0) or 0.0)
        price_out = float(getattr(self, "cost_output_per_1m", 8.0) or 0.0)
        price_cache = float(getattr(self, "cost_cache_per_1m", 0.5) or 0.0)
        return round(((tin - tcached) * price_in
                      + tcached * price_cache
                      + tout * price_out) / 1_000_000.0, 6)

    def _record_token_budget(self, session, *, input_tokens=0,
                             output_tokens=0, cached_tokens=0,
                             estimated=True, core=None,
                             count_call=True) -> None:
        """task-37: measured/estimated token + cost counters (read-only)."""
        try:
            store = self._token_budget if isinstance(
                getattr(self, "_token_budget", None), dict) else {}
            sessions = store.get("sessions") if isinstance(store.get("sessions"), dict) else {}
            key = str(session or "default")[:80]
            item = sessions.get(key) if isinstance(sessions.get(key), dict) else {}
            tin = int(input_tokens or 0)
            tout = int(output_tokens or 0)
            tcached = int(cached_tokens or 0)
            item["input_tokens"] = int(item.get("input_tokens", 0) or 0) + tin
            item["output_tokens"] = int(item.get("output_tokens", 0) or 0) + tout
            item["cached_tokens"] = int(item.get("cached_tokens", 0) or 0) + tcached
            # P2: a turn has one input call and one output call -> count the
            # round only on the output call (request passes count_call=False).
            if count_call:
                item["calls"] = int(item.get("calls", 0) or 0) + 1
            item["estimated_calls"] = (int(item.get("estimated_calls", 0) or 0)
                                       + (1 if estimated else 0))
            item["estimated"] = bool(estimated) or bool(item.get("estimated"))
            item["last_input"] = tin
            item["last_output"] = tout
            item["last_estimated"] = bool(estimated)
            item["cost"] = round(float(item.get("cost", 0.0) or 0.0)
                                 + self._cost_for(tin, tout, tcached), 6)
            sessions[key] = item
            store["sessions"] = sessions
            if count_call:
                store["calls"] = int(store.get("calls", 0) or 0) + 1
            today = time.strftime("%Y-%m-%d")
            day = store.get("today") if isinstance(store.get("today"), dict) else {}
            if str(day.get("date") or "") != today:
                day = {"date": today, "input_tokens": 0, "output_tokens": 0,
                       "cached_tokens": 0, "cost": 0.0, "calls": 0,
                       "estimated_calls": 0, "estimated": False}
            day["input_tokens"] = int(day.get("input_tokens", 0) or 0) + tin
            day["output_tokens"] = int(day.get("output_tokens", 0) or 0) + tout
            day["cached_tokens"] = int(day.get("cached_tokens", 0) or 0) + tcached
            day["cost"] = round(float(day.get("cost", 0.0) or 0.0)
                                + self._cost_for(tin, tout, tcached), 6)
            if count_call:
                day["calls"] = int(day.get("calls", 0) or 0) + 1
            day["estimated_calls"] = (int(day.get("estimated_calls", 0) or 0)
                                      + 1)
            day["estimated"] = bool(day.get("estimated")) or bool(estimated)
            store["today"] = day
            self._token_budget = store
            if core is not None and getattr(self, "token_budget_enabled", True):
                core.token_usage = dict(item)
        except Exception:
            pass

    @staticmethod
    def _reflect_template(triggers, reverse=None, core=None) -> str:
        labels = getattr(core, "labels", {}) if core is not None else {}
        labels = labels if isinstance(labels, dict) else {}
        emo = str(labels.get("emotion") or "neutral")[:10]
        need = str(labels.get("need") or "talk")[:10]
        action = {"low_confidence": "先确认再回答",
                  "violations": "少下结论、先核对",
                  "user_ask": "先复述再解释",
                  "relationship": "先接住情绪"}.get(
                      (triggers or ["generic"])[0], "先接住情绪")
        text = ("自我检查（%s）：情绪=%s 需要=%s；下一轮：%s"
                % ("/".join((triggers or ["generic"])[:2]), emo, need, action))
        return text[:120]

    async def _reflect_llm_text(self, key, prompt):
        """Optional cheaper-model reflection: 24h cache, silent fallback."""
        try:
            cache = self._reflect_cache if isinstance(
                getattr(self, "_reflect_cache", None), dict) else {}
            now = time.time()
            hit = cache.get(key)
            if isinstance(hit, tuple) and len(hit) == 2 and now - float(hit[0]) < 86400:
                return str(hit[1])[:120], "cached"
            provider = None
            if getattr(self, "think_reflect_provider", ""):
                try:
                    provider = self.context.get_provider_by_id(
                        self.think_reflect_provider)
                except Exception:
                    provider = None
            if provider is None:
                return "", "no_provider"
            try:
                resp = await provider.text_chat(prompt=prompt)
                text = str(getattr(resp, "completion_text", "") or "").strip()[:120]
            except Exception:
                return "", "error"
            if not text:
                return "", "empty"
            cache[key] = (now, text)
            self._reflect_cache = dict(list(cache.items())[-20:])
            return text, "llm"
        except Exception:
            return "", "error"

    async def _maybe_think_reflect(self, event, core, reply, user_text="") -> bool:
        """task-39 F2: one bounded reflection when a trigger fires (default OFF)."""
        try:
            _umo = str(getattr(event, "unified_msg_origin", "default") or "default")
            if (getattr(self, "think_reflect_private_only", True)
                    and not self._is_private_event(event)):
                stats = self._reflect_stats.setdefault(_umo, {"count": 0, "day": ""})
                stats["blocked_private"] = int(stats.get("blocked_private", 0) or 0) + 1
                return False
            triggers = []
            _ansc = (getattr(self, "_last_memory_meta", {}) or {}).get("answer_confidence")
            try:
                if _ansc is not None and float(_ansc) < 0.40:
                    triggers.append("low_confidence")
            except Exception:
                pass
            _rc = getattr(self, "_last_reverse_check", None)
            if isinstance(_rc, dict) and len(_rc.get("violations") or []) >= 2:
                triggers.append("violations")
            if any(w in str(user_text or "") for w in ("你想想", "想想为什么", "反思", "为什么")):
                triggers.append("user_ask")
            try:
                _rel = self._relationship_of(self._user_record(event))
                _state = _rel.get("state") if isinstance(_rel.get("state"), dict) else {}
                if float(_state.get("conflict", 0.0) or 0.0) >= 0.60:
                    triggers.append("relationship")
            except Exception:
                pass
            if not triggers:
                return False
            today = time.strftime("%Y-%m-%d")
            stats = self._reflect_stats.setdefault(_umo, {"count": 0, "day": ""})
            if str(stats.get("day") or "") != today:
                stats["day"] = today
                stats["count"] = 0
            cap = max(1, int(getattr(self, "think_reflect_daily_cap", 3) or 3))
            if int(stats.get("count", 0) or 0) >= cap:
                stats["blocked_daily"] = int(stats.get("blocked_daily", 0) or 0) + 1
                return False
            template = self._reflect_template(triggers, _rc, core)
            text = template
            fallback = True
            if getattr(self, "think_reflect_llm_enabled", False):
                key = _sha256(str(triggers) + str(_umo) + str(reply)[:80])[:16]
                llm_text, source = await self._reflect_llm_text(
                    key, "用不超过120字、只做一次自我检查：%s" % template)
                if llm_text:
                    text = llm_text
                    fallback = False
                stats["last_source"] = source
            try:
                tree = getattr(core, "reflection_tree", None)
                if not isinstance(tree, dict):
                    tree = {"roots": [], "count": 0}
                node = {"ts": time.time(), "insight": text,
                        "emotion": str((getattr(core, "labels", {}) or {}).get("emotion") or "neutral"),
                        "source": "think_reflect", "trigger": list(triggers[:3]),
                        "fallback": bool(fallback), "children": []}
                roots = tree.get("roots") or []
                if roots:
                    roots[-1].setdefault("children", []).append(node)
                else:
                    roots.append(node)
                tree["roots"] = roots[-10:]
                tree["count"] = int(tree.get("count", 0)) + 1
                core.reflection_tree = tree
            except Exception:
                pass
            stats["count"] = int(stats.get("count", 0) or 0) + 1
            stats["last_trigger"] = list(triggers[:3])
            stats["last_fallback"] = bool(fallback)
            self._reflect_hint = ("先核对再回答；少下结论" if "violations" in triggers
                                  else "先确认对方状态")[:140]
            try:
                if getattr(self, "think_repeat_guard_enabled", False):
                    self._repeat_hint = self._repeat_hint or "换一种说法"
            except Exception:
                pass
            return True
        except Exception:
            return False

    @staticmethod
    def _mood_multiplier(v) -> float:
        """task-38: mood-consistent recall multiplier (0.90–1.10, default OFF)."""
        try:
            value = max(-1.0, min(1.0, float(v or 0.0)))
        except Exception:
            value = 0.0
        return max(0.90, min(1.10, 1.0 + 0.10 * value))

    @staticmethod
    def _emotion_gate_params(stress, v) -> dict:
        """task-38: emotion gating (raise threshold / lower top-k when stressed)."""
        try:
            s = max(0.0, min(1.0, float(stress or 0.0)))
            val = max(-1.0, min(1.0, float(v or 0.0)))
        except Exception:
            s, val = 0.0, 0.0
        active = bool(s >= 0.65 or val <= -0.50)
        return {"active": active,
                "threshold_bonus": 0.05 if active else 0.0,
                "top_k_cap": 2 if active else 0}

    # ---- task-54/55 expression / relationship / learning (default OFF) ----
    def _learning_for(self, session) -> dict:
        store = self._learning if isinstance(getattr(self, "_learning", None), dict) else {}
        key = str(session or "default")[:80]
        st = store.get(key) if isinstance(store.get(key), dict) else {}
        day = time.strftime("%Y-%m-%d")
        if str(st.get("day") or "") != day:
            st = {"day": day, "cap_base": float(st.get("cap_base", 30.0) or 30.0),
                  "cap_delta_today": 0.0, "rel_delta_today": 0.0,
                  "k1": float(st.get("k1", 1.0) or 1.0),
                  "k3": float(st.get("k3", 1.0) or 1.0),
                  "repair_mult": float(st.get("repair_mult", 1.0) or 1.0),
                  "worth_bias": float(st.get("worth_bias", 0.0) or 0.0),
                  "updates": 0, "reward_baseline": float(st.get("reward_baseline", 0.0) or 0.0)}
        for k, v in (("cap_base", 30.0), ("cap_delta_today", 0.0),
                     ("rel_delta_today", 0.0), ("k1", 1.0), ("k3", 1.0),
                     ("repair_mult", 1.0), ("worth_bias", 0.0),
                     ("updates", 0), ("reward_baseline", 0.0)):
            st.setdefault(k, v)
        st["last_ts"] = time.time()
        store[key] = st
        # P2: bounded session map (oldest dropped, never unbounded growth).
        if len(store) > 50:
            _keep = sorted(store.items(), key=lambda kv: float(
                (kv[1] or {}).get("last_ts", 0.0) or 0.0), reverse=True)[:50]
            store = dict(_keep)
        self._learning = store
        return st

    def _learning_publish(self, core, session) -> None:
        if core is None:
            return
        if any(getattr(self, k, False) for k in (
                "learning_bandit_enabled", "learning_relationship_enabled",
                "learning_worthiness_enabled")):
            core.learning_state = dict(self._learning_for(session))

    @staticmethod
    def _learning_reward(prev_len, user_len, same_emotion=False) -> float:
        try:
            pl = max(1, int(prev_len or 0))
            ul = max(0, int(user_len or 0))
        except Exception:
            pl, ul = 1, 0
        engagement = min(1.0, ul / float(pl))
        emotion_cont = 1.0 if same_emotion else 0.0
        awkward = 1.0 if ul < 4 else 0.0
        shortened = 1.0 if ul < 0.5 * pl else 0.0
        return round(0.25 * engagement + 0.25 * emotion_cont
                     - 0.25 * awkward - 0.25 * shortened, 4)

    def _learning_bandit_update(self, core, session, reward) -> dict:
        st = self._learning_for(session)
        eta = 0.02
        baseline = float(st.get("reward_baseline", 0.0) or 0.0)
        target = float(st.get("cap_base", 30.0) or 30.0) + eta * (float(reward) - baseline)
        target = max(30.0, min(240.0, target))
        allowed = max(0.0, 5.0 - abs(float(st.get("cap_delta_today", 0.0) or 0.0)))
        step = max(-allowed, min(allowed, target - float(st.get("cap_base", 30.0))))
        st["cap_base"] = round(float(st["cap_base"]) + step, 4)
        st["cap_delta_today"] = round(float(st.get("cap_delta_today", 0.0)) + step, 4)
        st["reward_baseline"] = round(0.9 * baseline + 0.1 * float(reward), 4)
        st["updates"] = int(st.get("updates", 0)) + 1
        self._learning_publish(core, session)
        return dict(st)

    def _learning_relationship_update(self, core, session, disclosure=0.0,
                                      overreach=0.0) -> dict:
        st = self._learning_for(session)
        step = 0.01
        d1 = step * (1.0 if disclosure else 0.0) - step * (1.0 if overreach else 0.0)
        d3 = step * (1.0 if overreach else 0.0)
        d_rep = 0.01 if disclosure else -0.01
        # P1-3: hard daily cap ±0.03 across calls (all relationship coeffs).
        used = float(st.get("rel_delta_today", 0.0) or 0.0)
        remaining = 0.03 - abs(used)
        total = d1 + d3 + d_rep
        if abs(total) > remaining:
            scale = remaining / abs(total) if total else 0.0
            d1, d3, d_rep = d1 * scale, d3 * scale, d_rep * scale
        st["k1"] = round(max(0.50, min(1.50, float(st["k1"]) + d1)), 4)
        st["k3"] = round(max(0.50, min(1.50, float(st["k3"]) + d3)), 4)
        st["repair_mult"] = round(max(0.80, min(1.20, float(st["repair_mult"]) + d_rep)), 4)
        st["rel_delta_today"] = round(used + d1 + d3 + d_rep, 4)
        st["updates"] = int(st.get("updates", 0)) + 1
        self._learning_publish(core, session)
        return dict(st)

    def _learning_worthiness_step(self, core, session, important=True) -> dict:
        st = self._learning_for(session)
        delta = 0.01 if important else -0.01
        st["worth_bias"] = round(max(-0.05, min(0.05,
                                   float(st.get("worth_bias", 0.0)) + delta)), 4)
        st["updates"] = int(st.get("updates", 0)) + 1
        self._learning_publish(core, session)
        return dict(st)

    def _expression_hint(self, core, session, user_text="") -> str:
        labels = getattr(core, "labels", {}) or {}
        expr = str(labels.get("expression") or "normal")
        elaboration = {"open": 1.0, "normal": 0.6, "short": 0.25}.get(expr, 0.6)
        stress = float(getattr(core, "stress", 0.0) or 0.0)
        st = self._learning_for(session)
        cap_base = float(st.get("cap_base", 30.0)) if getattr(
            self, "learning_bandit_enabled", False) else 30.0
        if getattr(self, "big5_effect_enabled", False) and isinstance(
                getattr(core, "big5_effect", None), dict):
            elaboration += (float(core.big5_effect.get("openness", 0.5)) - 0.5) * 0.2
        suppression = float(getattr(core, "suppression", 0.0) or 0.0)
        if not suppression:
            try:
                _m = getattr(self, "_last_memory_meta", {}) or {}
                suppression = 0.5 if _m.get("abstain") else 0.0
            except Exception:
                suppression = 0.0
        cap_t = interpretation.expression_length_cap(
            elaboration, suppression=suppression, stress=stress, cap_base=cap_base)
        try:
            rel = self._relationship_of(self._user_record_from_text(user_text))
            state = rel.get("state") if isinstance(rel.get("state"), dict) else {}
            distance = 1.0 - float(state.get("closeness", 0.5) or 0.5)
            trust = float(state.get("trust", 0.5) or 0.5)
        except Exception:
            distance, trust = 0.5, 0.5
        risk = interpretation.politeness_risk(distance, trust, stress)
        strategy = interpretation.politeness_strategy(risk)
        allowed = False
        try:
            meta = getattr(self, "_last_memory_meta", {}) or {}
            if int(meta.get("count", 0) or 0) > 0:
                mode = "explicit" if any(w in str(user_text) for w in (
                    "记得", "上次", "之前", "你忘")) else "none"
                allowed = interpretation.memory_citation_allowed(
                    mode,
                    continuity_seconds=float(meta.get("continuity_seconds", 0.0) or 0.0),
                    open_loop=bool(getattr(core, "open_loops", None)),
                    milestone=bool(meta.get("milestone")),
                    confidence=float(meta.get("confidence", 0.0) or 0.0),
                    already_cited=0)
        except Exception:
            allowed = False
        return interpretation.expression_prompt_hint(
            cap_t, strategy, "可引用1条" if allowed else "不点破记忆")

    def _user_record_from_text(self, text):
        try:
            return self._relationship_of({})
        except Exception:
            return {}

    def _big5_effect(self, core) -> dict:
        prof = getattr(core, "profile", {}) if isinstance(
            getattr(core, "profile", {}), dict) else {}
        traits = prof.get("traits") if isinstance(prof.get("traits"), dict) else (
            prof.get("big5") if isinstance(prof.get("big5"), dict) else {})
        cue = max(0.0, min(1.0, (float(getattr(core, "a", 0.5) or 0.0)
                                 + (0.5 + 0.5 * float(getattr(core, "v", 0.0) or 0.0))) / 2.0))
        out = {}
        for name in ("openness", "conscientiousness", "extraversion",
                     "agreeableness", "neuroticism"):
            try:
                trait = float(traits.get(name, 0.5) or 0.5)
            except Exception:
                trait = 0.5
            out[name] = interpretation.big5_trait_effect(trait, cue)
        return out

    def _apply_relationship_chain(self, event, core, user_text, reply) -> None:
        try:
            data = self._user_record(event)
            rel = data.get("relationship") if isinstance(data, dict) else None
            if not isinstance(rel, dict):
                return
            state = rel.get("state") if isinstance(rel.get("state"), dict) else {}
            trust = float(state.get("trust", 0.5) or 0.5)
            conflict = float(state.get("conflict", 0.5) or 0.5)
            closeness = float(state.get("closeness", 0.5) or 0.5)
            repair = float(state.get("repair", 0.0) or 0.0)
            dyn = relationship_meta.attachment_dynamics(trust, conflict, closeness)
            text = str(user_text or "")
            disclosure = min(1.0, sum(1 for w in ("其实", "感觉", "最近", "压力",
                                                  "难过", "开心", "害怕", "喜欢")
                                      if w in text) / 3.0)
            response = 1.0 if any(w in str(reply or "") for w in (
                "我在", "听起来", "理解", "然后呢", "嗯，")) else 0.0
            overreach = 1.0 if interpretation._OVERREACH_RE.search(str(reply or "")) else 0.0
            st = self._learning_for(str(getattr(event, "unified_msg_origin", "default")))
            k1 = float(st.get("k1", 1.0)) if getattr(
                self, "learning_relationship_enabled", False) else 1.0
            k3 = float(st.get("k3", 1.0)) if getattr(
                self, "learning_relationship_enabled", False) else 1.0
            d_close = relationship_meta.closeness_step(disclosure, response, overreach, k1, k3)
            conflict_step = repair_act_step = 0.0
            horsemen = {}
            _writes = bool(getattr(self, "relationship_chain_enabled", False))
            if _writes and getattr(self, "gottman_enabled", False):
                horsemen, conflict_step = relationship_meta.gottman_conflict_step(text)
                _, repair_act_step = relationship_meta.repair_step(reply, dyn["repair_speed"])
                try:
                    repair_act_step *= float(st.get("repair_mult", 1.0) or 1.0)
                except Exception:
                    pass
            # P1-2: every per-round relationship delta is clipped to ±0.03.
            d_close = max(-0.03, min(0.03, d_close))
            conflict_step = max(-0.03, min(0.03, conflict_step))
            repair_act_step = max(-0.03, min(0.03, repair_act_step))
            closeness = max(0.0, min(1.0, closeness + d_close))
            conflict = max(0.0, min(1.0, conflict + conflict_step))
            repair = max(0.0, min(1.0, repair + repair_act_step))
            if _writes:
                rel["state"] = dict(state, trust=round(trust, 3), closeness=round(closeness, 3),
                                    conflict=round(conflict, 3), repair=round(repair, 3),
                                    predictability=state.get("predictability", 0.5))
                data["relationship"] = rel
                self._save_user_record(event, data)
            core.relationship_dynamics = dict(dyn, d_closeness=d_close,
                                              conflict_step=conflict_step,
                                              repair_step=repair_act_step,
                                              gottman=horsemen)
            if getattr(self, "learning_relationship_enabled", False):
                self._learning_relationship_update(
                    core, str(getattr(event, "unified_msg_origin", "default")),
                    disclosure=disclosure, overreach=overreach)
            if getattr(self, "big5_effect_enabled", False):
                core.big5_effect = self._big5_effect(core)
            _b = getattr(self, "_core_bridge", None)
            if _b is not None and getattr(_b, "enabled", False) and str(getattr(_b, "mode", "off")) == "primary":
                try:
                    _b.relation_update({"trust_delta": 0.0, "intimacy_delta": round(d_close, 4), "event": str(user_text or "")[:120]})
                except Exception:
                    pass
        except Exception:
            pass

    # ---- P2: startup self-check + transactional restore ----
    def _run_env_selfcheck(self) -> dict:
        warnings = []
        checks = {}
        try:
            probe = DATA_DIR / (".write_probe_" + str(int(time.time())))
            probe.write_text("ok", encoding="utf-8")
            probe.unlink(missing_ok=True)
            checks["data_writable"] = True
        except Exception:
            checks["data_writable"] = False
            warnings.append("data 目录不可写")
        version = ""
        try:
            import astrbot as _astrbot
            version = str(getattr(_astrbot, "__version__", "") or "")
        except Exception:
            version = ""
        version_ok = False
        try:
            _parts = [int(x) for x in re.findall(r"\d+", version)[:2]]
            if len(_parts) >= 2:
                version_ok = (4, 16) <= (_parts[0], _parts[1]) < (5, 0)
        except Exception:
            version_ok = False
        if not version:
            warnings.append("AstrBot 版本读取失败")
        elif not version_ok:
            warnings.append("AstrBot 版本不在 >=4.16,<5 范围: " + version)
        persona_present = PROFILE_PATH.exists()
        missing_config = []
        if not persona_present:
            missing_config.append("persona")
            warnings.append("未设置 persona（persona_profile.json 缺失）")
        api_ok = False
        try:
            _api = json.loads(API_CONFIG_PATH.read_text(encoding="utf-8"))
            _blob = json.dumps(_api, ensure_ascii=False).lower()
            api_ok = any(k in _blob for k in ("api_key", "apikey")) and "****" not in _blob
        except Exception:
            api_ok = False
        if not api_ok:
            missing_config.append("api_key")
            warnings.append("未配置 API Key（api_config.json 缺失或为空）")
        checks.update({"astrbot_version": version, "version_ok": version_ok,
                       "persona_present": persona_present, "api_key_present": api_ok,
                       "missing_config": missing_config, "warnings": warnings})
        try:
            (DATA_DIR / "env_checks.json").write_text(
                json.dumps(checks, ensure_ascii=False, indent=1), encoding="utf-8")
        except Exception:
            pass
        return checks

    def _commit_restore(self, staged_files, rollback_files) -> tuple:
        """P2: replace files via os.replace; on failure roll back and report."""
        import os as _os
        import shutil as _shutil
        done = []
        created = []
        try:
            for rel, staged in staged_files.items():
                dest = DATA_DIR / rel
                existed = dest.exists()
                dest.parent.mkdir(parents=True, exist_ok=True)
                if getattr(self, "_restore_fail_inject", False):
                    raise RuntimeError("injected restore failure")
                _os.replace(str(staged), str(dest))
                done.append(rel)
                if not existed:
                    created.append(rel)
            return len(done), ""
        except Exception as exc:
            for rel in done:
                backup = rollback_files.get(rel)
                dest = DATA_DIR / rel
                if backup and backup.exists():
                    dest.parent.mkdir(parents=True, exist_ok=True)
                    _shutil.copyfile(str(backup), str(dest))
            # P2: remove files newly created by this failed restore.
            for rel in created:
                try:
                    (DATA_DIR / rel).unlink(missing_ok=True)
                except Exception:
                    pass
            return len(done), str(exc)

    def _record_llm_telemetry(self, kind, outcome, detail="") -> None:
        """task-36: bounded read-only LLM failure/fallback telemetry."""
        if not getattr(self, "llm_telemetry_enabled", False):
            return
        try:
            tele = self._llm_telemetry if isinstance(
                getattr(self, "_llm_telemetry", None), dict) else {"counters": {}, "recent": []}
            counters = tele.get("counters") if isinstance(tele.get("counters"), dict) else {}
            key = "%s:%s" % (str(kind or "?")[:24], str(outcome or "?")[:16])
            counters[key] = min(10 ** 6, int(counters.get(key, 0) or 0) + 1)
            tele["counters"] = dict(sorted(counters.items(), key=lambda kv: -kv[1])[:20])
            recent = tele.get("recent") if isinstance(tele.get("recent"), list) else []
            tele["recent"] = ([{"ts": round(time.time(), 3), "kind": str(kind or "?")[:24],
                                "outcome": str(outcome or "?")[:16],
                                "detail": str(detail or "")[:120]}]
                              + [x for x in recent if isinstance(x, dict)])[:20]
            self._llm_telemetry = tele
        except Exception:
            pass

    @staticmethod
    def _extract_token_usage(response):
        """task-36: read provider usage if present; never guess/estimate."""
        candidates = []
        try:
            candidates.append(getattr(response, "usage", None))
            candidates.append(getattr(response, "usage_metadata", None))
            candidates.append(getattr(response, "token_usage", None))
            raw = getattr(response, "raw_completion", None)
            if isinstance(raw, dict):
                candidates.append(raw.get("usage"))
            elif raw is not None:
                candidates.append(getattr(raw, "usage", None))
        except Exception:
            pass
        for item in candidates:
            data = item if isinstance(item, dict) else None
            if data is None and item is not None:
                try:
                    data = {"prompt_tokens": getattr(item, "prompt_tokens", None),
                            "completion_tokens": getattr(item, "completion_tokens", None),
                            "total_tokens": getattr(item, "total_tokens", None)}
                except Exception:
                    data = None
            if not isinstance(data, dict):
                continue
            try:
                prompt = int(data.get("prompt_tokens") or 0)
                completion = int(data.get("completion_tokens") or 0)
                total = int(data.get("total_tokens") or (prompt + completion))
                cached = int(data.get("cached_tokens")
                             or data.get("prompt_cache_hit_tokens")
                             or data.get("cache_read_input_tokens") or 0)
            except Exception:
                continue
            if prompt or completion or total:
                return {"prompt_tokens": max(0, prompt),
                        "completion_tokens": max(0, completion),
                        "total_tokens": max(0, total),
                        "cached_tokens": max(0, cached)}
        return None

    def _record_token_usage(self, session, usage) -> None:
        if not getattr(self, "token_usage_enabled", False) or not isinstance(usage, dict):
            return
        try:
            store = self._token_usage if isinstance(
                getattr(self, "_token_usage", None), dict) else {"available": False, "sessions": {}}
            sessions = store.get("sessions") if isinstance(store.get("sessions"), dict) else {}
            key = str(session or "default")[:80]
            item = sessions.get(key) if isinstance(sessions.get(key), dict) else {}
            item["calls"] = min(10 ** 6, int(item.get("calls", 0) or 0) + 1)
            for field in ("prompt_tokens", "completion_tokens", "total_tokens"):
                item[field] = min(10 ** 12, int(item.get(field, 0) or 0)
                                  + int(usage.get(field, 0) or 0))
            item["last_ts"] = round(time.time(), 3)
            sessions[key] = item
            store["sessions"] = sessions
            store["available"] = True
            self._token_usage = store
        except Exception:
            pass

    # ---- P2: persisted, concurrency-safe background LLM budget ----
    def _bg_budget_file(self):
        return DATA_DIR / "background_budget.json"

    def _bg_budget_reserve(self, kind) -> bool:
        import threading
        import json as _json
        lock = getattr(self, "_bg_lock", None)
        if lock is None:
            lock = threading.Lock()
            self._bg_lock = lock
        with lock:
            path = self._bg_budget_file()
            day = time.strftime("%Y-%m-%d")
            state = {}
            try:
                if path.exists():
                    state = _json.loads(path.read_text(encoding="utf-8"))
            except Exception:
                state = {}
            if str(state.get("day") or "") != day:
                state = {"day": day, "calls": 0, "cost": 0.0}
            limit_calls = int(getattr(self, "bg_llm_daily_calls", 200) or 0)
            limit_cost = float(getattr(self, "bg_llm_daily_cost", 2.0) or 0.0)
            if ((limit_calls and int(state.get("calls", 0)) >= limit_calls)
                    or (limit_cost and float(state.get("cost", 0.0)) >= limit_cost)):
                self._bg_llm_usage = state
                return False
            state["calls"] = int(state.get("calls", 0)) + 1
            try:
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_text(_json.dumps(state), encoding="utf-8")
            except Exception:
                pass
            self._bg_llm_usage = state
            return True

    def _bg_budget_add_cost(self, cost) -> None:
        import threading
        import json as _json
        lock = getattr(self, "_bg_lock", None)
        if lock is None:
            lock = threading.Lock()
            self._bg_lock = lock
        try:
            with lock:
                path = self._bg_budget_file()
                day = time.strftime("%Y-%m-%d")
                state = {}
                if path.exists():
                    state = _json.loads(path.read_text(encoding="utf-8"))
                if str(state.get("day") or "") != day:
                    state = {"day": day, "calls": 0, "cost": 0.0}
                state["cost"] = round(float(state.get("cost", 0.0)) + float(cost or 0.0), 6)
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_text(_json.dumps(state), encoding="utf-8")
                self._bg_llm_usage = state
        except Exception:
            pass

    async def _bg_llm_direct(self, kind, provider, prompt, timeout_ms=None):
        """P1-5: budget + timeout wrapper for direct provider.text_chat paths."""
        try:
            if not self._bg_budget_reserve(kind):
                self._record_llm_telemetry(kind, "budget_blocked")
                return None
        except Exception:
            pass
        try:
            _tmo = max(2.0, min(20.0, float(
                timeout_ms or getattr(self, "summary_llm_timeout_ms", 8000)) / 1000.0))
            _call = provider.text_chat(prompt=prompt)
            if _SERVICES is not None:
                resp = await _SERVICES.llm(_call, _tmo)
            else:
                resp = await asyncio.wait_for(_call, timeout=_tmo)
        except asyncio.TimeoutError:
            self._record_llm_telemetry(kind, "timeout")
            return None
        except Exception:
            self._record_llm_telemetry(kind, "call_error")
            return None
        raw = str(getattr(resp, "completion_text", "") or "")
        try:
            self._bg_budget_add_cost(self._cost_for(
                max(1, int(len(prompt) / 2.2)), max(1, int(len(raw) / 2.2))))
        except Exception:
            pass
        return resp

    async def _llm_v2_call(self, kind, prompt, parser, event=None, system_prompt=None):
        if not self._llm_allowed(kind):
            return None
        try:
            provider = await self._provider_for(kind, event)
        except Exception as exc:
            logger.warning("[biocore] llm v2 provider failed (%s): %s", kind, exc)
            self._record_llm_telemetry(kind, "provider_error", str(exc))
            return None
        if provider is None:
            self._record_llm_telemetry(kind, "no_provider")
            return None
        if str(kind) in LLM_BACKGROUND_KINDS:
            try:
                if not self._bg_budget_reserve(kind):
                    self._record_llm_telemetry(kind, "budget_blocked")
                    return None
            except Exception:
                pass
        try:
            _tmo = float(getattr(self, "outbound_timeout_ms", 3000)) / 1000.0
            _call = (provider.text_chat(prompt=prompt, system_prompt=system_prompt)
                     if system_prompt else provider.text_chat(prompt=prompt))
            if _SERVICES is not None:
                resp = await _SERVICES.llm(_call, _tmo)
            else:
                resp = await asyncio.wait_for(_call, timeout=_tmo)
            raw = str(getattr(resp, "completion_text", "") or "").strip()
            if str(kind) in LLM_BACKGROUND_KINDS:
                try:
                    _in = max(1, int(len(prompt) / 2.2))
                    _out = max(1, int(len(raw) / 2.2))
                    self._bg_budget_add_cost(self._cost_for(_in, _out))
                except Exception:
                    pass
            if not raw:
                self._record_llm_telemetry(kind, "empty")
                return None
            return parser(raw)
        except asyncio.TimeoutError:
            self._record_llm_telemetry(kind, "timeout")
            return None
        except Exception as exc:
            logger.warning("[biocore] llm v2 call/paser failed (%s): %s", kind, exc)
            self._record_llm_telemetry(kind, "call_error", str(exc))
            return None

    def _llm_v2_cooldown_ok(self, kind):
        try:
            last = float((getattr(self, "_llm_v2_last", {}) or {}).get(kind, 0.0) or 0.0)
        except Exception:
            last = 0.0
        return (time.time() - last) >= float(LLM_V2_COOLDOWNS.get(kind, 600))

    def _llm_v2_mark(self, kind):
        if not isinstance(getattr(self, "_llm_v2_last", None), dict):
            self._llm_v2_last = {}
        self._llm_v2_last[kind] = time.time()

    def _user_record(self, event):
        try:
            path = self._user_path(event)
            if path.exists():
                data = json.loads(path.read_text(encoding="utf-8"))
                if isinstance(data, dict):
                    return data
        except Exception:
            pass
        return {}

    def _save_user_record(self, event, data):
        try:
            if not isinstance(data, dict):
                return
            path = self._user_path(event)
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(json.dumps(data, ensure_ascii=False, indent=1), encoding="utf-8")
        except Exception as exc:
            logger.warning("[biocore] user record save failed: %s", exc)

    def _record_calibration(self, event, source, predicted, correct) -> None:
        """Persist one calibration sample in the user relationship doc.

        Record-only: writes relationship.calibration (EWMA/Brier per evidence
        source) via the single user-file writer; it never rewrites trust or any
        other biological field. Called from the memory-conflict branch.
        """
        path = self._user_path(event)
        if not path.exists():
            return
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            return
        if not isinstance(data, dict):
            return
        rel = dict(data.get("relationship")) if isinstance(data.get("relationship"), dict) else {}
        rel["calibration"] = relationship_meta.calibration_update(
            rel.get("calibration"), source, predicted, correct)
        try:
            rel["calibration_last_delta"] = self._calibration_step(
                abs(float(predicted) - float(correct)),
                int((rel.get("calibration") or {}).get("samples", 1) or 1))
        except Exception:
            pass
        data["relationship"] = rel
        self._save_user_record(event, data)

    def _relationship_of(self, user_data):
        rel = (user_data or {}).get("relationship") if isinstance(user_data, dict) else None
        return rel if isinstance(rel, dict) else {}

    def _deterministic_hint(self, text, user_data, events_raw, memory_meta, core=None):
        """One bounded deterministic token; interpretation owns the wording."""
        rel = self._relationship_of(user_data)
        repair_state = rel.get("repair_state") if isinstance(rel.get("repair_state"), dict) else {}
        hint = interpretation.repair_strategy_block(repair_state)
        if not hint:
            # G2/L9: refusal is a posture token derived from boundary state. It
            # is not a gate and never decides whether a reply is sent.
            try:
                _state = rel.get("state") if isinstance(rel.get("state"), dict) else {}
                _protocol = relationship_meta.refusal_protocol({
                    "boundary_pressure": float(getattr(core, "boundary_pressure", 0.0) or 0.0),
                    "trust": float(_state.get("trust", 0.5) or 0.5),
                    "conflict": float(_state.get("conflict", 0.0) or 0.0),
                })
                hint = interpretation.refusal_strategy_block(_protocol)
            except Exception:
                hint = ""
        if not hint:
            # A4: deterministic empathy token from core affect (no LLM call).
            try:
                hint = interpretation.empathy_strategy_block(core)
            except Exception:
                hint = ""
        if not hint and interpretation.cause_question(text):
            hint = interpretation.cause_trace_block(getattr(self, "_last_cause_trace", []))
        if not hint:
            hint = interpretation.memory_receipt_block(memory_meta, text)
        if not hint:
            hint = interpretation.grounding_check_block(memory_meta, text)
        if not hint:
            hint = interpretation.response_strategy_block(events_raw)
        return hint

    async def _maybe_llm_hints(self, event, core, user_data, events_raw, memory_meta, text):
        """Optional per-turn strategy refinement; only when a function is ON."""
        parts = [self._deterministic_hint(text, user_data, events_raw, memory_meta, core)]
        rel = self._relationship_of(user_data)
        state = rel.get("state") if isinstance(rel.get("state"), dict) else {}
        repair_state = rel.get("repair_state") if isinstance(rel.get("repair_state"), dict) else {}
        phase = str(repair_state.get("phase") or "stable")
        gate = str((memory_meta or {}).get("gate") or "none")
        try:
            conflict = float(state.get("conflict", 0.5) or 0.5)
            trust = float(state.get("trust", 0.5) or 0.5)
        except Exception:
            conflict, trust = 0.5, 0.5
        try:
            if phase != "stable" and self._llm_v2_cooldown_ok("repair_hint"):
                tag = await self._llm_v2_call(
                    "repair_hint", interpretation.repair_hint_prompt(repair_state),
                    interpretation.parse_repair_hint, event)
                if tag:
                    parts.append("llm_repair=" + tag)
                    self._llm_v2_mark("repair_hint")
            elif events_raw and self._llm_v2_cooldown_ok("empathy_hint"):
                tag = await self._llm_v2_call(
                    "empathy_hint", interpretation.empathy_hint_prompt(events_raw),
                    interpretation.parse_empathy_hint, event)
                if tag:
                    parts.append("llm_empathy=" + tag)
                    self._llm_v2_mark("empathy_hint")
            elif gate in ("semi", "force") and self._llm_v2_cooldown_ok("pragmatics_hint"):
                tag = await self._llm_v2_call(
                    "pragmatics_hint", interpretation.pragmatics_hint_prompt(memory_meta),
                    interpretation.parse_pragmatics_hint, event)
                if tag:
                    parts.append("llm_pragma=" + tag)
                    self._llm_v2_mark("pragmatics_hint")
            elif (conflict < 0.45 and trust > 0.5 and self._llm_v2_cooldown_ok("humor_hint")):
                tag = await self._llm_v2_call(
                    "humor_hint", interpretation.humor_hint_prompt(rel),
                    interpretation.parse_humor_hint, event)
                if tag and tag != "none":
                    parts.append("humor=" + tag)
                    self._llm_v2_mark("humor_hint")
        except Exception as exc:
            logger.warning("[biocore] llm v2 hint failed: %s", exc)
        hint = interpretation.combine_strategy_hint(*parts)
        self._last_strategy_hint = hint
        return hint

    async def _maybe_tom_probe(self, event, core, text, user_data, memory_meta):
        """L-T06: optional bounded ToM annotation; never changes core state."""
        if not self._llm_allowed("tom_probe") or not self._llm_v2_cooldown_ok("tom_probe"):
            return
        try:
            recent = [str(h.get("text") or "") for h in (core.history or [])[-6:]]
            refs = [str(x) for x in (getattr(self, "_last_memory_entries", []) or []) if str(x)][:6]
            proposal = await self._llm_v2_call(
                "tom_probe",
                interpretation.tom_prompt(user_data, recent, memory_lines=refs),
                lambda raw: interpretation.parse_tom_update(raw, allowed_refs=refs),
                event)
            if not proposal:
                return
            updated = relationship_meta.apply_tom_update(user_data, proposal, allowed_refs=refs)
            if updated:
                self._save_user_record(event, updated)
                self._llm_v2_mark("tom_probe")
        except Exception as exc:
            logger.warning("[biocore] tom probe failed: %s", exc)

    async def _maybe_relationship_impression(self, event, core):
        """L-T01/A3: bounded impression writing; deterministic by default.

        The LLM path stays available behind the per-function switch (default
        OFF). With the switch off, the relation numbers are mapped to a short
        deterministic template. Neither path touches trust or core state.
        """
        if not self._llm_v2_cooldown_ok("relationship_impression"):
            return
        try:
            events = [e for e in self._event_archive(12) if isinstance(e, dict)]
            important = [e for e in events
                         if float(e.get("importance", 0.0) or 0.0) >= 0.6]
            if len(important) < 3:
                return
            allowed = [str(e.get("id") or "") for e in important if str(e.get("id") or "")]
            if len(allowed) < 3:
                return
            user_data = self._user_record(event)
            current = self._relationship_of(user_data)
            if self._llm_allowed("relationship_impression"):
                proposal = await self._llm_v2_call(
                    "relationship_impression",
                    interpretation.relationship_impression_prompt(important, current),
                    lambda raw: interpretation.parse_relationship_impression(
                        raw, allowed_refs=allowed),
                    event)
                if not proposal:
                    return
            else:
                proposal = interpretation.relationship_impression_template(
                    current, len(important))
                if not proposal.get("traits"):
                    return
                proposal["evidence_refs"] = allowed[:6]
            updated = relationship_meta.apply_relationship_impression(
                current, proposal, allowed_refs=allowed)
            if not updated:
                return
            user_data["relationship"] = updated
            self._save_user_record(event, user_data)
            self._llm_v2_mark("relationship_impression")
        except Exception as exc:
            logger.warning("[biocore] relationship impression failed: %s", exc)

    async def _maybe_diary(self, event, core):
        """L-T08: at most one bounded diary entry per cooldown (default OFF)."""
        if not self._llm_allowed("diary") or not self._llm_v2_cooldown_ok("diary"):
            return
        try:
            digests = [d for d in (getattr(core, "daily_digests", []) or [])
                       if isinstance(d, dict)]
            if not digests:
                return
            digest = digests[-1]
            allowed = [str(x) for x in (digest.get("event_ids") or []) if str(x)]
            if not allowed:
                return
            titles = [str(e.get("title") or "")
                      for e in self._event_archive(10) if isinstance(e, dict)]
            parsed = await self._llm_v2_call(
                "diary", interpretation.diary_prompt(digest, titles),
                lambda raw: interpretation.parse_diary(raw, allowed_event_ids=allowed),
                event)
            if not parsed:
                return
            diary = self.self_model.get("diary")
            if not isinstance(diary, list):
                diary = []
            diary.append({"ts": time.time(), "date": str(digest.get("date") or ""),
                          "text": parsed["diary"], "evidence": parsed["evidence"],
                          "generated": True})
            self.self_model["diary"] = diary[-30:]
            self._save_self_model()
            self._llm_v2_mark("diary")
        except Exception as exc:
            logger.warning("[biocore] diary failed: %s", exc)

    async def _maybe_relationship_narrative(self, event, core):
        """L-T12: manual/periodic bounded relationship narrative (default OFF)."""
        if not self._llm_allowed("relationship_narrative"):
            return
        if not self._llm_v2_cooldown_ok("relationship_narrative"):
            return
        try:
            user_data = self._user_record(event)
            rel = self._relationship_of(user_data)
            marks = [m for m in (rel.get("milestones") or []) if isinstance(m, dict)]
            allowed = [str(m.get("key") or m.get("type") or "") for m in marks
                       if str(m.get("key") or m.get("type") or "")]
            if not allowed:
                return
            parsed = await self._llm_v2_call(
                "relationship_narrative",
                interpretation.relationship_narrative_prompt(rel),
                lambda raw: interpretation.parse_relationship_narrative(
                    raw, allowed_refs=allowed), event)
            if not parsed:
                return
            items = self.self_model.get("relationship_narratives")
            if not isinstance(items, list):
                items = []
            items.append({"ts": time.time(), "text": parsed["narrative"],
                          "evidence_refs": parsed["evidence_refs"]})
            self.self_model["relationship_narratives"] = items[-5:]
            self._save_self_model()
            self._llm_v2_mark("relationship_narrative")
        except Exception as exc:
            logger.warning("[biocore] relationship narrative failed: %s", exc)


    def _vision_provider_for(self, event=None):
        """Resolve the vision provider for image caption (never a text LLM)."""
        _b = getattr(self, "_core_bridge", None)
        if _b is not None and getattr(_b, "enabled", False):
            try:
                _last = float(getattr(self, "_media_probe_last", 0.0) or 0.0)
                if time.time() - _last >= 3600:
                    self._media_probe_last = time.time()
                    _b.media_probe()
            except Exception:
                pass
        _cfg = self._function_cfg("image_caption")
        _override = _cfg["provider"]
        _pid = ""
        if _override and _override not in ("follow_llm", "main", "default", ""):
            _pid = _override
        if not _pid:
            try:
                _cfg_all = self.context.get_config()
                _ps = _cfg_all.get("provider_settings", {}) if isinstance(_cfg_all, dict) else {}
                _pid = str(_ps.get("default_image_caption_provider_id") or "exusiai-img")
            except Exception:
                _pid = "exusiai-img"
        try:
            _vp = self.context.get_provider_by_id(_pid)
        except Exception as exc:
            logger.warning("[biocore] vision provider lookup failed (%s): %s", _pid, exc)
            return None
        if _vp is not None and self._provider_kind(_vp) == "vision":
            return _vp
        if _vp is not None:
            logger.warning("[biocore] image_caption provider %s is not a vision provider; ignored", _pid)
        # Fall back to the configured default image provider, but never a text LLM.
        try:
            _cfg = self.context.get_config()
            _ps = _cfg.get("provider_settings", {}) if isinstance(_cfg, dict) else {}
            _def = str(_ps.get("default_image_caption_provider_id") or "")
            if _def and _def != _pid:
                _vp2 = self.context.get_provider_by_id(_def)
                if _vp2 is not None and self._provider_kind(_vp2) == "vision":
                    return _vp2
        except Exception:
            pass
        return None

    async def _compile_profile(self, event):
        text = await self._persona_text(event)
        if not text:
            self.profile = dict(DEFAULT_PROFILE)
            self.persona_text = ""
            self.schema_texts = []
            try:
                PROFILE_PATH.write_text(json.dumps(
                    {"persona": "", "profile": self.profile, "schema": [],
                     "style": dict(getattr(self, "persona_style", {}) or {})},
                    ensure_ascii=False, indent=1), encoding="utf-8")
            except Exception:
                pass
            return
        if not self._llm_allowed("persona_compile"):
            self.persona_text = text
            logger.info("[biocore] persona_compile disabled; keep saved profile")
            return
        _ph = _sha256(text)
        if getattr(self, "_persona_compiled_hash", "") == _ph and getattr(self, "profile", None):
            # Already compiled for this persona: no extra LLM call.
            self.persona_text = text
            logger.info("[biocore] persona already compiled; skip")
            return
        try:
            provider = await self._provider_for("persona_compile", event)
            if provider is None:
                self.profile = dict(DEFAULT_PROFILE)
                return
            # Prompt construction and output validation belong to the
            # interpretation layer; this wiring only calls it.
            system = interpretation.persona_compile_system()
            prompt = interpretation.persona_compile_prompt(text)
            resp = await provider.text_chat(prompt=prompt, system_prompt=system)
            raw = str(getattr(resp, "completion_text", "") or "")
            _compiled = interpretation.parse_persona_compile(raw, DEFAULT_PROFILE)
            self.profile = _compiled.get("profile") or dict(DEFAULT_PROFILE)
            self.schema_texts = list(_compiled.get("schema") or [])
            _style = _compiled.get("style") if isinstance(_compiled.get("style"), dict) else {}
            self.persona_style = {"intimacy_style": str(_style.get("intimacy_style") or "neutral"),
                                  "address_terms": list(_style.get("address_terms") or [])[:3]}
            logger.info("[biocore] persona schema slots=%s style=%s", len(self.schema_texts),
                        self.persona_style.get("intimacy_style"))
        except Exception as exc:
            logger.warning("[biocore] persona compile failed: %s", exc)
            self.profile = dict(DEFAULT_PROFILE)
        self.persona_text = text
        try:
            PROFILE_PATH.write_text(json.dumps(
                {"persona": self.persona_text, "profile": self.profile,
                 "schema": list(getattr(self, "schema_texts", []) or []),
                 "style": dict(getattr(self, "persona_style", {}) or {}),
                 "persona_hash": _sha256(self.persona_text or text)},
                ensure_ascii=False, indent=1), encoding="utf-8")
            self._persona_compiled_hash = _sha256(self.persona_text or text)
            logger.info("[biocore] first-run profile written: %s", PROFILE_PATH)
        except Exception as exc:
            logger.warning("[biocore] profile save failed: %s", exc)

