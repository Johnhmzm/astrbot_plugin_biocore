    async def _autonomy_tick(self, now=None) -> list:
        """L4 adapter: engine switch (legacy|module) with safe fallback."""
        import asyncio as _asyncio
        import time as _time
        started = float(now if now is not None else _time.time())
        engine = str(getattr(self, "autonomy_tick_engine", "legacy") or "legacy").lower()
        if engine != "module":
            return await self._autonomy_tick_legacy(now)
        try:
            try:
                from .biocore_model import autonomy_tick as _tick_mod
                from .biocore_model import autonomy_model as _am
                from .biocore_model import ui_settings as _ui
                from .biocore_model import expr_template as _etpl
            except Exception:
                from biocore_model import autonomy_tick as _tick_mod
                from biocore_model import autonomy_model as _am
                from biocore_model import ui_settings as _ui
                from biocore_model import expr_template as _etpl
            sessions = [{"umo": umo} for umo in list(getattr(self, "_autonomy_private_sessions", {}).keys())]
            if not sessions:
                _key, _core0 = self._latest_private_core()
                if _key:
                    sessions = [{"umo": _key}]
            deps = type("Deps", (), {})()
            deps.load_acc = lambda: dict((_ui.load(self).get("autonomy") or {}).get("accumulator") or {})
            deps.save_acc = lambda acc: _ui.save(self, {"autonomy": {"accumulator": dict(acc)}})
            deps.list_sessions = lambda: list(sessions)
            deps.get_core = lambda umo: self.cores.get(umo)
            deps.snapshot = lambda core: core.snapshot()
            deps.step = lambda V, drift, theta: _am.step(V, drift, float((_ui.load(self).get("autonomy") or {}).get("accumulator", {}).get("leak", 0.15) or 0.15), float((_ui.load(self).get("autonomy") or {}).get("accumulator", {}).get("sigma", 0.06) or 0.06), theta)
            def _gate(core, acc, silence, now_ts):
                try:
                    state = core.autonomy_state(self._relationship_of({}), now=now_ts, persist=False)
                    return _am.send_gate(state, True, now_ts, AUTONOMY_QUIET_START_HOUR, AUTONOMY_QUIET_END_HOUR, AUTONOMY_COOLDOWN_SECONDS, int(getattr(self, "autonomy_daily_cap", 5) or 5), bool(getattr(self, "proactive_send", False)))
                except Exception as exc:
                    return False, "gate_error:" + type(exc).__name__
            deps.gate = _gate
            deps.build_text = lambda core, acc: self._autonomy_template(core)
            def _trigger_send(umo, text):
                async def _send():
                    try:
                        target = _AutonomySendTarget(self, umo, "", "", private=True)
                        await target.send(MessageChain([Plain(text)]))
                    except Exception as exc:
                        logger.warning("[biocore] module send failed: %s", exc)
                try:
                    _asyncio.ensure_future(_send())
                    return True
                except Exception:
                    return False
            deps.send_text = _trigger_send
            result = _tick_mod.tick_once(deps, started)
            logger.info("[biocore] autonomy tick engine=module V=%.3f skipped=%d blocked=%d reason=%s",
                        float(deps.load_acc().get("V", 0.0) or 0.0), len(result.get("skipped") or []),
                        len(result.get("blocked") or []), result.get("reason", ""))
            return list(result.get("sent") or [])
        except Exception as exc:
            logger.warning("[biocore] autonomy module engine failed, falling back to legacy: %s", exc)
            return await self._autonomy_tick_legacy(now)


